-- Vectors and matrices: the carriers, their leaves and their accessors. An interface: the
-- carriers and the leaves are declared without a body, and `array_python.lut` binds them to
-- numpy. Everything else here is written in Luthier over the leaves.
--
-- A `Vec` or a `Mat` is a value Luthier does not take apart. Luthier sees it
-- through accessors (`at`, `entry`, `length`, `rows`, `cols`, `row`) and builds it through their
-- duals (`tabulate`, `tabulateMat`, `stack`): a program can define any operation as a recursion
-- over an index and never hold the array as a list. The leaves below have no body. What they
-- mean is stated twice: by the definition `...Def` written through the accessors, when the laws
-- alone would not pin the operation down (dot, det, matVec), and by the laws of the algebraic
-- structures in `algebra.lut`, which the leaves instantiate. The laws `Agrees` certify that each
-- implementation computes its definition within the rounding of n terms.
--
-- The carriers do not carry their shapes; the refinements VecOf n and MatOf m n below do, and
-- the laws quantify over dimensions and then over values of those shapes.

import "real"

Vec : U
Mat : U

-- ---------------------------------------------------------------- accessors and their duals
length : Vec -> Int
rows   : Mat -> Int
cols   : Mat -> Int
at     : Vec -> Int -> R
entry  : Mat -> Int -> Int -> R
row    : Mat -> Int -> Vec
last   : Vec -> R

tabulate    : Int -> (Int -> R) -> Vec
tabulateMat : Int -> Int -> (Int -> Int -> R) -> Mat
stack       : Int -> (Int -> Vec) -> Mat   -- row i is f i

-- ---------------------------------------------------------------- construction and pieces
fromList : List R -> Vec
toList   : Vec -> List R
zeros    : Int -> Vec
ones     : Int -> Vec
identity : Int -> Mat
head     : Vec -> Int -> Vec       -- the first n entries
append   : Vec -> R -> Vec
concat   : Vec -> Vec -> Vec

-- ---------------------------------------------------------------- the leaves
add   : Vec -> Vec -> Vec
sub   : Vec -> Vec -> Vec
scale : R -> Vec -> Vec
dot   : Vec -> Vec -> R
norm  : Vec -> R
total : Vec -> R
product : Vec -> R
minimum : Vec -> R
maximum : Vec -> R

outer     : Vec -> Vec -> Mat
matVec    : Mat -> Vec -> Vec
matMul    : Mat -> Mat -> Mat
transpose : Mat -> Mat
trace     : Mat -> R
det       : Mat -> R
frob      : Mat -> R
cond      : Mat -> R
solve      : Mat -> Vec -> Vec          -- x with A x = b
eigvalsSym : Mat -> Vec           -- ascending
invSqrtSym : Mat -> Mat          -- M with M A M = I
retainedRank : Mat -> Int        -- eigenvalues above n eps max |eigenvalue|
pinvSym : Mat -> Mat             -- the pseudo-inverse on the retained subspace
pinvSqrtSym : Mat -> Mat         -- M with M A M the projector on the retained subspace

madd     : Mat -> Mat -> Mat
msub     : Mat -> Mat -> Mat
mscale   : R -> Mat -> Mat
hadamard : Mat -> Mat -> Mat       -- entrywise product
maxAbs    : Vec -> R
maxAbsMat : Mat -> R
index    : Vec -> Int -> Int          -- entry k of whole numbers

-- n standard normals from a seed, and the next seed
normalVec : Int -> Int -> Vec * Int

-- ---------------------------------------------------------------- operators
-- The arithmetic of vectors and matrices written with + - *: each operator is resolved by the
-- types of its two operands, and falls back to the arithmetic of Int and R when none applies.
operator + := add
operator - := sub
operator * := scale        -- R * Vec
operator + := madd
operator - := msub
operator * := mscale       -- R * Mat
operator * := matVec       -- Mat * Vec
operator * := matMul       -- Mat * Mat

-- ---------------------------------------------------------------- comparison
-- `==` does not decide on arrays. Entrywise |a - b| <= tol (1 + |a| + |b|).
approxR   : R -> R -> R -> Bool
approxVec : R -> Vec -> Vec -> Bool
approxMat : R -> Mat -> Mat -> Bool

-- The tolerance of a law: a sum of n products rounds to about n eps times the size of the
-- terms, and the terms can cancel, so a law whose sides may be near zero scales its tolerance
-- by the norms involved, not by the result. The slack covers the few extra operations each
-- side performs. Declared once, here.
roundingSlack : R := 8.0
tolOf (n : Int) : R := roundingSlack * toR n * eps
scaledTol (n : Int) (magnitude : R) : R := tolOf n * (1.0 + magnitude)

factorial (n : Int) : Int := if n <= 1 then 1 else n * factorial (n - 1)
powR (x : R) (n : Int) : R := if n <= 0 then 1.0 else x * powR x (n - 1)

-- ---------------------------------------------------------------- the definitions
-- sum_{k = lo}^{hi - 1} f k, a recursion over the index
sumFrom (lo hi : Int) (f : Int -> R) : R := if lo >= hi then 0.0 else f lo + sumFrom (lo + 1) hi f
sumTo (n : Int) (f : Int -> R) : R := sumFrom 0 n f

dotDef (x y : Vec) : R := sumTo (length x) (\ k { at x k * at y k })
normDef (x : Vec) : R := sqrtR (dotDef x x)
totalDef (x : Vec) : R := sumTo (length x) (\ k { at x k })
addDef (x y : Vec) : Vec := tabulate (length x) (\ k { at x k + at y k })
subDef (x y : Vec) : Vec := tabulate (length x) (\ k { at x k - at y k })
scaleDef (c : R) (x : Vec) : Vec := tabulate (length x) (\ k { c * at x k })
outerDef (x y : Vec) : Mat := tabulateMat (length x) (length y) (\ i j { at x i * at y j })
matVecDef (a : Mat) (x : Vec) : Vec := tabulate (rows a) (\ i { sumTo (cols a) (\ j { entry a i j * at x j }) })
matMulDef (a b : Mat) : Mat := tabulateMat (rows a) (cols b) (\ i j { sumTo (cols a) (\ k { entry a i k * entry b k j }) })
transposeDef (a : Mat) : Mat := tabulateMat (cols a) (rows a) (\ i j { entry a j i })
traceDef (a : Mat) : R := sumTo (rows a) (\ i { entry a i i })
maddDef (a b : Mat) : Mat := tabulateMat (rows a) (cols a) (\ i j { entry a i j + entry b i j })
msubDef (a b : Mat) : Mat := tabulateMat (rows a) (cols a) (\ i j { entry a i j - entry b i j })
mscaleDef (c : R) (a : Mat) : Mat := tabulateMat (rows a) (cols a) (\ i j { c * entry a i j })
hadamardDef (a b : Mat) : Mat := tabulateMat (rows a) (cols a) (\ i j { entry a i j * entry b i j })
maxFrom (lo hi : Int) (f : Int -> R) (best : R) : R :=
  if lo >= hi then best else maxFrom (lo + 1) hi f (if f lo > best then f lo else best)
maxAbsDef (x : Vec) : R := maxFrom 0 (length x) (\ k { abs (at x k) }) 0.0

-- the determinant by Laplace expansion along the first row; minor j drops row 0 and column j
minor (a : Mat) (j : Int) : Mat :=
  tabulateMat (rows a - 1) (cols a - 1) (\ r c { entry a (r + 1) (if c < j then c else c + 1) })
detDef (a : Mat) : R :=
  if rows a == 1 then entry a 0 0
  else sumTo (cols a) (\ j { (if j mod 2 == 0 then 1.0 else 0.0 - 1.0) * entry a 0 j * detDef (minor a j) })

-- ---------------------------------------------------------------- the spectrum, natively
-- Jacobi's method: a plane rotation J(p, q) chosen to zero the entry (p, q) of a symmetric A,
-- A <- J^T A J and V <- V J, in cyclic sweeps over all pairs until what is left off the diagonal
-- is below jacobiTol times the size of A. The diagonal is then the spectrum and V its vectors.
-- The rotation of Golub and Van Loan: with r = (A_qq - A_pp) / (2 A_pq), t = sign r /
-- (|r| + sqrt(r^2 + 1)) is the tangent of the smaller angle, c = 1 / sqrt(t^2 + 1), s = t c.
jacobiTol : R := eps
maxSweeps : Int := 30

rotation (n p q : Int) (c s : R) : Mat :=
  tabulateMat n n (\ i j {
    if i == p and j == p then c else if i == q and j == q then c
    else if i == p and j == q then s else if i == q and j == p then 0.0 - s
    else if i == j then 1.0 else 0.0 })

-- the size of what is off the diagonal, summed directly: frob^2 minus the diagonal would
-- cancel, and lose everything below sqrt(eps) of the matrix
offDiagonal (a : Mat) : R :=
  sqrtR (sumTo (rows a) (\ i { sumTo (cols a) (\ j { if i == j then 0.0 else entry a i j * entry a i j }) }))

-- one rotation on the pair (p, q); a pair already zero is left alone. The pair is carried
-- through hundreds of rotations, so both components are evaluated at each one: a lazy pair
-- would hold the whole chain of pending rotations (the accumulator leak of lazy evaluation).
rotate (p q : Int) (av : Mat * Mat) : Mat * Mat :=
  match av { (a, v) ->
  if entry a p q == 0.0 then (a, v)
  else match (entry a q q - entry a p p) / (2.0 * entry a p q) { r ->
       match (if r >= 0.0 then 1.0 else 0.0 - 1.0) / (abs r + sqrtR (r * r + 1.0)) { t ->
       match 1.0 / sqrtR (t * t + 1.0) { c ->
       match rotation (rows a) p q c (t * c) { j ->
       match matMul (transpose j) (matMul a j) { a2 -> match matMul v j { v2 -> (a2, v2) } } } } } } }

-- a sweep: every pair p < q in order
sweepFrom (p q : Int) (av : Mat * Mat) : Mat * Mat :=
  match av { (a, v) ->
  if p >= rows a - 1 then av
  else if q >= rows a then sweepFrom (p + 1) (p + 2) av
  else sweepFrom p (q + 1) (rotate p q av) }

jacobi (a0 : Mat) (k : Int) (av : Mat * Mat) : Mat * Mat :=
  match av { (a, v) ->
  if k >= maxSweeps or offDiagonal a <= jacobiTol * frob a0 then av
  else jacobi a0 (k + 1) (sweepFrom 0 1 av) }

-- the spectrum and the vectors, unordered: column k of V belongs to entry k of the diagonal
eigenDef (a : Mat) : Vec * Mat :=
  match jacobi a 0 (a, identity (rows a)) { (d, v) -> (tabulate (rows d) (\ i { entry d i i }), v) }

sumToInt (n : Int) (f : Int -> Int) : Int := if n <= 0 then 0 else f (n - 1) + sumToInt (n - 1) f

-- ascending order, by rank: entry i goes to the number of entries before it in the order
rankIn (x : Vec) (i : Int) : Int :=
  sumToInt (length x) (\ j { if at x j < at x i or (at x j == at x i and j < i) then 1 else 0 })
sortedDef (x : Vec) : Vec :=
  tabulate (length x) (\ k { sumTo (length x) (\ i { if rankIn x i == k then at x i else 0.0 }) })

eigvalsDef (a : Mat) : Vec := match eigenDef a { (e, v) -> sortedDef e }

-- a function of a symmetric matrix through its spectrum: V diag(f lambda) V^T
spectralMap (f : R -> R) (a : Mat) : Mat :=
  match eigenDef a { (e, v) -> matMul (matMul v (tabulateMat (length e) (length e) (\ i j { if i == j then f (at e i) else 0.0 }))) (transpose v) }

-- the retained subspace: eigenvalues above n eps times the largest in size
retainedFloor (a : Mat) : R :=
  match eigenDef a { (e, v) -> toR (length e) * eps * maxFrom 0 (length e) (\ k { abs (at e k) }) 0.0 }
retainedRankDef (a : Mat) : Int :=
  match eigenDef a { (e, v) -> match retainedFloor a { fl -> sumToInt (length e) (\ k { if at e k > fl then 1 else 0 }) } }

invSqrtDef (a : Mat) : Mat := spectralMap (\ x { 1.0 / sqrtR x }) a
pinvDef (a : Mat) : Mat := match retainedFloor a { fl -> spectralMap (\ x { if x > fl then 1.0 / x else 0.0 }) a }
pinvSqrtDef (a : Mat) : Mat := match retainedFloor a { fl -> spectralMap (\ x { if x > fl then 1.0 / sqrtR x else 0.0 }) a }

-- ---------------------------------------------------------------- shapes in the types
-- A vector of length n, a matrix of m rows and n columns: refinements of the carriers. A leaf
-- returns a bare Vec or Mat; where a shaped type is expected, the shape is an obligation that
-- `test` checks. The laws quantify over the dimensions first and then over values of those
-- shapes, so every argument of a law fits the others.
Dim  : U := { n : Int | 1 <= n }
Dim2 : U := { n : Int | 2 <= n }
VecOf (n : Int) : U := { v : Vec | length v == n }
MatOf (m n : Int) : U := { a : Mat | rows a == m and cols a == n }
-- symmetric positive definite, and positive semidefinite of rank below n
SpdOf (n : Int) : U := { a : Mat | rows a == n and cols a == n and approxMat 0.0 a (transpose a) and minimum (eigvalsSym a) > 0.0 }
DeficientOf (n : Int) : U := { a : Mat | rows a == n and cols a == n and retainedRank a < n }

-- ---------------------------------------------------------------- each leaf agrees with its definition
DotAgrees (d : Vec -> Vec -> R) (n : Dim) (x y : VecOf n) : Bool :=
  approxR (scaledTol n (norm x * norm y)) (d x y) (dotDef x y)
NormAgrees (nm : Vec -> R) (n : Dim) (x : VecOf n) : Bool := approxR (tolOf n) (nm x) (normDef x)
TotalAgrees (t : Vec -> R) (n : Dim) (x : VecOf n) : Bool := approxR (scaledTol n (norm x)) (t x) (totalDef x)
AddAgrees (ad : Vec -> Vec -> Vec) (n : Dim) (x y : VecOf n) : Bool := approxVec 0.0 (ad x y) (addDef x y)
SubAgrees (sb : Vec -> Vec -> Vec) (n : Dim) (x y : VecOf n) : Bool := approxVec 0.0 (sb x y) (subDef x y)
ScaleAgrees (sc : R -> Vec -> Vec) (n : Dim) (c : R) (x : VecOf n) : Bool := approxVec 0.0 (sc c x) (scaleDef c x)
OuterAgrees (o : Vec -> Vec -> Mat) (m n : Dim) (x : VecOf m) (y : VecOf n) : Bool := approxMat 0.0 (o x y) (outerDef x y)
MatVecAgrees (mv : Mat -> Vec -> Vec) (m n : Dim) (a : MatOf m n) (x : VecOf n) : Bool :=
  approxVec (scaledTol n (frob a * norm x)) (mv a x) (matVecDef a x)
MatMulAgrees (mm : Mat -> Mat -> Mat) (m k n : Dim) (a : MatOf m k) (b : MatOf k n) : Bool :=
  approxMat (scaledTol k (frob a * frob b)) (mm a b) (matMulDef a b)
TransposeAgrees (tr : Mat -> Mat) (m n : Dim) (a : MatOf m n) : Bool := approxMat 0.0 (tr a) (transposeDef a)
TraceAgrees (t : Mat -> R) (n : Dim) (a : MatOf n n) : Bool := approxR (scaledTol n (frob a)) (t a) (traceDef a)
MaddAgrees (f : Mat -> Mat -> Mat) (m n : Dim) (a b : MatOf m n) : Bool := approxMat 0.0 (f a b) (maddDef a b)
MsubAgrees (f : Mat -> Mat -> Mat) (m n : Dim) (a b : MatOf m n) : Bool := approxMat 0.0 (f a b) (msubDef a b)
MscaleAgrees (f : R -> Mat -> Mat) (m n : Dim) (c : R) (a : MatOf m n) : Bool := approxMat 0.0 (f c a) (mscaleDef c a)
HadamardAgrees (f : Mat -> Mat -> Mat) (m n : Dim) (a b : MatOf m n) : Bool := approxMat 0.0 (f a b) (hadamardDef a b)
MaxAbsAgrees (f : Vec -> R) (n : Dim) (x : VecOf n) : Bool := f x == maxAbsDef x
-- Laplace has n! terms, so the definition is only evaluated up to laplaceLimit; its rounding is
-- bounded by n! eps times the product of the row norms, dominated by the Frobenius norm to the n
laplaceLimit : Int := 4
DetAgrees (dt : Mat -> R) (n : Dim) (a : MatOf n n) : Bool :=
  n > laplaceLimit or approxR (scaledTol (factorial n) (powR (frob a) n)) (dt a) (detDef a)
-- the spectral leaves agree with Jacobi's spectrum
spectralTol (s : Mat) : R := cond s * scaledTol (rows s * rows s) (frob s)
EigvalsAgree (ev : Mat -> Vec) (n : Dim) (s : SpdOf n) : Bool :=
  approxVec (scaledTol (n * n) (frob s)) (ev s) (eigvalsDef s)
InvSqrtAgrees (m : Mat -> Mat) (n : Dim) (s : SpdOf n) : Bool := approxMat (spectralTol s) (m s) (invSqrtDef s)
singularTol (s : Mat) : R := scaledTol (rows s * rows s) (frob s) * (1.0 + frob s * frob (pinvDef s))
RankAgrees (r : Mat -> Int) (n : Dim2) (s : DeficientOf n) : Bool := r s == retainedRankDef s
PinvAgrees (m : Mat -> Mat) (n : Dim2) (s : DeficientOf n) : Bool := approxMat (singularTol s) (m s) (pinvDef s)
PinvSqrtAgrees (m : Mat -> Mat) (n : Dim2) (s : DeficientOf n) : Bool := approxMat (singularTol s) (m s) (pinvSqrtDef s)

-- ---------------------------------------------------------------- laws the definitions do not need
DotCommutes (d : Vec -> Vec -> R) (n : Dim) (x y : VecOf n) : Bool := approxR (tolOf n) (d x y) (d y x)
DotLinear (d : Vec -> Vec -> R) (n : Dim) (x y z : VecOf n) : Bool :=
  approxR (scaledTol n (norm z * (norm x + norm y))) (d (add x y) z) (d x z + d y z)
NormIsDot (d : Vec -> Vec -> R) (n : Dim) (x : VecOf n) : Bool := approxR (tolOf n) (norm x * norm x) (d x x)
-- <A x, y> = <x, A^T y>: transpose is the adjoint of matVec
TransposeIsAdjoint (mv : Mat -> Vec -> Vec) (m n : Dim) (a : MatOf m n) (x : VecOf n) (y : VecOf m) : Bool :=
  approxR (scaledTol (m * n) (frob a * norm x * norm y)) (dot (mv a x) y) (dot x (mv (transpose a) y))
TransposeInvolutive (tr : Mat -> Mat) (m n : Dim) (a : MatOf m n) : Bool := approxMat 0.0 (tr (tr a)) a
-- (y x^T) z = (x . z) y
OuterActs (o : Vec -> Vec -> Mat) (m n : Dim) (y : VecOf m) (x z : VecOf n) : Bool :=
  approxVec (scaledTol n (norm y * norm x * norm z)) (matVec (o y x) z) (scale (dot x z) y)
-- (A B) x = A (B x)
MatMulAssociates (mm : Mat -> Mat -> Mat) (m k n : Dim) (a : MatOf m k) (b : MatOf k n) (x : VecOf n) : Bool :=
  approxVec (scaledTol (k * n) (frob a * frob b * norm x)) (matVec (mm a b) x) (matVec a (matVec b x))
SolveInverts (sv : Mat -> Vec -> Vec) (n : Dim) (s : SpdOf n) (x : VecOf n) : Bool :=
  approxVec (cond s * tolOf (n * n)) (matVec s (sv s x)) x
DetOfTranspose (dt : Mat -> R) (n : Dim) (s : SpdOf n) : Bool := approxR (tolOf (n * n)) (dt s) (dt (transpose s))
DetPositive (dt : Mat -> R) (n : Dim) (s : SpdOf n) : Bool := dt s > 0.0
EigenvaluesSumToTrace (ev : Mat -> Vec) (n : Dim) (s : SpdOf n) : Bool :=
  approxR (scaledTol n (frob s)) (total (ev s)) (trace s)
EigenvaluesMultiplyToDet (ev : Mat -> Vec) (n : Dim) (s : SpdOf n) : Bool :=
  approxR (cond s * tolOf (n * n)) (product (ev s)) (det s)
InvSqrtInverts (m : Mat -> Mat) (n : Dim) (s : SpdOf n) : Bool :=
  approxMat (cond s * tolOf (n * n)) (matMul (m s) (matMul s (m s))) (identity n)
ListRoundTrip (fl : List R -> Vec) (l : List R) : Bool := approxVec 0.0 (fl (toList (fl l))) (fl l)
