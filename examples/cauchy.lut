-- The reals by construction: a real is a sequence of rationals whose n-th term is within 2^-n of
-- every later one (a Cauchy sequence with a modulus). The sum of two reals is defined, and it
-- reduces to a rational at any precision asked; the exponential is Taylor with as many terms as
-- the precision asks, its remainder bounded from the size of the argument. What never computes
-- is equality: two sequences with the same limit are equal by a law that no finite observation
-- decides (05 R8), so `Cauchy` is a value that is defined without being a datum one can compare.
--
-- `Real` stays the ideal, declared and never run; `Cauchy` is one more realization of it, beside
-- `Float64` (D-2026-10-07-c). It is the "Real that computes" of 06 §4 and 06 §9, and what lets
-- the arrow of examples/exp.lut, from the ideal to the doubles, be run: `roundC (f (fromDouble x))`.
--
-- The exponential's obligation is tested at size 3: its exact fractions grow fast, and the
-- interpreter of version 0 formats every operand into a message, which Python refuses beyond
-- 4300 digits (an interpreter defect noted on 2026-10-07; `PYTHONINTMAXSTRDIGITS=0` lifts it).
-- Luciano, 2026-10-07.

import "rational"

pow2 (n : Int) : Int := if n <= 0 then 1 else 2 * pow2 (n - 1)
epsQ (n : Int) : Rational := ratio 1 (pow2 n)
factorialI (n : Int) : Int := if n <= 1 then 1 else n * factorialI (n - 1)

Modulus (s : Int -> Rational) (n : Nat) (m : Nat) : Bool := m < n or absQ (s n - s m) <= epsQ n
Cauchy : U := { s : Int -> Rational | Modulus s }

-- the sum of two reals: defined, and it reduces at any precision
addC (x y : Cauchy) : Cauchy := \ n { x (n + 1) + y (n + 1) }
-- a double is a real: the constant sequence
fromDouble (d : Float64) : Cauchy := \ n { toQ d }
-- back to the doubles: the nearest double to the term at precision 2^-60 (absolute)
roundC (x : Cauchy) : Float64 := nearest (x 60)

-- the exponential: Taylor with as many terms as the precision asks. With |x| <= B (B an integer
-- read off the first term of x, since |x - x 0| <= 1), N terms leave a remainder below
-- 3^B B^(N+1) / (N+1)!, and taking x at precision n + 1 + 2B keeps the error of the argument
-- below 2^-(n+1), since exp' = exp <= 3^B <= 2^(2B) there.
powI (b : Int) (k : Int) : Int := if k <= 0 then 1 else b * powI b (k - 1)
boundOf (x : Cauchy) : Int := round (nearest (absQ (x 0))) + 2
termsFor (bound : Int) (n : Int) (k : Int) : Int :=
  if factorialI (k + 1) >= powI 3 bound * powI bound (k + 1) * pow2 (n + 1) then k else termsFor bound n (k + 1)
taylorQ (x : Rational) (k : Int) (term : Rational) (left : Int) : Rational :=
  if left <= 0 then zeroQ else term + taylorQ x (k + 1) (term * x / fromInt (k + 1)) (left - 1)
expC (x : Cauchy) : Cauchy := \ n { let b = boundOf x in taylorQ (x (n + 1 + 2 * b)) 0 oneQ (termsFor b n 1) }

-- e, and the sum of the two doubles 0.1 and 0.2, exact in the rationals before it is rounded
e : Float64 := roundC (expC (fromDouble 1.0))
sumOfTenths : Float64 := roundC (addC (fromDouble 0.1) (fromDouble 0.2))

test addC with 100
test fromDouble with 100
test expC with 30 size 3
