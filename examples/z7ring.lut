-- The integers modulo 7 as a ring. Z7 is its own type, not a subtype of Int: as rings Z7 is a
-- quotient of Int, the projection `mod 7` is the homomorphism and the inclusion of representatives
-- is not, so `+` on two values of Z7 is the ring's addition and never Int's (05 R13, D-2026-10-11-j:
-- a type names its model; a carrier with two models is two types). The representatives are Fin 7
-- inside the one label `z7` (a non-recursive type is a sum, 05 R4); `forget` is `rep`. The laws of `CommutativeRing` from the algebra
-- library are checked on every case, and the projection is certified a ring homomorphism.

import "algebra"

Z7 = < z7 : Fin 7 >

rep (a : Z7) : Int := match a { z7 k -> k }
proj (k : Int) : Z7 := z7 (k mod 7)

eqZ7 (a b : Z7) : Bool := rep a == rep b
addZ7 (a b : Z7) : Z7 := proj (rep a + rep b)
mulZ7 (a b : Z7) : Z7 := proj (rep a * rep b)
negZ7 (a : Z7) : Z7 := proj (7 - rep a)

operator + := addZ7
operator * := mulZ7

ringZ7 : CommutativeRing Z7 := {
  eq  := eqZ7,
  add := { monoid := { op := addZ7, unit := proj 0 }, inv := negZ7 },
  mul := { op := mulZ7, unit := proj 1 } }

-- the projection is a homomorphism of both operations: the law that lets a Z7 use Int's
-- arithmetic on its representatives (05 R13)
intAdd (a b : Int) : Int := a + b
intMul (a b : Int) : Int := a * b
RingHomIntZ7 : U := { f : Int -> Z7 | Homomorphism Int Z7 eqZ7 intAdd addZ7 f & Homomorphism Int Z7 eqZ7 intMul mulZ7 f }
projHom : RingHomIntZ7 := proj

-- or and and on Bool satisfy every law of a ring but the inverses
eqB (a b : Bool) : Bool := a == b
badRing : Ring Bool := {
  eq  := eqB,
  add := { monoid := { op := or, unit := false }, inv := not },
  mul := { op := and, unit := true } }

test ringZ7 exhaustive
test projHom with 500
test badRing exhaustive
