-- The integers modulo 7 as a ring: a refinement of Int, three operations, and the laws of
-- `Ring` from the algebra library, checked on every case.

import "algebra"

Z7 : U := { k : Int | 0 <= k and k < 7 }

eqZ7 (a b : Z7) : Bool := a == b
addMod7 (a b : Z7) : Z7 := (a + b) mod 7
mulMod7 (a b : Z7) : Z7 := (a * b) mod 7
negMod7 (a : Z7) : Z7 := (7 - a) mod 7

ringZ7 : CommutativeRing Z7 := {
  eq  := eqZ7,
  add := { monoid := { op := addMod7, unit := 0 }, inv := negMod7 },
  mul := { op := mulMod7, unit := 1 } }

-- or and and on Bool satisfy every law of a ring but the inverses
eqB (a b : Bool) : Bool := a == b
badRing : Ring Bool := {
  eq  := eqB,
  add := { monoid := { op := or, unit := false }, inv := not },
  mul := { op := and, unit := true } }

test ringZ7 exhaustive
test badRing exhaustive
