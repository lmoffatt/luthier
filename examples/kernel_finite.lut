-- The kernel's laws checked on finite types: every function Fin 3 -> Fin 2 is drawn as its table,
-- every pair and every value enumerated, so the pairs and values could be exhaustive; functions over `Fin n` are drawn as tables and lists are
-- sampled (05 §7), so the test is sampled, 200 cases per law.
-- What this certifies is the interpreter's conformance to 04 §4 on these types (kernel_laws.lut).

import "kernel_laws"

eqFin3 (a b : Fin 3) : Bool := a == b
eqFin2 (a b : Fin 2) : Bool := a == b
eqPair (p q : Fin 3 * Fin 2) : Bool := p == q
-- the algebra of the fold: count the elements modulo 2
step (x : Fin 3) (acc : Fin 2) : Fin 2 := (acc + 1) mod 2

kernelFin : KernelLaws (Fin 3) (Fin 2) := { eqA := eqFin3, eqB := eqFin2, eqAB := eqPair, n := 0, c := step }

test kernelFin with 200
