-- Three nodes: 0 and 1 are leaves, 2 is their sum. The schedules 0,1,2 and 1,0,2 both linearize
-- the dataflow and must give the same values; 2,0,1 does not linearize it and the law says
-- nothing about it. Every schedule of Fin 3 is enumerated (6 permutations out of 27 tables), so
-- the law is checked exhaustively on every pair.

import "plan"

eqInt (a b : Int) : Bool := a == b

depsSum (i j : Fin 3) : Bool := i == 2 and (j == 0 or j == 1)
stepSum (i : Fin 3) (env : Fin 3 -> Int) : Int :=
  if i == 0 then 1 else if i == 1 then 2 else env 0 + env 1

sumFlow : Planned Int eqInt 3 := { init := 0, deps := depsSum, step := stepSum }

-- a dataflow whose step ignores the dependencies it declares is still confluent: the law is about
-- the values, and declared dependencies only restrict the schedules
test sumFlow exhaustive
