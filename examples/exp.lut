-- The exponential as a type, written once over a number model and instantiated twice: on Real,
-- the ideal, which is a statement because nothing computes the reals; and on Float64, which runs,
-- with two models certified against the same laws, a Taylor sum and math.exp. The arrow between
-- the two instances goes from the ideal to the doubles: `realize f x = round (f x)`, and a machine
-- exp realizes the ideal one when it stays within tolerance of that. It is stated here and not
-- run, since `round : Real -> Float64` waits for a Real that computes (06 §4, 06 §9).
-- Luciano, 2026-10-07; guide 00, "A function as a type".

import "real"
import "real_python"
import "random"
import "algebra"

-- A number model: the operations the laws of Exp need, with its equality. Its own laws are the
-- two identities, which hold exactly on the doubles too (x + 0.0 == x, x * 1.0 == x).
AddZero (R : U) (eq : R -> R -> Bool) (add : R -> R -> R) (zero : R) (x : R) : Bool := eq (add x zero) x
MulOne  (R : U) (eq : R -> R -> Bool) (mul : R -> R -> R) (one : R) (x : R) : Bool := eq (mul x one) x
NumberModel (R : U) : U := { add : R -> R -> R, mul : R -> R -> R, zero : R, one : R, eq : R -> R -> Bool
  | AddZero R eq add zero & MulOne R eq mul one }

-- The laws of the exponential: a homomorphism from addition to multiplication, normalized at zero.
Homomorphic (R : U) (m : NumberModel R) (f : R -> R) (x y : R) : Bool := m.eq (f (m.add x y)) (m.mul (f x) (f y))
AtZero (R : U) (m : NumberModel R) (f : R -> R) : Bool := m.eq (f m.zero) m.one
Exp (R : U) (m : NumberModel R) : U := { f : R -> R | Homomorphic R m f & AtZero R m f }

-- The reals: the axiom's operations and its exact equality (06 §3). Nothing computes them.
realModel : NumberModel Real := {
  add := realField.ordered.field.ring.add.monoid.op,
  mul := realField.ordered.field.ring.mul.op,
  zero := realField.ordered.field.ring.add.monoid.unit,
  one := realField.ordered.field.ring.mul.unit,
  eq := realField.ordered.field.ring.eq }

-- The doubles: the machine's operations, equality within a tolerance, which is a parameter.
float64Model (tol : NonNegative) : NumberModel Float64 :=
  { add := \ (a b : Float64) { a + b }, mul := \ (a b : Float64) { a * b }, zero := 0.0, one := 1.0, eq := approx tol }
expTol : NonNegative := 1.0e-9

-- The ideal: declared, a statement with no body.
expIdeal : Exp Real realModel

-- Two models on the doubles. The Taylor series is summed from the term where it no longer changes
-- the sum back to the first, so the small terms are added first.
taylorFrom (x : Float64) (k : Int) (term : Float64) : Float64 :=
  if abs term <= 1.0e-18 then 0.0 else term + taylorFrom x (k + 1) (term * x / toFloat64 (k + 1))
expTaylor : Exp Float64 (float64Model expTol) := \ x { taylorFrom x 0 1.0 }
expPy : Exp Float64 (float64Model expTol) := extern "python:math.exp"

-- The arrow. A double is a real (Float64 : Real), so the ideal applies to it; `roundReal` brings
-- the result back and is the hole nothing fills yet. `g` realizes `f` when it stays within
-- tolerance of `realize f`. The test of `expPyRealizes` is not run until `roundReal` has a value.
roundReal : Real -> Float64
realize (f : Exp Real realModel) (x : Float64) : Float64 := roundReal (f x)
Realizes (g : Float64 -> Float64) (f : Exp Real realModel) (x : Float64) : Bool := approx expTol (g x) (realize f x)
expPyRealizes : { g : Exp Float64 (float64Model expTol) | Realizes g expIdeal } := expPy

test float64Model with 100 size 3
test expTaylor with 200 size 3
test expPy with 200 size 3
test expPyRealizes with 20 size 3
