-- distances.lut: positions from tape-measure distances, the instance of the Gaussian construction.
--
-- Ported 2026-10-14 by Claude Opus 5.5, an agent of the coordinating session, on the brief
-- record/IA/slice-port-2-2026-10-14/prompt.md, from prototipo-cero/luthier/distances.lut of
-- sonolocalización at its commit 5ffc36ef70e16e11182bc09e4a927c381e35df1c (v0.1 syntax). The
-- changes from v0.1, beyond `fn`, `vec`/`mat`, blocks for the one-arm `match`es and named imports
-- (as positions.lut): the parameter spaces are `VecOf n` and the likelihoods `Likelihood n`
-- (7.R2, probability.lth; the theories' report, record/IA/slice-theories-2-2026-10-14/report.md,
-- last section), so `MeanModel FreeCoords { dim, shift, ... }` is `MeanModel freeDim { k, ... }`
-- and `Likelihood FullCoords (Vec Float64)` is `Likelihood (freeDim + 1)`; `pitResolution` is a
-- `Resolution` (probability.lth §1); a law's tolerance is the demand's, a parameter `tol` (11.S18,
-- P11), scaled as v0.1's `scaledTol` scaled `8 eps`. Not ported: the sampler (`nativeSampler`,
-- `profileSamplerOf`, `sigmaProfile`, `SamplerAgrees`, `ensemble`), which needs a generator of
-- standard normals that generators.lth does not have yet (the theories' report); the three laws
-- that drew their data from it take the data `y` as a parameter instead, which a test binds.
--
-- From distances.lut's header, kept: the design is every pair of `nodes` nodes, each measured
-- once, and the mean model is the one of positions.lut that experiment_zero.lut fits, the
-- horizontal distances, with the gauge fixed by removing the coordinates no distance sees: the
-- height of every node, and three of the plane, node 0 at the origin and node 1 on the x axis.
-- With every pair of nodes not on one line measured, the distances see everything else, so with
-- the gauge fixed the model is identifiable and its information is not singular. A design that
-- leaves more unseen has a singular information even with the gauge fixed, and there only the
-- posterior, with the prior's precision, is proper: experiment_zero.lut fits with the prior.
-- Two likelihoods: the full one, with u = log sigma appended to the parameter, and the profile
-- one, sigma eliminated. This file is the model and its laws, with no implementation: the laws
-- say an implementation agrees with the native definition, and that the profile likelihood is
-- the full one at the sigma that maximizes it. (v0.1's distances_python.lut bound the fast
-- likelihoods of sonolocalización's src/positions_luthier.py; they live in that repository, P7.)

import "numbers.lth" Tolerance Doubles Elementary within abs
import "numbers_model.lut" doubles : Doubles elementary : Elementary
import "arrays.lth" Vec Mat VecOf vec mat forallBelow sumToInt approxVec approxMat frobDef
import "arrays_model.lut" numpy : Arrays sub dot norm
import "probability.lth" MeanModel ScaledModel Likelihood Resolution gaussian profiled
import "positions.lut" PositionsOf PairsAmong Design positionsModel

-- ---------------------------------------------------------------- the design
-- every pair a < b of the nodes, in the order of numpy's triu_indices: the pairs with first node a
-- start at pairOffset a, and the first node of pair k is the last a whose pairs start at or before k
nodes : Int := 7
nPairs : Int := nodes * (nodes - 1) / 2
pairOffset (a : Int) : Int := a * nodes - a * (a + 1) / 2
firstFrom (k a : Int) : Int := if a + 2 < nodes and pairOffset (a + 1) <= k then firstFrom k (a + 1) else a
pairI : Vec (Fin nodes) := vec (Fin nodes) nPairs (fn k { firstFrom k 0 })
pairJ : PairsAmong nodes pairI := vec (Fin nodes) nPairs (fn k {
  a := firstFrom k 0
  a + 1 + k - pairOffset a })
design : Design := { nodes := nodes, i := pairI, j := pairJ }
freeDim : Int := 2 * nodes - 3

-- ---------------------------------------------------------------- the gauge
-- Every height (coordinate 2 of each node, 3 n + 2), node 0 at the origin of the floor
-- (coordinates 0, 1) and node 1 on the x axis (its y, 4). The fixed coordinates are said once; the
-- rest is derived from them, and freeCoords is what the fast likelihoods receive.
isFixed (c : Int) : Bool := c mod 3 == 2 or c <= 1 or c == 4
-- how many coordinates below c are fixed
fixedBelow (c : Int) : Int := sumToInt c (fn b { if isFixed b then 1 else 0 })
-- the coordinate of free index f: the f-th coordinate that is not fixed, searching from c
freeFrom (f c : Int) : Int := if isFixed c then freeFrom f (c + 1) else if f <= 0 then c else freeFrom (f - 1) (c + 1)
freeCoord (f : Int) : Int := freeFrom f 0
freeCoords : Vec Int := vec Int freeDim (fn f { freeCoord f })

-- a parameter holding the free coordinates, with or without u after them
HasFree : U := { v : Vec Float64 | freeDim <= v.n }

-- the positions of the nodes, with the fixed coordinates at zero
embed (t : HasFree) : PositionsOf nodes := vec Float64 (3 * nodes) (fn c { if isFixed c then 0.0 else t.f (c - fixedBelow c) })

-- ---------------------------------------------------------------- the mean model
-- the model of the design on the positions, read on the free coordinates: the distances at the
-- embedded positions, and d h_k / d t_f, the column of the coordinate f stands for, zero on u, which
-- the mean does not depend on
positions : MeanModel (3 * nodes) := positionsModel design

meanDist (t : HasFree) : Vec Float64 := positions.mean (embed t)
jacDist (t : HasFree) : Mat Float64 := {
  jp := positions.jac (embed t)
  mat Float64 jp.m t.n (fn k f { if f >= freeDim then 0.0 else jp.f k (freeCoord f) }) }

-- ---------------------------------------------------------------- parameter spaces
-- the free coordinates, and those with u = log sigma after them
FreeCoords = VecOf freeDim
FullCoords = VecOf (freeDim + 1)

-- the last entry of a vector that has one, and a vector with one entry appended (v0.1 array.lut:46-50)
last (v : { w : Vec Float64 | 1 <= w.n }) : Float64 := v.f (v.n - 1)
append (v : Vec Float64) (x : Float64) : Vec Float64 := vec Float64 (v.n + 1) (fn k { if k < v.n then v.f k else x })

-- ---------------------------------------------------------------- where the laws are tested
-- The layouts and the errors the laws of the model are certified at: free coordinates within
-- positionBox metres of the origin, as the nodes of experiment zero are, and a tape error sigma
-- between sigmaLow and sigmaHigh metres. Domains of the laws, types with their laws; a shift may
-- leave them and stays in the space. Their generators receive these constants as the types'
-- arguments, so they are written once, here.
positionBox : Float64 := 5.0
sigmaLow : Float64 := 0.01
sigmaHigh : Float64 := 0.1
-- the first d entries of v within box of zero
WithinBox (box : Float64) (v : Vec Float64) (d : Nat) : Bool := forallBelow d (fn k { if k < v.n then abs (v.f k) <= box else false })
PositionsWithin (d : Nat) (box : Float64) : U := { v : VecOf d | WithinBox box v d }
ScaledPositionsWithin (d : Nat) (box lo hi : Float64) : U :=
  { v : VecOf (d + 1) | if v.n == d + 1 then WithinBox box v d and lo <= last v and last v <= hi else false }
TestedFree = PositionsWithin freeDim positionBox
TestedFull = ScaledPositionsWithin freeDim positionBox (elementary.log sigmaLow) (elementary.log sigmaHigh)

-- How the slope of the transform is measured: by a central difference of step eps^(1/3) metres,
-- whose truncation, of order (step / sigma)^2, is below 1e-6 for the sigmas of the tape (sigmaLow
-- and up). The step is the cube root of doubles.epsilon, written as its value: the elementary
-- functions of numbers.lth have no cube root.
pitResolution : Resolution := { step := 6.055454452393343e-06, tol := 1e-6 }

posModel : MeanModel freeDim := { k := nPairs, mean := fn t { meanDist t }, jac := fn t { jacDist t } }
fullModel : ScaledModel (freeDim + 1) := {
  model := { k := nPairs, mean := fn t { meanDist t }, jac := fn t { jacDist t } },
  logSigma := fn t { last t },
  dLogSigma := fn t { vec Float64 t.n (fn f { if f == freeDim then 1.0 else 0.0 }) } }

-- ---------------------------------------------------------------- the native likelihoods
nativeFull : Likelihood (freeDim + 1) := gaussian (freeDim + 1) fullModel
nativeProfile : Likelihood freeDim := profiled freeDim posModel

-- ---------------------------------------------------------------- native and an implementation agree
-- Both sides sum K terms over D coordinates; the tolerance scales by the size of the terms (v0.1's
-- `scaledTol (nPairs * freeDim) magnitude`, with the demand's tol in place of 8 eps).
agreeTol (tol : Tolerance) (magnitude : Float64) : Float64 := tol * toFloat64 (nPairs * freeDim) * (1.0 + magnitude)

FullAgrees (l : Likelihood (freeDim + 1)) (tol : Tolerance) (t : TestedFull) (y : VecOf nPairs) : Bool := {
  e := elementary.exp (0.0 - 2.0 * last t)
  fj := frobDef (jacDist t)
  nr := norm (sub y (meanDist t))
  within (agreeTol tol (e * nr * nr + toFloat64 nPairs)) (l.loglik y t) (nativeFull.loglik y t)
  and approxVec (agreeTol tol (e * fj * nr + e * nr * nr + toFloat64 nPairs)) (l.score y t) (nativeFull.score y t)
  and approxMat (agreeTol tol (e * fj * fj + 2.0 * toFloat64 nPairs)) (l.info y t) (nativeFull.info y t) }

ProfileAgrees (l : Likelihood freeDim) (tol : Tolerance) (t : TestedFree) (y : VecOf nPairs) : Bool := {
  nr := norm (sub y (meanDist t))
  w := toFloat64 nPairs / (nr * nr)
  fj := frobDef (jacDist t)
  within (agreeTol tol (toFloat64 nPairs)) (l.loglik y t) (nativeProfile.loglik y t)
  and approxVec (agreeTol tol (w * fj * nr)) (l.score y t) (nativeProfile.score y t)
  and approxMat (agreeTol tol (w * fj * fj)) (l.info y t) (nativeProfile.info y t) }

-- The profile likelihood is the full one at the sigma that maximizes it, sigma^2 = RSS / K,
-- and there the score of the full likelihood in u vanishes.
ProfileIsFullAtItsSigma (l : Likelihood freeDim) (tol : Tolerance) (t : TestedFree) (y : VecOf nPairs) : Bool := {
  r := sub y (meanDist t)
  tf := append t (0.5 * elementary.log (dot r r / toFloat64 nPairs))
  within (agreeTol tol (toFloat64 nPairs)) (l.loglik y t) (nativeFull.loglik y tf)
  and abs (last (nativeFull.score y tf)) < agreeTol tol (toFloat64 nPairs) }
