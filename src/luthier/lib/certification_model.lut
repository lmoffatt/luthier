-- certification_model.lut: the store as a value, the reference model of `Certifying`, and the hash
-- of a cone as a route to the host.
--
-- Draft 0, 2026-10-14, by Claude Opus 5.5, an agent of the coordinating session, on the brief
-- record/IA/certification-2026-10-14/prompt-theory.md (item 4). A model file (12.S23): `certifying`
-- reads the store written in Luthier over the kernel's types, and is what certify.py, tester.py's
-- store and `run`'s refusal are certified against (6.S16, L14.3). `hashing` is the host's hash of
-- a cone (6.S8), a route the specimen gives: src/luthier/certify.py must define `cone_hash`, taking
-- a cone (the code in canonical form, the hosts by route, the interpreter's revision) and answering
-- a string; it is validated against certification.lth §4 like any extern (3.S28).
--
-- Draft 1, 2026-10-15, by Claude Opus 5.5, on record/IA/layer-3-review-2026-10-15/
-- prompt-fix-certification.md: `refuse` follows certification.lth draft 1 (C5 of the round-1
-- review: a law with a failure at the current hash is refused whatever serves, listed with that
-- failure). `grade` already is the fold the theory's step laws now fix (C1), and is unchanged.
--
-- Draft 2, 2026-10-16, by Claude Opus 5.5, on record/IA/code-follows-2026-10-16/
-- prompt-replay-fuel.md (D-2026-10-15-f, D-2026-10-15-g): a disagreement recorded at the current
-- hash leaves no grade and is refused first, naming both entries; `recording` is the theory's
-- `recordEntry`, the reference model of the store law `Recording`.
--
-- Draft 3, 2026-10-16, by Claude Opus 5.5, on record/IA/code-follows-2026-10-16/
-- prompt-pool-seeds.md (D-2026-10-16-g): `pooling` is the theory's `pooledCases`, the reference
-- model of `Pooling`, the union of a law's stretches.
--
-- Draft 4, 2026-10-17, by Claude Fable 5.1, on record/IA/regions-2026-10-17/prompt-theory.md
-- (D-2026-10-16-i, D-2026-10-16-j): `regioning` is the theory's `regionedGrade` combined by the
-- weakest (5.S8's default), the reference model of `Regioning`; `deriving` is the theory's
-- `lawRegions`, the reference model of `Deriving`.

import "certification.lth" samplingOf Pruning disputes Certifying ConeHashing Erasure eraseBinders Store Entry Identity Certificate ConeDemand ConeName Refusal
  Standing Link ParameterReach Reach Value Hash Support Interval Members Number Printed Passed Failed State Current Stale
  Uncertified Provisional Disagrees DrawnParameter stronger reachOf coversAll latestOf latestAt failureAt
  disputeAt Recording recordEntry Pooling pooledCases Regioning regionedGrade orWeakest Deriving lawRegions
  Routing Routed Theory Veto Members
import "test.lth" Grade gradeRank weakest
import "term_model.lut" alpha canonical substitute stepper

-- the store as a value: the entries, the latest in front (6.S8); it starts empty
emptyStore : Store certifying := nil

-- 7.S9, 7.S13: the identity of an outcome
entryIdentity (e : Entry) : Identity := { law := e.law, cone := e.cone, binding := e.binding, seed := e.seed, cases := e.cases,
                                     conjunct := e.conjunct, sampling := samplingOf e.budgets }

-- 12.S11: stale against the current hash of the cone
stale (h : Hash) (e : Entry) : Bool := not (e.cone == h)

-- 7.S10, 7.S15: a reach as a set of values
reachContains (r : Reach) (v : Value) : Bool := match r {
  Support -> true ;
  Interval lo hi -> (match v { Number x -> lo <= x and x <= hi ; Printed s -> false }) ;
  Members vs -> any List Value (fn (w : Value) { w == v }) vs }

-- 6.S7, 7.S10: the grade of a certificate. The entries that count are the law's at the current
-- hash; a failure among them, or a disagreement (D-2026-10-15-f), leaves no grade; under one
-- binding the strongest pass, across bindings the weakest.
counts (c : Certificate) (e : Entry) : Bool := e.law == c.law and e.cone == c.cone
hasFailure (c : Certificate) (es : List Entry) : Bool := any List Entry (fn (e : Entry) { counts c e and entryFailed e }) es
entryFailed (e : Entry) : Bool := match e.outcome { Failed x -> true ; _ -> false }
-- the passes that count, each with its grade
passes (c : Certificate) (es : List Entry) : List (List DrawnParameter * Grade) :=
  concat (List DrawnParameter * Grade) (map Entry (List (List DrawnParameter * Grade))
    (fn (e : Entry) { match e.grade { just g -> [(e.binding, g)] ; nothing -> nil } })
    (filter List Entry (fn (e : Entry) { counts c e and e.outcome == Passed }) es))
-- the strongest grade under one binding
bestUnder (b : List DrawnParameter) (ps : List (List DrawnParameter * Grade)) (g : Grade) : Grade :=
  fold (List DrawnParameter * Grade) Grade stronger g (fn (bh : List DrawnParameter * Grade) { match bh { (b2, h) -> if b2 == b then h else g } }) ps
-- the weakest of the bindings' bests
weakestOfBests (all ps : List (List DrawnParameter * Grade)) (acc : Maybe Grade) : Maybe Grade :=
  fold (List DrawnParameter * Grade) (Maybe Grade)
    (fn (x y : Maybe Grade) { match x { nothing -> y ; just a -> (match y { nothing -> x ; just b -> just (weakest a b) }) } })
    acc (fn (bg : List DrawnParameter * Grade) { match bg { (b, g) -> just (bestUnder b all g) } }) ps
certificateDisputed (c : Certificate) : Bool := match disputeAt entryIdentity c.law c.cone c.entries { just p -> true ; nothing -> false }
certificateGrade (c : Certificate) : Maybe Grade :=
  if hasFailure c c.entries or certificateDisputed c then nothing else weakestOfBests (passes c c.entries) (passes c c.entries) nothing

-- 6.S15, 7.S15: an entry serves a demand when it is the law's at the current hash, passed, at or
-- above the cutoff, and its reach covers what the run gives
atLeast (accepts : Grade) (g : Maybe Grade) : Bool := match g { just h -> gradeRank accepts <= gradeRank h ; nothing -> false }
serves (d : ConeDemand) (e : Entry) : Bool :=
  e.law == d.law and e.cone == d.cone and e.outcome == Passed and atLeast d.accepts e.grade
    and coversAll reachContains e.reach d.given

-- 6.S14, 7.S15, 12.S17, 6.S3: what a cone is refused, each with its state; a law with a
-- disagreement at the current hash is refused whatever serves, with the first the store holds
-- (D-2026-10-15-f); else a law with a failure there, with the latest such failure as its state
stateOf (d : ConeDemand) (es : List Entry) : State :=
  match latestAt d.law d.cone es { just e -> Current e.outcome ;
    nothing -> (match latestOf d.law es { just f -> Stale f.cone ; nothing -> Uncertified }) }
refuseLaw (es : List Entry) (n : String) (d : ConeDemand) : List Refusal :=
  match disputeAt entryIdentity d.law d.cone es {
    just (a, b) -> [{ name := n, law := just d.law, state := Disagrees a b }] ;
    nothing -> (match failureAt d.law d.cone es {
      just f -> [{ name := n, law := just d.law, state := Current f.outcome }] ;
      nothing -> if any List Entry (fn (e : Entry) { serves d e }) es then nil
                 else [{ name := n, law := just d.law, state := stateOf d es }] }) }
refuseLaws (es : List Entry) (n : String) (ds : List ConeDemand) : List Refusal :=
  concat Refusal (map ConeDemand (List Refusal) (refuseLaw es n) ds)
refuseName (es : List Entry) (c : ConeName) : List Refusal :=
  if c.provisional then [{ name := c.name, law := nothing, state := Provisional }] else refuseLaws es c.name c.laws
refuse (es : List Entry) (cs : List ConeName) : List Refusal :=
  concat Refusal (map ConeName (List Refusal) (refuseName es) cs)

-- 6.S11: transport along a Boolean identity: the intersection of the reaches, the weaker grade, and
-- only along a link from the law carried (C7 of the round-1 review)
keepWithin (r : Reach) (vs : List Value) : List Value := filter List Value (reachContains r) vs
meet (r s : Reach) : Reach := match r {
  Support -> s ;
  Interval lo hi -> (match s { Support -> r ; Interval lo2 hi2 -> Interval (larger lo lo2) (smaller hi hi2) ;
                                Members vs -> Members (keepWithin r vs) }) ;
  Members vs -> Members (keepWithin s vs) }
meetReaches (bs is : List ParameterReach) : List ParameterReach :=
  concat ParameterReach (map ParameterReach (List ParameterReach)
    (fn (r : ParameterReach) { match reachOf r.parameter is { just s -> [{ parameter := r.parameter, reach := meet r.reach s }] ; nothing -> nil } }) bs)
transport (b : Standing) (l : Link) : Maybe Standing :=
  if l.from == b.law then just { law := l.to, on := meetReaches b.on l.standing.on, grade := weakest b.grade l.standing.grade }
  else nothing

certifying : Certifying := {
  identity := entryIdentity, stale := stale, grade := certificateGrade, contains := reachContains, serves := serves,
  refuse := refuse, transport := transport,
}

-- D-2026-10-15-f, D-2026-10-15-g: the store law's reference, the theory's own `recordEntry`
recording : Recording certifying := { record := fn e es { recordEntry certifying e es } }

-- [core bite 13b, bite 13c's item 1] the retention law's reference: at the hash given, the four most
-- recent entries that did not fail stay, every failure stays, and the entries of a disagreement
-- stay; a store with no entry at that hash keeps its latest entry. (certify.py's `prune` is per
-- group of law and binding; this one is of one law's store, which is what the laws read.)
keepCurrent (h : Hash) (es : List Entry) : List Entry :=
  if isEmpty Entry (filter List Entry (fn (e : Entry) { e.cone == h }) es) then take Entry 1 es
  else filter List Entry (fn (e : Entry) {
    e.cone == h and (entryFailed e
      or any List Entry (fn (f : Entry) { f == e }) (take Entry 4 (filter List Entry (fn (x : Entry) { x.cone == h and not (entryFailed x) }) es))
      or any List (Entry * Entry) (fn (p : Entry * Entry) { match p { (a, b) -> a == e or b == e } }) (disputes entryIdentity nil es)) }) es
pruning : Pruning certifying := { prune := keepCurrent }

-- D-2026-10-16-g: the union of the stretches' reference, the theory's own `pooledCases`
pooling : Pooling certifying := { pooled := pooledCases }

-- D-2026-10-16-i, D-2026-10-16-j: the grade over the regions, combined by the weakest (5.S8's
-- default; a demand that chooses another combination is another model), and the law's regions
-- from its cutoffs and premises, the theory's own `regionedGrade` and `lawRegions`
regioning : Regioning certifying := { combine := orWeakest, graded := fn c rs ev { regionedGrade certifying orWeakest c rs ev } }
deriving : Deriving := { ofLaw := lawRegions }

-- [Before the tag, 2026-10-22, by Claude Sonnet 5.5, on record/plan/core-2026-10-17/prompt-refuse-theory.md]
-- The route of a demand, the reference model of `Routing` (certification.lth §6). It follows certify.py's
-- `witness`, `_each`, `_obligations`, `_conjunct_witness` and `veto`, `_about`, `_passes_theory`, in the
-- order the code reads them, and is written apart from the theory's specification (`obligations`,
-- `inSubject`, `refutedAsConsequence`), which the laws read it against. Left out, as the theory says:
-- fingerprints (`passesTheory` here compares the one the binding recorded whole, where certify.py
-- intersects the comma-separated sets of a census), the grade over regions, a control's entries, the
-- demand a refusal names and the words of the exception.
-- Written as one record with its helpers local, so that it adds no loose function (4.S17); the control
-- file's wrong models read the same pieces through `routing.witness` and `routing.veto`.
-- `witness`: `_each` serves each conjunct with the first of its entries that the demand serves;
-- `_obligations`/`_conjunct_witness` take the theory's conjuncts headed by one of the law's names.
-- `veto`: the routes are the law's own entries that may be about the model (`_about`) and the
-- theory's conjunct entries about it; a disagreement, else a failure, over every route, else the
-- exception (the first failure of the law on a model of the theory, `_passes_theory`).
routing : Routing certifying := {
  headOf := extern "python:luthier.certify._text_head",
  witness := fn (d : Routed) (es : List Entry) {
    head := extern "python:luthier.certify._text_head"
    keepFirst := fn (xs : List String) { fold String (List String) (fn (a b : List String) { a <> filter List String (fn (y : String) { not (member List String y a) }) b }) nil (fn (c : String) { [c] }) xs }
    listing := fn (l : String) (h : Hash) { keepFirst (concat String (map Entry (List String) (fn (e : Entry) { e.conjuncts })
      (filter List Entry (fn (e : Entry) { e.law == l and e.cone == h }) es))) }
    each := fn (dm : ConeDemand) (cs : List String) { (fold String (Maybe (List Entry))
      (fn (x y : Maybe (List Entry)) { match x { nothing -> nothing ; just u -> (match y { nothing -> nothing ; just v -> just (u <> v) }) } }) (just nil)
      (fn (c : String) { match nth Entry (filter List Entry (fn (e : Entry) { e.conjunct == just c and serves dm e }) es) 0 { nothing -> nothing ; just e -> just [e] } }) cs) }
    viaTheory := match d.theory { nothing -> nothing ; just t ->
      (match filter List String (fn (c : String) { any List String (fn (h : String) { h == head c }) t.heads }) (listing t.demand.law t.demand.cone) {
        nil -> nothing ; cons c cs -> each t.demand (cons c cs) }) }
    if d.byModel then viaTheory
    else (match listing d.demand.law d.demand.cone { cons c cs -> each d.demand (cons c cs) ; nil ->
      (match nth Entry (filter List Entry (serves d.demand) es) 0 { just e -> just [e] ; nothing -> viaTheory }) }) },
  veto := fn (d : Routed) (es : List Entry) {
    head := extern "python:luthier.certify._text_head"
    keepFirst := fn (xs : List String) { fold String (List String) (fn (a b : List String) { a <> filter List String (fn (y : String) { not (member List String y a) }) b }) nil (fn (c : String) { [c] }) xs }
    listing := fn (l : String) (h : Hash) (xs : List Entry) { keepFirst (concat String (map Entry (List String) (fn (e : Entry) { e.conjuncts })
      (filter List Entry (fn (e : Entry) { e.law == l and e.cone == h }) xs))) }
    given := fn (p : String) { nth Value (map (String * Value) Value (fn (pv : String * Value) { match pv { (q, v) -> v } })
      (filter List (String * Value) (fn (pv : String * Value) { match pv { (q, v) -> q == p } }) d.demand.given)) 0 }
    about := fn (e : Entry) { all List String (fn (p : String) { match reachOf p e.reach { nothing -> true ; just r ->
      (match given p { nothing -> true ; just v -> reachContains r v }) } }) d.models }
    mine := match d.theory { nothing -> nil ; just t -> filter List String (fn (c : String) { any List String (fn (h : String) { h == head c }) t.heads }) (listing t.demand.law t.demand.cone es) }
    ownRoute := (if d.byModel then nil
      else [(d.demand.law, fn (e : Entry) { e.cone == d.demand.cone and about e })])
    theoryRoute := match d.theory { nothing -> nil ; just t ->
      [(t.demand.law, fn (e : Entry) { e.cone == t.demand.cone and coversAll reachContains e.reach t.demand.given
        and (match e.conjunct { just c -> member List String c mine ; nothing -> false }) })] }
    routes := ownRoute <> theoryRoute
    inRoute := fn (r : String * (Entry -> Bool)) { match r { (l, here) -> filter List Entry (fn (e : Entry) { e.law == l and here e }) es } }
    dispute := nth (Entry * Entry) (concat (Entry * Entry) (map (String * (Entry -> Bool)) (List (Entry * Entry))
      (fn (r : String * (Entry -> Bool)) { disputes entryIdentity nil (inRoute r) }) routes)) 0
    failure := nth Entry (concat Entry (map (String * (Entry -> Bool)) (List Entry)
      (fn (r : String * (Entry -> Bool)) { filter List Entry entryFailed (inRoute r) }) routes)) 0
    fingerprintOf := fn (p : String) (b : List DrawnParameter) { match nth String (map DrawnParameter String (fn (x : DrawnParameter) { x.fingerprint })
      (filter List DrawnParameter (fn (x : DrawnParameter) { x.parameter == p }) b)) 0 { just f -> f ; nothing -> "" } }
    isModel := fn (t : Theory) (q : String) (model : Value) (prints : String) {
      ofModel := filter List Entry (fn (e : Entry) { e.law == t.demand.law and e.cone == t.demand.cone and coversAll reachContains e.reach [(q, model)]
        and fingerprintOf q e.binding == prints }) es
      probe := { law := t.demand.law, cone := t.demand.cone, given := [(q, model)], accepts := t.demand.accepts }
      conjuncts := keepFirst (concat String (map Entry (List String) (fn (e : Entry) { e.conjuncts }) ofModel))
      not (isEmpty String conjuncts) and not (any List Entry entryFailed ofModel) and isEmpty (Entry * Entry) (disputes entryIdentity nil ofModel)
        and all List String (fn (c : String) { any List Entry (fn (e : Entry) { e.conjunct == just c and serves probe e }) ofModel }) conjuncts }
    consequence := (if d.byModel then nothing
      else (match d.theory { nothing -> nothing ; just t ->
        (match t.demand.given { nil -> nothing ; cons qv rest -> (match qv { (q, w) ->
          nth Entry (filter List Entry (fn (f : Entry) { f.law == d.demand.law and f.cone == d.demand.cone and entryFailed f
            and any List String (fn (p : String) { match reachOf p f.reach { nothing -> false ; just r -> (match r {
              Members vs -> any List Value (fn (model : Value) { isModel t q model (fingerprintOf p f.binding) }) vs ; Support -> false ; Interval lo hi -> false }) } }) d.models }) es) 0 }) }) }))
    match dispute { just p -> (match p { (a, b) -> just { state := Disagrees a b, exception := false } }) ; nothing ->
      (match failure { just f -> just { state := Current f.outcome, exception := false } ; nothing ->
        (match consequence { just f -> just { state := Current f.outcome, exception := true } ; nothing -> nothing }) }) } } }

-- 6.S8: the hash of a cone, the host's
hashing : ConeHashing alpha canonical := {
  hash := extern "python:luthier.certify.cone_hash",
}

-- D-2026-10-15-e: the hash's erasure of the binders' annotations, the theory's own `eraseBinders`
-- over term_model.lut's reduction (the host's, certify.py's `erase`, is checked against kernel.py
-- in tests/test_certify.py)
erasure : Erasure alpha substitute stepper := { erase := eraseBinders }
