-- certification_model.lut: the store as a value, the reference model of `Certifying`, and the hash
-- of a cone as a route to the host.
--
-- Draft 0, 2026-10-14, by Claude Opus 5.5, an agent of the coordinating session, on the brief
-- record/IA/certification-2026-10-14/prompt-theory.md (item 4). A model file (12.S23): `certifying`
-- reads the store written in Luthier over the kernel's types, and is what certify.py, tester.py's
-- store and `run`'s refusal are certified against (6.S16, L14.3). `hashing` is the host's hash of
-- a cone (6.S8), a route the specimen gives: src/luthier/certify.py must define `cone_hash`, taking
-- a cone (the code in canonical form, the hosts by route, the interpreter's revision) and answering
-- a string; it is validated against certification.lth §4 like any extern (3.S28).
--
-- Draft 1, 2026-10-15, by Claude Opus 5.5, on record/IA/layer-3-review-2026-10-15/
-- prompt-fix-certification.md: `refuse` follows certification.lth draft 1 (C5 of the round-1
-- review: a law with a failure at the current hash is refused whatever serves, listed with that
-- failure). `grade` already is the fold the theory's step laws now fix (C1), and is unchanged.
--
-- Draft 2, 2026-10-16, by Claude Opus 5.5, on record/IA/code-follows-2026-10-16/
-- prompt-replay-fuel.md (D-2026-10-15-f, D-2026-10-15-g): a disagreement recorded at the current
-- hash leaves no grade and is refused first, naming both entries; `recording` is the theory's
-- `recordEntry`, the reference model of the store law `Recording`.
--
-- Draft 3, 2026-10-16, by Claude Opus 5.5, on record/IA/code-follows-2026-10-16/
-- prompt-pool-seeds.md (D-2026-10-16-g): `pooling` is the theory's `pooledCases`, the reference
-- model of `Pooling`, the union of a law's stretches.
--
-- Draft 4, 2026-10-17, by Claude Fable 5.1, on record/IA/regions-2026-10-17/prompt-theory.md
-- (D-2026-10-16-i, D-2026-10-16-j): `regioning` is the theory's `regionedGrade` combined by the
-- weakest (5.S8's default), the reference model of `Regioning`; `deriving` is the theory's
-- `lawRegions`, the reference model of `Deriving`.

import "certification.lth" Certifying ConeHashing Erasure eraseBinders Store Entry Identity Certificate Demand ConeName Refusal
  Standing Link ParameterReach Reach Value Hash Support Interval Members Number Printed Passed Failed State Current Stale
  Uncertified Provisional Disagrees Drawing stronger reachOf coversAll latestOf latestAt failureAt
  disputeAt Recording recordEntry Pooling pooledCases Regioning regionedGrade orWeakest Deriving lawRegions
import "test.lth" Grade gradeRank weakest
import "term_model.lut" alpha canonical substitute stepper

-- the store as a value: the entries, the latest in front (6.S8); it starts empty
emptyStore : Store certifying := nil

-- 7.S9, 7.S13: the identity of an outcome
identity (e : Entry) : Identity := { law := e.law, cone := e.cone, binding := e.binding, seed := e.seed, cases := e.cases,
                                     conjunct := e.conjunct }

-- 12.S11: stale against the current hash of the cone
stale (h : Hash) (e : Entry) : Bool := not (e.cone == h)

-- 7.S10, 7.S15: a reach as a set of values
contains (r : Reach) (v : Value) : Bool := match r {
  Support -> true ;
  Interval lo hi -> (match v { Number x -> lo <= x and x <= hi ; Printed s -> false }) ;
  Members vs -> any List Value (fn (w : Value) { w == v }) vs }

-- 6.S7, 7.S10: the grade of a certificate. The entries that count are the law's at the current
-- hash; a failure among them, or a disagreement (D-2026-10-15-f), leaves no grade; under one
-- binding the strongest pass, across bindings the weakest.
counts (c : Certificate) (e : Entry) : Bool := e.law == c.law and e.cone == c.cone
anyFailure (c : Certificate) (es : List Entry) : Bool := any List Entry (fn (e : Entry) { counts c e and isFailure e }) es
isFailure (e : Entry) : Bool := match e.outcome { Failed x -> true ; _ -> false }
-- the passes that count, each with its grade
passes (c : Certificate) (es : List Entry) : List (List Drawing * Grade) :=
  match es { nil -> nil ; cons e rest ->
    if counts c e and e.outcome == Passed
    then (match e.grade { just g -> cons (e.binding, g) (passes c rest) ; nothing -> passes c rest })
    else passes c rest }
-- the strongest grade under one binding
bestUnder (b : List Drawing) (ps : List (List Drawing * Grade)) (g : Grade) : Grade :=
  match ps { nil -> g ; cons (b2, h) rest -> bestUnder b rest (if b2 == b then stronger g h else g) }
-- the weakest of the bindings' bests
weakestOfBests (all ps : List (List Drawing * Grade)) (acc : Maybe Grade) : Maybe Grade :=
  match ps { nil -> acc ; cons (b, g) rest ->
    weakestOfBests all rest (just (match acc { nothing -> bestUnder b all g ; just h -> weakest h (bestUnder b all g) })) }
disputed (c : Certificate) : Bool := match disputeAt identity c.law c.cone c.entries { just p -> true ; nothing -> false }
grade (c : Certificate) : Maybe Grade :=
  if anyFailure c c.entries or disputed c then nothing else weakestOfBests (passes c c.entries) (passes c c.entries) nothing

-- 6.S15, 7.S15: an entry serves a demand when it is the law's at the current hash, passed, at or
-- above the cutoff, and its reach covers what the run gives
atLeast (accepts : Grade) (g : Maybe Grade) : Bool := match g { just h -> gradeRank accepts <= gradeRank h ; nothing -> false }
serves (d : Demand) (e : Entry) : Bool :=
  e.law == d.law and e.cone == d.cone and e.outcome == Passed and atLeast d.accepts e.grade
    and coversAll contains e.reach d.given

-- 6.S14, 7.S15, 12.S17, 6.S3: what a cone is refused, each with its state; a law with a
-- disagreement at the current hash is refused whatever serves, with the first the store holds
-- (D-2026-10-15-f); else a law with a failure there, with the latest such failure as its state
stateOf (d : Demand) (es : List Entry) : State :=
  match latestAt d.law d.cone es { just e -> Current e.outcome ;
    nothing -> (match latestOf d.law es { just f -> Stale f.cone ; nothing -> Uncertified }) }
refuseLaw (es : List Entry) (n : String) (d : Demand) : List Refusal :=
  match disputeAt identity d.law d.cone es {
    just (a, b) -> [{ name := n, law := just d.law, state := Disagrees a b }] ;
    nothing -> (match failureAt d.law d.cone es {
      just f -> [{ name := n, law := just d.law, state := Current f.outcome }] ;
      nothing -> if any List Entry (fn (e : Entry) { serves d e }) es then nil
                 else [{ name := n, law := just d.law, state := stateOf d es }] }) }
refuseLaws (es : List Entry) (n : String) (ds : List Demand) : List Refusal :=
  concat Refusal (map Demand (List Refusal) (refuseLaw es n) ds)
refuseName (es : List Entry) (c : ConeName) : List Refusal :=
  if c.provisional then [{ name := c.name, law := nothing, state := Provisional }] else refuseLaws es c.name c.laws
refuse (es : List Entry) (cs : List ConeName) : List Refusal :=
  concat Refusal (map ConeName (List Refusal) (refuseName es) cs)

-- 6.S11: transport along a Boolean identity: the intersection of the reaches, the weaker grade, and
-- only along a link from the law carried (C7 of the round-1 review)
larger (x y : Float64) : Float64 := if x <= y then y else x
smaller (x y : Float64) : Float64 := if x <= y then x else y
keepWithin (r : Reach) (vs : List Value) : List Value := filter List Value (contains r) vs
meet (r s : Reach) : Reach := match r {
  Support -> s ;
  Interval lo hi -> (match s { Support -> r ; Interval lo2 hi2 -> Interval (larger lo lo2) (smaller hi hi2) ;
                                Members vs -> Members (keepWithin r vs) }) ;
  Members vs -> Members (keepWithin s vs) }
meetReaches (bs is : List ParameterReach) : List ParameterReach :=
  match bs { nil -> nil ; cons r rest ->
    (match reachOf r.parameter is { just s -> cons { parameter := r.parameter, reach := meet r.reach s } (meetReaches rest is) ;
                                    nothing -> meetReaches rest is }) }
transport (b : Standing) (l : Link) : Maybe Standing :=
  if l.from == b.law then just { law := l.to, on := meetReaches b.on l.standing.on, grade := weakest b.grade l.standing.grade }
  else nothing

certifying : Certifying := {
  identity := identity, stale := stale, grade := grade, contains := contains, serves := serves,
  refuse := refuse, transport := transport,
}

-- D-2026-10-15-f, D-2026-10-15-g: the store law's reference, the theory's own `recordEntry`
recording : Recording certifying := { record := fn e es { recordEntry certifying e es } }

-- D-2026-10-16-g: the union of the stretches' reference, the theory's own `pooledCases`
pooling : Pooling certifying := { pooled := pooledCases }

-- D-2026-10-16-i, D-2026-10-16-j: the grade over the regions, combined by the weakest (5.S8's
-- default; a demand that chooses another combination is another model), and the law's regions
-- from its cutoffs and premises, the theory's own `regionedGrade` and `lawRegions`
regioning : Regioning certifying := { combine := orWeakest, graded := fn c rs ev { regionedGrade certifying orWeakest c rs ev } }
deriving : Deriving := { ofLaw := lawRegions }

-- 6.S8: the hash of a cone, the host's
hashing : ConeHashing alpha canonical := {
  hash := extern "python:luthier.certify.cone_hash",
}

-- D-2026-10-15-e: the hash's erasure of the binders' annotations, the theory's own `eraseBinders`
-- over term_model.lut's reduction (the host's, certify.py's `erase`, is checked against kernel.py
-- in tests/test_certify.py)
erasure : Erasure alpha substitute stepper := { erase := eraseBinders }
