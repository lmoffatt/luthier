-- plan_model.lut: the default plan, call by need as run.py does, and forward on demand, over a
-- small dataflow; the reference model of `Planning`.
--
-- Draft 0, 2026-10-15, by Claude Fable 5.1, an agent of the coordinating session, on the brief
-- record/IA/demand-2026-10-15/prompt.md. A model file (12.S23): `planning` schedules the live
-- cone by the strategy asked; `byNeed` is the order run.py reduces in (8.S4: each name at its
-- first demand, kept), `forward` the strict topological order of 8.S3; `example` is a dataflow of
-- five names of which the entry reaches four, and the two plans of it agree (`Confluent`). The
-- memo of 8.S8 has no model here: its one model is run.py's (`result_key`, `key_hash`, the store
-- `x.results.json`, 2026-10-16), and a model in Luthier of plan.lth's `Keying` waits for the host's
-- hash of a key, as certification_model.lut's `hashing` is for a cone.
-- 2026-10-15, by Claude Opus 5.5, an agent of the coordinating session, on record/IA/
-- layer-3-review-2026-10-15/prompt-fix-BCD.md (item 2 of its summary-BCD.md): `example` a model of
-- the theory `Dataflow` (plan.lth §1); call by need is plan.lth's `firstDemand`, the order its law
-- `ByNeedIsFirstDemand` names; forward on demand places in strict rounds (a round places what
-- the names placed before it allow), so its schedule goes by levels (`ForwardIsByLevels`); the
-- duplicates of plan.lth's `readsOf` and `keep` are gone; and the schedule that computes `d`
-- before what it reads is refused.

import "plan.lth" Planning Plan Dataflow Node Schedule Strategy ForwardOnDemand CallByNeed reaches
  subset keep readsOf firstDemand LinearizesOn EquivalentOn Confluent NamesAreUnique Acyclic

-- call by need: the order of first demand (plan.lth `firstDemand`, a depth-first visit from the
-- entry in the order the reads are listed, each name after what it reads and once)
byNeed (A : U) (eq : A -> A -> Bool) (d : Dataflow A eq) (entry : String) : Schedule := firstDemand A eq d entry

-- forward on demand: the live names placed in strict rounds, each round placing, in the order of
-- the live set, every name not yet placed whose reads among the live names were placed by the
-- rounds before it; a name no round can place (a cycle, which a `Dataflow` does not have) is left
-- out
placeable (ns : List Node) (live before : List String) (n : String) : Bool :=
  not (member List String n before) and subset (keep live (readsOf ns n)) before
round (ns : List Node) (live before placed candidates : List String) : List String :=
  placed <> filter List String (fn n { placeable ns live before n }) candidates
rounds (ns : List Node) (live placed : List String) (k : Nat) : List String :=
  if k == 0 then placed else rounds ns live (round ns live placed placed live) (k - 1)
forward (A : U) (eq : A -> A -> Bool) (d : Dataflow A eq) (live : List String) : Schedule := rounds d.nodes live nil (1 + size d.nodes)

plan (A : U) (eq : A -> A -> Bool) (st : Strategy) (d : Dataflow A eq) (entry : String) : Plan A :=
  { strategy := st, entry := entry, live := reaches A eq d entry,
    schedule := (match st { CallByNeed -> byNeed A eq d entry ; ForwardOnDemand -> forward A eq d (reaches A eq d entry) }) }

eqNat (x y : Nat) : Bool := x == y
planning : Planning Nat eqNat := { plan := plan Nat eqNat }

-- the example: a = 1, b = a + 1, c = a * 2, d = b + c, e = d + 100; the entry `d` reaches four
-- names and `e` is not produced (L5.13)
example : Dataflow Nat eqNat := {
  nodes := [{ name := "a", reads := nil }, { name := "b", reads := ["a"] }, { name := "c", reads := ["a"] },
            { name := "d", reads := ["b", "c"] }, { name := "e", reads := ["d"] }],
  init := 0,
  step := fn n env { if n == "a" then 1 else if n == "b" then env "a" + 1 else if n == "c" then env "a" * 2
                     else if n == "d" then env "b" + env "c" else if n == "e" then env "d" + 100 else 0 },
}
-- its names are unique and it has no cycle (its step reads what its nodes list, `StepIsLocal`, a
-- law over drawn environments, for the tester)
exampleIsADag : Bool := NamesAreUnique Nat eqNat example and Acyclic Nat eqNat example
-- call by need gives a, b, c, d; forward on demand gives a, b, c, d too on this example: the live
-- set is listed from the entry (d, b, c, a), the first round places a, the second b and c, the
-- third d
needPlan : Plan Nat := plan Nat eqNat CallByNeed example "d"
forwardPlan : Plan Nat := plan Nat eqNat ForwardOnDemand example "d"
bothLinearize : Bool := LinearizesOn Nat eqNat example needPlan.live needPlan.schedule
  and LinearizesOn Nat eqNat example forwardPlan.live forwardPlan.schedule
-- and a third linearization by hand, c before b, gives the same values (8.S5)
schedulesAgree : Bool := Confluent Nat eqNat example needPlan.live needPlan.schedule ["a", "c", "b", "d"]
  and EquivalentOn Nat eqNat example needPlan.live needPlan.schedule forwardPlan.schedule
-- the schedule that computes d before what it reads is not a linearization (it gave d = 0)
readersFirstRefused : Bool := not (LinearizesOn Nat eqNat example needPlan.live ["d", "b", "c", "a"])
-- [core bite 13b] the four facts about the example, gathered so that this file claims them (4.S14)
ExampleFacts := exampleIsADag & bothLinearize & schedulesAgree & readersFirstRefused
