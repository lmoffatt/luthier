import "checks.lth" Failures

-- ---------------------------------------------------------------- §1 The verdict

-- A cost `C` (5.S2, 6.S5) with what a verdict needs of it: `zero`, holding exactly; `top`, failing;
-- and its order. The algebra of costs, with its six laws, is certification.lth's (step 5); here
-- only the two laws the retraction needs (5.S5): `zero <= zero`, and `top <= zero` false, so a
-- library cannot take `zero = top`.
CostScale (C : U) : { zero : C, top : C, leq : C -> C -> Bool }
ZeroIsExact (C : U) (s : CostScale C) : Bool := s.leq s.zero s.zero
TopIsNotExact (C : U) (s : CostScale C) : Bool := not (s.leq s.top s.zero)
CostScale (C : U) := ZeroIsExact C & TopIsNotExact C & VerdictsAreExact C

-- `lift` reads a Boolean law as a cost, `exact` reads a cost back as whether it holds exactly
-- (5.S5); `exact (lift b) == b` follows from the two laws above
lift (C : U) (s : CostScale C) (b : Bool) : C := if b then s.zero else s.top
holdsExactly (C : U) (s : CostScale C) (c : C) : Bool := s.leq c s.zero

-- What the core asks of a law's value (5.S3): a verdict in `C`. For `Bool` it is `lift`; for `C`
-- the identity; for a check, `lift` of whether it holds (5.S9). These are definitions, not a
-- theory with one model whose laws would restate them (D-2026-10-13-aa, Q5; 4.R10). A law into a
-- type with none of these verdicts is not a law: that is the checker's (4.R6, program.lth).
verdictOfBool (C : U) (s : CostScale C) (b : Bool) : C := lift C s b
verdictOfCost (C : U) (s : CostScale C) (c : C) : C := c
verdictOfCheck (C : U) (s : CostScale C) (E : U) (fs : Failures E) : C := lift C s (isEmpty E fs)

-- What characterizes a verdict is its retraction: reading it back as whether it holds exactly
-- gives what the law said (5.S5). Claimed by `CostScale`, whose two laws make it hold.
VerdictsAreExact (C : U) (s : CostScale C) (b : Bool) (E : U) (fs : Failures E) : Bool :=
  holdsExactly C s (verdictOfBool C s b) == b and holdsExactly C s (verdictOfCheck C s E fs) == isEmpty E fs

-- ---------------------------------------------------------------- §3 A law as a theory

-- The forms of a law (D-2026-10-13-l): a case, a `forall` (Π) and an `exists` (Σ) over a type, and
-- the connectives; `then` is material, `not (p and not q)`, so `Not` is a form and `Then` is
-- stated by it (conditioning is an operation on a measure, not a connective). This is the type
-- `Law` of what a test runs (5.S1, 3.S12); it is Boolean until the cost library (D-2026-10-13-aa,
-- Q6), when a case valued in `C` joins it. In `U` with constructors over `U`: version 0 keeps
-- `U : U` (3.S8). `Statistical` is the form of a statistical law (7.S17, §4): a theory of its
-- statistic and its alternative, the stream its samples are drawn from, and the cutoffs of the
-- sequential test that values it.
Law : U := data {
  Case : Bool -> Law ;
  Forall : (A : U) -> (A -> Law) -> Law ;
  Exists : (A : U) -> (A -> Law) -> Law ;
  Conjunction : Law -> Law -> Law ;
  Either : Law -> Law -> Law ;
  Not : Law -> Law ;
  Then : Law -> Law -> Law ;
  Statistical : (S T : U) -> StatisticalLaw S -> (Nat -> T -> S * T) -> Sequential -> Law ;
}

-- How much of a type the cases of a `forall` cover: all of it; all of it up to a size, the box
-- the domain names (7.S10: bounded is exhaustive on that box, and on the whole type a support);
-- a census chosen by hand; or a draw from a seed (7.R1, 7.S8). Roles: `ForallOnPoints` and
-- `ExistsOnPoints` (only the exhaustive coverage confirms a `forall` or refutes an `exists`), and
-- `CoveragesAreOrdered`, the order of the four by strength, from which the weakest of several is
-- read (7.S10; D-2026-10-14-b: a data's constructors have their roles in the file that defines
-- it, so the order moved here from test.lth, which reads it). The grade each coverage gives is
-- test.lth's (`GradesAsTerms`).
Coverage : U := data {
  Exhaustive : Coverage ;
  Bounded : Nat -> Coverage ;
  Listed : Coverage ;
  Drawn : Nat -> Coverage ;
}

-- The coverages in order of strength (7.S10: an entry's grade is summarized by the weakest of the
-- reaches of its parameters): exhaustive above bounded above listed above drawn. `rankOf` is the
-- reference order and `weaker` the weakest of two, which test.lth reads to give a run the weakest
-- of its mode's and its bindings'. A model of `Covering` ranks coverages; the law is the chain of
-- the four, stated by the constructors, whatever a bound's size or a draw's seed.
rankOf (c : Coverage) : Nat := match c { Exhaustive -> 3 ; Bounded n -> 2 ; Listed -> 1 ; Drawn s -> 0 }
weaker (c d : Coverage) : Coverage := if rankOf c <= rankOf d then c else d
Covering : { rank : Coverage -> Nat }
CoveragesAreOrdered (k : Covering) (n s : Nat) : Bool :=
  k.rank (Drawn s) < k.rank Listed and k.rank Listed < k.rank (Bounded n) and k.rank (Bounded n) < k.rank Exhaustive
Covering := CoveragesAreOrdered

-- Evidence follows the form of the law (D-2026-10-13-l): a case evaluated, with the value the
-- evaluation gave; a value of the quantified type with the evidence for the law at it (a witness
-- of an `exists`, a counterexample to a `forall`); points of the type with their evidence and how
-- much they cover; a pair for `and`; one side for `or`; a citation or an assumption, which models
-- any law whole; a run that gave no case, with its reason (a budget spent, a generator that could
-- not draw; 7.S12), which settles nothing; and, for a statistical law, the verdict of its
-- sequential test with the rates it carries (§4, 7.S17).
Evidence : U := data {
  Evaluated : Bool -> Evidence ;
  At : (A : U) -> A -> Evidence -> Evidence ;
  Points : (A : U) -> List (A * Evidence) -> Coverage -> Evidence ;
  EvidencePair : Evidence -> Evidence -> Evidence ;
  Side : Bool -> Evidence -> Evidence ;
  Cited : String -> Evidence ;
  Assumed : Evidence ;
  NotRun : String -> Evidence ;
  Tested : StatisticalVerdict -> Evidence ;
}

-- What evidence settles: confirmed, refuted, supported (by a census or a sample, never confirmed),
-- unsettled, or taken on a citation or on an assumption. Roles: the laws of `Settling`.
Verdict : U := data {
  Confirmed : Verdict ;
  Refuted : Verdict ;
  Supported : Verdict ;
  Unsettled : Verdict ;
  Cites : String -> Verdict ;
  Assumes : Verdict ;
}

-- A model says what evidence settles, and how the verdicts of the parts of a conjunction combine:
-- that combination is the demand's (5.S8: the vector of grades or the weakest), so it is the
-- model's, held to the laws every combination keeps. The certifier of spec 6 and 7 is a model.
Settling : {
  settles : Law -> Evidence -> Verdict,
  combine : Verdict -> Verdict -> Verdict,
}

isRefuted (v : Verdict) : Bool := match v { Refuted -> true ; _ -> false }
isConfirmed (v : Verdict) : Bool := match v { Confirmed -> true ; _ -> false }
-- the verdicts of the law at each point
pointVerdicts (m : Settling) (A : U) (p : A -> Law) (pts : List (A * Evidence)) : List Verdict :=
  map (A * Evidence) Verdict (fn (pt : A * Evidence) { match pt { (a, e) -> m.settles (p a) e } }) pts
-- an `exists` on points: confirmed by any witness; refuted only when the points are all of the type
-- and each refutes
existsVerdict (vs : List Verdict) (c : Coverage) : Verdict :=
  if any List Verdict isConfirmed vs then Confirmed
  else match c { Exhaustive -> (if all List Verdict isRefuted vs then Refuted else Unsettled) ; _ -> Unsettled }
reversedVerdict (v : Verdict) : Verdict := match v { Confirmed -> Refuted ; Refuted -> Confirmed ; _ -> Unsettled }

-- a case is settled by evaluating it, and evidence that does not agree with the case settles
-- nothing (it cannot lie; review of layers 0-1, C)
CaseIsEvaluated (m : Settling) (c b : Bool) : Bool :=
  m.settles (Case c) (Evaluated b) == (if not (b == c) then Unsettled else if c then Confirmed else Refuted)
-- a `forall` is refuted exactly by a counterexample: evidence at one point refutes it when it
-- refutes the law there, and otherwise settles nothing
ForallAtOnePoint (m : Settling) (A : U) (p : A -> Law) (a : A) (e : Evidence) : Bool :=
  m.settles (Forall A p) (At A a e) == (if isRefuted (m.settles (p a) e) then Refuted else Unsettled)
-- a `forall` on points: refuted by any counterexample; confirmed only when the points are all of
-- the type and each confirms; supported when every point confirms or is supported and the points
-- are a census or a sample, or are all of the type with some point only supported. Written out in
-- the law, not through a helper, since it is the role of `Supported` (4.R3, L2.7: a law depends on
-- the names in its body, 4.S15). [proposed, L2 of summary-BCD.md, Fable's reply to bundle C] A law
-- with two parameters is `Forall A (fn a { Forall B ... })`, its evidence points of `A` each with
-- points of `B`: when the inner points are a sample each inner verdict is `Supported`, and
-- requiring every point confirmed left the outer `Unsettled`, so no sampled law of more than one
-- parameter was settled, where 7.S10 grades it by the weakest reach.
isSupported (v : Verdict) : Bool := match v { Supported -> true ; _ -> false }
isConfirmedOrSupported (v : Verdict) : Bool := isConfirmed v or isSupported v
ForallOnPoints (m : Settling) (A : U) (p : A -> Law) (pts : List (A * Evidence)) (c : Coverage) : Bool :=
  m.settles (Forall A p) (Points A pts c)
    == (if any List Verdict isRefuted (pointVerdicts m A p pts) then Refuted
        else if all List Verdict isConfirmed (pointVerdicts m A p pts) then (match c { Exhaustive -> Confirmed ; _ -> Supported })
        else if all List Verdict isConfirmedOrSupported (pointVerdicts m A p pts) then Supported
        else Unsettled)
-- an `exists` is confirmed by a witness, and a failing instance does not refute it
ExistsAtOnePoint (m : Settling) (A : U) (p : A -> Law) (a : A) (e : Evidence) : Bool :=
  m.settles (Exists A p) (At A a e) == (if isConfirmed (m.settles (p a) e) then Confirmed else Unsettled)
ExistsOnPoints (m : Settling) (A : U) (p : A -> Law) (pts : List (A * Evidence)) (c : Coverage) : Bool :=
  m.settles (Exists A p) (Points A pts c) == existsVerdict (pointVerdicts m A p pts) c
-- `and` by a pair, its verdicts combined; `or` by either side, which confirms when its side does
-- and supports when its side is supported (the same review item: a sampled side was dropped), or
-- by a pair of refutations
ConjunctionByPair (m : Settling) (p q : Law) (e f : Evidence) : Bool :=
  m.settles (Conjunction p q) (EvidencePair e f) == m.combine (m.settles p e) (m.settles q f)
EitherBySide (m : Settling) (p q : Law) (side : Bool) (e : Evidence) : Bool :=
  m.settles (Either p q) (Side side e)
    == (if isConfirmed (m.settles (if side then p else q) e) then Confirmed
        else if isSupported (m.settles (if side then p else q) e) then Supported else Unsettled)
EitherRefutedByBoth (m : Settling) (p q : Law) (e f : Evidence) : Bool :=
  m.settles (Either p q) (EvidencePair e f)
    == (if isRefuted (m.settles p e) and isRefuted (m.settles q f) then Refuted else Unsettled)
-- `not` exchanges confirmation and refutation; what is only supported or unsettled stays unsettled.
-- [proposed, L1 of summary-BCD.md, Fable's one-line fix] Not on a citation or an assumption, which
-- model any law whole (`CitedWhole`, `AssumedWhole`): at `p := Not q` the two laws gave `Cites r`
-- and `reversedVerdict (Cites r) == Unsettled` for one value, so `Settling` had no model.
takenWhole (e : Evidence) : Bool := match e { Cited r -> true ; Assumed -> true ; _ -> false }
NotFlips (m : Settling) (p : Law) (e : Evidence) : Bool := takenWhole e or m.settles (Not p) e == reversedVerdict (m.settles p e)
-- `then` is material: settled as `not (p and not q)`, by the same evidence
ThenIsMaterial (m : Settling) (p q : Law) (e : Evidence) : Bool :=
  m.settles (Then p q) e == m.settles (Not (Conjunction p (Not q))) e
-- a citation or an assumption models any law whole, and says on what it is taken
CitedWhole (m : Settling) (p : Law) (r : String) : Bool := m.settles p (Cited r) == Cites r
AssumedWhole (m : Settling) (p : Law) : Bool := m.settles p Assumed == Assumes
-- a run that did not run settles nothing
NotRunIsUnsettled (m : Settling) (p : Law) (r : String) : Bool := m.settles p (NotRun r) == Unsettled
-- a statistical law is settled by the verdict of its sequential test (§4): holding supports it (a
-- sample never confirms, 7.S10), failing refutes it, and an unresolved test settles nothing
StatisticalByTest (m : Settling) (S T : U) (l : StatisticalLaw S) (draw : Nat -> T -> S * T) (c : Sequential) (v : StatisticalVerdict) : Bool :=
  m.settles (Statistical S T l draw c) (Tested v)
    == (match v { Holds r -> Supported ; Fails r -> Refuted ; Unresolved r -> Unsettled })
-- the combination of a conjunction's verdicts: commutative and associative, a refutation absorbs
-- everything, an unsettled part absorbs all but a refutation, and confirmation is neutral; beyond
-- that it is the demand's (5.S8)
CombineAbsorbs (m : Settling) (v : Verdict) : Bool :=
  m.combine Refuted v == Refuted and (isRefuted v or m.combine Unsettled v == Unsettled) and m.combine Confirmed v == v
-- [proposed, L4 of summary-BCD.md] and a conjunction is confirmed only when both parts are: two
-- citations, two assumptions, or a supported part never combine into a confirmation (L10.9: no
-- grade raised without evidence); left free, a model could turn `Cites r` and `Cites s` into
-- `Confirmed`
CombineNeverConfirmsMore (m : Settling) (u v : Verdict) : Bool :=
  isConfirmed (m.combine u v) == (isConfirmed u and isConfirmed v)

Settling (m : Settling) := CaseIsEvaluated m & ForallAtOnePoint m & ForallOnPoints m & ExistsAtOnePoint m & ExistsOnPoints m
  & ConjunctionByPair m & EitherBySide m & EitherRefutedByBoth m & NotFlips m & ThenIsMaterial m & CitedWhole m
  & AssumedWhole m & NotRunIsUnsettled m & StatisticalByTest m & Commutative Verdict Verdict (structural Verdict) m.combine
  & Associative Verdict (structural Verdict) m.combine & CombineAbsorbs m & CombineNeverConfirmsMore m

-- ---------------------------------------------------------------- §4 Statistical laws

-- A statistical law's verdict is ternary (7.S17, L9.15, D-2026-10-15-b): it holds, it fails, or it
-- is unresolved with what was sampled. Each carries its rates: `alpha`, the probability of failing
-- a law that holds; `beta`, of holding one that fails, against the alternative at distance
-- `delta`; and the samples spent. They go into the certificate as the price of a sampled grade,
-- operated on when the cost types come (G2, L12.6; D-2026-10-13-m). [proposed] `delta` travels
-- with `beta`, which means nothing without the alternative it is measured against.
Rates = { alpha beta delta : Float64, spent : Nat }
StatisticalVerdict : U := data {
  Holds : Rates -> StatisticalVerdict ;
  Fails : Rates -> StatisticalVerdict ;
  Unresolved : Rates -> StatisticalVerdict ;
}

-- The cutoffs of the sequential test, every one the demand's (D-2026-10-14-c, L5.18, 7.S8), never
-- a constant in a law: the error rates `alpha` and `beta`, the distance `delta` of the
-- alternative, the size of each sample (`initial`: the test grows by samples of this size,
-- [proposed] reading of L9.15's "initial size") and the budget, the most samples the test may
-- spend. `alpha + beta < 1` so that Wald's thresholds bracket one; `delta < 1` so that the
-- reference alternative below is a density with no zero (a single sample would otherwise settle
-- the test by itself).
sequentialCutoffs (alpha beta delta : Float64) (initial budget : Nat) : Bool :=
  0.0 < alpha and alpha < 1.0 and 0.0 < beta and beta < 1.0 and alpha + beta < 1.0
  and 0.0 < delta and delta < 1.0 and 0 < initial and 0 < budget
Sequential : U := { alpha beta delta : Float64, initial budget : Nat | sequentialCutoffs alpha beta delta initial budget }
rates (c : Sequential) (spent : Nat) : Rates := { alpha := c.alpha, beta := c.beta, delta := c.delta, spent := spent }

-- A statistical law is a theory of its statistic and of its alternative at a distance (7.S17):
-- `statistic` reads a sample of `S`; `ratio delta v` is the likelihood of the statistic's value
-- `v` under the alternative at distance `delta` against the null, the law holding. Its laws: at
-- distance zero there is no alternative, so the ratio is one, and the test could never conclude;
-- and a likelihood ratio is never negative. What the test presumes beyond them, that the ratio
-- has mean one under the null, is the calibration of the statistic (7.S17's runs on the model
-- the law tests), a statistical law of this theory itself, not stated here. The stream the
-- samples come from is not the law's: `Statistical` carries it beside the law, as `Forall`
-- carries its type, a `draw` that gives one sample of a size from the state of the stream and
-- the state after it (for a generator the state is the seed, 7.S1, which is the test's and not
-- the law's, L9.15).
StatisticalLaw (S : U) : { statistic : S -> Float64, ratio : Float64 -> Float64 -> Float64 }
NoAlternativeAtZero (S : U) (l : StatisticalLaw S) (x : S) : Bool := l.ratio 0.0 (l.statistic x) == 1.0
RatioNonNegative (S : U) (l : StatisticalLaw S) (c : Sequential) (x : S) : Bool := 0.0 <= l.ratio c.delta (l.statistic x)
StatisticalLaw (S : U) := NoAlternativeAtZero S & RatioNonNegative S

-- The reference alternative, for a law whose statistic is a p-value: under the null the p-value
-- is uniform on [0, 1]; under the alternative at distance `delta` its density is
-- `1 + delta (1 - 2 p)`, tilted toward small p-values. [proposed] 7.S17 names an alternative at
-- distance delta and no form. This one is a density for every `delta` in (0, 1), keeps the ratio
-- within [1 - delta, 1 + delta] so that no single p-value settles the test alone, needs neither a
-- logarithm nor a power (laws.lth imports no model), and lies at Kolmogorov distance `delta / 4`
-- from the uniform. The drift of the log ratio per sample under the null is about -0.045 at
-- `delta = 0.5` and -0.19 at `delta = 0.9`; against a source whose p-values are all near zero it
-- is `log (1 + delta)`.
tilt (delta p : Float64) : Float64 := 1.0 + delta * (1.0 - 2.0 * p)
byPValue (S : U) (pValue : S -> Float64) : StatisticalLaw S := { statistic := pValue, ratio := tilt }

-- Wald's sequential probability ratio test (7.S17, 7.S18; Wald 1945) as a definition over the
-- stream of samples: the product of the likelihood ratios of the samples so far fails the law
-- when it reaches `(1 - beta) / alpha`, holds it when it falls to `beta / (1 - alpha)` (the
-- thresholds whose error rates are at most about `alpha` and `beta`), and between the two one
-- more sample is drawn, until the budget is spent, which leaves the law unresolved with what was
-- spent. 7.S18's repetition of a failure once is this test's continuation into the grey zone,
-- with one more draw.
upperThreshold (c : Sequential) : Float64 := (1.0 - c.beta) / c.alpha
lowerThreshold (c : Sequential) : Float64 := c.beta / (1.0 - c.alpha)
sequentialFrom (S T : U) (l : StatisticalLaw S) (draw : Nat -> T -> S * T) (c : Sequential) (t : T) (ratio : Float64) (spent : Nat) : StatisticalVerdict :=
  if ratio >= upperThreshold c then Fails (rates c spent)
  else if ratio <= lowerThreshold c then Holds (rates c spent)
  else if spent >= c.budget then Unresolved (rates c spent)
  else match draw c.initial t { (x, t2) -> sequentialFrom S T l draw c t2 (ratio * l.ratio c.delta (l.statistic x)) (spent + 1) }
sequential (S T : U) (l : StatisticalLaw S) (draw : Nat -> T -> S * T) (c : Sequential) (t : T) : StatisticalVerdict :=
  sequentialFrom S T l draw c t 1.0 0

-- [D-2026-10-16-g] A stretch of the test: the test continued from the ratio and the samples its
-- earlier stretches left, drawing from a new state (a new seed). Its verdict is `sequentialFrom`
-- from that ratio and that count, and `ratioAfter` is the ratio it stops at, from which the next
-- stretch starts when this one leaves the test unresolved; from a ratio of one and nothing spent the
-- stretch is the whole test, `sequential`. The stretches of a law under one binding are one test
-- whose samples are their total, and its alpha holds over the total: the product of likelihood
-- ratios is a martingale under the null, so the chance that it ever reaches the upper threshold is
-- at most about alpha however many stretches continue it (Ville's inequality). The budget bounds
-- the whole test across its stretches (D-2026-10-15-b names two cutoffs, the size of each sample
-- and the budget the demand pays in all): a new seed buys no budget, so a stretch that starts at
-- the budget draws nothing and leaves the test unresolved; a demand with a larger budget continues
-- it from the ratio recorded (the coordinator's answer to step 3i's question, 2026-10-16).
ratioAfter (S T : U) (l : StatisticalLaw S) (draw : Nat -> T -> S * T) (c : Sequential) (t : T) (ratio : Float64) (spent : Nat) : Float64 :=
  if ratio >= upperThreshold c then ratio
  else if ratio <= lowerThreshold c then ratio
  else if spent >= c.budget then ratio
  else match draw c.initial t { (x, t2) -> ratioAfter S T l draw c t2 (ratio * l.ratio c.delta (l.statistic x)) (spent + 1) }
-- the samples a verdict spent
spentOf (v : StatisticalVerdict) : Nat := match v { Holds r -> r.spent ; Fails r -> r.spent ; Unresolved r -> r.spent }
