-- Probability as it is computed with: a sampler and a likelihood as one kernel read two ways,
-- the information the likelihood reports, and the identities that tie the two together.
--
-- A kernel Theta ~> Y gives, for each parameter, a probability on the data. Read forward it is
-- a sampler: a parameter and a seed give data and the next seed (the seed is the Omega of the
-- probability space). Read through its density it is a likelihood. The likelihood here is not
-- a bare number: it reports its score, the gradient of the log-likelihood, and the Fisher
-- information it claims, as the paper's diagnostics need (Moffatt, "Likelihood approximations
-- distort the ion channel kinetic information in macroscopic currents").
--
-- A pair (sampler, likelihood) is lawful when the likelihood is the density of the sampler.
-- The laws checked are the two of the paper, measured at the generating parameter over an
-- ensemble of draws: the mean score is zero, and the distortion C = H^{-1/2} J H^{-1/2} is the
-- identity, with H the reported information averaged over the ensemble and J the covariance of
-- the score. Each entry is compared with its own standard error; nothing assumes the score is
-- Gaussian.

import "real"
import "algebra"
import "random"
import "array"

pi : Float64 := 3.141592653589793
log2pi : Float64 := log (2.0 * pi)

-- ---------------------------------------------------------------- how a statistical law is measured
-- The draws of an ensemble, and the z beyond which a statistic is a departure: choices of whoever
-- states the law, given to it where it is stated (the experiment, for its kernel). More draws resolve
-- a smaller departure; a larger zMax trades power for fewer false failures. With d parameters a
-- density pair has d + d (d + 1) / 2 entries; at z = 5 a calibrated pair passes each case with
-- probability above 1 - 1e-4 for d up to 16. Below 100 draws the normal approximation of the
-- statistics is poor, and below z = 3 false failures are common; the type does not allow them.
EnsembleParts = { draws : Nat, zMax : Float64 }
Ensemble : U := { e : EnsembleParts | 100 <= e.draws and 3.0 <= e.zMax }

normalCdf (x : Float64) : Float64 := 0.5 * (1.0 + erf (x / sqrt 2.0))
-- the probability of a departure beyond z standard errors, on either side
normalTail (z : Float64) : Float64 := 1.0 - erf (z / sqrt 2.0)

-- ---------------------------------------------------------------- uniform values
-- Values uniform on [0, 1] (a probability integral transform of data from the right model, the rank
-- of the truth under a calibrated belief), tested two ways. Their first two moments, 1/2 and 1/3,
-- each within zMax standard errors (the variances of u and u^2 are 1/12 and 4/45); and their
-- empirical distribution, by Kolmogorov's distance D = sup |F_n(u) - u|, whose tail probability must
-- not fall below that of zMax standard errors. The moments see a shift and a change of spread; the
-- distance sees a change of shape.
uniformMoments (e : Ensemble) (s1 s2 : Float64) (count : Int) : Bool :=
  match toFloat64 count { n ->
  abs (s1 / n - 0.5) / sqrt (1.0 / 12.0 / n) < e.zMax and abs (s2 / n - 1.0 / 3.0) / sqrt (4.0 / 45.0 / n) < e.zMax }

-- the values of n draws, the last first
uniformValues (draw : Int -> Vec Float64 * Int) (n i seed : Int) (acc : List (Vec Float64)) : List (Vec Float64) :=
  if i >= n then acc
  else match draw seed { (u, next) -> uniformValues draw n (i + 1) next (cons (Vec Float64) u acc) }

-- sums of u and u^2 over every entry of the values, and how many entries
valueSums (vs : List (Vec Float64)) : Float64 * Float64 * Int :=
  match vs { nil -> (0.0, 0.0, 0) ; cons u rest -> match valueSums rest { (s1, s2, c) -> (s1 + total u, s2 + dot u u, c + u.n) } }

-- The Kolmogorov distance of the values from the uniform on [0, 1]: on the values sorted, the largest
-- of i/n - u_i and u_i - (i - 1)/n. A leaf (probability_python.lut binds it to numpy's sort),
-- characterized by this definition, on the values sorted by insertion.
entriesOnto (v : Vec Float64) (k : Nat) (tail : List Float64) : List Float64 :=
  if k >= v.n then tail else cons Float64 (v.f k) (entriesOnto v (k + 1) tail)
pooled (vs : List (Vec Float64)) : List Float64 := match vs { nil -> nil Float64 ; cons v rest -> entriesOnto v 0 (pooled rest) }
insertSorted (x : Float64) (xs : List Float64) : List Float64 :=
  match xs { nil -> cons Float64 x (nil Float64) ; cons y ys -> if x <= y then cons Float64 x xs else cons Float64 y (insertSorted x ys) }
sortedValues (xs : List Float64) : List Float64 := match xs { nil -> nil Float64 ; cons y ys -> insertSorted y (sortedValues ys) }
kolmogorovFrom (n i : Int) (us : List Float64) (acc : Float64) : Float64 :=
  match us { nil -> acc ; cons u rest ->
  match toFloat64 i / toFloat64 n - u { a -> match u - toFloat64 (i - 1) / toFloat64 n { b ->
  kolmogorovFrom n (i + 1) rest (if a > acc then (if b > a then b else a) else (if b > acc then b else acc)) } } }
kolmogorovDistanceDef (vs : List (Vec Float64)) : Float64 :=
  match valueSums vs { (s1, s2, count) -> kolmogorovFrom count 1 (sortedValues (pooled vs)) 0.0 }
KolmogorovDistance (k : List (Vec Float64) -> Float64) (vs : List (Vec Float64)) : Bool := k vs == kolmogorovDistanceDef vs
kolmogorovDistance : { k : List (Vec Float64) -> Float64 | KolmogorovDistance k }

-- Kolmogorov's limit of the tail P(sqrt n D > x), 2 sum_k (-1)^(k-1) exp(-2 k^2 x^2), with Stephens's
-- correction for a finite n, x = (sqrt n + 0.12 + 0.11 / sqrt n) D (Stephens, JRSS B 32, 1970); one
-- below x = 0.2, where the series is slow and the tail is above 1 - 1e-13
kolmogorovTail (x : Float64) : Float64 :=
  if x < 0.2 then 1.0
  else 2.0 * sumTo 100 (\ k { (if k mod 2 == 0 then 1.0 else 0.0 - 1.0) * exp (0.0 - 2.0 * toFloat64 ((k + 1) * (k + 1)) * x * x) })

KolmogorovUniform (e : Ensemble) (vs : List (Vec Float64)) (count : Int) : Bool :=
  if count < 1 then true
  else match sqrt (toFloat64 count) { r -> kolmogorovTail ((r + 0.12 + 0.11 / r) * kolmogorovDistance vs) > normalTail e.zMax }

-- the values the draws produce, over an ensemble, are uniform on [0, 1]
UniformDraws (e : Ensemble) (draw : Int -> Vec Float64 * Int) (seed : Int) : Bool :=
  match uniformValues draw e.draws 0 seed (nil (Vec Float64)) { vs ->
  match valueSums vs { (s1, s2, count) -> uniformMoments e s1 s2 count and KolmogorovUniform e vs count } }

-- n standard normals from a seed, and the next seed: n of them, and their probability integral
-- transform is uniform, over the ensemble the generator is certified with. The law tests each value's
-- distribution, not their independence.
normalEnsemble : Ensemble := { draws := 400, zMax := 5.0 }
NormalLength (g : Int -> Int -> Vec Float64 * Int) (n : Dim) (seed : Seed) : Bool := match g n seed { (z, next) -> z.n == n }
NormalDraws (g : Int -> Int -> Vec Float64 * Int) (n : Dim) (seed : Seed) : Bool :=
  UniformDraws normalEnsemble (\ s { match g n s { (z, next) -> ((z.n, \ k { normalCdf (z.f k) }), next) } }) seed
normalVec : { g : Int -> Int -> Vec Float64 * Int | NormalLength g & NormalDraws g }

-- ---------------------------------------------------------------- sampler and likelihood
Draw (Y : U) = Int -> Y * Int              -- seed in, a value and the next seed out
Sampler (Theta Y : U) = Theta -> Draw Y

drawAt (Theta Y : U) (s : Sampler Theta Y) (t : Theta) (seed : Int) : Y := match s t seed { (y, s2) -> y }

-- What a likelihood reports. `dim` is the dimension of the space of directions, the space the score
-- and the information live in; `shift` moves a parameter along a direction of that dimension: the
-- vectors of dimension dim act on Theta. A shift that takes only directions of that dimension can keep
-- the parameter inside its type (the positions of a fixed number of nodes, VecOf (3 n)). The
-- dimension is one for the whole space: Theta is connected (07 §9).
Likelihood (Theta Y : U) = {
  dim    : Nat
  shift  : Theta -> VecOf dim -> Theta
  loglik : Y -> Theta -> Float64
  score  : Y -> Theta -> Vec Float64
  info   : Y -> Theta -> Mat Float64 }

-- ---------------------------------------------------------------- laws of one likelihood
-- The vectors act on Theta: the zero vector leaves a parameter where it is, and moving by u + v is
-- moving by v and then by u (LeftIdentity and Associative, the laws of an action). Theta has no
-- equality of its own, so the laws read it through what the likelihood sees: the log-likelihood,
-- exactly for the zero vector and within fdTol for a composition, which rounds.
ShiftByZero (Theta Y : U) (s : Sampler Theta Y) (l : Likelihood Theta Y) (t : Theta) (seed : Int) : Bool :=
  match drawAt Theta Y s t seed { y ->
  LeftIdentity (VecOf l.dim) Theta (\ a b { l.loglik y a == l.loglik y b }) (\ v p { l.shift p v }) (zeros l.dim) t }

ShiftComposes (Theta Y : U) (s : Sampler Theta Y) (l : Likelihood Theta Y) (t : Theta) (seed : Int) : Bool :=
  match s t seed { (y, s2) ->
  match normalVec l.dim s2 { (u, s3) -> match normalVec l.dim s3 { (v, s4) ->
  Associative (VecOf l.dim) Theta (\ a b { approx fdTol (l.loglik y a) (l.loglik y b) }) (\ p q { add p q }) (\ w p { l.shift p w }) u v t } } }

-- the score is the gradient of the log-likelihood
ScoreIsGradient (Theta Y : U) (s : Sampler Theta Y) (l : Likelihood Theta Y) (t : Theta) (seed : Int) : Bool :=
  match drawAt Theta Y s t seed { y -> IsGradient Theta l.dim l.shift (l.loglik y) (l.score y) t }

-- the score and the information live in the space of directions: their dimension is dim
TangentShapes (Theta Y : U) (s : Sampler Theta Y) (l : Likelihood Theta Y) (t : Theta) (seed : Int) : Bool :=
  match drawAt Theta Y s t seed { y ->
  (l.score y t).n == l.dim and (l.info y t).m == l.dim and (l.info y t).n == l.dim }

-- the information reported is a Fisher information: symmetric and positive semidefinite
InfoIsPositive (Theta Y : U) (s : Sampler Theta Y) (l : Likelihood Theta Y) (t : Theta) (seed : Int) : Bool :=
  match drawAt Theta Y s t seed { y -> match l.info y t { h -> if symmetric 0.0 h then positiveSemidefinite h else false } }

-- ---------------------------------------------------------------- the ensemble diagnostics
-- pass 1: the reported information, summed over n draws
sumInfo (Theta Y : U) (s : Sampler Theta Y) (l : Likelihood Theta Y) (t : Theta) (n k seed : Int) (acc : Mat Float64) : Mat Float64 :=
  if k >= n then acc
  else match s t seed { (y, s2) -> match madd acc (l.info y t) { a2 -> sumInfo Theta Y s l t n (k + 1) s2 a2 } }

-- pass 2, over the same draws: the whitened score w = M s, with M H M = I, and its moments
Moments = { sw : Vec Float64, ss : Vec Float64, sww : Mat Float64, sq : Mat Float64 }

sumWhite (Theta Y : U) (s : Sampler Theta Y) (l : Likelihood Theta Y) (t : Theta) (m : Mat Float64)
         (n k seed : Int) (sw ss : Vec Float64) (sww sq : Mat Float64) : Moments :=
  if k >= n then { sw := sw, ss := ss, sww := sww, sq := sq }
  else match s t seed { (y, s2) ->
       match l.score y t { g ->
       match matVec m g { w ->
       match outer w w { p ->
       match add sw w { sw2 -> match add ss g { ss2 ->
       match madd sww p { sww2 -> match madd sq (hadamard p p) { sq2 ->
       sumWhite Theta Y s l t m n (k + 1) s2 sw2 ss2 sww2 sq2 } } } } } } } }

-- What the ensemble measures.
--   meanScore  the mean score, in score units
--   bias       H^{-1} times the mean score: how far the estimate is pushed, in parameter units
--   reported   H, the mean reported information
--   distortion C, the covariance of the whitened score; the identity when calibrated
--   zMean      the whitened mean score over its standard error, entry by entry
--   zC         C minus the identity over the standard error of each entry
Diagnosis = { meanScore : Vec Float64, bias : Vec Float64, reported : Mat Float64, distortion : Mat Float64, zMean : Vec Float64, zC : Mat Float64 }

diagnose (Theta Y : U) (s : Sampler Theta Y) (l : Likelihood Theta Y) (t : Theta) (n seed : Int) : Diagnosis :=
  match s t seed { (y0, s1) ->
  match l.info y0 t { h0 ->
  match mscale (1.0 / toFloat64 n) (sumInfo Theta Y s l t n 1 s1 h0) { h ->
  match invSqrtSym h { m ->
  match h.m { d ->
  match sumWhite Theta Y s l t m n 0 seed (zeros d) (zeros d) (mscale 0.0 h) (mscale 0.0 h) { mo ->
  match scale (1.0 / toFloat64 n) mo.sw { wbar ->
  match mscale (1.0 / toFloat64 n) mo.sww { ww ->
  match msub ww (outer wbar wbar) { c ->
  match msub (mscale (1.0 / toFloat64 n) mo.sq) (hadamard ww ww) { var ->
  match scale (1.0 / toFloat64 n) mo.ss { sbar ->
  { meanScore := sbar,
    bias := solve h sbar,
    reported := h,
    distortion := c,
    zMean := (d, \ k { wbar.f k / sqrt (c.f k k / toFloat64 n) }),
    zC := (d, d, \ i j { (c.f i j - (identity d).f i j) / sqrt (var.f i j / toFloat64 n) }) } } } } } } } } } } } }

-- the two scalars of the paper: the typical factor and its spread across directions
logEigs (c : Mat Float64) : Vec Float64 := match eigvalsSym c { e -> (e.n, \ k { log (e.f k) }) }
magnitude (c : Mat Float64) : Float64 := match logEigs c { le -> exp (total le / toFloat64 le.n) }
anisotropy (c : Mat Float64) : Float64 :=
  match logEigs c { le -> match total le / toFloat64 le.n { mu ->
  exp (sqrt (sumTo le.n (\ k { (le.f k - mu) * (le.f k - mu) }) / toFloat64 le.n)) } }

-- The likelihood is the density of the sampler: at every parameter, mean score zero and
-- delivered information equal to reported, entry by entry within zMax standard errors, over the
-- draws of the ensemble.
IsDensityOf (Theta Y : U) (e : Ensemble) (s : Sampler Theta Y) (l : Likelihood Theta Y) (t : Theta) (seed : Int) : Bool :=
  match diagnose Theta Y s l t e.draws seed { dg ->
  maxAbs dg.zMean < e.zMax and maxAbsMat dg.zC < e.zMax }

-- A pair over a space Theta is lawful at the parameters of a domain D, a part of Theta given by its
-- inclusion `at` (the layouts within a box, the errors within a range): the laws are stated at those
-- parameters, and a shift may take a parameter out of D while it stays in Theta. A domain is a type
-- with its law, so where the laws are tested is said by a type, not by a generator; how the
-- statistical law is measured is said by the ensemble. DensityPair is the pair lawful at every
-- parameter, D = Theta.
DensityPairOn (Theta Y : U) (D : U) (at : D -> Theta) (e : Ensemble) : U := {
  sample : Sampler Theta Y
  lik    : Likelihood Theta Y
  |
  \ (d : D) (seed : Seed) { TangentShapes Theta Y sample lik (at d) seed }
  & \ (d : D) (seed : Seed) { ShiftByZero Theta Y sample lik (at d) seed }
  & \ (d : D) (seed : Seed) { ShiftComposes Theta Y sample lik (at d) seed }
  & \ (d : D) (seed : Seed) { ScoreIsGradient Theta Y sample lik (at d) seed }
  & \ (d : D) (seed : Seed) { InfoIsPositive Theta Y sample lik (at d) seed }
  & \ (d : D) (seed : Seed) { IsDensityOf Theta Y e sample lik (at d) seed } }
DensityPair (Theta Y : U) (e : Ensemble) = DensityPairOn Theta Y Theta (\ (t : Theta) { t }) e

-- ---------------------------------------------------------------- the kernel and its three presentations
-- A kernel Theta ~> data is one object read three ways: forward, as a sampler; through its
-- density, as a likelihood; and through its distribution function, as the probability integral
-- transform of each datum: entry k of `pit y t` is the probability that datum k falls below y_k.
-- The kernel is the head and the three are its presentations; its laws say they present the same
-- thing, one law for each side of the triangle:
--   sample and lik    a density pair (above)
--   pit and lik       the slope of pit is the density: sum_k log (d pit_k / d y_k) = loglik y t
--   sample and pit    data the sampler draws have a uniform pit
-- A transform entry by entry supposes the data independent given the parameter. The density-pair
-- laws test the first two Bartlett identities only; the uniform pit tests the whole distribution
-- of each datum.

-- the three presentations without their laws: what a control that breaks one side is
KernelParts (Theta : U) = { sample : Sampler Theta (Vec Float64), lik : Likelihood Theta (Vec Float64), pit : Vec Float64 -> Theta -> Vec Float64 }

-- y with entry j moved by h
bumped (y : Vec Float64) (j : Fin y.n) (h : Float64) : Vec Float64 := (y.n, \ i { if i == j then y.f i + h else y.f i })

-- How the slope of a transform is measured: the step of its central difference, in the units of the
-- data, and the tolerance of the sum of the log slopes against the log-likelihood. The truncation is
-- of order (step / sigma)^2 for data of scale sigma, so both are the experiment's, by the scale of its
-- data.
PitResolutionParts = { step : Float64, tol : Float64 }
PitResolution : U := { r : PitResolutionParts | 0.0 < r.step and 0.0 < r.tol }

-- the slope of pit_j along y_j, by central difference
pitSlope (Theta : U) (r : PitResolution) (pit : Vec Float64 -> Theta -> Vec Float64) (y : Vec Float64) (t : Theta) (j : Fin y.n) : Float64 :=
  ((pit (bumped y j r.step) t).f j - (pit (bumped y j (0.0 - r.step)) t).f j) / (2.0 * r.step)

PitIsDensity (Theta : U) (r : PitResolution) (sample : Sampler Theta (Vec Float64)) (lik : Likelihood Theta (Vec Float64)) (pit : Vec Float64 -> Theta -> Vec Float64) (t : Theta) (seed : Int) : Bool :=
  match drawAt Theta (Vec Float64) sample t seed { y ->
  approx r.tol (sumTo y.n (\ j { log (pitSlope Theta r pit y t j) })) (lik.loglik y t) }

PitUniform (Theta : U) (e : Ensemble) (sample : Sampler Theta (Vec Float64)) (pit : Vec Float64 -> Theta -> Vec Float64) (t : Theta) (seed : Int) : Bool :=
  UniformDraws e (\ s { match sample t s { (y, next) -> (pit y t, next) } }) seed

KernelOn (Theta : U) (D : U) (at : D -> Theta) (e : Ensemble) (r : PitResolution) : U := {
  pair : DensityPairOn Theta (Vec Float64) D at e
  pit  : Vec Float64 -> Theta -> Vec Float64
  |
  \ (d : D) (seed : Seed) { PitIsDensity Theta r pair.sample pair.lik pit (at d) seed }
  & \ (d : D) (seed : Seed) { PitUniform Theta e pair.sample pit (at d) seed } }
Kernel (Theta : U) (e : Ensemble) (r : PitResolution) = KernelOn Theta Theta (\ (t : Theta) { t }) e r

-- ---------------------------------------------------------------- the Gaussian construction
-- A mean model: the predicted observations and their Jacobian with respect to the parameter.
MeanModel (Theta : U) = {
  dim   : Nat
  shift : Theta -> VecOf dim -> Theta
  mean  : Theta -> Vec Float64
  jac   : Theta -> Mat Float64 }

-- A scaled model: a mean model whose parameter also carries u = log sigma, a homogeneous
-- error, with its gradient in the parameter space.
ScaledModel (Theta : U) = {
  model     : MeanModel Theta
  logSigma  : Theta -> Float64
  dLogSigma : Theta -> Vec Float64 }

-- Full Gaussian likelihood, u = log sigma a parameter. With r = y - mean, J the Jacobian,
-- K the number of observations and g the gradient of u:
--   loglik = -1/2 e^{-2u} |r|^2 - K u - K/2 log 2 pi
--   score  = e^{-2u} J^T r + (e^{-2u} |r|^2 - K) g
--   info   = e^{-2u} J^T J + 2 K g g^T
gaussian (Theta : U) (m : ScaledModel Theta) : Likelihood Theta (Vec Float64) := {
  dim := m.model.dim,
  shift := m.model.shift,
  loglik := \ y t { match y - m.model.mean t { r -> match m.logSigma t { u ->
    0.0 - 0.5 * exp (0.0 - 2.0 * u) * dot r r - toFloat64 r.n * u - 0.5 * toFloat64 r.n * log2pi } } },
  score := \ y t { match y - m.model.mean t { r -> match exp (0.0 - 2.0 * m.logSigma t) { e ->
    e * (transpose (m.model.jac t) * r) + (e * dot r r - toFloat64 r.n) * m.dLogSigma t } } },
  info := \ y t { match m.model.jac t { j -> match exp (0.0 - 2.0 * m.logSigma t) { e ->
    e * (transpose j * j) + (2.0 * toFloat64 j.m) * outer (m.dLogSigma t) (m.dLogSigma t) } } } }

-- Profile likelihood, sigma eliminated by its maximum sigma^2 = RSS / K:
--   loglik = -K/2 log(2 pi RSS / K) - K/2
--   score  = (K / RSS) J^T r
--   info   = (K / RSS) J^T J
profiled (Theta : U) (m : MeanModel Theta) : Likelihood Theta (Vec Float64) := {
  dim := m.dim,
  shift := m.shift,
  loglik := \ y t { match y - m.mean t { r -> match toFloat64 r.n { k ->
    0.0 - 0.5 * k * log (2.0 * pi * dot r r / k) - 0.5 * k } } },
  score := \ y t { match y - m.mean t { r -> (toFloat64 r.n / dot r r) * (transpose (m.jac t) * r) } },
  info := \ y t { match y - m.mean t { r -> match m.jac t { j -> (toFloat64 r.n / dot r r) * (transpose j * j) } } } }

-- The sampler of the scaled model: mean plus sigma times standard normals drawn from the seed.
gaussianSampler (Theta : U) (m : ScaledModel Theta) : Sampler Theta (Vec Float64) :=
  \ t seed { match m.model.mean t { mu -> match normalVec mu.n seed { (z, s2) ->
    (mu + exp (m.logSigma t) * z, s2) } } }

-- The distribution function of the scaled model, datum by datum: Phi((y_k - mean_k) / sigma).
gaussianPit (Theta : U) (m : ScaledModel Theta) : Vec Float64 -> Theta -> Vec Float64 :=
  \ y t { match m.model.mean t { mu -> match exp (m.logSigma t) { s ->
    (y.n, \ j { normalCdf ((y.f j - mu.f j) / s) }) } } }

-- the scaled model as a kernel: its three presentations built from the one model
gaussianKernel (Theta : U) (m : ScaledModel Theta) (e : Ensemble) (r : PitResolution) : Kernel Theta e r :=
  { pair := { sample := gaussianSampler Theta m, lik := gaussian Theta m }, pit := gaussianPit Theta m }
