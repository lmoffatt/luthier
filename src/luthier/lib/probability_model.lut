-- probability_model.lut: numpy's sort as the model of `Kolmogorov` (probability.lth §5), and the
-- distance bound to it by name.
--
-- Draft 0, 2026-10-14, by Claude Fable 5.1, an agent of the coordinating session, on the brief
-- record/IA/slice-theories-2-2026-10-14/prompt.md (item 1; inventory row 24). A model file
-- (12.S23): one value of the theory, its field a route to the host (3.S40, 10.S8), certified
-- against probability.lth §5 like any extern (10.S10). The host code is
-- src/luthier/arrays.py `kolmogorov_distance`, which survives from v0.1 (probability_python.lut
-- at the tag v0.1-final bound the same route) and computes the native definition's operations
-- on the values sorted, so `KolmogorovAgrees` is exact. What crosses: a Luthier `List (Vec
-- Float64)`, each vector's `f` materialized over `Fin n` (3.S23), as a Python list of arrays;
-- back, a float. The Gaussian construction's model is `gaussianConstruction` (added 2026-10-15
-- on record/IA/controls-2026-10-15/prompt-weak-laws.md, L9.14): `gaussian` and `profiled`,
-- native, over the leaves of arrays_model.lut; v0.1's `normalVec` (the sampler's normals) is
-- not bound, since probability.lth states no theory for it yet.
-- 2026-10-15, by Claude Fable 5.1, an agent of the coordinating session, on record/IA/
-- statistical-2026-10-15/prompt-theory.md: `lump`, a source broken on purpose, the control of
-- `SourceIsUniform` (L9.14, 7.S19) that needs no host.

import "probability.lth" Kolmogorov Vec UnitList SourceIsUniform GaussianConstruction gaussian profiled Pushforward
import "arrays.lth" vec
import "generators.lth" Gen Seed nextSeed
import "laws.lth" Law Sequential

numpySort : Kolmogorov := {
  distance := extern "python:luthier.arrays.kolmogorov_distance",
}

-- the leaf by name, as experiment_zero.lut calls it (:161)
kolmogorovDistance : List (Vec Float64) -> Float64 := numpySort.distance

-- the Gaussian construction of probability.lth §4, the full and the profile likelihood, as the
-- model of its theory (L9.14: a wrong construction can then be passed to its laws)
gaussianConstruction : GaussianConstruction := { full := gaussian, profile := profiled }

-- The control of `SourceIsUniform` (L9.14: a law is evidence of nothing until a wrong model
-- refutes it): a source every value of which is 0.9, the lump that tests/tester/probability_laws.test.lut
-- lists as no sample of the uniform; its p-value is near zero on every sample, so the sequential
-- test fails it in about `log ((1 - beta) / alpha) / log (1 + delta)` samples (laws.lth §4). The
-- law on numpy's sort and this source is `LumpIsUniform`, expected to fail; the same law on the
-- host's calibrated sample is generators_model.lut's `UniformSampleIsUniform`.
lump : Gen UnitList := fn size seed { ([vec Float64 size (fn k { 0.9 })], nextSeed seed) }
LumpIsUniform (c : Sequential) : Law := SourceIsUniform numpySort lump c

-- [core bite 12, Claude Opus 5.5, 2026-10-22] The push of a sampler along a function, the model of
-- probability.lth's `Pushforward` (§6): each draw mapped by f, the seed after it unchanged.
pushGen (A B : U) (f : A -> B) (g : Gen A) : Gen B := fn n s { match g n s { (x, s1) -> (f x, s1) } }
PushingDraws (A : U) (B : Concrete) (f : A -> B) (model : Pushforward A B f <- { push := pushGen A B f }) : Bool :=
  Pushforward A B f model
-- [core bite 12] the claims of this file, gathered so that it claims them (4.S14), as
-- numbers_model.lut gathers `NumberModels`
ProbabilityModels := PushingDraws
