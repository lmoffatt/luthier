-- ebnf_model.lut: `backtrack`, a model of `Derives` (ebnf.lth), a recognizer by backtracking.
--
-- Draft 1, 2026-10-13, by Claude Opus 5.5 in the session integrating the specification, on the
-- review of four models. A model file (spec 12.S23): one named value of a theory, certified
-- against its laws on their domain, the well-formed grammars. Draft 0 redefined the name
-- `derives`, which the theory file had already defined; now the theory declares a field and this
-- file gives a value of the theory, imported by name with it (12.S22).
--
-- The model: a right-hand side, matched at the front of a token list, leaves a list of possible
-- remainders; alternatives contribute all of theirs, a sequence threads them, a repetition
-- iterates while each round consumes. A list derives when some remainder is empty. On a grammar
-- with left recursion `ref n` expands before consuming and the recognizer does not end; the laws
-- do not quantify over such grammars, and a test draws only well-formed ones. Where fuel stops it
-- the case is not run, never counted as false (spec 7.S12): with fuel it would answer false where
-- the laws can force true (Kimi's `start -> seq [ref "start", lit "x"] | eps`).

import "ebnf.lth" Ebnf Rhs TokenView Derives rulesOf eps lit cat ref seq alt opt rep

-- every remainder after matching `r` at the front of `ts`
remainders (e : Ebnf) (r : Rhs) (ts : List TokenView) : List (List TokenView) := match r {
  eps -> [ts] ;
  lit s -> match ts { nil -> nil ; cons t rest -> if t.text == s then [rest] else nil } ;
  cat k -> match ts { nil -> nil ; cons t rest -> if t.kind == k then [rest] else nil } ;
  ref n -> remaindersAny e (rulesOf e n) ts ;
  seq rs -> remaindersSeq e rs ts ;
  alt rs -> remaindersAny e rs ts ;
  opt a -> cons ts (remainders e a ts) ;
  rep a -> cons ts (remaindersRep e a ts) ;
}

remaindersAny (e : Ebnf) (rs : List Rhs) (ts : List TokenView) : List (List TokenView) :=
  concat (List TokenView) (map (fn (r : Rhs) { remainders e r ts }) rs)

remaindersSeq (e : Ebnf) (rs : List Rhs) (ts : List TokenView) : List (List TokenView) :=
  match rs { nil -> [ts] ; cons r rest -> remaindersFrom e rest (remainders e r ts) }

remaindersFrom (e : Ebnf) (rs : List Rhs) (starts : List (List TokenView)) : List (List TokenView) :=
  concat (List TokenView) (map (fn (ts : List TokenView) { remaindersSeq e rs ts }) starts)

-- one or more rounds, each consuming something: the model of `RepRounds`
remaindersRep (e : Ebnf) (a : Rhs) (ts : List TokenView) : List (List TokenView) :=
  remaindersRepFrom e a (shorter ts (remainders e a ts))

remaindersRepFrom (e : Ebnf) (a : Rhs) (starts : List (List TokenView)) : List (List TokenView) :=
  concat (List TokenView) (map (fn (ts : List TokenView) { cons ts (remaindersRepFrom e a (shorter ts (remainders e a ts))) }) starts)

-- only the remainders strictly shorter than `ts`
shorter (ts : List TokenView) (rs : List (List TokenView)) : List (List TokenView) :=
  filter List (List TokenView) (fn (r : List TokenView) { size r < size ts }) rs

hasEmpty (rs : List (List TokenView)) : Bool :=
  any List (List TokenView) (fn (r : List TokenView) { isEmpty TokenView r }) rs

-- the model: a right-hand side derives a list when matching it can leave nothing
backtrack : Derives := { derivesRhs := fn (e : Ebnf) (r : Rhs) (ts : List TokenView) { hasEmpty (remainders e r ts) } }
