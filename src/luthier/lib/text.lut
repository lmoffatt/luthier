-- Text as characters: a String is the concatenation of its characters, each a String of one. What a
-- grammar written in Luthier reads (the format of tables, table.lut).

import "real"
import "algebra"

-- the concatenation of a list of strings, in order
concatAll (cs : List String) : String := match cs { nil -> "" ; cons c rest -> c + concatAll rest }

-- the characters of a string: putting them together gives it back, and each is one character (its
-- own characters are itself)
CharsRoundTrip (f : String -> List String) (s : String) : Bool := concatAll (f s) == s
CharsAreSingle (f : String -> List String) (s : String) : Bool :=
  allSingle f (f s)
allSingle (f : String -> List String) (cs : List String) : Bool :=
  match cs { nil -> true ; cons c rest -> (match f c { nil -> false ; cons d more -> d == c and (match more { nil -> true ; cons e es -> false }) }) and allSingle f rest }
chars : { f : String -> List String | CharsRoundTrip f & CharsAreSingle f } := extern "python:luthier.text.chars"

-- the members of a list of strings
member (x : String) (xs : List String) : Bool := match xs { nil -> false ; cons a rest -> a == x or member x rest }

-- a list in the other order
reverseOnto (A : U) (xs : List A) (acc : List A) : List A := match xs { nil -> acc ; cons x rest -> reverseOnto A rest (cons A x acc) }
reverse (A : U) (xs : List A) : List A := reverseOnto A xs (nil A)

test chars with 200
