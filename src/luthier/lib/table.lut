-- Tables and the codec that reads and writes them as text.
--
-- A table has n rows and named, typed columns; its cells are what a column name and a row give,
-- `cell : String -> Fin n -> Maybe Cell`, nothing where the table has no such column. Its laws are
-- those of its schema: the names distinct, each with a known kind, every cell of its column's
-- kind, and no cells off the schema. The table of luthier/tables.py is a value of this type as it
-- is: its `cell` is the function.
--
-- A codec is a parse and a render between text and tables, with the equality of tables it is
-- judged by, and four laws pin it down:
--   RoundTrip      reading what was written gives back the table
--   Canonical      read, write, read again: the same as reading once (writing is canonical)
--   Tolerant       a text written differently but with the same content reads the same
--   Rejects        a text with a defect is not read
-- Canonical follows from RoundTrip on the tables parse produces; it is tested on texts, so it
-- covers tables the table generator may not reach. Rejects is the negative control: a codec
-- that read anything would pass the first three.

import "real"
import "algebra"
import "text"

Cell = < int : Int | real : Float64 | text : String >

-- ---------------------------------------------------------------- lists
listLength (A : U) (xs : List A) : Int := match xs { nil -> 0 ; cons x rest -> 1 + listLength A rest }
distinct (xs : List String) : Bool := match xs { nil -> true ; cons a rest -> not (member a rest) and distinct rest }

-- the first index below n where p fails, or -1: for messages that point at the row
firstFailing (k : Nat) (n : Int) (p : Fin n -> Bool) : Int :=
  if k >= n then 0 - 1 else if p k then firstFailing (k + 1) n p else k

-- ---------------------------------------------------------------- the table and its schema
-- The kind of a cell: "int", "float" or "str", and "" where there is none.
kindOf (c : Maybe Cell) : String := match c { nothing -> "" ; just v -> match v { int k -> "int" ; real x -> "float" ; text s -> "str" } }

Table : { nRows : Nat, names : List String, kinds : List String, cell : String -> Fin nRows -> Maybe Cell }

-- the columns are named once each, with one kind each
SchemaWellFormed (t : Table) : Bool := distinct t.names and listLength String t.names == listLength String t.kinds
-- every cell of a column is of the column's kind
columnsOfKind (t : Table) (ns ks : List String) : Bool :=
  match ns { nil -> true ; cons n rest -> match ks { nil -> false ; cons k more ->
  forallBelow t.nRows (\ r { kindOf (t.cell n r) == k }) and columnsOfKind t rest more } }
CellsOfTheirKind (t : Table) : Bool := columnsOfKind t t.names t.kinds
KindsKnown (t : Table) : Bool := allKnown t.kinds
allKnown (ks : List String) : Bool := match ks { nil -> true ; cons k rest -> (k == "int" or k == "float" or k == "str") and allKnown rest }
-- a name that is not a column has no cells
NoCellsOffSchema (t : Table) (c : String) (r : Fin t.nRows) : Bool := member c t.names or kindOf (t.cell c r) == ""

Table := SchemaWellFormed & KindsKnown & CellsOfTheirKind & NoCellsOffSchema

-- ---------------------------------------------------------------- accessors
nCols (t : Table) : Int := listLength String t.names

pairIn (ns ks : List String) (n k : String) : Bool :=
  match ns { nil -> false ; cons a rest -> match ks { nil -> false ; cons b more -> (a == n and b == k) or pairIn rest more n k } }

-- a column of this name and kind: "int", "float" or "str"
hasColumn (t : Table) (name kind : String) : Bool := pairIn t.names t.kinds name kind

-- The cells of a column of a kind. The column is a precondition; by the laws of Table its cells
-- are then of that kind, and the other branches are unreachable (they give 0, 0.0 and "" only
-- because a match names every case).
intAt (t : Table) (c : { s : String | hasColumn t s "int" }) (r : Fin t.nRows) : Int :=
  match t.cell c r { just v -> (match v { int k -> k ; real x -> 0 ; text s -> 0 }) ; nothing -> 0 }
realAt (t : Table) (c : { s : String | hasColumn t s "float" }) (r : Fin t.nRows) : Float64 :=
  match t.cell c r { just v -> (match v { int k -> toFloat64 k ; real x -> x ; text s -> 0.0 }) ; nothing -> 0.0 }
textAt (t : Table) (c : { s : String | hasColumn t s "str" }) (r : Fin t.nRows) : String :=
  match t.cell c r { just v -> (match v { int k -> "" ; real x -> "" ; text s -> s }) ; nothing -> "" }

-- two tables are the same when they have the same columns and every cell agrees
sameCells (t : Table) (u : { v : Table | v.nRows == t.nRows }) (ns : List String) : Bool :=
  match ns { nil -> true ; cons n rest -> forallBelow t.nRows (\ r { t.cell n r == u.cell n r }) and sameCells t u rest }
sameTable (t u : Table) : Bool :=
  if t.nRows == u.nRows then t.names == u.names and t.kinds == u.kinds and sameCells t u t.names else false

-- ---------------------------------------------------------------- the codec
Codec : { parse : String -> Maybe Table, render : Table -> String, eq : Setoid Table }

sameParse (c : Codec) (a b : Maybe Table) : Bool :=
  match a { nothing -> (match b { nothing -> true ; just y -> false })
          ; just x -> (match b { nothing -> false ; just y -> c.eq x y }) }

-- ---------------------------------------------------------------- the format, as a grammar
-- The text of a table is CSV read strictly. A record ends at \n, \r\n or \r. A field is quoted ("...",
-- a quote inside it written twice, the closing quote followed by a comma or the end of the record) or
-- not (no comma, no line end; a quote inside it is a character). An empty line is no record; a quote
-- left open, or a closing quote followed by anything else, makes the text no text. The first record is
-- the header: each cell `name : kind`, the name not empty, the kind int, float or str, the names
-- distinct. Every other record has a cell per column: an int cell `[+-]digits`, a float cell a decimal
-- `[+-](digits[.digits] | .digits)[(e|E)[+-]digits]` with a finite value, each with white space around
-- it allowed, and a str cell anything. This is the specification; luthier/tables.py implements it, and
-- ReadsTheFormat says it does.

CsvState = < fieldStart : Unit | unquoted : Unit | quoted : Unit | afterQuote : Unit >

isLineEnd (c : String) : Bool := c == "\n" or c == "\r"
-- what follows a line end: \r\n is one
afterLineEnd (c : String) (rest : List String) : List String :=
  if c == "\r" then (match rest { nil -> rest ; cons d more -> if d == "\n" then more else rest }) else rest

-- the record that ends here, added to those before it, unless the line was empty
endRecord (st : CsvState) (cur : String) (fields : List String) (recs : List (List String)) : List (List String) :=
  match st {
    fieldStart -> (match fields { nil -> recs ; cons f fs -> cons (List String) (reverse String (cons String cur fields)) recs }) ;
    unquoted -> cons (List String) (reverse String (cons String cur fields)) recs ;
    quoted -> recs ;
    afterQuote -> cons (List String) (reverse String (cons String cur fields)) recs }

-- the records of a text: the characters left, where the reader is, the field it is reading, the fields
-- of the record so far and the records so far (both in reverse)
csvRead (cs : List String) (st : CsvState) (cur : String) (fields : List String) (recs : List (List String)) : Maybe (List (List String)) :=
  match cs {
    nil -> (match st { quoted -> nothing ; fieldStart -> just (reverse (List String) (endRecord st cur fields recs)) ;
                       unquoted -> just (reverse (List String) (endRecord st cur fields recs)) ;
                       afterQuote -> just (reverse (List String) (endRecord st cur fields recs)) }) ;
    cons c rest -> (match st {
      fieldStart -> (if c == "\"" then csvRead rest quoted "" fields recs
                     else if c == "," then csvRead rest fieldStart "" (cons String cur fields) recs
                     else if isLineEnd c then csvRead (afterLineEnd c rest) fieldStart "" (nil String) (endRecord st cur fields recs)
                     else csvRead rest unquoted c fields recs) ;
      unquoted -> (if c == "," then csvRead rest fieldStart "" (cons String cur fields) recs
                   else if isLineEnd c then csvRead (afterLineEnd c rest) fieldStart "" (nil String) (endRecord st cur fields recs)
                   else csvRead rest unquoted (cur + c) fields recs) ;
      quoted -> (if c == "\"" then csvRead rest afterQuote cur fields recs else csvRead rest quoted (cur + c) fields recs) ;
      afterQuote -> (if c == "\"" then csvRead rest quoted (cur + "\"") fields recs
                     else if c == "," then csvRead rest fieldStart "" (cons String cur fields) recs
                     else if isLineEnd c then csvRead (afterLineEnd c rest) fieldStart "" (nil String) (endRecord st cur fields recs)
                     else nothing) }) }
csvRecords (s : String) : Maybe (List (List String)) := csvRead (chars s) fieldStart "" (nil String) (nil (List String))

-- white space, and the characters of a cell without it at either end
isSpace (c : String) : Bool := c == " " or c == "\t" or c == "\n" or c == "\r" or c == "\x0b" or c == "\x0c"
dropSpaces (cs : List String) : List String := match cs { nil -> nil String ; cons c rest -> if isSpace c then dropSpaces rest else cs }
stripped (cs : List String) : List String := reverse String (dropSpaces (reverse String (dropSpaces cs)))

-- a header cell: the name and the kind on either side of the first ':', each stripped
splitColon (cs : List String) (before : List String) : Maybe (List String * List String) :=
  match cs { nil -> nothing ; cons c rest -> if c == ":" then just (reverse String before, rest) else splitColon rest (cons String c before) }
headerCell (cell : String) : Maybe (String * String) :=
  match splitColon (chars cell) (nil String) {
    nothing -> nothing ;
    just (a, b) -> (let n = concatAll (stripped a) in let k = concatAll (stripped b) in
                    if n == "" then nothing else if k == "int" or k == "float" or k == "str" then just (n, k) else nothing) }
-- the names and the kinds of a header, or nothing if a cell is not one
headerOf (cells : List String) : Maybe (List String * List String) :=
  match cells {
    nil -> just (nil String, nil String) ;
    cons c rest -> (match headerCell c { nothing -> nothing ; just (n, k) ->
                    (match headerOf rest { nothing -> nothing ; just (ns, ks) -> just (cons String n ns, cons String k ks) }) }) }

-- the decimal digits, and the value of a run of them
digitChars : List String := chars "0123456789"
isDigit (c : String) : Bool := member c digitChars
allDigits (cs : List String) : Bool := match cs { nil -> true ; cons c rest -> isDigit c and allDigits rest }
someDigits (cs : List String) : Bool := match cs { nil -> false ; cons c rest -> allDigits cs }
digitOf (c : String) (ds : List String) (k : Int) : Int := match ds { nil -> 0 ; cons d rest -> if d == c then k else digitOf c rest (k + 1) }
digitsValue (cs : List String) (acc : Int) : Int := match cs { nil -> acc ; cons c rest -> digitsValue rest (acc * 10 + digitOf c digitChars 0) }
power10 (k : Nat) : Int := if k <= 0 then 1 else 10 * power10 (k - 1)
power2 (k : Nat) : Int := if k <= 0 then 1 else 2 * power2 (k - 1)
-- without its sign, and whether it was negative
unsigned (cs : List String) : List String := match cs { nil -> cs ; cons c rest -> if c == "+" or c == "-" then rest else cs }
signNegative (cs : List String) : Bool := match cs { nil -> false ; cons c rest -> c == "-" }

IntCell (cell : String) : Bool := someDigits (unsigned (stripped (chars cell)))

-- the parts of a decimal: before and after the point, the digits of the exponent (with its sign)
splitAt (cut : String -> Bool) (cs : List String) (before : List String) : List String * Maybe (List String) :=
  match cs { nil -> (reverse String before, nothing) ;
             cons c rest -> if cut c then (reverse String before, just rest) else splitAt cut rest (cons String c before) }
-- the values a double cannot reach: from the point halfway between the largest double and 2^1024,
-- which rounds to infinity, up
overflowBound : Int := (power2 54 - 1) * power2 970
digitCount (m : Int) : Int := if m < 10 then 1 else 1 + digitCount (m / 10)
-- m 10^e is below the bound; for |e| beyond any double's reach only the magnitude decides
finiteDecimal (m : Nat) (e : Int) : Bool :=
  if m == 0 then true
  else if digitCount m + e > 400 then false
  else if digitCount m + e < 0 - 400 then true
  else if e >= 0 then m * power10 e < overflowBound
  else m < overflowBound * power10 (0 - e)
FloatCell (cell : String) : Bool :=
  let body = unsigned (stripped (chars cell)) in
  (match splitAt (\ c { c == "e" or c == "E" }) body (nil String) {
    (mant, ex) -> (match splitAt (\ c { c == "." }) mant (nil String) {
      (whole, frac) -> (let fracDigits = (match frac { nothing -> nil String ; just f -> f }) in
        let mantissaOk = (match frac { nothing -> someDigits whole ;
                                       just f -> allDigits whole and allDigits f and (someDigits whole or someDigits f) }) in
        let expDigits = (match ex { nothing -> nil String ; just x -> unsigned x }) in
        let expOk = (match ex { nothing -> true ; just x -> someDigits (unsigned x) }) in
        if mantissaOk and expOk then
          (let e0 = digitsValue expDigits 0 in
           let e = (match ex { nothing -> 0 ; just x -> if signNegative x then 0 - e0 else e0 }) in
           finiteDecimal (digitsValue (concatChars whole fracDigits) 0) (e - listLength String fracDigits))
        else false) }) })
concatChars (a b : List String) : List String := match a { nil -> b ; cons c rest -> cons String c (concatChars rest b) }

cellFits (kind : String) (cell : String) : Bool := if kind == "int" then IntCell cell else if kind == "float" then FloatCell cell else true
rowFits (kinds : List String) (cells : List String) : Bool :=
  match kinds { nil -> (match cells { nil -> true ; cons c cs -> false }) ;
                cons k ks -> (match cells { nil -> false ; cons c cs -> cellFits k c and rowFits ks cs }) }
rowsFit (kinds : List String) (rows : List (List String)) : Bool :=
  match rows { nil -> true ; cons r rest -> rowFits kinds r and rowsFit kinds rest }

-- a text of the format
WellFormed (s : String) : Bool :=
  match csvRecords s {
    nothing -> false ;
    just recs -> (match recs { nil -> false ; cons h rows ->
                  (match headerOf h { nothing -> false ; just (names, kinds) -> distinct names and rowsFit kinds rows }) }) }

-- A table and a text with the same content written differently, and a text that is not of the format.
-- The second is a type with its law, so its generator's texts are checked against the grammar.
Perturbed = { table : Table, text : String }
BrokenText : U := { s : String | not (WellFormed s) }

RoundTrip (c : Codec) (t : Table) : Bool := sameParse c (c.parse (c.render t)) (just t)

-- a text that parses renders to a text that parses to the same table
Canonical (c : Codec) (p : Perturbed) : Bool :=
  match c.parse p.text { nothing -> true ; just t -> sameParse c (c.parse (c.render t)) (just t) }

Tolerant (c : Codec) (p : Perturbed) : Bool := sameParse c (c.parse p.text) (just p.table)

Rejects (c : Codec) (b : BrokenText) : Bool := match c.parse b { nothing -> true ; just t -> false }

-- a codec reads exactly the texts of the format: tested on any text, and on renderings written
-- differently, which are of it
ReadsTheFormat (c : Codec) (s : String) : Bool := match c.parse s { nothing -> not (WellFormed s) ; just t -> WellFormed s }
ReadsRenderings (c : Codec) (p : Perturbed) : Bool := ReadsTheFormat c p.text

-- and on texts one character away from a rendering: the character at position i replaced by one of the
-- characters the format gives a meaning to, which is where a reader and a grammar part ways
meaningful : List String := chars ",\"\n\r :.e-+0a"
nthOf (cs : List String) (k : Int) : String := match cs { nil -> "" ; cons c rest -> if k <= 0 then c else nthOf rest (k - 1) }
replaceAt (cs : List String) (i : Int) (c : String) : List String :=
  match cs { nil -> cs ; cons d rest -> if i <= 0 then cons String c rest else cons String d (replaceAt rest (i - 1) c) }
mutated (s : String) (i j : Nat) : String :=
  let cs = chars s in let n = listLength String cs in
  if n == 0 then s else concatAll (replaceAt cs (i mod n) (nthOf meaningful (j mod listLength String meaningful)))
ReadsMutations (c : Codec) (p : Perturbed) (i j : Nat) : Bool := ReadsTheFormat c (mutated p.text i j)

Codec := RoundTrip & Canonical & Tolerant & Rejects & ReadsTheFormat & ReadsRenderings & ReadsMutations
