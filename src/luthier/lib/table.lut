-- Tables and the codec that reads and writes them as text.
--
-- A table has n rows and named, typed columns; its cells are what a column name and a row give,
-- `cell : String -> Fin n -> Maybe Cell`, nothing where the table has no such column. Its laws are
-- those of its schema: the names distinct, each with a known kind, every cell of its column's
-- kind, and no cells off the schema. The table of luthier/tables.py is a value of this type as it
-- is: its `cell` is the function.
--
-- A codec is a parse and a render between text and tables, with the equality of tables it is
-- judged by, and four laws pin it down:
--   RoundTrip      reading what was written gives back the table
--   Canonical      read, write, read again: the same as reading once (writing is canonical)
--   Tolerant       a text written differently but with the same content reads the same
--   Rejects        a text with a defect is not read
-- Canonical follows from RoundTrip on the tables parse produces; it is tested on texts, so it
-- covers tables the table generator may not reach. Rejects is the negative control: a codec
-- that read anything would pass the first three.

import "real"
import "algebra"

Cell = < int : Int | real : Float64 | text : String >

-- ---------------------------------------------------------------- lists
listLength (A : U) (xs : List A) : Int := match xs { nil -> 0 ; cons x rest -> 1 + listLength A rest }
member (x : String) (xs : List String) : Bool := match xs { nil -> false ; cons a rest -> a == x or member x rest }
distinct (xs : List String) : Bool := match xs { nil -> true ; cons a rest -> not (member a rest) and distinct rest }

-- the first index below n where p fails, or -1: for messages that point at the row
firstFailing (k : Nat) (n : Int) (p : Fin n -> Bool) : Int :=
  if k >= n then 0 - 1 else if p k then firstFailing (k + 1) n p else k

-- ---------------------------------------------------------------- the table and its schema
-- The kind of a cell: "int", "float" or "str", and "" where there is none.
kindOf (c : Maybe Cell) : String := match c { nothing -> "" ; just v -> match v { int k -> "int" ; real x -> "float" ; text s -> "str" } }

Table : { nRows : Nat, names : List String, kinds : List String, cell : String -> Fin nRows -> Maybe Cell }

-- the columns are named once each, with one kind each
SchemaWellFormed (t : Table) : Bool := distinct t.names and listLength String t.names == listLength String t.kinds
-- every cell of a column is of the column's kind
columnsOfKind (t : Table) (ns ks : List String) : Bool :=
  match ns { nil -> true ; cons n rest -> match ks { nil -> false ; cons k more ->
  forallBelow t.nRows (\ r { kindOf (t.cell n r) == k }) and columnsOfKind t rest more } }
CellsOfTheirKind (t : Table) : Bool := columnsOfKind t t.names t.kinds
KindsKnown (t : Table) : Bool := allKnown t.kinds
allKnown (ks : List String) : Bool := match ks { nil -> true ; cons k rest -> (k == "int" or k == "float" or k == "str") and allKnown rest }
-- a name that is not a column has no cells
NoCellsOffSchema (t : Table) (c : String) (r : Fin t.nRows) : Bool := member c t.names or kindOf (t.cell c r) == ""

Table := SchemaWellFormed & KindsKnown & CellsOfTheirKind & NoCellsOffSchema

-- ---------------------------------------------------------------- accessors
nCols (t : Table) : Int := listLength String t.names

pairIn (ns ks : List String) (n k : String) : Bool :=
  match ns { nil -> false ; cons a rest -> match ks { nil -> false ; cons b more -> (a == n and b == k) or pairIn rest more n k } }

-- a column of this name and kind: "int", "float" or "str"
hasColumn (t : Table) (name kind : String) : Bool := pairIn t.names t.kinds name kind

-- The cells of a column of a kind. The column is a precondition; by the laws of Table its cells
-- are then of that kind, and the other branches are unreachable (they give 0, 0.0 and "" only
-- because a match names every case).
intAt (t : Table) (c : { s : String | hasColumn t s "int" }) (r : Fin t.nRows) : Int :=
  match t.cell c r { just v -> (match v { int k -> k ; real x -> 0 ; text s -> 0 }) ; nothing -> 0 }
realAt (t : Table) (c : { s : String | hasColumn t s "float" }) (r : Fin t.nRows) : Float64 :=
  match t.cell c r { just v -> (match v { int k -> toFloat64 k ; real x -> x ; text s -> 0.0 }) ; nothing -> 0.0 }
textAt (t : Table) (c : { s : String | hasColumn t s "str" }) (r : Fin t.nRows) : String :=
  match t.cell c r { just v -> (match v { int k -> "" ; real x -> "" ; text s -> s }) ; nothing -> "" }

-- two tables are the same when they have the same columns and every cell agrees
sameCells (t : Table) (u : { v : Table | v.nRows == t.nRows }) (ns : List String) : Bool :=
  match ns { nil -> true ; cons n rest -> forallBelow t.nRows (\ r { t.cell n r == u.cell n r }) and sameCells t u rest }
sameTable (t u : Table) : Bool :=
  if t.nRows == u.nRows then t.names == u.names and t.kinds == u.kinds and sameCells t u t.names else false

-- ---------------------------------------------------------------- the codec
Codec : { parse : String -> Maybe Table, render : Table -> String, eq : Setoid Table }

sameParse (c : Codec) (a b : Maybe Table) : Bool :=
  match a { nothing -> (match b { nothing -> true ; just y -> false })
          ; just x -> (match b { nothing -> false ; just y -> c.eq x y }) }

-- A table and a text with the same content written differently; a text with one defect, and the
-- name of its defect. An alias is the type it stands for (05 R7), so a generator of a String alias
-- would be the generator of every String; these are records, and their generators give values of
-- them and of nothing else. That the defect of a BrokenText is real is not stated: it needs the
-- grammar of the format written natively, which the parser of luthier/tables.py holds today.
Perturbed = { table : Table, text : String }
BrokenText = { text : String, defect : String }

RoundTrip (c : Codec) (t : Table) : Bool := sameParse c (c.parse (c.render t)) (just t)

-- a text that parses renders to a text that parses to the same table
Canonical (c : Codec) (p : Perturbed) : Bool :=
  match c.parse p.text { nothing -> true ; just t -> sameParse c (c.parse (c.render t)) (just t) }

Tolerant (c : Codec) (p : Perturbed) : Bool := sameParse c (c.parse p.text) (just p.table)

Rejects (c : Codec) (b : BrokenText) : Bool := match c.parse b.text { nothing -> true ; just t -> false }

Codec := RoundTrip & Canonical & Tolerant & Rejects
