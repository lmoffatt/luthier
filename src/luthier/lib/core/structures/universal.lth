-- Universal constructions: declarations and their universal laws (D-2026-10-17-g).
-- Codex, bite 6, 2026-10-20, execution.md §3.5 at 2859815; bare form D-2026-10-18-f.
-- Reference: Mac Lane, Categories for the Working Mathematician (1998), III.1, III.3, V.1.
-- Equalities are the objects', including the codomain of each universal arrow.
Terminal (T : U) (o : Object T) : { point : T }
OnlyThePoint (T : U) (o : Object T) (t : Terminal T o) (x : T) : Bool := o.eq x t.point
Terminal (T : U) (o : Object T) := OnlyThePoint T o
Initial (T : U) : { absurd : (A : U) -> T -> A }
NoValue (T : U) (i : Initial T) (x : T) : Bool := i.absurd Bool x and not (i.absurd Bool x)
Initial (T : U) := NoValue T
Exponential (A B : U) (o : Object B) : { apply : (A -> B) -> A -> B }
Beta (A B : U) (o : Object B) (e : Exponential A B o) (f : A -> B) (x : A) : Bool := o.eq (e.apply (fn y { f y }) x) (f x)
Exponential (A B : U) (o : Object B) := Beta A B o
Product (A B P : U) (a : Object A) (b : Object B) (o : Object P) : { pair : A -> B -> P, first : P -> A, second : P -> B }
PairFst (A B P : U) (a : Object A) (b : Object B) (o : Object P) (p : Product A B P a b o) (x : A) (y : B) : Bool := a.eq (p.first (p.pair x y)) x
PairSnd (A B P : U) (a : Object A) (b : Object B) (o : Object P) (p : Product A B P a b o) (x : A) (y : B) : Bool := b.eq (p.second (p.pair x y)) y
Pairing (A B P : U) (a : Object A) (b : Object B) (o : Object P) (p : Product A B P a b o) (q : P) : Bool := o.eq (p.pair (p.first q) (p.second q)) q
Product (A B P : U) (a : Object A) (b : Object B) (o : Object P) := PairFst A B P a b o & PairSnd A B P a b o & Pairing A B P a b o
Coproduct (A B S : U) (o : Object S) : { left : A -> S, right : B -> S, cases : (C : U) -> (A -> C) -> (B -> C) -> S -> C }
CaseLeft (A B S : U) (o : Object S) (s : Coproduct A B S o) (C : U) (c : Object C) (f : A -> C) (g : B -> C) (a : A) : Bool := c.eq (s.cases C f g (s.left a)) (f a)
CaseRight (A B S : U) (o : Object S) (s : Coproduct A B S o) (C : U) (c : Object C) (f : A -> C) (g : B -> C) (b : B) : Bool := c.eq (s.cases C f g (s.right b)) (g b)
CasesAreAll (A B S : U) (o : Object S) (s : Coproduct A B S o) (v : S) : Bool := o.eq (s.cases S s.left s.right v) v
Coproduct (A B S : U) (o : Object S) := CaseLeft A B S o & CaseRight A B S o & CasesAreAll A B S o
Selected (A B : U) = { one : A || two : B }
NamedProduct (A B P : Concrete) (a : Object A) (b : Object B) (o : Object P) : {
  pair : A -> B -> P, first : P -> A, second : P -> B, firstName secondName : String,
  select : String -> P -> Maybe (Selected A B) }
ProjectionNamesDistinct (A B P : U) (a : Object A) (b : Object B) (o : Object P) (r : NamedProduct A B P a b o) : Bool := not (r.firstName == r.secondName)
SelectByName (A B P : Concrete) (a : Object A) (b : Object B) (o : Object P) (r : NamedProduct A B P a b o) (x : A) (y : B) : Bool :=
  r.select r.firstName (r.pair x y) == just (one x) and r.select r.secondName (r.pair x y) == just (two y)
NamedProduct (A B P : Concrete) (a : Object A) (b : Object B) (o : Object P) (r : NamedProduct A B P a b o) :=
  Product A B P a b o { pair := r.pair, first := r.first, second := r.second }
  & ProjectionNamesDistinct A B P a b o r & SelectByName A B P a b o r
NamedCoproduct (A B S : U) (o : Object S) : {
  left : A -> S, right : B -> S, cases : (C : U) -> (A -> C) -> (B -> C) -> S -> C,
  leftName rightName : String, labelOf : S -> String }
InjectionNamesDistinct (A B S : U) (o : Object S) (s : NamedCoproduct A B S o) : Bool := not (s.leftName == s.rightName)
LabelByName (A B S : U) (o : Object S) (s : NamedCoproduct A B S o) (a : A) (b : B) : Bool :=
  s.labelOf (s.left a) == s.leftName and s.labelOf (s.right b) == s.rightName
NamedCoproduct (A B S : U) (o : Object S) (s : NamedCoproduct A B S o) :=
  Coproduct A B S o { left := s.left, right := s.right, cases := s.cases }
  & InjectionNamesDistinct A B S o s & LabelByName A B S o s

FreeMonoid (A : U) (F : U -> U) (o : Object (F A)) : {
  monoid : Monoid (F A) o, inject : A -> F A, foldable : Foldable F }
FoldNeutral (A : U) (F : U -> U) (o : Object (F A)) (m : FreeMonoid A F o) (N : U) (nO : Object N) (n : Monoid N nO) (f : A -> N) : Bool := nO.eq (m.foldable.fold A N n.combine n.neutral f m.monoid.neutral) n.neutral
FoldInject (A : U) (F : U -> U) (o : Object (F A)) (m : FreeMonoid A F o) (N : U) (nO : Object N) (n : Monoid N nO) (f : A -> N) (a : A) : Bool := nO.eq (m.foldable.fold A N n.combine n.neutral f (m.inject a)) (f a)
FoldCombine (A : U) (F : U -> U) (o : Object (F A)) (m : FreeMonoid A F o) (N : U) (nO : Object N) (n : Monoid N nO) (f : A -> N) (x y : F A) : Bool := nO.eq (m.foldable.fold A N n.combine n.neutral f (m.monoid.combine x y)) (n.combine (m.foldable.fold A N n.combine n.neutral f x) (m.foldable.fold A N n.combine n.neutral f y))
FoldIsItself (A : U) (F : U -> U) (o : Object (F A)) (m : FreeMonoid A F o) (x : F A) : Bool := o.eq (m.foldable.fold A (F A) m.monoid.combine m.monoid.neutral m.inject x) x
FreeMonoid (A : U) (F : U -> U) (o : Object (F A)) (m : FreeMonoid A F o) :=
  Monoid (F A) o m.monoid & FoldNeutral A F o m & FoldInject A F o m & FoldCombine A F o m & FoldIsItself A F o m
Lists (A : U) (o : Object (List A)) : { free : FreeMonoid A List o }
NilIsNeutral (A : U) (o : Object (List A)) (l : Lists A o) : Bool := o.eq l.free.monoid.neutral nil
ConsIsInjectionCombined (A : U) (o : Object (List A)) (l : Lists A o) (a : A) (xs : List A) : Bool := o.eq (l.free.monoid.combine (l.free.inject a) xs) (cons a xs)
Lists (A : U) (o : Object (List A)) (l : Lists A o) := FreeMonoid A List o l.free & NilIsNeutral A o l & ConsIsInjectionCombined A o l

Equalizer (A B E : U) (a : Object A) (b : Object B) (e : Object E) (f g : A -> B) : {
  include : E -> A, restrict : { x : A | b.eq (f x) (g x) } -> E }
Equalizes (A B E : U) (a : Object A) (b : Object B) (e : Object E) (f g : A -> B) (m : Equalizer A B E a b e f g) (x : E) : Bool := b.eq (f (m.include x)) (g (m.include x))
RestrictIncludes (A B E : U) (a : Object A) (b : Object B) (e : Object E) (f g : A -> B) (m : Equalizer A B E a b e f g) (x : { x : A | b.eq (f x) (g x) }) : Bool := a.eq (m.include (m.restrict x)) x
IncludeRestricts (A B E : U) (a : Object A) (b : Object B) (e : Object E) (f g : A -> B) (m : Equalizer A B E a b e f g) (x : E) : Bool := e.eq (m.restrict (m.include x)) x
Equalizer (A B E : U) (a : Object A) (b : Object B) (e : Object E) (f g : A -> B) := Equalizes A B E a b e f g & RestrictIncludes A B E a b e f g & IncludeRestricts A B E a b e f g
agreeing (A B C : U) (o : Object C) (f : A -> C) (g : B -> C) : U := { x : A, y : B | o.eq (f x) (g y) }
Pullback (A B C P : U) (a : Object A) (b : Object B) (c : Object C) (o : Object P) (f : A -> C) (g : B -> C) : { first : P -> A, second : P -> B, pair : agreeing A B C c f g -> P }
PullbackCommutes (A B C P : U) (a : Object A) (b : Object B) (c : Object C) (o : Object P) (f : A -> C) (g : B -> C) (p : Pullback A B C P a b c o f g) (x : P) : Bool := c.eq (f (p.first x)) (g (p.second x))
PullbackProjects (A B C P : U) (a : Object A) (b : Object B) (c : Object C) (o : Object P) (f : A -> C) (g : B -> C) (p : Pullback A B C P a b c o f g) (v : agreeing A B C c f g) : Bool := a.eq (p.first (p.pair v)) v.x and b.eq (p.second (p.pair v)) v.y
PullbackUnique (A B C P : U) (a : Object A) (b : Object B) (c : Object C) (o : Object P) (f : A -> C) (g : B -> C) (p : Pullback A B C P a b c o f g) (x : P) : Bool := o.eq (p.pair { x := p.first x, y := p.second x }) x
Pullback (A B C P : U) (a : Object A) (b : Object B) (c : Object C) (o : Object P) (f : A -> C) (g : B -> C) := PullbackCommutes A B C P a b c o f g & PullbackProjects A B C P a b c o f g & PullbackUnique A B C P a b c o f g

-- The relation need not be an equivalence: the projection coequalizes its generating pairs.
-- A respecting map is supplied with its pointwise witness; lift is unique by surjectivity.
Coequalizer (A Q : U) (o : Object Q) (r : A -> A -> Bool) : {
  project : A -> Q, representative : Q -> A,
  lift : (B : U) -> (b : Object B) -> (f : A -> B) -> ((p : Related A r) -> { u : Unit | b.eq (f p.x) (f p.y) }) -> Q -> B }
ProjectsRelated (A Q : U) (o : Object Q) (r : A -> A -> Bool) (q : Coequalizer A Q o r) (p : Related A r) : Bool := o.eq (q.project p.x) (q.project p.y)
ProjectIsOnto (A Q : U) (o : Object Q) (r : A -> A -> Bool) (q : Coequalizer A Q o r) (x : Q) : Bool := o.eq (q.project (q.representative x)) x
LiftProjects (A Q : U) (o : Object Q) (r : A -> A -> Bool) (q : Coequalizer A Q o r) (B : U) (b : Object B) (f : A -> B) (respect : (p : Related A r) -> { u : Unit | b.eq (f p.x) (f p.y) }) (x : A) : Bool := b.eq (q.lift B b f respect (q.project x)) (f x)
Coequalizer (A Q : U) (o : Object Q) (r : A -> A -> Bool) := ProjectsRelated A Q o r & ProjectIsOnto A Q o r & LiftProjects A Q o r
