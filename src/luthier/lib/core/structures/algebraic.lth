-- Algebraic structures, stated over the carrier's Object (D-2026-10-17-b, -c).
-- Bite 6, Codex, 2026-10-20, from execution.md §3.3 at 2859815;
-- bare conjunctions: D-2026-10-18-f, spec 7.S22. References: Birkhoff, Lattice Theory
-- (1967), chapters I and II; Huntington (1904), Sets of independent postulates for the algebra
-- of logic. These are theories (planes 1 and 2, D-2026-10-18-c); models live in core.lut.
import "core/structures/equality.lth" Object
import "core/properties/operations.lth" Associative Commutative Neutral Invertible Distributive
  Absorbing Distinct Idempotent Absorptive Complemented

Semigroup (A : U) (o : Object A) : { combine : A -> A -> A }
Semigroup (A : U) (o : Object A) (m : Semigroup A o) := Associative A o m.combine
Monoid (A : U) (o : Object A) : { neutral : A, combine : A -> A -> A }
Monoid (A : U) (o : Object A) (m : Monoid A o) := Associative A o m.combine & Neutral A o m.combine m.neutral
CommutativeMonoid (A : U) (o : Object A) : { neutral : A, combine : A -> A -> A }
CommutativeMonoid (A : U) (o : Object A) (m : CommutativeMonoid A o) :=
  Associative A o m.combine & Neutral A o m.combine m.neutral & Commutative A A o m.combine
Group (A : U) (o : Object A) : { neutral : A, combine : A -> A -> A, inverse : A -> A }
Group (A : U) (o : Object A) (m : Group A o) :=
  Associative A o m.combine & Neutral A o m.combine m.neutral & Invertible A o m.combine m.neutral m.inverse
AbelianGroup (A : U) (o : Object A) : { neutral : A, combine : A -> A -> A, inverse : A -> A }
AbelianGroup (A : U) (o : Object A) (m : AbelianGroup A o) :=
  Group A o m & Commutative A A o m.combine
Semiring (A : U) (o : Object A) : { zero one : A, plus times : A -> A -> A }
Semiring (A : U) (o : Object A) (s : Semiring A o) :=
  CommutativeMonoid A o { neutral := s.zero, combine := s.plus }
  & Monoid A o { neutral := s.one, combine := s.times }
  & Distributive A o s.times s.plus & Absorbing A o s.times s.zero & Distinct A o s.one s.zero
Ring (A : U) (o : Object A) : { zero one : A, plus times : A -> A -> A, negate : A -> A }
Ring (A : U) (o : Object A) (r : Ring A o) :=
  Semiring A o { zero := r.zero, one := r.one, plus := r.plus, times := r.times }
  & Invertible A o r.plus r.zero r.negate
CommutativeRing (A : U) (o : Object A) : { zero one : A, plus times : A -> A -> A, negate : A -> A }
CommutativeRing (A : U) (o : Object A) (r : CommutativeRing A o) := Ring A o r & Commutative A A o r.times
Lattice (A : U) (o : Object A) : { meet join : A -> A -> A }
Lattice (A : U) (o : Object A) (l : Lattice A o) :=
  Associative A o l.meet & Associative A o l.join & Commutative A A o l.meet
  & Commutative A A o l.join & Idempotent A o l.meet & Idempotent A o l.join & Absorptive A o l.meet l.join
BooleanAlgebra (B : U) (o : Object B) : { top bottom : B, complement : B -> B, meet join : B -> B -> B }
BooleanAlgebra (B : U) (o : Object B) (b : BooleanAlgebra B o) :=
  Lattice B o { meet := b.meet, join := b.join }
  & Neutral B o b.meet b.top & Neutral B o b.join b.bottom
  & Distributive B o b.meet b.join & Distributive B o b.join b.meet
  & Complemented B o b.meet b.complement b.bottom & Complemented B o b.join b.complement b.top
  & Distinct B o b.top b.bottom
-- The algebra is self-dual; the kernel's if selects its top's first branch (3.S36).
TheBooleans : { algebra : BooleanAlgebra Bool (structural Bool) }
TopIsTheFirstBranch (b : TheBooleans) : Bool :=
  (if b.algebra.top then 1 else 0) == 1 and (if b.algebra.bottom then 1 else 0) == 0
TheBooleans (b : TheBooleans) := BooleanAlgebra Bool (structural Bool) b.algebra & TopIsTheFirstBranch b

-- The commutative unital quantale: a complete join-semilattice and a commutative monoid
-- whose tensor preserves ALL joins, including the empty join, in each variable.
-- Lawvere (1973), https://www.tac.mta.ca/tac/reprints/articles/1/tr1abs.html;
-- Rosenthal, Quantales and Their Applications (1990), chapter 2.
-- D-2026-10-18-i names four intended bases: error [0, infinity] with + and <=;
-- uncertainty, distribution functions with a t-norm; evidence [0, 1] with + or max;
-- resources, + in sequence and max in parallel. These name intended models, not claims:
-- an actual quantale must specify its order orientation, saturation and empty join. In
-- particular ordinary + and <= on nonnegative numbers do not preserve the empty join;
-- Lawvere uses the opposite order. No model of these four bases is asserted here.
Quantale (Q : U) (o : Object Q) : {
  neutral : Q, combine : Q -> Q -> Q, leq : Q -> Q -> Bool,
  supremum : (I : U) -> (I -> Q) -> Q }
JoinUpper (Q : U) (o : Object Q) (q : Quantale Q o) (I : U) (f : I -> Q) (i : I) : Bool := q.leq (f i) (q.supremum I f)
-- `upper` is a witness for every member, so the premise is genuinely universal, not a finite
-- sample mistaken for completeness. The declaration ranges over arbitrary I, including Empty.
JoinLeast (Q : U) (o : Object Q) (q : Quantale Q o) (I : U) (f : I -> Q) (b : Q)
          (upper : (i : I) -> { u : Unit | q.leq (f i) b }) : Bool := q.leq (q.supremum I f) b
TensorPreservesJoins (Q : U) (o : Object Q) (q : Quantale Q o) (I : U) (f : I -> Q) (x : Q) : Bool :=
  o.eq (q.combine x (q.supremum I f)) (q.supremum I (fn i { q.combine x (f i) }))
Quantale (Q : U) (o : Object Q) (q : Quantale Q o) :=
  CommutativeMonoid Q o { neutral := q.neutral, combine := q.combine }
  & PartialOrder Q o q.leq & JoinUpper Q o q & JoinLeast Q o q & TensorPreservesJoins Q o q

-- The Boolean implication primitive's truth table (classical Boolean algebra).
MaterialImplication (candidate : Bool -> Bool -> Bool) (p q : Bool) : Bool := candidate p q == (not p or q)
