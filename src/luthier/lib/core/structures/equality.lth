-- Equality and metric levels (D-2026-10-18-c), theories only.
-- Codex, bite 6, 2026-10-20, from execution.md §3.1 at 2859815; D-2026-10-17-f,
-- D-2026-10-18-f and the correction of D-2026-10-18-c. Mathematical references:
-- Frechet (1906), Sur quelques points du calcul fonctionnel, §I (metric axioms);
-- Lawvere (1973), Metric spaces, generalized logic, and closed categories;
-- Menger (1942), Statistical metrics (the probabilistic extension below).
import "core/properties/relations.lth" Equivalence Related Chain Reflexive Symmetric
import "core/properties/operations.lth" Commutative

Object (A : U) : { eq : A -> A -> Bool }
Object (A : U) (o : Object A) := Equivalence A o.eq
EqualPair (A : U) (o : Object A) = Related A o.eq
EqualChain (A : U) (o : Object A) = Chain A o.eq
hasStructuralEquality : U -> Bool
Concrete : U := { A : U | hasStructuralEquality A }
-- Structural models and their projections are constructed in core.lut (plane 3).
Structural (A : Concrete) : { eq : A -> A -> Bool }
Substitutive (A : Concrete) (s : Structural A) (B : Concrete) (f : A -> B) (p : Related A s.eq) : Bool := f p.x == f p.y
Structural (A : Concrete) (s : Structural A) := Equivalence A s.eq & Substitutive A s

Metric (A : U) (o : Object A) : { d : A -> A -> Float64 }
MetricZeroOnEqual (A : U) (o : Object A) (m : Metric A o) (p : EqualPair A o) : Bool := m.d p.x p.y == 0.0
MetricIndiscernible (A : U) (o : Object A) (m : Metric A o) (x y : A) : Bool := o.eq x y or not (m.d x y == 0.0)
Triangular (A : U) (d : A -> A -> Float64) (x y z : A) : Bool := d x z <= d x y + d y z
Ultratriangular (A : U) (d : A -> A -> Float64) (x y z : A) : Bool := d x z <= (if d x y <= d y z then d y z else d x y)
-- Non-negativity follows from the diagonal, symmetry and triangle; stated for the negative control.
MetricNonNegative (A : U) (d : A -> A -> Float64) (x y : A) : Bool := 0.0 <= d x y
Metric (A : U) (o : Object A) (m : Metric A o) :=
  MetricZeroOnEqual A o m & MetricIndiscernible A o m
  & Commutative A Float64 (structural Float64) m.d & Triangular A m.d & MetricNonNegative A m.d
Pseudometric (A : U) (o : Object A) : { d : A -> A -> Float64 }
Pseudometric (A : U) (o : Object A) (m : Pseudometric A o) :=
  MetricZeroOnEqual A o m & Commutative A Float64 (structural Float64) m.d & Triangular A m.d & MetricNonNegative A m.d
Quasimetric (A : U) (o : Object A) : { d : A -> A -> Float64 }
Quasimetric (A : U) (o : Object A) (m : Quasimetric A o) :=
  MetricZeroOnEqual A o m & MetricIndiscernible A o m & Triangular A m.d & MetricNonNegative A m.d
Ultrametric (A : U) (o : Object A) : { d : A -> A -> Float64 }
Ultrametric (A : U) (o : Object A) (m : Ultrametric A o) :=
  MetricZeroOnEqual A o m & MetricIndiscernible A o m
  & Commutative A Float64 (structural Float64) m.d & Ultratriangular A m.d & MetricNonNegative A m.d
NonNegativeFloat : U := { x : Float64 | 0.0 <= x }
Extended = { finiteDistance : NonNegativeFloat || infiniteDistance : Unit }
ExtendedMetric (A : U) (o : Object A) : { d : A -> A -> Extended }
-- Declared only, as execution.md §3.1 requests; no extended arithmetic or model is claimed.

Ball (A : U) (d : A -> A -> Float64) (radius : A -> A -> Float64) (x y : A) : Bool := d x y <= radius x y
-- An epsilon threshold gives a tolerance, not an equivalence (D-2026-10-18-c correction).
ToleranceRelation (A : U) : { relates : A -> A -> Bool }
ToleranceRelation (A : U) (t : ToleranceRelation A) := Reflexive A t.relates & Symmetric A t.relates
-- With Ultrametric's strong triangle the same threshold is also transitive.
UltrametricThreshold (A : U) (o : Object A) (m : Ultrametric A o) (epsilon : NonNegativeFloat) :=
  Equivalence A (MetricTolerance A m.d epsilon)

MetricWithin (A : U) (o : Object A) : { d bound : A -> A -> Float64 }
WithinZeroOnEqual (A : U) (o : Object A) (m : MetricWithin A o) (p : EqualPair A o) : Bool := Ball Float64 coreFloatDistance (fn x y { m.bound p.x p.y }) (m.d p.x p.y) 0.0
WithinSymmetric (A : U) (o : Object A) (m : MetricWithin A o) (x y : A) : Bool :=
  floatAbs (m.d x y - m.d y x) <= m.bound x y + m.bound y x
WithinTriangular (A : U) (o : Object A) (m : MetricWithin A o) (x y z : A) : Bool :=
  m.d x z <= m.d x y + m.d y z + m.bound x z + m.bound x y + m.bound y z
MetricWithin (A : U) (o : Object A) (m : MetricWithin A o) := WithinZeroOnEqual A o m & WithinSymmetric A o m & WithinTriangular A o m

-- [proposed] Menger's probabilistic level, declarations only; question 2 of
-- record/plan/three-levels-2026-10-18/report.md is still open. No stochastic model is claimed.
-- Source: Menger, Statistical metrics (1942); Schweizer and Sklar, Probabilistic Metric
-- Spaces (1983), chapters 2 and 8. Definition checked against the research paper
-- https://pmc.ncbi.nlm.nih.gov/articles/PMC4771691/ (2016), Definitions 1 and 2.
-- Distance distributions are LEFT-continuous: F(t) = P(distance < t), with F(0) = 0.
ProbabilityLevel : U := { p : Float64 | 0.0 <= p and p <= 1.0 }
TNorm : { tensor : ProbabilityLevel -> ProbabilityLevel -> ProbabilityLevel }
TNorm (t : TNorm) := Associative ProbabilityLevel (structural ProbabilityLevel) t.tensor
  & Commutative ProbabilityLevel ProbabilityLevel (structural ProbabilityLevel) t.tensor
  & Neutral ProbabilityLevel (structural ProbabilityLevel) t.tensor 1.0
  & MonotoneIn ProbabilityLevel (fn x y { x <= y }) t.tensor
DistanceDistribution : {
  cdf : Float64 -> ProbabilityLevel,
  tail : { p : ProbabilityLevel | p < 1.0 } -> NonNegativeFloat,
  below : (t : Float64) -> { p : ProbabilityLevel | p < cdf t } -> Float64 }
DistributionZero (f : DistanceDistribution) (t : { t : Float64 | t <= 0.0 }) : Bool := f.cdf t == 0.0
DistributionMonotone (f : DistanceDistribution) := Monotone Float64 ProbabilityLevel (fn x y { x <= y }) (fn x y { x <= y }) f.cdf
DistributionTail (f : DistanceDistribution) (p : { p : ProbabilityLevel | p < 1.0 }) (t : { t : Float64 | f.tail p <= t }) : Bool := p < f.cdf t
DistributionLeftContinuous (f : DistanceDistribution) (t : Float64) (p : { p : ProbabilityLevel | p < f.cdf t }) : Bool := f.below t p < t and p < f.cdf (f.below t p)
DistanceDistribution := DistributionZero & DistributionMonotone & DistributionTail & DistributionLeftContinuous
ProbabilisticMetric (A : U) (o : Object A) (t : TNorm) : {
  distribution : A -> A -> DistanceDistribution,
  separates : { x y : A | not (o.eq x y) } -> { s : Float64 | 0.0 < s } }
MengerDiagonal (A : U) (o : Object A) (t : TNorm) (m : ProbabilisticMetric A o t) (p : EqualPair A o) (s : Float64) : Bool :=
  (m.distribution p.x p.y).cdf s == (if s <= 0.0 then 0.0 else 1.0)
MengerSeparated (A : U) (o : Object A) (t : TNorm) (m : ProbabilisticMetric A o t) (p : { x y : A | not (o.eq x y) }) : Bool :=
  (m.distribution p.x p.y).cdf (m.separates p) < 1.0
MengerSymmetric (A : U) (o : Object A) (t : TNorm) (m : ProbabilisticMetric A o t) (x y : A) (s : Float64) : Bool :=
  (m.distribution x y).cdf s == (m.distribution y x).cdf s
MengerTriangle (A : U) (o : Object A) (t : TNorm) (m : ProbabilisticMetric A o t) (x y z : A) (s u : NonNegativeFloat) : Bool :=
  t.tensor ((m.distribution x y).cdf s) ((m.distribution y z).cdf u) <= (m.distribution x z).cdf (s + u)
MengerDistributions (A : U) (o : Object A) (t : TNorm) (m : ProbabilisticMetric A o t) (x y : A) := DistanceDistribution (m.distribution x y)
ProbabilisticMetric (A : U) (o : Object A) (t : TNorm) :=
  MengerDiagonal A o t & MengerSeparated A o t & MengerSymmetric A o t & MengerTriangle A o t & MengerDistributions A o t
