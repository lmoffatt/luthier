-- relations.lth: the properties of a binary relation, each said once over the type, the relation
-- and the pair or chain it qualifies, and the orders and the equivalence built from them.
--
-- Draft 0, 2026-10-17, by Claude Fable 5.1, an agent of the coordinating session, on the brief
-- record/plan/core-2026-10-17/prompt-bite-2.md (bite 2 of record/plan/core-2026-10-17/execution.md,
-- section 3.1). Sources: D-2026-10-17-b (the properties are generic laws over a relation or an
-- operation and the type's equality, said once; a structure is a conjunction of properties),
-- D-2026-10-17-c (the names: English adjectives without "is", the type first, then what is
-- qualified), spec 7.S12 (the pairs and chains a relation relates are drawn by their own
-- generators, said once), 3.S6 (a subtype passes where its type is expected), L9.14 (a law
-- without a refuted model is evidence of nothing).
--
-- Bite 6 revision, Codex, 2026-10-21, prompt-bite-6.md at 2859815:
-- Object now lives in structures/equality.lth. The cycle is between files, not definitions.
-- Structures and core.lut's kernel instances claim these generic properties across files.
-- D-2026-10-18-f makes composites bare conjunctions; the tester expands their independently
-- quantified parts (7.S22). Related and Chain supply witnesses for laws with premises (7.S12).

import "core/structures/equality.lth" Object

-- ---------------------------------------------------------------- the pairs a relation relates

-- The pairs and chains a relation relates, drawn by their generators, said once (7.S12). They
-- replace kernel_laws.lth's `EqualPair`, `EqualChain` and numbers.lth's `LeqPair`, `LeqChain`,
-- `LeqBoth`, one each per relation. `Both` is the pairs related both ways, for a law that needs
-- them as a premise rather than by the contrapositive.
Related (A : U) (r : A -> A -> Bool) : U := { x y : A | r x y }
Chain (A : U) (r : A -> A -> Bool) : U := { x y z : A | r x y and r y z }
Both (A : U) (r : A -> A -> Bool) : U := { x y : A | r x y and r y x }

-- ---------------------------------------------------------------- the properties

Reflexive (A : U) (r : A -> A -> Bool) (x : A) : Bool := r x x
Irreflexive (A : U) (r : A -> A -> Bool) (x : A) : Bool := not (r x x)
Symmetric (A : U) (r : A -> A -> Bool) (p : Related A r) : Bool := r p.y p.x
-- by its contrapositive over every pair: equal, or not related both ways
Antisymmetric (A : U) (o : Object A) (r : A -> A -> Bool) (x y : A) : Bool := o.eq x y or not (r x y and r y x)
Asymmetric (A : U) (r : A -> A -> Bool) (p : Related A r) : Bool := not (r p.y p.x)
Transitive (A : U) (r : A -> A -> Bool) (c : Chain A r) : Bool := r c.x c.z
Total (A : U) (r : A -> A -> Bool) (x y : A) : Bool := r x y or r y x

-- ---------------------------------------------------------------- the composites

-- D-2026-10-18-f: each partially applied conjunct quantifies its missing variables separately
-- (7.S22); these are statements, not Boolean computations on functions.
Equivalence (A : U) (r : A -> A -> Bool) := Reflexive A r & Symmetric A r & Transitive A r
Preorder (A : U) (r : A -> A -> Bool) := Reflexive A r & Transitive A r
PartialOrder (A : U) (o : Object A) (r : A -> A -> Bool) := Preorder A r & Antisymmetric A o r
TotalOrder (A : U) (o : Object A) (r : A -> A -> Bool) := PartialOrder A o r & Total A r
StrictOrder (A : U) (r : A -> A -> Bool) := Irreflexive A r & Asymmetric A r & Transitive A r
