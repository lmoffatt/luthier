-- The numpy implementation of the leaves of array.lut, the generators of its shapes, and the
-- certification of each leaf against the laws its declaration states. An array of numpy is a value
-- of `Vec` or `Mat` as it is (04 §6): nothing here converts. The leaves take their types, with the
-- laws, from array.lut (03 §3).

import "real"
import "real_python"
import "algebra"
import "array"

add          := extern "python:luthier.arrays.add"
sub          := extern "python:luthier.arrays.sub"
scale        := extern "python:luthier.arrays.scale"
dot          := extern "python:luthier.arrays.dot"
norm         := extern "python:luthier.arrays.norm"
total        := extern "python:luthier.arrays.total"
product      := extern "python:luthier.arrays.product"
minimum      := extern "python:luthier.arrays.minimum"
maximum      := extern "python:luthier.arrays.maximum"
outer        := extern "python:luthier.arrays.outer"
matVec       := extern "python:luthier.arrays.mat_vec"
matMul       := extern "python:luthier.arrays.mat_mul"
transpose    := extern "python:luthier.arrays.transpose"
trace        := extern "python:luthier.arrays.trace"
det          := extern "python:luthier.arrays.det"
frob         := extern "python:luthier.arrays.frob"
cond         := extern "python:luthier.arrays.cond"
solve        := extern "python:luthier.arrays.solve"
eigvalsSym   := extern "python:luthier.arrays.eigvals_sym"
invSqrtSym   := extern "python:luthier.arrays.inv_sqrt_sym"
retainedRank := extern "python:luthier.arrays.retained_rank"
pinvSym      := extern "python:luthier.arrays.pinv_sym"
pinvSqrtSym  := extern "python:luthier.arrays.pinv_sqrt_sym"
madd         := extern "python:luthier.arrays.madd"
msub         := extern "python:luthier.arrays.msub"
mscale       := extern "python:luthier.arrays.mscale"
hadamard     := extern "python:luthier.arrays.hadamard"
maxAbs       := extern "python:luthier.arrays.max_abs"
maxAbsMat    := extern "python:luthier.arrays.max_abs"
approxVec    := extern "python:luthier.arrays.approx"
approxMat    := extern "python:luthier.arrays.approx"

gen Dim := extern "python:luthier.arrays.gen_dim"
gen Dim2 := extern "python:luthier.arrays.gen_dim2"
gen VecOf := extern "python:luthier.arrays.gen_vec_of"
gen MatOf := extern "python:luthier.arrays.gen_mat_of"
gen MatRows := extern "python:luthier.arrays.gen_mat_rows"
gen SpdOf := extern "python:luthier.arrays.gen_spd_of"
gen Square := extern "python:luthier.arrays.gen_square"
gen SquareOf := extern "python:luthier.arrays.gen_square_of"
gen SymmetricSquare := extern "python:luthier.arrays.gen_symmetric"
gen DeficientOf := extern "python:luthier.arrays.gen_deficient_of"

-- The spectral leaves are compared with Jacobi's method written natively, whose cost grows as
-- n^5 in the interpreter: their tests stop at matrices of size 5 and 50 cases, which keeps each law
-- under a minute (at size 6 and 100 cases they took up to two, 2026-10-06).
test add with 100
test sub with 100
test scale with 100
test dot with 100
test norm with 100
test total with 100
test product with 100
test minimum with 100
test maximum with 100
test outer with 100
test matVec with 100
test matMul with 100
test transpose with 100
test trace with 100
test det with 30
test frob with 100
test cond with 100
test solve with 100
test eigvalsSym with 50 size 5
test invSqrtSym with 50 size 5
test retainedRank with 50 size 5
test pinvSym with 50 size 5
test pinvSqrtSym with 50 size 5
test madd with 50
test msub with 50
test mscale with 50
test hadamard with 50
test maxAbs with 100
test maxAbsMat with 100
test approxVec with 100
test approxMat with 100
