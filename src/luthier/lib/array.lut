-- Vectors and matrices. A vector of length n is a function from the n indices to the numbers,
-- `Fin n -> A`, and a matrix of m rows and n columns is `Fin m -> Fin n -> A` (04 §6, 06 §7). A
-- vector of any length carries its length: `{ n : Nat, f : Fin n -> A }`; its entries are `v.f k`
-- and its length `v.n`, and `(n, g)` builds one. An array of numpy is a value of these types as it
-- is: it crosses into Luthier without conversion, applying it is indexing, and a function written
-- in Luthier crosses into numpy as the array of its values.
--
-- The vectors of length n are the Euclidean space of dimension n, and a matrix is a linear map
-- with its table on the basis (07 §1-2). The operations numpy computes faster are leaves, declared
-- here with the laws that characterize them in their types; array_python.lut binds them to numpy
-- and certifies those laws on the leaves themselves. The laws of the structures they form together
-- (a vector space, a Euclidean space, linear maps) are algebra's, certified on the instances made of
-- these leaves in algebra_python.lut. What is native here: the types, the constructors, and a
-- definition of each operation written through the entries (`addDef`, `matVecDef`, the determinant
-- by Laplace, the spectrum by Jacobi). A law `...Agrees` says a leaf computes its native definition
-- within the rounding of the terms it sums: a corollary of the characterization, which certifies
-- the definition and tightens the tolerance (05 R10).

import "real"
import "algebra"

Vec (A : U) = { n : Nat, f : Fin n -> A }
Mat (A : U) = { m : Nat, n : Nat, f : Fin m -> Fin n -> A }

-- ---------------------------------------------------------------- shapes
Dim  : U := { n : Int | 1 <= n }
Dim2 : U := { n : Int | 2 <= n }
VecOf (k : Int) : U := { v : Vec Float64 | v.n == k }
MatOf (r c : Int) : U := { a : Mat Float64 | a.m == r and a.n == c }
MatRows (r : Int) : U := { a : Mat Float64 | a.m == r }
Square : U := { a : Mat Float64 | a.m == a.n }
SquareOf (k : Int) : U := { s : Square | s.m == k }
NonEmptyVec : U := { v : Vec Float64 | 1 <= v.n }

-- A matrix is symmetric when it is square and Symmetric, the law of algebra, as a function of its
-- two indices, judged by approx with a tolerance: exactly with 0, within rounding for a computed
-- matrix. It is then a symmetric bilinear form (a self-adjoint map): on the basis the form is the
-- entry function, and bilinearity carries the law from the basis to all vectors. What Jacobi's
-- method and the spectral theorem take, exactly.
symmetric (tol : Float64) (a : Mat Float64) : Bool :=
  if a.m == a.n then forallPairs a.m (Symmetric (Fin a.m) Float64 (approx tol) (\ i j { a.f i j })) else false
SymmetricSquare : U := { a : Square | symmetric 0.0 a }

-- ---------------------------------------------------------------- constructors
row (a : Mat Float64) (i : Fin a.m) : Vec Float64 := (a.n, a.f i)
last (v : NonEmptyVec) : Float64 := v.f (v.n - 1)
zeros (n : Nat) : Vec Float64 := (n, \ k { 0.0 })
ones (n : Nat) : Vec Float64 := (n, \ k { 1.0 })
identity (n : Nat) : Mat Float64 := (n, n, \ i j { if i == j then 1.0 else 0.0 })
append (v : Vec Float64) (x : Float64) : Vec Float64 := (v.n + 1, \ k { if k < v.n then v.f k else x })
head (v : Vec Float64) (k : { m : Nat | m <= v.n }) : Vec Float64 := (k, \ i { v.f i })     -- the first k entries
-- row i replaced by r; rows i and j exchanged
withRow (a : Mat Float64) (i : Fin a.m) (r : VecOf a.n) : Mat Float64 := (a.m, a.n, \ p q { if p == i then r.f q else a.f p q })
swapRows (a : Mat Float64) (i j : Fin a.m) : Mat Float64 :=
  (a.m, a.n, \ p q { if p == i then a.f j q else if p == j then a.f i q else a.f p q })

-- x^k, k products of x in a row (the doubles have no monoid: rational.lut)
pow (x : Float64) (k : Nat) : Float64 := powerWith Float64 (\ (a b : Float64) { a * b }) 1.0 x k

-- ---------------------------------------------------------------- the definitions
dotDef (x : Vec Float64) (y : VecOf x.n) : Float64 := sumTo x.n (\ k { x.f k * y.f k })
normDef (x : Vec Float64) : Float64 := sqrt (dotDef x x)
addDef (x : Vec Float64) (y : VecOf x.n) : Vec Float64 := (x.n, \ k { x.f k + y.f k })
subDef (x : Vec Float64) (y : VecOf x.n) : Vec Float64 := (x.n, \ k { x.f k - y.f k })
scaleDef (c : Float64) (x : Vec Float64) : Vec Float64 := (x.n, \ k { c * x.f k })
outerDef (x y : Vec Float64) : Mat Float64 := (x.n, y.n, \ i j { x.f i * y.f j })
matVecDef (a : Mat Float64) (x : VecOf a.n) : Vec Float64 := (a.m, \ i { sumTo a.n (\ j { a.f i j * x.f j }) })
matMulDef (a : Mat Float64) (b : MatRows a.n) : Mat Float64 := (a.m, b.n, \ i j { sumTo a.n (\ k { a.f i k * b.f k j }) })
transposeDef (a : Mat Float64) : Mat Float64 := (a.n, a.m, \ i j { a.f j i })
traceDef (a : Square) : Float64 := sumTo a.m (\ i { a.f i i })
maddDef (a : Mat Float64) (b : MatOf a.m a.n) : Mat Float64 := (a.m, a.n, \ i j { a.f i j + b.f i j })
msubDef (a : Mat Float64) (b : MatOf a.m a.n) : Mat Float64 := (a.m, a.n, \ i j { a.f i j - b.f i j })
mscaleDef (c : Float64) (a : Mat Float64) : Mat Float64 := (a.m, a.n, \ i j { c * a.f i j })
hadamardDef (a : Mat Float64) (b : MatOf a.m a.n) : Mat Float64 := (a.m, a.n, \ i j { a.f i j * b.f i j })
frobDef (a : Mat Float64) : Float64 := sqrt (sumTo a.m (\ i { sumTo a.n (\ j { a.f i j * a.f i j }) }))

-- the metric of the Euclidean space: the norm of the difference
distance (x : Vec Float64) (y : VecOf x.n) : Float64 := normDef (subDef x y)

-- the determinant by Laplace expansion along the first row; minor j drops row 0 and column j
sign (j : Int) : Float64 := if j mod 2 == 0 then 1.0 else 0.0 - 1.0
minor (a : { s : Square | 1 <= s.m }) (j : Fin a.n) : Mat Float64 :=
  (a.m - 1, a.n - 1, \ r c { a.f (r + 1) (if c < j then c else c + 1) })
detDef (a : Square) : Float64 :=
  if a.m <= 1 then (if a.m == 1 then a.f 0 0 else 1.0)
  else sumTo a.n (\ j { sign j * a.f 0 j * detDef (minor a j) })

-- ---------------------------------------------------------------- the spectrum, natively
-- Jacobi's method: a plane rotation J(p, q) chosen to zero the entry (p, q) of a symmetric A,
-- A <- J^T A J and V <- V J, in cyclic sweeps over all pairs until what is left off the diagonal
-- is below jacobiTol times the size of A. The diagonal is then the spectrum and V its vectors.
-- The rotation of Golub and Van Loan: with r = (A_qq - A_pp) / (2 A_pq), t = sign r /
-- (|r| + sqrt(r^2 + 1)) is the tangent of the smaller angle, c = 1 / sqrt(t^2 + 1), s = t c.
-- Written over the native definitions, not the leaves, so it does not depend on what it certifies.
jacobiTol : Float64 := eps
maxSweeps : Int := 30

rotation (n : Nat) (p q : Fin n) (c s : Float64) : Mat Float64 :=
  (n, n, \ i j {
    if i == p and j == p then c else if i == q and j == q then c
    else if i == p and j == q then s else if i == q and j == p then 0.0 - s
    else if i == j then 1.0 else 0.0 })

-- the size of what is off the diagonal, summed directly: frob^2 minus the diagonal would
-- cancel, and lose everything below sqrt(eps) of the matrix
offDiagonal (a : Mat Float64) : Float64 :=
  sqrt (sumTo a.m (\ i { sumTo a.n (\ j { if i == j then 0.0 else a.f i j * a.f i j }) }))

-- one rotation on the pair (p, q); a pair already zero is left alone
rotate (n : Nat) (p q : Fin n) (av : SquareOf n * SquareOf n) : SquareOf n * SquareOf n :=
  match av { (a, v) ->
  if a.f p q == 0.0 then (a, v)
  else match (a.f q q - a.f p p) / (2.0 * a.f p q) { r ->
       match (if r >= 0.0 then 1.0 else 0.0 - 1.0) / (abs r + sqrt (r * r + 1.0)) { t ->
       match 1.0 / sqrt (t * t + 1.0) { c ->
       match rotation n p q c (t * c) { j ->
       (matMulDef (transposeDef j) (matMulDef a j), matMulDef v j) } } } } }

-- a sweep: every pair p < q in order
sweepFrom (n : Nat) (p q : Nat) (av : SquareOf n * SquareOf n) : SquareOf n * SquareOf n :=
  if p + 1 >= n then av
  else if q >= n then sweepFrom n (p + 1) (p + 2) av
  else sweepFrom n p (q + 1) (rotate n p q av)

jacobi (n : Nat) (a0 : SquareOf n) (k : Int) (av : SquareOf n * SquareOf n) : SquareOf n * SquareOf n :=
  match av { (a, v) ->
  if k >= maxSweeps or offDiagonal a <= jacobiTol * frobDef a0 then av
  else jacobi n a0 (k + 1) (sweepFrom n 0 1 av) }

-- the diagonal of a square matrix, as a vector
diagonal (d : Square) : Vec Float64 := (d.m, \ i { d.f i i })

-- the spectrum and the vectors, unordered: column k of V belongs to entry k of the diagonal
eigenDef (a : SymmetricSquare) : Vec Float64 * (Mat Float64) :=
  match jacobi a.m a 0 (a, identity a.m) { (d, v) -> (diagonal d, v) }

-- ascending order, by rank: entry i goes to the number of entries before it in the order
rankIn (x : Vec Float64) (i : Fin x.n) : Int :=
  sumToInt x.n (\ j { if x.f j < x.f i or (x.f j == x.f i and j < i) then 1 else 0 })
sortedDef (x : Vec Float64) : Vec Float64 :=
  (x.n, \ k { sumTo x.n (\ i { if rankIn x i == k then x.f i else 0.0 }) })

eigvalsDef (a : SymmetricSquare) : Vec Float64 := match eigenDef a { (e, v) -> sortedDef e }

-- a function of a symmetric matrix through its spectrum: V diag(f lambda) V^T
spectralMap (f : Float64 -> Float64) (a : SymmetricSquare) : Mat Float64 :=
  match eigenDef a { (e, v) ->
    matMulDef (matMulDef v (e.n, e.n, \ i j { if i == j then f (e.f i) else 0.0 })) (transposeDef v) }

-- the retained subspace: eigenvalues above n eps times the largest in size
retainedFloor (a : SymmetricSquare) : Float64 :=
  match eigenDef a { (e, v) -> toFloat64 e.n * eps * fold NonNegative exactNonNegative largest e.n (\ k { abs (e.f k) }) }
retainedRankDef (a : SymmetricSquare) : Int :=
  match eigenDef a { (e, v) -> match retainedFloor a { fl -> sumToInt e.n (\ k { if e.f k > fl then 1 else 0 }) } }

invSqrtDef (a : SymmetricSquare) : Mat Float64 := spectralMap (\ x { 1.0 / sqrt x }) a
pinvDef (a : SymmetricSquare) : Mat Float64 := match retainedFloor a { fl -> spectralMap (\ x { if x > fl then 1.0 / x else 0.0 }) a }
pinvSqrtDef (a : SymmetricSquare) : Mat Float64 := match retainedFloor a { fl -> spectralMap (\ x { if x > fl then 1.0 / sqrt x else 0.0 }) a }

-- ---------------------------------------------------------------- matrices the laws quantify over
-- symmetric positive definite, and symmetric of rank below n; their predicates use the leaves, and
-- their values come from the generators of array_python.lut
SpdOf (n : Int) : U := { a : SymmetricSquare | a.m == n and minimum (eigvalsSym a) > 0.0 }
DeficientOf (n : Int) : U := { a : SymmetricSquare | a.m == n and retainedRank a < n }

-- the symmetric part of a square matrix, (A + A^T) / 2: exactly symmetric, and A itself when A is
symmetricPart (a : Square) : SymmetricSquare := (a.m, a.n, \ i j { 0.5 * (a.f i j + a.f j i) })

-- positive semidefinite within rounding: no eigenvalue below the rounding of the spectrum
positiveSemidefinite (a : SymmetricSquare) : Bool := minimum (eigvalsSym a) >= 0.0 - scaledTol (a.m * a.m) (frob a)

-- Hadamard's bound on the size of a determinant: the product of the norms of the rows
hadamardBound (a : Mat Float64) : Float64 :=
  foldWith Float64 (\ (a b : Float64) { a * b }) 1.0 a.m (\ i { norm (row a i) })

-- ---------------------------------------------------------------- derivatives
-- g is the gradient of f at t, on a space Theta that vectors move along by `shift`: the slope of f
-- along g(t), by central difference, equals |g(t)|. Step eps^(1/3), whose truncation and rounding
-- are both of order eps^(2/3); the tolerance sqrt eps leaves a margin of a hundred.
fdStep : Float64 := cbrt eps
fdTol  : Float64 := sqrt eps

IsGradient (Theta : U) (shift : Theta -> Vec Float64 -> Theta) (f : Theta -> Float64) (g : Theta -> Vec Float64) (t : Theta) : Bool :=
  match g t { v -> match norm v { nv ->
  if nv == 0.0 then true else
  match scale (fdStep / nv) v { h ->
  match (f (shift t h) - f (shift t (scale (0.0 - 1.0) h))) / (2.0 * fdStep) { slope ->
  approx (fdTol * (1.0 + abs (f t))) slope nv } } } }

-- ---------------------------------------------------------------- the laws of the leaves
-- Pointwise: the vector space of functions on the indices adds and scales entry by entry, so these
-- characterize their leaves, exactly.
AddPointwise (ad : Vec Float64 -> Vec Float64 -> Vec Float64) (n : Dim) (x y : VecOf n) : Bool := approxVec 0.0 (ad x y) (addDef x y)
SubPointwise (sb : Vec Float64 -> Vec Float64 -> Vec Float64) (n : Dim) (x y : VecOf n) : Bool := approxVec 0.0 (sb x y) (subDef x y)
ScalePointwise (sc : Float64 -> Vec Float64 -> Vec Float64) (n : Dim) (c : Float64) (x : VecOf n) : Bool := approxVec 0.0 (sc c x) (scaleDef c x)
OuterPointwise (o : Vec Float64 -> Vec Float64 -> Mat Float64) (m n : Dim) (x : VecOf m) (y : VecOf n) : Bool := approxMat 0.0 (o x y) (outerDef x y)
TransposePointwise (tr : Mat Float64 -> Mat Float64) (m n : Dim) (a : MatOf m n) : Bool := approxMat 0.0 (tr a) (transposeDef a)
MaddPointwise (f : Mat Float64 -> Mat Float64 -> Mat Float64) (m n : Dim) (a b : MatOf m n) : Bool := approxMat 0.0 (f a b) (maddDef a b)
MsubPointwise (f : Mat Float64 -> Mat Float64 -> Mat Float64) (m n : Dim) (a b : MatOf m n) : Bool := approxMat 0.0 (f a b) (msubDef a b)
MscalePointwise (f : Float64 -> Mat Float64 -> Mat Float64) (m n : Dim) (c : Float64) (a : MatOf m n) : Bool := approxMat 0.0 (f c a) (mscaleDef c a)
HadamardPointwise (f : Mat Float64 -> Mat Float64 -> Mat Float64) (m n : Dim) (a b : MatOf m n) : Bool := approxMat 0.0 (f a b) (hadamardDef a b)

-- the equalities within a tolerance: approx, the equality of Float64, entry by entry, and false on
-- arrays of different shapes
ApproxVecPointwise (av : Float64 -> Vec Float64 -> Vec Float64 -> Bool) (n : Dim) (tol : NonNegative) (x y : VecOf n) : Bool :=
  av tol x y == forallBelow x.n (\ k { approx tol (x.f k) (y.f k) })
ApproxVecLength (av : Float64 -> Vec Float64 -> Vec Float64 -> Bool) (n : Dim) (x : VecOf n) (y : VecOf (n + 1)) : Bool := not (av 1.0 x y)
ApproxMatPointwise (am : Float64 -> Mat Float64 -> Mat Float64 -> Bool) (m n : Dim) (tol : NonNegative) (a b : MatOf m n) : Bool :=
  am tol a b == forallBelow a.m (\ i { forallBelow a.n (\ j { approx tol (a.f i j) (b.f i j) }) })
ApproxMatShape (am : Float64 -> Mat Float64 -> Mat Float64 -> Bool) (m n : Dim) (a : MatOf m n) (b : MatOf m (n + 1)) : Bool := not (am 1.0 a b)

-- the inner product: its structure (symmetric, bilinear, positive, the basis orthonormal) is the
-- Euclidean instance of algebra_python; that it is the sum of the products follows, within rounding
DotAgrees (d : Vec Float64 -> Vec Float64 -> Float64) (n : Dim) (x y : VecOf n) : Bool :=
  approx (scaledTol n (norm x * norm y)) (d x y) (dotDef x y)
-- the norm and the total are the inner product's: |x| = sqrt <x, x>, total x = <x, ones>
NormOfInner (nm : Vec Float64 -> Float64) (n : Dim) (x : VecOf n) : Bool := approx (tolOf n) (nm x) (sqrt (dot x x))
TotalOfInner (t : Vec Float64 -> Float64) (n : Dim) (x : VecOf n) : Bool :=
  approx (scaledTol n (norm x * sqrt (toFloat64 n))) (t x) (dot x (ones n))
-- the product, by its recursion: one more factor multiplies it, and the empty product is one
ProductRecursion (p : Vec Float64 -> Float64) (n : Dim) (x : VecOf n) (a : Float64) : Bool :=
  approx (tolOf (n + 1)) (p (append x a)) (p x * a)
ProductOfNone (p : Vec Float64 -> Float64) : Bool := p (zeros 0) == 1.0

-- the largest of n values: an upper bound that is one of them
GreatestOf (n : Int) (f : Fin n -> Float64) (m : Float64) : Bool := forallBelow n (\ k { f k <= m }) and existsBelow n (\ k { f k == m })
IsMaximum (mx : Vec Float64 -> Float64) (n : Dim) (x : VecOf n) : Bool := GreatestOf x.n x.f (mx x)
IsMinimum (mn : Vec Float64 -> Float64) (n : Dim) (x : VecOf n) : Bool := GreatestOf x.n (\ k { 0.0 - x.f k }) (0.0 - mn x)
IsMaxAbs (ma : Vec Float64 -> Float64) (n : Dim) (x : VecOf n) : Bool := GreatestOf x.n (\ k { abs (x.f k) }) (ma x)
IsMaxAbsMat (ma : Mat Float64 -> Float64) (m n : Dim) (a : MatOf m n) : Bool :=
  GreatestOf (a.m * a.n) (\ c { abs (a.f (c / a.n) (c mod a.n)) }) (ma a)

-- a matrix acting: its structure (linear, composing as the product, adjoint as the transpose) is
-- the instance of linear maps in algebra_python; its table on the basis is the matrix, and a linear
-- map is determined by its values on a basis
MatVecTable (mv : Mat Float64 -> Vec Float64 -> Vec Float64) (m n : Dim) (a : MatOf m n) (j : Fin n) : Bool :=
  approxVec 0.0 (mv a (row (identity n) j)) (m, \ i { a.f i j })
MatVecAgrees (mv : Mat Float64 -> Vec Float64 -> Vec Float64) (m n : Dim) (a : MatOf m n) (x : VecOf n) : Bool :=
  approxVec (scaledTol n (frob a * norm x)) (mv a x) (matVecDef a x)
MatMulAgrees (mm : Mat Float64 -> Mat Float64 -> Mat Float64) (m k n : Dim) (a : MatOf m k) (b : MatOf k n) : Bool :=
  approxMat (scaledTol k (frob a * frob b)) (mm a b) (matMulDef a b)

-- the trace: additive, cyclic, n on the identity; a linear functional with these is the trace
TraceAdditive (t : Mat Float64 -> Float64) (n : Dim) (a b : MatOf n n) : Bool :=
  Homomorphism (MatOf n n) Float64 (approx (scaledTol n (frob a + frob b))) (\ p q { madd p q }) (\ p q { p + q }) t a b
TraceCyclic (t : Mat Float64 -> Float64) (m n : Dim) (a : MatOf m n) (b : MatOf n m) : Bool :=
  approx (scaledTol (m * n) (frob a * frob b)) (t (matMul a b)) (t (matMul b a))
TraceOfIdentity (t : Mat Float64 -> Float64) (n : Dim) : Bool := t (identity n) == toFloat64 n
TraceAgrees (t : Mat Float64 -> Float64) (n : Dim) (a : MatOf n n) : Bool := approx (scaledTol n (frob a)) (t a) (traceDef a)

-- The determinant: linear in each row, alternating, one on the identity; the unique such function.
-- Its rounding is bounded by n^3 eps times Hadamard's bound.
DetMultilinear (dt : Mat Float64 -> Float64) (n : Dim) (a : MatOf n n) (i : Fin n) (u v : VecOf n) : Bool :=
  approx (scaledTol (n * n * n) (hadamardBound (withRow a i u) + hadamardBound (withRow a i v)))
    (dt (withRow a i (add u v))) (dt (withRow a i u) + dt (withRow a i v))
DetAlternating (dt : Mat Float64 -> Float64) (n : Dim) (a : MatOf n n) (i j : Fin n) : Bool :=
  i == j or approx (scaledTol (n * n * n) (hadamardBound a)) (dt (swapRows a i j)) (0.0 - dt a)
DetOfIdentity (dt : Mat Float64 -> Float64) (n : Dim) : Bool := dt (identity n) == 1.0
-- Laplace has n! terms, so the definition is only evaluated up to laplaceLimit
laplaceLimit : Int := 4
DetAgrees (dt : Mat Float64 -> Float64) (n : Dim) (a : MatOf n n) : Bool :=
  n > laplaceLimit or approx (scaledTol (factorial n) (pow (frob a) n)) (dt a) (detDef a)

-- the Frobenius norm: the square root of the trace of A^T A
FrobOfTrace (f : Mat Float64 -> Float64) (m n : Dim) (a : MatOf m n) : Bool :=
  approx (tolOf (m * n)) (f a) (sqrt (trace (matMul (transpose a) a)))
FrobAgrees (f : Mat Float64 -> Float64) (m n : Dim) (a : MatOf m n) : Bool := approx (tolOf (m * n)) (f a) (frobDef a)

-- solving: A (solve A b) = b, unique on a nonsingular A
SolveInverts (sv : Mat Float64 -> Vec Float64 -> Vec Float64) (n : Dim) (s : SpdOf n) (x : VecOf n) : Bool :=
  approxVec (cond s * tolOf (n * n)) (matVec s (sv s x)) x

-- The spectrum of a symmetric matrix, ascending. Its sum is the trace and its product the
-- determinant; returning only the values, these do not determine it (07 §3), and agreement with
-- Jacobi's spectrum is the law that does, here.
Ascending (ev : Mat Float64 -> Vec Float64) (n : Dim) (s : SpdOf n) : Bool :=
  match ev s { e -> forallBelow (e.n - 1) (\ k { e.f k <= e.f (k + 1) }) }
EigenvaluesSumToTrace (ev : Mat Float64 -> Vec Float64) (n : Dim) (s : SpdOf n) : Bool :=
  approx (scaledTol n (frob s)) (total (ev s)) (trace s)
EigenvaluesMultiplyToDet (ev : Mat Float64 -> Vec Float64) (n : Dim) (s : SpdOf n) : Bool :=
  approx (cond s * tolOf (n * n)) (product (ev s)) (det s)
EigvalsAgree (ev : Mat Float64 -> Vec Float64) (n : Dim) (s : SpdOf n) : Bool :=
  approxVec (scaledTol (n * n) (frob s)) (ev s) (eigvalsDef s)
-- the condition number of a symmetric positive definite matrix: its largest eigenvalue over its smallest
CondOfSpectrum (c : Mat Float64 -> Float64) (n : Dim) (s : SpdOf n) : Bool :=
  match eigvalsSym s { e -> match maximum e / minimum e { k -> approx (tolOf (n * n) * k) (c s) k } }

-- the inverse square root of a symmetric positive definite A: the M symmetric positive definite
-- with M A M = I, which is unique
spectralTol (s : Mat Float64) : Float64 := cond s * scaledTol (s.m * s.m) (frob s)
InvSqrtInverts (m : Mat Float64 -> Mat Float64) (n : Dim) (s : SpdOf n) : Bool :=
  approxMat (cond s * tolOf (n * n)) (matMul (m s) (matMul s (m s))) (identity n)
InvSqrtPositive (m : Mat Float64 -> Mat Float64) (n : Dim) (s : SpdOf n) : Bool :=
  match m s { r -> if r.m == r.n then symmetric (cond s * tolOf (n * n)) r and minimum (eigvalsSym (symmetricPart r)) > 0.0 else false }
InvSqrtAgrees (m : Mat Float64 -> Mat Float64) (n : Dim) (s : SpdOf n) : Bool := approxMat (spectralTol s) (m s) (invSqrtDef s)

-- The pseudo-inverse P of a symmetric A on its retained subspace: Moore-Penrose, A P A = A,
-- P A P = P, A P and P A symmetric; unique. Within the rounding of the retained spectrum.
singularTol (s : SymmetricSquare) : Float64 := scaledTol (s.m * s.m) (frob s) * (1.0 + frob s * frob (pinvDef s))
MoorePenrose (pv : Mat Float64 -> Mat Float64) (n : Dim2) (s : DeficientOf n) : Bool :=
  match pv s { p -> match singularTol s { tol ->
  approxMat tol (matMul s (matMul p s)) s and approxMat tol (matMul p (matMul s p)) p
  and approxMat tol (matMul s p) (transpose (matMul s p)) and approxMat tol (matMul p s) (transpose (matMul p s)) } }
PinvAgrees (m : Mat Float64 -> Mat Float64) (n : Dim2) (s : DeficientOf n) : Bool := approxMat (singularTol s) (m s) (pinvDef s)
-- its square root: M symmetric positive semidefinite with M A M the projector A P
PinvSqrtProjects (m : Mat Float64 -> Mat Float64) (n : Dim2) (s : DeficientOf n) : Bool :=
  match m s { r -> approxMat (singularTol s) (matMul r (matMul s r)) (matMul s (pinvSym s))
                   and (if r.m == r.n then symmetric (singularTol s) r and positiveSemidefinite (symmetricPart r) else false) }
PinvSqrtAgrees (m : Mat Float64 -> Mat Float64) (n : Dim2) (s : DeficientOf n) : Bool := approxMat (singularTol s) (m s) (pinvSqrtDef s)
-- the rank retained: the trace of the projector A P
RankOfProjector (r : Mat Float64 -> Int) (n : Dim2) (s : DeficientOf n) : Bool := r s == round (trace (matMul s (pinvSym s)))
RankAgrees (r : Mat Float64 -> Int) (n : Dim2) (s : DeficientOf n) : Bool := r s == retainedRankDef s

-- ---------------------------------------------------------------- the leaves
add   : { f : Vec Float64 -> Vec Float64 -> Vec Float64 | AddPointwise f }
sub   : { f : Vec Float64 -> Vec Float64 -> Vec Float64 | SubPointwise f }
scale : { f : Float64 -> Vec Float64 -> Vec Float64 | ScalePointwise f }
dot   : { f : Vec Float64 -> Vec Float64 -> Float64 | DotAgrees f }
norm  : { f : Vec Float64 -> Float64 | NormOfInner f }
total : { f : Vec Float64 -> Float64 | TotalOfInner f }
product : { f : Vec Float64 -> Float64 | ProductRecursion f & ProductOfNone f }
minimum : { f : Vec Float64 -> Float64 | IsMinimum f }
maximum : { f : Vec Float64 -> Float64 | IsMaximum f }
maxAbs  : { f : Vec Float64 -> Float64 | IsMaxAbs f }

outer     : { f : Vec Float64 -> Vec Float64 -> Mat Float64 | OuterPointwise f }
matVec    : { f : Mat Float64 -> Vec Float64 -> Vec Float64 | MatVecTable f & MatVecAgrees f }
matMul    : { f : Mat Float64 -> Mat Float64 -> Mat Float64 | MatMulAgrees f }
transpose : { f : Mat Float64 -> Mat Float64 | TransposePointwise f }
trace     : { f : Mat Float64 -> Float64 | TraceAdditive f & TraceCyclic f & TraceOfIdentity f & TraceAgrees f }
det       : { f : Mat Float64 -> Float64 | DetMultilinear f & DetAlternating f & DetOfIdentity f & DetAgrees f }
frob      : { f : Mat Float64 -> Float64 | FrobOfTrace f & FrobAgrees f }
cond      : { f : Mat Float64 -> Float64 | CondOfSpectrum f }
solve        : { f : Mat Float64 -> Vec Float64 -> Vec Float64 | SolveInverts f }
eigvalsSym   : { f : Mat Float64 -> Vec Float64 | Ascending f & EigenvaluesSumToTrace f & EigenvaluesMultiplyToDet f & EigvalsAgree f }
invSqrtSym   : { f : Mat Float64 -> Mat Float64 | InvSqrtInverts f & InvSqrtPositive f & InvSqrtAgrees f }
retainedRank : { f : Mat Float64 -> Int | RankOfProjector f & RankAgrees f }
pinvSym      : { f : Mat Float64 -> Mat Float64 | MoorePenrose f & PinvAgrees f }
pinvSqrtSym  : { f : Mat Float64 -> Mat Float64 | PinvSqrtProjects f & PinvSqrtAgrees f }

madd      : { f : Mat Float64 -> Mat Float64 -> Mat Float64 | MaddPointwise f }
msub      : { f : Mat Float64 -> Mat Float64 -> Mat Float64 | MsubPointwise f }
mscale    : { f : Float64 -> Mat Float64 -> Mat Float64 | MscalePointwise f }
hadamard  : { f : Mat Float64 -> Mat Float64 -> Mat Float64 | HadamardPointwise f }          -- entrywise product
maxAbsMat : { f : Mat Float64 -> Float64 | IsMaxAbsMat f }

-- Functions have no structural equality (05 R8): arrays compare entry by entry with approx.
approxVec : { f : Float64 -> Vec Float64 -> Vec Float64 -> Bool | ApproxVecPointwise f & ApproxVecLength f }
approxMat : { f : Float64 -> Mat Float64 -> Mat Float64 -> Bool | ApproxMatPointwise f & ApproxMatShape f }

-- ---------------------------------------------------------------- operators
-- The arithmetic of vectors and matrices written with + - *: each operator is resolved by the
-- types of its two operands, and falls back to the arithmetic of Int and Float64 when none applies.
operator + := add
operator - := sub
operator * := scale        -- Float64 * Vec
operator + := madd
operator - := msub
operator * := mscale       -- Float64 * Mat
operator * := matVec       -- Mat * Vec
operator * := matMul       -- Mat * Mat
