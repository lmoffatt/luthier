-- Algebraic structures as types with laws, and their instances.
--
-- Each law is written once, in its most general form, and every structure is built from the ones
-- below it: a group is a monoid with inverses, a ring an abelian group and a monoid joined by
-- distributivity, a field a commutative ring with inverses. A structure is the invariant of the
-- values that have its type. Every structure carries its own equality, a Setoid, because what
-- "equal" means depends on the carrier: exact on Int, within rounding on Float64, entrywise within
-- rounding on arrays. The operation comes first and the quantified variables last, so a partial
-- application is the predicate a test fills.
--
-- Floating point is a setoid only up to a tolerance that depends on the magnitude of the values;
-- transitivity fails at that scale and is not stated. The instances over Int, Float64 and Bool are
-- here, with the folds over the indices they give (a sum, a power, a quantifier); the instances
-- over the arrays live in algebra_python.lut, where the leaves and the generators are bound.

import "real"
import "laws"

-- an equality: reflexive and symmetric; transitive too on an exact carrier, not stated (see above)
Setoid (A : U) : U := { eq : A -> A -> Bool | Reflexive A eq & Symmetric A Bool (\ (p q : Bool) { p == q }) eq }

TotalOrder (A : U) (eq : Setoid A) : U := { le : A -> A -> Bool | Total A le & Antisymmetric A eq le & Transitive A le }

-- ---------------------------------------------------------------- isomorphism
-- Two maps that undo each other, each side judged by its own equality.
Iso (A B : U) : U := {
  eqA  : A -> A -> Bool
  eqB  : B -> B -> Bool
  to   : A -> B
  from : B -> A
  |
  \ (a : A) { eqA (from (to a)) a } & \ (b : B) { eqB (to (from b)) b } }

-- ---------------------------------------------------------------- monoid, group, ring, field
Monoid (A : U) (eq : Setoid A) : U := {
  op   : A -> A -> A
  unit : A
  |
  Associative A A eq op op & LeftIdentity A A eq op unit & RightIdentity A eq op unit }

Group (A : U) (eq : Setoid A) : U := {
  monoid : Monoid A eq
  inv    : A -> A
  |
  LeftInverse A eq monoid.op monoid.unit inv & RightInverse A eq monoid.op monoid.unit inv }

AbelianGroup (A : U) (eq : Setoid A) : U := { g : Group A eq | Symmetric A A eq g.monoid.op }

-- the additive group is `add`, its zero `add.monoid.unit` and its negation `add.inv`; the
-- multiplicative monoid is `mul`, its one `mul.unit`
Ring (A : U) : U := {
  eq  : Setoid A
  add : AbelianGroup A eq
  mul : Monoid A eq
  |
  LeftDistrib A A eq add.monoid.op mul.op & RightDistrib A A A eq add.monoid.op add.monoid.op mul.op }

CommutativeRing (A : U) : U := { r : Ring A | Symmetric A A r.eq r.mul.op }

-- every element but zero has an inverse
Invertible (A : U) (eq : A -> A -> Bool) (mul : A -> A -> A) (zero one : A) (inv : A -> A) (x : A) : Bool :=
  eq x zero or eq (mul x (inv x)) one

Field (A : U) : U := {
  ring : CommutativeRing A
  inv  : A -> A
  |
  Invertible A ring.eq ring.mul.op ring.add.monoid.unit ring.mul.unit inv }

-- ---------------------------------------------------------------- the real numbers
-- An ordered field: a field with a total order its operations respect. Complete: every set that
-- is bounded above has a least upper bound, the set given by its predicate and the bound by `sup`.
-- That `sup S` is an upper bound of S is a universal law; that it is the least one needs an
-- existential (below any smaller bound there is a member of S), which the laws of version 0 do not
-- state: it is named here and holds by the axiom below, not by these conjuncts.
AddMonotone (A : U) (le : A -> A -> Bool) (add : A -> A -> A) (x y z : A) : Bool := le x y -> le (add x z) (add y z)
MulPositive (A : U) (le : A -> A -> Bool) (mul : A -> A -> A) (zero : A) (x y : A) : Bool :=
  le zero x -> le zero y -> le zero (mul x y)
SupIsUpperBound (A : U) (le : A -> A -> Bool) (sup : (A -> Bool) -> A) (s : A -> Bool) (x : A) : Bool :=
  s x -> le x (sup s)

OrderedField (A : U) : U := {
  field : Field A
  le    : TotalOrder A field.ring.eq
  |
  AddMonotone A le field.ring.add.monoid.op & MulPositive A le field.ring.mul.op field.ring.add.monoid.unit }

CompleteOrderedField (A : U) : U := {
  ordered : OrderedField A
  sup     : (A -> Bool) -> A
  |
  SupIsUpperBound A ordered.le sup }

-- The reals are assumed, not tested: nothing computes their operations (06 §3). Code that runs
-- computes with Float64, which refines Real as a set and approximates its operations.
realField : CompleteOrderedField Real := axiom "the real numbers: the complete ordered field"

-- ---------------------------------------------------------------- vector space over a field
-- The field acts on V: associatively and with its one as identity (an action of its
-- multiplicative monoid), by additive maps, and additively in the scalar.
VectorSpace (K : U) (F : Field K) (V : U) : U := {
  eq    : Setoid V
  add   : AbelianGroup V eq
  scale : K -> V -> V
  |
  Associative K V eq F.ring.mul.op scale & LeftIdentity K V eq scale F.ring.mul.unit
  & LeftDistrib K V eq add.monoid.op scale
  & RightDistrib K V V eq F.ring.add.monoid.op add.monoid.op scale }

-- ---------------------------------------------------------------- inner product space
-- positive: the form of a vector with itself is above zero unless the vector is zero
PositiveForm (K V : U) (le : K -> K -> Bool) (zeroK : K) (eqV : V -> V -> Bool) (zeroV : V) (ip : V -> V -> K) (x : V) : Bool :=
  eqV x zeroV or not (le (ip x x) zeroK)

-- Over an ordered field: a symmetric bilinear form (additive and homogeneous in the first
-- argument, hence in both by symmetry) that is positive.
InnerProductSpace (K : U) (F : OrderedField K) (V : U) : U := {
  space : VectorSpace K F.field V
  inner : V -> V -> K
  |
  Symmetric V K F.field.ring.eq inner
  & RightDistrib V V K F.field.ring.eq space.add.monoid.op F.field.ring.add.monoid.op inner
  & Homogeneous K V K F.field.ring.eq space.scale F.field.ring.mul.op inner
  & PositiveForm K V F.le F.field.ring.add.monoid.unit space.eq space.add.monoid.unit inner }

-- ---------------------------------------------------------------- Euclidean space
-- An inner product space with n orthonormal vectors: their Gram matrix is the identity. With V of
-- dimension n they are a basis, and the inner product is then the sum of the products of the
-- coordinates (theorem); the dimension of V is not stated by these laws.
Orthonormal (I V K : U) (eqK : K -> K -> Bool) (ip : V -> V -> K) (e : I -> V) (delta : I -> I -> K) (i j : I) : Bool :=
  eqK (ip (e i) (e j)) (delta i j)

Euclidean (K : U) (F : OrderedField K) (V : U) (n : Int) : U := {
  space : InnerProductSpace K F V
  basis : Fin n -> V
  |
  Orthonormal (Fin n) V K F.field.ring.eq space.inner basis
    (\ i j { if i == j then F.field.ring.mul.unit else F.field.ring.add.monoid.unit }) }

-- ---------------------------------------------------------------- linear maps on an inner product space
-- Matrices as the maps: `apply` is an action of the monoid (`compose`, `id`) by linear maps, and
-- `adjoint` is the transpose, characterized by the inner product.
AdjointOfInner (K V M : U) (eqK : K -> K -> Bool) (ip : V -> V -> K) (ap : M -> V -> V) (adj : M -> M) (a : M) (x y : V) : Bool :=
  eqK (ip (ap a x) y) (ip x (ap (adj a) y))

LinearMaps (K : U) (F : OrderedField K) (V M : U) : U := {
  on      : InnerProductSpace K F V
  apply   : M -> V -> V
  compose : M -> M -> M
  id      : M
  adjoint : M -> M
  |
  Associative M V on.space.eq compose apply & LeftIdentity M V on.space.eq apply id
  & LeftDistrib M V on.space.eq on.space.add.monoid.op apply
  & CommutingActions M K V on.space.eq apply on.space.scale
  & AdjointOfInner K V M F.field.ring.eq on.inner apply adjoint }

-- ---------------------------------------------------------------- instances
-- exact equalities: reflexive and symmetric on these carriers
exactBool : Setoid Bool := \ (p q : Bool) { p == q }
exactInt  : Setoid Int := \ (a b : Int) { a == b }
exactNonNegative : Setoid NonNegative := \ (a b : NonNegative) { a == b }

-- Int, exact
intRing : CommutativeRing Int := {
  eq  := exactInt,
  add := { monoid := { op := \ (a b : Int) { a + b }, unit := 0 }, inv := \ (a : Int) { 0 - a } },
  mul := { op := \ (a b : Int) { a * b }, unit := 1 } }

-- Float64 is not a field: under cancellation no fixed relative tolerance makes its addition
-- associative ((1e8 + -1e8) + 3e-9 is 3e-9, 1e8 + (-1e8 + 3e-9) is 0), and a box of magnitudes is not
-- closed under its operations. What the doubles are is in rational.lut: operations that round the
-- exact ones on the rationals, certified at every scale, with the bounds of sums that follow. The
-- sums and products of the doubles below are folds of their operations, with no laws claimed.

-- Bool under and, and under or; the nonnegative doubles under the larger of two
allOf : Monoid Bool exactBool := { op := and, unit := true }
anyOf : Monoid Bool exactBool := { op := or, unit := false }
largest : Monoid NonNegative exactNonNegative := { op := \ a b { if a > b then a else b }, unit := 0.0 }

-- ---------------------------------------------------------------- folds over the indices
-- The product of a monoid over n terms, associated to the right: f 0 op (f 1 op (... op (f (n - 1)
-- op unit))). A sum, a maximum, a power and a quantifier over the indices are each one of these.
-- The order is part of the rounding of a sum (04 §6).
-- foldWith is the fold of any operation and unit, with no law: what the doubles have.
foldWithFrom (A : U) (op : A -> A -> A) (unit : A) (n : Int) (lo : Nat) (f : Fin n -> A) : A :=
  if lo >= n then unit else op (f lo) (foldWithFrom A op unit n (lo + 1) f)
foldWith (A : U) (op : A -> A -> A) (unit : A) (n : Int) (f : Fin n -> A) : A := foldWithFrom A op unit n 0 f
fold (A : U) (eq : Setoid A) (M : Monoid A eq) (n : Int) (f : Fin n -> A) : A := foldWith A M.op M.unit n f

power (A : U) (eq : Setoid A) (M : Monoid A eq) (a : A) (k : Nat) : A := fold A eq M k (\ i { a })
powerWith (A : U) (op : A -> A -> A) (unit : A) (a : A) (k : Nat) : A := foldWith A op unit k (\ i { a })

-- the sum of n doubles, associated to the right; rational.lut certifies it within gamma n of the
-- exact sum (sumToRounds)
sumTo (n : Int) (f : Fin n -> Float64) : Float64 := foldWith Float64 (\ (a b : Float64) { a + b }) 0.0 n f
sumToInt (n : Int) (f : Fin n -> Int) : Int := fold Int exactInt intRing.add.monoid n f
factorial (n : Int) : Int := fold Int exactInt intRing.mul n (\ i { i + 1 })

-- a law over every index, or every pair of indices, below n: the universal closure, evaluated
forallBelow (n : Int) (p : Fin n -> Bool) : Bool := fold Bool exactBool allOf n p
existsBelow (n : Int) (p : Fin n -> Bool) : Bool := fold Bool exactBool anyOf n p
forallPairs (n : Int) (p : Fin n -> Fin n -> Bool) : Bool := forallBelow n (\ i { forallBelow n (p i) })
