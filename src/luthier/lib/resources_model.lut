-- §1; the coordinator's correction to D-2026-10-18-i (2026-10-23). Its laws run in
-- tests/tester/resources_laws.test.lut, with a control per conjunct.

import "resources.lth" Resources ResourceAlgebra largerCount

-- work adds in both; the span adds in sequence and takes the larger in parallel; the peak memory takes
-- the larger in sequence and adds in parallel; nothing spent is zero in every part
workSpanMemory : ResourceAlgebra := {
  none := { work := 0, span := 0, memory := 0 },
  sequence := fn r s { { work := r.work + s.work, span := r.span + s.span, memory := largerCount r.memory s.memory } },
  parallel := fn r s { { work := r.work + s.work, span := largerCount r.span s.span, memory := r.memory + s.memory } },
}
WorkSpanMemoryIsAResourceAlgebra (model : ResourceAlgebra <- workSpanMemory) : Bool := ResourceAlgebra model
