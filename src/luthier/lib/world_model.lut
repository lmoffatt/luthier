-- world_model.lut: the first model of the world: a representation, the console's actions described
-- over it, and the host's actions as externs, held to the console's descriptions.
--
-- Draft 1, 2026-10-13, by Claude Fable 5.1 in the session (step 6.1; draft 0 at 1f8c61c). 2026-10-15,
-- by Claude Fable 5.1, an agent of the coordinating session, on record/IA/layer-3-review-2026-10-15/
-- prompt-fix-host.md: the host carries the console and no description of its own (W1, M1). The
-- representation `State` is what the host observes of the world at the places it is asked for:
-- the standard output, and the files at the paths observed (10.S5: the library gives the
-- representation and the observations). `observe w places` reads those places from the world; a
-- path with no file is absent from `files`, so `readFile` of it gives `nothing`, and so does a path
-- not observed. `console` describes `print` and `readFile` over it, pure functions that world.lth's
-- laws test by sampling `State` (tests/tester/world_laws.lut); `host` is the actions themselves,
-- routes to host functions (10.S8), held to `console`'s descriptions (world.lth §4,
-- `printDescription`, `readFileDescription`, `observeDescription`) by the laws of `Host` over the
-- cases `agreement` gathers along one chain of tokens (world.lth §5).

import "world.lth" World Console Host appendStr lineOf

-- the representation: the standard output so far, and the files by path
State = { stdout : String, files : List (String * String) }
lookupFile (fs : List (String * String)) (p : String) : Maybe String :=
  match fs { nil -> nothing ; cons (q, c) rest -> if p == q then just c else lookupFile rest p }

-- the observable world: what is read at a place of the representation
theWorld : World State := {
  read := fn st p { if p == "stdout" then just st.stdout else lookupFile st.files p },
}

-- the console, by its descriptions: `print` appends a line to the standard output and changes
-- nothing else; `readFile` gives what is at the path and changes nothing. The standard output's
-- place is `stdout`, the one `theWorld.read` answers from `st.stdout`; world.lth's descriptions
-- of the host's actions read it from here.
console : Console State := {
  world := theWorld,
  printLine := fn s st { ({ stdout := appendStr st.stdout (lineOf s), files := st.files }, unit) },
  readFile := fn p st { (st, lookupFile st.files p) },
  stdout := "stdout",
}

-- The host's actions, routes to Python. The token comes first and a token goes back (10.S5: a new
-- one each time, in the abstraction; the Python hands back the object it was given, which is one
-- implementation of it, since no program compares tokens). `observe w places` reads the files at
-- `places` from the disk and the standard output when "stdout" is among them, from the text
-- `print` has written so far (host.py): the observer reads what the host itself wrote there, and
-- the terminal gets that text when the run ends. That is what world.lth's `ObserverIsFaithful`
-- assumes of this model, an entry of its store that is an assumption or a citation of host.py,
-- never a case. `Host`'s laws hold each action to the console's description; run.py validates an
-- action at its first application in a run (10.S10, L11.2), the case gathered by `agreement`, and
-- keeps the entry in world_model.cert.json.
HostConsole = Host State
host : HostConsole := {
  console := console,
  observe := extern "python:luthier.host.observe",
  print := extern "python:luthier.host.print_line",
  readFile := extern "python:luthier.host.read_file",
}
