-- kernel_models.lut: the core's types as models of the structures of kernel_laws.lth.
--
-- Draft 0, 2026-10-13, by Claude Opus 5.5 in the session (step 2.1; §7 of kernel_laws.lth). Each
-- value below says which known structure a core type or a kernel form is (L2.7,
-- D-2026-10-13-t). The models of core's data (`Unit`, `Empty`, `Bool`, `Maybe`, `List`) moved to
-- core.lut on 2026-10-14 (D-2026-10-14-b), where their data are defined. They are certified against their
-- theories like any model (spec 7); a law that quantifies over maps or monoids gets them from a
-- census (7.R4). A model file holds models of theories (12.S23); these are the kernel's own.

import "kernel_laws.lth" Object Concrete Structural
  OrderedSemiring Exponential Product NamedProduct NamedCoproduct Selected one two

-- the structural equality of every concrete type is an object (D-2026-10-12-ak, 4.R8)
structuralEquality (A : Concrete) : Structural A := { eq := fn x y { x == y } }

-- `Unit`, `Empty`, `Bool`, `Maybe` and `List` are claimed in core.lut, where they are defined
-- (D-2026-10-14-b); their models moved there.

-- `Nat` is an ordered commutative semiring (11.R1)
naturals : OrderedSemiring Nat := {
  zero := 0, one := 1,
  plus := fn a b { a + b },
  times := fn a b { a * b },
  leq := fn a b { a <= b },
}

-- the kernel's application, pairing and match are the exponential, the product and the coproduct
-- (3.S8, 3.S36); on `Bool` and `Maybe` the coproduct is core.lut's
application (A B : U) : Exponential A B := { apply := fn f x { f x } }
pairs (A B : U) : Product A B (A * B) := {
  pair := fn a b { (a, b) },
  first := fn p { match p { (a, b) -> a } },
  second := fn p { match p { (a, b) -> b } },
}
-- a record type is a named product: `.x` and `.y` its projections (D-2026-10-13-x); a labeled sum a
-- named coproduct, its labels the injections. Instances on the labels `x`, `y` and `a`, `b`.
recordXY (A B : U) : NamedProduct A B { x : A, y : B } := {
  pair := fn u v { { x := u, y := v } },
  first := fn r { r.x }, second := fn r { r.y },
  firstName := "x", secondName := "y",
  select := fn n r { if n == "x" then just (one r.x) else if n == "y" then just (two r.y) else nothing },
}
sumAB (A B : U) : NamedCoproduct A B { a : A || b : B } := {
  left := fn u { a u }, right := fn v { b v },
  cases := fn (C : U) f g s { match s { a u -> f u ; b v -> g v } },
  leftName := "a", rightName := "b",
  labelOf := fn s { match s { a u -> "a" ; b v -> "b" } },
}
