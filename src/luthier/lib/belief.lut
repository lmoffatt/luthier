-- Belief: a state of knowledge about a parameter, and the update that data makes to it.
--
-- There is one concept, not two. "Prior" and "posterior" are the same belief seen before and
-- after an update; which is which depends only on where the cursor stands in the sequence of
-- data. A family of beliefs is a type of states with an update by one datum and the log
-- predictive of that datum (the increment of the log evidence). The cursor `after` folds the
-- update over a list of data: the prior is `after u b []`.
--
-- The likelihood defines the update. Exact Bayes multiplies the belief by it and renormalises;
-- a family that is not closed under that multiplication approximates it, and how much it
-- departs is measured by the same laws the exact update satisfies:
--   Exchangeable          data independent given theta update in any order to the same belief
--   EvidenceChains        log p(y1) + log p(y2 | y1) = log p(y2) + log p(y1 | y2)
--   Calibrated (discrete) theta drawn from the belief, data from the sampler at theta: the
--                         updated belief ranks theta uniformly
--
-- Two families. `Discrete`, a finite support with log weights: closed under the exact update,
-- the reference. `GaussianBelief` in information form, a mean and a precision: its update is
-- Laplace's, the maximum of the log posterior and the information there, and the maximizer is
-- an argument. A precision with zero eigenvalues is an improper belief that knows nothing along
-- those directions, which is how the gauge of the positions enters without inventing a scale.

import "real"
import "algebra"
import "random"
import "array"
import "probability"

LogLik (Theta Y : U) = Y -> Theta -> Float64

-- ---------------------------------------------------------------- a family of beliefs
BeliefFamily (Theta B Y : U) = {
  update     : B -> Y -> B                -- the belief after one datum
  predictive : B -> Y -> Float64                -- log p(y | b): the increment of the log evidence
  draw       : B -> Int -> Theta * Int    -- a parameter drawn from the belief, and the next seed
  same       : Setoid B                   -- two beliefs that say the same thing
  }

-- the cursor: the belief after a list of data
after (Theta B Y : U) (f : BeliefFamily Theta B Y) (b : B) (ys : List Y) : B :=
  match ys { nil -> b ; cons y rest -> after Theta B Y f (f.update b y) rest }

-- two data from the same parameter, itself drawn from the belief
twoData (Theta B Y : U) (f : BeliefFamily Theta B Y) (s : Sampler Theta Y) (b : B) (seed : Int) : Y * Y :=
  match f.draw b seed { (t, s1) -> match s t s1 { (y1, s2) -> match s t s2 { (y2, s3) -> (y1, y2) } } }

-- ---------------------------------------------------------------- the laws of an update
Exchangeable (Theta B Y : U) (f : BeliefFamily Theta B Y) (s : Sampler Theta Y) (b : B) (seed : Int) : Bool :=
  match twoData Theta B Y f s b seed { (y1, y2) ->
  f.same (f.update (f.update b y1) y2) (f.update (f.update b y2) y1) }

-- the log evidence of two data, accumulated in either order
evidenceTol : Float64 := sqrt eps
EvidenceChains (Theta B Y : U) (f : BeliefFamily Theta B Y) (s : Sampler Theta Y) (b : B) (seed : Int) : Bool :=
  match twoData Theta B Y f s b seed { (y1, y2) ->
  match f.update b y1 { b1 -> match f.update b y2 { b2 ->
  approx evidenceTol (f.predictive b y1 + f.predictive b1 y2) (f.predictive b y2 + f.predictive b2 y1) } } }

-- ---------------------------------------------------------------- discrete beliefs
-- n support points given by index, and unnormalised log weights
Discrete (Theta : U) = { size : Int, point : Int -> Theta, logw : Vec Float64 }

logSumExp (v : Vec Float64) : Float64 := match maximum v { m -> m + log (sumTo v.n (\ k { exp (v.f k - m) })) }

weights (Theta : U) (b : Discrete Theta) : Vec Float64 :=
  match logSumExp b.logw { z -> (b.size, \ k { exp (b.logw.f k - z) }) }

bayes (Theta Y : U) (l : LogLik Theta Y) (b : Discrete Theta) (y : Y) : Discrete Theta :=
  { size := b.size, point := b.point, logw := (b.size, \ k { b.logw.f k + l y (b.point k) }) }

logPredictive (Theta Y : U) (l : LogLik Theta Y) (b : Discrete Theta) (y : Y) : Float64 :=
  logSumExp (bayes Theta Y l b y).logw - logSumExp b.logw

-- a uniform number in [0, 1) from the seed, with Luthier's own generator
uniform01 (s : Int) : Float64 * Int := match randBelow 1073741824 s { (k, s2) -> (toFloat64 k / 1073741824.0, s2) }

-- the index where the cumulative weight first passes u, searching from k, which starts at 0 and only
-- grows (an Int would let k be negative, where w.f k has no value)
indexAt (w : Vec Float64) (u : Float64) (k : Nat) (acc : Float64) : Int :=
  if k >= w.n - 1 then k
  else if acc + w.f k > u then k
  else indexAt w u (k + 1) (acc + w.f k)

drawIndex (Theta : U) (b : Discrete Theta) (seed : Int) : Int * Int :=
  match uniform01 seed { (u, s2) -> (indexAt (weights Theta b) u 0 0.0, s2) }

discreteFamily (Theta Y : U) (l : LogLik Theta Y) : BeliefFamily Theta (Discrete Theta) Y := {
  update := bayes Theta Y l,
  predictive := logPredictive Theta Y l,
  draw := \ b seed { match drawIndex Theta b seed { (k, s2) -> (b.point k, s2) } },
  same := \ b c { approxVec (tolOf b.size) (weights Theta b) (weights Theta c) } }

-- Calibration of a discrete update. Draw an atom k from the belief, data at its point, and
-- update; the randomized rank u = W(< k) + v W(k) of the drawn atom under the updated weights
-- W, with v uniform, is uniform on [0, 1] for the exact update (UniformDraws).
rankOf (Theta Y : U) (l : LogLik Theta Y) (s : Sampler Theta Y) (b : Discrete Theta) (seed : Int) : Float64 * Int :=
  match drawIndex Theta b seed { (k, s1) ->
  match s (b.point k) s1 { (y, s2) ->
  match weights Theta (bayes Theta Y l b y) { w ->
  match uniform01 s2 { (v, s3) ->
  match sumTo k (\ j { w.f j }) + v * w.f k { u -> (u, s3) } } } } }

Calibrated (Theta Y : U) (e : Ensemble) (l : LogLik Theta Y) (s : Sampler Theta Y) (b : Discrete Theta) (seed : Int) : Bool :=
  UniformDraws e (\ q { match rankOf Theta Y l s b q { (u, next) -> ((1, \ k { u }), next) } }) seed

-- ---------------------------------------------------------------- Gaussian beliefs
-- Information form, on the vectors of a dimension n: the mean and the precision, the inverse
-- covariance, an n x n matrix. Zero precision along a direction is a belief that knows nothing there.
-- The log density is up to a constant.
GaussianBelief (n : Int) = { mean : VecOf n, precision : MatOf n n }

gaussianLogDensity (n : Nat) (b : GaussianBelief n) (t : VecOf n) : Float64 :=
  match t - b.mean { d -> 0.0 - 0.5 * dot d (b.precision * d) }

-- A maximizer works on the vectors of a dimension n: it takes the log posterior, its gradient, a
-- positive step matrix and a start, and returns where it stopped and whether it converged there; it
-- evaluates the functions only at vectors of that dimension, which their types say. A method with a
-- budget can run out of it before the gradient vanishes, and says so. Levenberg-Marquardt is one;
-- what any maximizer must satisfy (it ascends, and where it says it converged the gradient vanishes)
-- is stated in optimization.lut, and certified for each maximizer on its problems.
MaxResult (n : Int) = { x : VecOf n, converged : Bool }
Maximizer = (n : Nat) -> (VecOf n -> Float64) -> (VecOf n -> Vec Float64) -> (VecOf n -> Mat Float64) -> VecOf n -> MaxResult n

-- Laplace's update: the new mean is the maximum of belief times likelihood, the new precision
-- the prior precision plus the information the likelihood reports there. The step matrix is
-- the same sum, positive wherever the posterior is proper.
laplaceMode (n : Nat) (Y : U) (maximize : Maximizer) (l : Likelihood (VecOf n) Y) (b : GaussianBelief n) (y : Y) : MaxResult n :=
  maximize n (\ t { gaussianLogDensity n b t + l.loglik y t })
             (\ t { l.score y t - b.precision * (t - b.mean) })
             (\ t { b.precision + l.info y t })
             b.mean
-- the Gaussian belief at a mode m: mean m, precision the prior's plus the information there
laplaceAt (n : Nat) (Y : U) (l : Likelihood (VecOf n) Y) (b : GaussianBelief n) (y : Y) (m : VecOf n) : GaussianBelief n :=
  { mean := m, precision := b.precision + l.info y m }
laplaceUpdate (n : Nat) (Y : U) (maximize : Maximizer) (l : Likelihood (VecOf n) Y) (b : GaussianBelief n) (y : Y) : GaussianBelief n :=
  laplaceAt n Y l b y (laplaceMode n Y maximize l b y).x

-- ---------------------------------------------------------------- the Gaussian family
-- log det of a symmetric positive definite matrix, from its spectrum
logDet (m : Mat Float64) : Float64 := match eigvalsSym m { e -> sumTo e.n (\ k { log (e.f k) }) }

-- Laplace's evidence for one datum: the log of the integral of belief times likelihood, from
-- the second-order expansion at the new mean m' with the new precision P':
--   log p(y | b) = l(y; m') - 1/2 (m' - m)^T P (m' - m) + 1/2 log det P - 1/2 log det P'
-- It needs a proper belief: P positive definite.
laplaceEvidence (n : Nat) (Y : U) (maximize : Maximizer) (l : Likelihood (VecOf n) Y) (b : GaussianBelief n) (y : Y) : Float64 :=
  match laplaceUpdate n Y maximize l b y { b2 -> match b2.mean - b.mean { d ->
  l.loglik y b2.mean - 0.5 * dot d (b.precision * d) + 0.5 * logDet b.precision - 0.5 * logDet b2.precision } }

-- a draw from a proper Gaussian belief: mean + P^{-1/2} z
drawGaussian (n : Nat) (b : GaussianBelief n) (seed : Int) : VecOf n * Int :=
  match normalVec n seed { (z, s2) -> (b.mean + invSqrtSym b.precision * z, s2) }

-- the distance between the means of two Gaussian beliefs, in standard deviations of the first;
-- measured both ways, it makes `same` a symmetric relation
meanGap (n : Nat) (a c : GaussianBelief n) : Float64 := match a.mean - c.mean { d -> sqrt (dot d (a.precision * d)) }

gaussianFamily (n : Nat) (Y : U) (maximize : Maximizer) (l : Likelihood (VecOf n) Y) (tol : Float64) : BeliefFamily (VecOf n) (GaussianBelief n) Y := {
  update := laplaceUpdate n Y maximize l,
  predictive := laplaceEvidence n Y maximize l,
  draw := drawGaussian n,
  same := \ a c { meanGap n a c < tol and meanGap n c a < tol and approxMat tol a.precision c.precision } }

-- ---------------------------------------------------------------- approximations that converge
-- An approximate update departs from the exact laws by an amount that must vanish as the data
-- become informative. With sigma the error of the data, a departure of order q falls by 2^q
-- when sigma is halved; but only in the asymptotic regime, and where that regime starts depends
-- on the geometry. So the law searches for it: from sigma it halves repeatedly, estimating the
-- order from each halving, until two consecutive estimates agree within settleTol. That
-- settled estimate must be at least q - orderMargin. The estimates approach their limit like
-- 1 - c sigma, changing less at each halving, so settling is asked at a quarter of the margin
-- of the verdict: a sequence still moving by the margin has not reached its limit. The search stops without a verdict when the
-- departure falls below the floor the computation can resolve, and fails when it has not
-- stabilized after maxHalvings: a departure that never settles to its order is structural.
orderMargin : Float64 := 0.1
settleTol : Float64 := orderMargin / 4.0
maxHalvings : Int := 12

observedOrder (d1 d2 : Float64) : Float64 := log (d1 / d2) / log 2.0

-- the order the departure settles to below sigma, or a negative number if it never settles
settledOrder (departure : Float64 -> Int -> Float64) (floor : Float64) (sigma : Float64) (seed : Int) (depth : Int) (d1 d2 : Float64) (last : Float64) : Float64 :=
  if d2 < floor then last
  else match departure (sigma / 2.0) seed { d3 ->
       if d3 < floor then last
       else match observedOrder d2 d3 { o ->
            if abs (o - last) < settleTol then o
            else if depth >= maxHalvings then 0.0 - 1.0
            else settledOrder departure floor (sigma / 2.0) seed (depth + 1) d2 d3 o } }

ConvergesAtOrder (q : Float64) (floor : Float64) (departure : Float64 -> Int -> Float64) (sigma : Float64) (seed : Int) : Bool :=
  match departure sigma seed { d1 -> match departure (sigma / 2.0) seed { d2 ->
  if d1 < floor or d2 < floor then true
  else settledOrder departure floor (sigma / 2.0) seed 1 d1 d2 (observedOrder d1 d2) > q - orderMargin } }

-- the two departures of an update from the exact laws, in natural units
exchangeDeparture (Theta B Y : U) (f : BeliefFamily Theta B Y) (s : Sampler Theta Y) (b : B) (gap : B -> B -> Float64) (seed : Int) : Float64 :=
  match twoData Theta B Y f s b seed { (y1, y2) ->
  gap (f.update (f.update b y1) y2) (f.update (f.update b y2) y1) }

evidenceDeparture (Theta B Y : U) (f : BeliefFamily Theta B Y) (s : Sampler Theta Y) (b : B) (seed : Int) : Float64 :=
  match twoData Theta B Y f s b seed { (y1, y2) ->
  abs ((f.predictive b y1 + f.predictive (f.update b y1) y2) - (f.predictive b y2 + f.predictive (f.update b y2) y1)) }

-- Calibration of a Gaussian update. Draw theta from the belief, data at theta, update, and
-- project on a direction v drawn at random: u = Phi(v^T (theta - m') / sqrt(v^T P'^{-1} v)) is
-- uniform on [0, 1] when the updated belief is the posterior (UniformDraws).
projectedRank (n : Nat) (Y : U) (f : BeliefFamily (VecOf n) (GaussianBelief n) Y) (s : Sampler (VecOf n) Y) (b : GaussianBelief n) (seed : Int) : Float64 * Int :=
  match f.draw b seed { (t, s1) ->
  match s t s1 { (y, s2) ->
  match f.update b y { b2 ->
  match normalVec t.n s2 { (v, s3) ->
  (normalCdf (dot v (t - b2.mean) / sqrt (dot v (solve b2.precision v))), s3) } } } }

CalibratedGaussian (n : Nat) (Y : U) (e : Ensemble) (f : BeliefFamily (VecOf n) (GaussianBelief n) Y) (s : Sampler (VecOf n) Y) (b : GaussianBelief n) (seed : Int) : Bool :=
  UniformDraws e (\ q { match projectedRank n Y f s b q { (u, next) -> ((1, \ k { u }), next) } }) seed
