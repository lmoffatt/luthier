-- Python's math as the implementation of the functions real.lut declares.

import "real"

abs := extern "python:builtins.abs"
ulp : Float64 -> Float64 := extern "python:math.ulp"
sqrt : Float64 -> Float64 := extern "python:math.sqrt"
cbrt : Float64 -> Float64 := extern "python:math.cbrt"
exp : Float64 -> Float64 := extern "python:math.exp"
log : Float64 -> Float64 := extern "python:math.log"
erf : Float64 -> Float64 := extern "python:math.erf"
round : Float64 -> Int := extern "python:builtins.round"

test abs with 100
