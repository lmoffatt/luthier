-- Python's math as the implementation of the functions real.lut declares.

import "real"

abs : R -> R := extern "python:builtins.abs"
toR : Int -> R := extern "python:builtins.float"
ulp : R -> R := extern "python:math.ulp"
sqrtR : R -> R := extern "python:math.sqrt"
cbrtR : R -> R := extern "python:math.cbrt"
expR : R -> R := extern "python:math.exp"
logR : R -> R := extern "python:math.log"
erfR : R -> R := extern "python:math.erf"
roundR : R -> Int := extern "python:builtins.round"
