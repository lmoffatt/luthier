import "numbers.lth" Tolerance within abs absDistance Positive Elementary Doubles
import "numbers_model.lut" elementary : Elementary
import "laws.lth" Law Within Case

-- ---------------------------------------------------------------- §1 The types (11.S9)

-- spec 11.S9: an array of length n is a function on the n indices; a vector carries its length,
-- a matrix its two
Array (A : U) (n : Nat) = Fin n -> A
Vec (A : U) = { n : Nat, f : Fin n -> A }
Mat (A : U) = { m : Nat, n : Nat, f : Fin m -> Fin n -> A }
-- the constructors: a vector from its length and its entries, a matrix from its shape and its
-- entries (v0.1 wrote the pair `(n, fn k { ... })`; a record is not a pair, D-2026-10-13-x)
vec (A : U) (n : Nat) (f : Fin n -> A) : Vec A := { n := n, f := f }
mat (A : U) (m n : Nat) (f : Fin m -> Fin n -> A) : Mat A := { m := m, n := n, f := f }

-- the shapes (v0.1 array.lut:26-33)
Dim : U := { n : Int | 1 <= n }
VecOf (k : Int) : U := { v : Vec Float64 | v.n == k }
MatOf (r c : Int) : U := { a : Mat Float64 | a.m == r and a.n == c }
MatRows (r : Int) : U := { a : Mat Float64 | a.m == r }
Square : U := { a : Mat Float64 | a.m == a.n }

-- [core bite 11, 2026-10-21, execution.md §3.4 and §6] The container structures of the core
-- (core/structures/containers.lth), claimed here where the types are defined (L2.8), so that
-- `size v`, `at v k`, `map g v` resolve at `Vec Float64` by the type (D-2026-10-18-b). A vector
-- is indexed by `Fin n`, a matrix row-major by `Fin (m * n)` with its two-index `f` kept.
vecIndexed (A : U) : Indexed (Vec A) A := { size := fn (v : Vec A) { v.n }, at := fn (v : Vec A) k { v.f k } }
vecMap (A B : U) (g : A -> B) (v : Vec A) : Vec B := vec B v.n (fn k { g (v.f k) })
vecFold (A M : U) (op : M -> M -> M) (e : M) (g : A -> M) (v : Vec A) : M := foldWith M op e v.n (fn k { g (v.f k) })
vecObject (A : Concrete) : Object (Vec A) := pointwise (Vec A) A (vecIndexed A) (structural A)
matAt (A : U) (a : Mat A) (k : Fin (a.m * a.n)) : A := a.f (k / a.n) (k mod a.n)
matIndexed (A : U) : Indexed (Mat A) A := { size := fn (a : Mat A) { a.m * a.n }, at := matAt A }
matMap (A B : U) (g : A -> B) (a : Mat A) : Mat B := mat B a.m a.n (fn i j { g (a.f i j) })
-- two matrices are equal when their shapes and their entries are: the row-major index alone does
-- not see the shape (a 2 x 3 and a 3 x 2 matrix can have the same six entries in the same order)
sameShape (A B : U) (a : Mat A) (b : Mat B) : Bool := a.m == b.m and a.n == b.n
matObject (A : Concrete) : Object (Mat A) :=
  { eq := fn a b { if sameShape A A a b then sameEntries (Mat A) A (matIndexed A) (structural A) a b else false } }
-- the matrices of one shape, where the row-major index is extensional
MatShaped (A : U) (r c : Nat) : U := { a : Mat A | a.m == r and a.n == c }
VecIsIndexed (A : Concrete) (model : Indexed (Vec A) A <- vecIndexed A) : Bool := Indexed (Vec A) A model
VecIsAnObject (A : Concrete) (model : Object (Vec A) <- vecObject A) : Bool := Object (Vec A) model
VecIsAFunctor (model : Functor Vec <- { map := vecMap }) : Bool := Functor Vec model
VecIsFoldable (model : Foldable Vec <- { fold := vecFold }) : Bool := Foldable Vec model
VecIsTabulated (A : Concrete) (model : Tabulated (Vec A) A <- { build := vec A }) : Bool := Tabulated (Vec A) A model (vecIndexed A)
MatIsIndexed (A : Concrete) (r c : Nat) (model : Indexed (MatShaped A r c) A <- matIndexed A) : Bool := Indexed (MatShaped A r c) A model
MatIsAnObject (A : Concrete) (model : Object (Mat A) <- matObject A) : Bool := Object (Mat A) model
MatIsAFunctor (model : Functor Mat <- { map := matMap }) : Bool := Functor Mat model

-- symmetric exactly: what the spectral leaves take (the host reads one triangle). The equalizer
-- of the identity and the transpose (universal.lth's `Equalizer`; execution.md §5.1): the
-- matrices on which the two agree, included in `Mat Float64` as they are. Named
-- `SymmetricMatrix` since the core's `Symmetric` is the property of a relation (D-2026-10-18-b).
SymmetricMatrix : U := { a : Mat Float64 | (matObject Float64).eq a (transposeDef a) }
SymmetricOf (k : Int) : U := { s : SymmetricMatrix | s.m == k }
SymmetricIsAnEqualizer
  (model : Equalizer (Mat Float64) (Mat Float64) SymmetricMatrix (matObject Float64) (matObject Float64) (matObject Float64) (id (Mat Float64)) transposeDef
    <- { include := fn s { s }, restrict := fn a { a } }) : Bool :=
  Equalizer (Mat Float64) (Mat Float64) SymmetricMatrix (matObject Float64) (matObject Float64) (matObject Float64) (id (Mat Float64)) transposeDef model
ArrayContainers := VecIsIndexed & VecIsAnObject & VecIsAFunctor & VecIsFoldable & VecIsTabulated
  & MatIsIndexed & MatIsAnObject & MatIsAFunctor & SymmetricIsAnEqualizer

-- ---------------------------------------------------------------- §2 Folds over the indices

-- the fold of an operation with a unit over n terms, associated to the right:
-- `f 0 op (f 1 op (... op (f (n - 1) op unit)))`; no law claimed of the operation (v0.1
-- algebra.lut `foldWith`): what the doubles have, since they are not a monoid (11.S15)
-- the sum of the magnitudes of n terms: the scale a rounded sum is compared at (11.S14)
absSumTo (n : Int) (f : Fin n -> Float64) : Float64 := sumTo n (fn k { abs (f k) })

-- ---------------------------------------------------------------- §3 The native definitions

-- vectors (v0.1 array.lut:49-54, 78)
zeros (n : Nat) : Vec Float64 := vec Float64 n (fn k { 0.0 })
ones (n : Nat) : Vec Float64 := vec Float64 n (fn k { 1.0 })
-- the j-th vector of the basis
basis (n : Nat) (j : Fin n) : Vec Float64 := vec Float64 n (fn k { if k == j then 1.0 else 0.0 })
dotDef (x : Vec Float64) (y : VecOf x.n) : Float64 := sumTo x.n (fn k { x.f k * y.f k })
normDef (x : Vec Float64) : Float64 := elementary.sqrt (dotDef x x)
addDef (x : Vec Float64) (y : VecOf x.n) : Vec Float64 := vec Float64 x.n (fn k { x.f k + y.f k })
subDef (x : Vec Float64) (y : VecOf x.n) : Vec Float64 := vec Float64 x.n (fn k { x.f k - y.f k })
scaleDef (c : Float64) (x : Vec Float64) : Vec Float64 := vec Float64 x.n (fn k { c * x.f k })
-- the metric of the Euclidean space: the norm of the difference (v0.1 array.lut:78)
distance (x : Vec Float64) (y : VecOf x.n) : Float64 := normDef (subDef x y)

-- matrices (v0.1 array.lut:51, 55-67)
identity (n : Nat) : Mat Float64 := mat Float64 n n (fn i j { if i == j then 1.0 else 0.0 })
zeroMat (m n : Nat) : Mat Float64 := mat Float64 m n (fn i j { 0.0 })
diagonal (d : Vec Float64) : Mat Float64 := mat Float64 d.n d.n (fn i j { if i == j then d.f i else 0.0 })
row (a : Mat Float64) (i : Fin a.m) : Vec Float64 := vec Float64 a.n (a.f i)
column (a : Mat Float64) (j : Fin a.n) : Vec Float64 := vec Float64 a.m (fn i { a.f i j })
matVecDef (a : Mat Float64) (x : VecOf a.n) : Vec Float64 := vec Float64 a.m (fn i { sumTo a.n (fn j { a.f i j * x.f j }) })
matMulDef (a : Mat Float64) (b : MatRows a.n) : Mat Float64 :=
  mat Float64 a.m b.n (fn i j { sumTo a.n (fn k { a.f i k * b.f k j }) })
transposeDef (a : Mat Float64) : Mat Float64 := mat Float64 a.n a.m (fn i j { a.f j i })
maddDef (a : Mat Float64) (b : MatOf a.m a.n) : Mat Float64 := mat Float64 a.m a.n (fn i j { a.f i j + b.f i j })
msubDef (a : Mat Float64) (b : MatOf a.m a.n) : Mat Float64 := mat Float64 a.m a.n (fn i j { a.f i j - b.f i j })
mscaleDef (c : Float64) (a : Mat Float64) : Mat Float64 := mat Float64 a.m a.n (fn i j { c * a.f i j })
-- the trace of a square matrix, the sum of its diagonal in the order of 3.S27 (v0.1 array.lut:70)
traceDef (a : Square) : Float64 := sumTo a.m (fn i { a.f i i })
-- the Frobenius norm, the root of the sum of the squares of the entries (v0.1 array.lut:75); a
-- bound on every eigenvalue in magnitude, which is what the pseudo-inverse's laws use it for
frobDef (a : Mat Float64) : Float64 := elementary.sqrt (sumTo a.m (fn i { sumTo a.n (fn j { a.f i j * a.f i j }) }))
-- the pseudo-inverse of a diagonal matrix at a floor: one over each entry above the floor times
-- the largest in magnitude, zero elsewhere (negative entries are never retained, as retainedRank
-- counts them)
pinvOfDiagonal (fl : RankFloor) (d : Vec Float64) : Mat Float64 :=
  { big := foldWith Float64 (fn a b { if a > b then a else b }) 0.0 d.n (fn k { abs (d.f k) })
    diagonal (vec Float64 d.n (fn k { if d.f k > fl * big then 1.0 / d.f k else 0.0 })) }

-- Functions have no structural equality (4.R8): arrays compare entry by entry, and differ when
-- their shapes do. [core bite 11, execution.md §5.1] Each comparison is a ball of the core
-- (`entrywiseBall`, containers; `Ball`, equality.lth) of numbers.lth's `absDistance`, entry by
-- entry through the index of §1, with the radius the comparison names: the tolerance times one
-- plus the magnitudes (`within`), or times a scale given entry by entry (11.S14: what the sum
-- compared adds in magnitude, so the comparison follows the magnitudes and not a flat constant),
-- with a known slack added (the part of a matrix dropped below a floor), or with the scale of
-- both entries and a normwise term (Higham, Accuracy and Stability of Numerical Algorithms, 2nd
-- ed., 2002, section 3.5: |C - fl(AB)| <= gamma_n |A| |B| and ||C - fl(AB)|| <= gamma_n ||A||
-- ||B||; an exact zero on one side, a structural zero, has a componentwise scale of zero while its
-- computed twin carries the rounding of the whole product, which only the normwise term bounds;
-- 2026-10-17, record/IA/regions-2026-10-17/report-code.md finding 1). With tolerance zero the
-- comparison is exact. Inside the branch the shapes agree, which is what lets the second
-- argument take the first's index (4.R11). `approxVec tol` and `approxMat tol` keep their names,
-- abbreviations of the balls.
vecBall (radius : (x : Vec Float64) -> Vec Float64 -> Fin x.n -> Float64) (x y : Vec Float64) : Bool :=
  if x.n == y.n then entrywiseBall (Vec Float64) Float64 (vecIndexed Float64) absDistance radius x y else false
matBall (radius : (a : Mat Float64) -> Mat Float64 -> Fin (a.m * a.n) -> Float64) (a b : Mat Float64) : Bool :=
  if sameShape Float64 Float64 a b then entrywiseBall (Mat Float64) Float64 (matIndexed Float64) absDistance radius a b else false
approxVec (tol : Tolerance) (x y : Vec Float64) : Bool :=
  vecBall (fn c e k { tol * (1.0 + abs (c.f k) + abs (e.f k)) }) x y
approxMat (tol : Tolerance) (a b : Mat Float64) : Bool :=
  matBall (fn c e k { tol * (1.0 + abs (matAt Float64 c k) + abs (matAt Float64 e k)) }) a b
exact : Tolerance := 0.0
-- the scale of an entry is the entry's magnitude [proposed, D-2026-10-14-c; 11.S14]
absMat (a : Mat Float64) : Mat Float64 := matMap Float64 Float64 abs a
-- the tolerance times the scale of the entry, plus a slack (zero for none); the scale is a matrix
-- of the shape compared, else the comparison fails [proposed, D-2026-10-14-c; 11.S14]
approxMatSlackOf (slack : Float64) (tol : Tolerance) (scale a b : Mat Float64) : Bool :=
  if sameShape Float64 Float64 scale a then matBall (fn c e k { slack + tol * matAt Float64 scale k }) a b else false
approxMatOf (tol : Tolerance) (scale a b : Mat Float64) : Bool := approxMatSlackOf 0.0 tol scale a b
-- the tolerance times the scale of the first entry (`sa`), of the second (`sb`) and `norm`
-- [proposed, 2026-10-17, the coordinator's answer to report-code.md finding 1]
approxMatBoth (tol : Tolerance) (sa sb : Mat Float64) (norm : Float64) (a b : Mat Float64) : Bool :=
  if sameShape Float64 Float64 sa a and sameShape Float64 Float64 sb a then
    matBall (fn c e k { tol * (matAt Float64 sa k + matAt Float64 sb k + norm) }) a b
  else false

-- [core bite 11; D-2026-10-18-j] The bounds of the summing leaves are the theory's, never a
-- tolerance of the demand: Higham 2002, section 3.1, eq. (3.5) and Lemma 3.1: an inner product of
-- n terms computed in any order, with or without a fused multiply-add, is within `gamma n` times
-- the sum of the magnitudes of its terms of the exact one, `gamma n = n u / (1 - n u)`, `u` the
-- unit roundoff, half the model's `epsilon` (numbers.lth's `Doubles`); likewise a sum of n terms.
-- Two such computations of one exact value differ by twice that; measuring the difference and the
-- sum of magnitudes in floating point costs a factor `(1 + u) / (1 - gamma n)` and the radius's
-- own roundings `(1 - u)^3`, so `3 gamma n` bounds it with room while `gamma n < 1/4`, as numbers.lth
-- bounds the associativity of `plus` (D-2026-10-17-f as corrected). Each such law states its
-- range as its premise: at most 10^6 terms (`n u` below 1.2e-10, and a sum of 10^6 products
-- below 1e300 does not overflow) and entries zero or of magnitude in [1e-150, 1e150], numbers.lth's
-- `Moderate`, so that no product underflows below the normal doubles or overflows.
gammaN (fp : Doubles Float64) (n : Int) : Float64 := (toFloat64 n * fp.epsilon / 2.0) / (1.0 - toFloat64 n * fp.epsilon / 2.0)
-- The range is written as the law's premise in its body (`not (in range) or ...`), not as a
-- refinement of its variables: the tester's drawing of a refinement of `VecOf n` exhausted the
-- host's recursion (2026-10-21), and a premise claims nothing outside it just the same.
sumRange (n : Int) : Bool := n <= 1000000
moderateEntry (x : Float64) : Bool := x == 0.0 or (1.0e-150 <= abs x and abs x <= 1.0e150)
moderateVec (v : Vec Float64) : Bool := forallBelow v.n (fn j { moderateEntry (v.f j) })
moderateMat (a : Mat Float64) : Bool := forallBelow a.m (fn i { forallBelow a.n (fn j { moderateEntry (a.f i j) }) })

-- ---------------------------------------------------------------- §4 The leaves (3.S28, 12.S9)

-- The operations the host computes faster, as one record: what a model of it must meet is below,
-- and arrays_model.lut names numpy's as the model. Each takes and gives the records of §1; the
-- bridge reads `f` as the array (3.S22 to 3.S24). The rank floor is a parameter of the rank
-- (P11, 11.S18): the retained eigenvalues of a symmetric matrix are those above the floor times
-- the largest in magnitude, so the floor is a fraction below one.
RankFloor : U := { f : Float64 | 0.0 <= f and f < 1.0 }
Arrays : {
  add sub : Vec Float64 -> Vec Float64 -> Vec Float64,
  scale : Float64 -> Vec Float64 -> Vec Float64,
  dot : Vec Float64 -> Vec Float64 -> Float64,
  norm : Vec Float64 -> Float64,
  matVec : Mat Float64 -> Vec Float64 -> Vec Float64,
  matMul madd msub : Mat Float64 -> Mat Float64 -> Mat Float64,
  mscale : Float64 -> Mat Float64 -> Mat Float64,
  transpose : Mat Float64 -> Mat Float64,
  retainedRank : RankFloor -> Mat Float64 -> Int,
  trace : Mat Float64 -> Float64,
  pinvSym : RankFloor -> Mat Float64 -> Mat Float64,
}

-- entrywise operations are exact: the host applies the machine's operation to each entry, which
-- is the native definition (11.S4), so the two agree bit for bit and the shape is the definition's
-- spec 3.S28. [core bite 11, execution.md §5.1] Each is the core's `Pointwise` (functions.lth)
-- between the leaf and the native definition, at the equality of §1 (shape and entries).
AddPointwise (m : Arrays) (n : Dim) (x y : VecOf n) : Bool :=
  Pointwise2 (VecOf n) (VecOf n) (Vec Float64) (vecObject Float64) m.add (fn a b { addDef a b }) x y
SubPointwise (m : Arrays) (n : Dim) (x y : VecOf n) : Bool :=
  Pointwise2 (VecOf n) (VecOf n) (Vec Float64) (vecObject Float64) m.sub (fn a b { subDef a b }) x y
ScalePointwise (m : Arrays) (n : Dim) (c : Float64) (x : VecOf n) : Bool :=
  Pointwise2 Float64 (VecOf n) (Vec Float64) (vecObject Float64) m.scale scaleDef c x
TransposePointwise (m : Arrays) (r c : Dim) (a : MatOf r c) : Bool :=
  Pointwise (MatOf r c) (Mat Float64) (matObject Float64) m.transpose (fn b { transposeDef b }) a
MaddPointwise (m : Arrays) (r c : Dim) (a b : MatOf r c) : Bool :=
  Pointwise2 (MatOf r c) (MatOf r c) (Mat Float64) (matObject Float64) m.madd (fn x y { maddDef x y }) a b
MsubPointwise (m : Arrays) (r c : Dim) (a b : MatOf r c) : Bool :=
  Pointwise2 (MatOf r c) (MatOf r c) (Mat Float64) (matObject Float64) m.msub (fn x y { msubDef x y }) a b
MscalePointwise (m : Arrays) (r c : Dim) (s : Float64) (a : MatOf r c) : Bool :=
  Pointwise2 Float64 (MatOf r c) (Mat Float64) (matObject Float64) m.mscale mscaleDef s a

-- the inner product: commutative exactly (the same products, summed in one order; the core's
-- `Commutative`), the basis orthonormal exactly (one term, the rest exact zeros), and its two
-- numerical laws (D-2026-10-18-j, L9.18; wave C, bite C1, 2026-10-25, Claude Opus 5.5):
-- - stability at exact inputs: within `3 gamma n` of the native sum relative to the sum of the
--   magnitudes of the terms (§3's bounds, Higham 2002 eq. 3.5), a `Within` law whose certificate
--   records the worst ratio of the difference to that bound (laws.lth §5). This was `DotAgrees`.
-- - sensitivity: moving `x` to `x'` moves the product by at most `|x' - x| |y|` (Cauchy and
--   Schwarz: the product is Lipschitz in `x` with the norm of `y` as constant, D-2026-10-18-i), plus
--   the algorithm's error at the two points, each within `gamma n` of its exact value relative to
--   its magnitudes, taken as 3 gamma n each, the stability law's bound, with room for the
--   roundings of the bound itself. The bound is `dotTransformer`'s, the core's bound transformer
--   (core/properties/functions.lth): `L` the norm of `y` widened by `gamma (2n + 8)` for the roundings of the two computed norms (each a sum of
--   n squares after n differences, a square root and a product: below `(n + 4) u` relative, Higham
--   2002 section 3.1), `eta` the algorithm's error, the domain the moderate vectors, the radius the
--   moderate range (the product is bilinear, so the bound holds at every distance the range allows).
--   Its range is its premise: the sum range and moderate entries, and `x'` admissible.
-- The output's error is at most the sensitivity times the input's plus the algorithm's own error
-- (L9.18); the demand fixes one tolerance and the transformer's pull-back gives the other (L6.8).
DotCommutative (m : Arrays) (n : Dim) (x y : VecOf n) : Bool := Commutative (VecOf n) Float64 (structural Float64) m.dot x y
DotOnBasis (m : Arrays) (n : Dim) (x : VecOf n) (j : Fin n) : Bool := m.dot x (basis n j) == x.f j
DotStable (m : Arrays) (fp : Doubles Float64) (n : Dim) (x y : VecOf n) : Law :=
  if sumRange n and moderateVec x and moderateVec y
  then Within Float64 absDistance (3.0 * gammaN fp n * absSumTo n (fn k { x.f k * y.f k })) (m.dot x y) (dotDef x y)
  else Case true
-- the transformer of the product with `y` at the moderate vectors of length n, its defect the
-- algorithm's error at `x` and `x'`
dotTransformer (fp : Doubles Float64) (n : Dim) (x x' y : Vec Float64) : Affine (Vec Float64) :=
  { lipschitz := (1.0 + gammaN fp (2 * n + 8)) * normDef y,
    defect := 3.0 * gammaN fp n * (absSumTo n (fn k { x'.f k * y.f k }) + absSumTo n (fn k { x.f k * y.f k })),
    radius := 1.0e150,
    domain := moderateVec }
DotSensitive (m : Arrays) (fp : Doubles Float64) (n : Dim) (x x' y : VecOf n) : Law :=
  { t := dotTransformer fp n x x' y
    if sumRange n and moderateVec x and moderateVec x' and moderateVec y and admissible (Vec Float64) t x (distance x' x)
    then Within Float64 absDistance (transform (Vec Float64) t (distance x' x)) (m.dot x' y) (m.dot x y)
    else Case true }
-- the norm: the root of the inner product, one on the basis, scaling with the magnitude. [bite C1,
-- D-2026-10-18-j] The last two are `Within` laws with the theory's bound in place of the demand's
-- tolerance: a sum of n squares is within `gamma n` of the exact one relative to itself (its terms
-- are not negative, so the sum of their magnitudes is the sum), the root halves that and rounds
-- once, so each computed norm is within `gamma (n + 2)` of the exact one relative to it, and two
-- computations differ by twice that; scaling the entries first rounds each once more (`u`), and the
-- product by `c` once. `3 gamma (n + 2)` bounds both with room for the bound's own roundings, as §3
-- does. Range: the sum range and moderate entries (their squares stay normal), and the scaled
-- vector moderate.
NormOfBasis (m : Arrays) (n : Dim) (j : Fin n) : Bool := m.norm (basis n j) == 1.0
NormOfDot (m : Arrays) (fp : Doubles Float64) (n : Dim) (x : VecOf n) : Law :=
  if sumRange n and moderateVec x
  then Within Float64 absDistance (3.0 * gammaN fp (n + 2) * m.norm x) (m.norm x) (elementary.sqrt (m.dot x x))
  else Case true
NormScales (m : Arrays) (fp : Doubles Float64) (n : Dim) (c : Positive) (x : VecOf n) : Law :=
  if sumRange n and moderateVec x and moderateVec (m.scale c x)
  then Within Float64 absDistance (3.0 * gammaN fp (n + 2) * c * m.norm x) (m.norm (m.scale c x)) (c * m.norm x)
  else Case true

-- a matrix acting: its table on the basis is the matrix, exactly; on any vector each entry is
-- within `3 gamma c` of the native sum relative to the magnitudes of the row's terms (Higham 2002
-- section 3.5)
MatVecOnBasis (m : Arrays) (r c : Dim) (a : MatOf r c) (j : Fin c) : Bool := approxVec exact (m.matVec a (basis c j)) (column a j)
MatVecAgrees (m : Arrays) (fp : Doubles Float64) (r c : Dim) (a : MatOf r c) (x : VecOf c) : Bool :=
  not (sumRange c and moderateMat a and moderateVec x) or vecBall (fn p q i { 3.0 * gammaN fp c * absSumTo c (fn j { a.f i j * x.f j }) }) (m.matVec a x) (matVecDef a x)
-- the product: the identity is neutral exactly (the core's `Neutral`, on the square matrices;
-- on a rectangular one the identities of its two sizes, `MatMulByIdentity`), the transpose
-- reverses it, and each entry is within `3 gamma k` of the native sum relative to the magnitudes
-- of its terms (Higham 2002 section 3.5; 11.S14)
MatMulNeutral (m : Arrays) (k : Dim) (a : MatOf k k) : Bool := Neutral (Mat Float64) (matObject Float64) m.matMul (identity k) a
MatMulByIdentity (m : Arrays) (r c : Dim) (a : MatOf r c) : Bool :=
  (matObject Float64).eq (m.matMul a (identity c)) a and (matObject Float64).eq (m.matMul (identity r) a) a
-- both sides sum the same k products of each entry, in orders the host chooses
MatMulTransposes (m : Arrays) (fp : Doubles Float64) (r k c : Dim) (a : MatOf r k) (b : MatOf k c) : Bool :=
  not (sumRange k and moderateMat a and moderateMat b) or matBall (fn p q e { 3.0 * gammaN fp k * absSumTo k (fn l { a.f (e mod r) l * b.f l (e / r) }) })
    (m.transpose (m.matMul a b)) (m.matMul (m.transpose b) (m.transpose a))
MatMulAgrees (m : Arrays) (fp : Doubles Float64) (r k c : Dim) (a : MatOf r k) (b : MatOf k c) : Bool :=
  not (sumRange k and moderateMat a and moderateMat b) or matBall (fn p q e { 3.0 * gammaN fp k * absSumTo k (fn l { a.f (e / c) l * b.f l (e mod c) }) }) (m.matMul a b) (matMulDef a b)

-- The retained rank of a symmetric matrix at a floor: the number of its eigenvalues above the
-- floor times the largest eigenvalue in magnitude. Characterized where the spectrum is read off
-- the matrix: a diagonal whose entries are zero or well above the floor has as many retained as
-- it has positive entries; the zero matrix none, the identity all; the rank is bounded by the
-- size, is the same at any positive scale (the floor is relative), and under rotation by an
-- orthogonal matrix (the spectrum is invariant), whose generator is a family of the model's
-- (7.S5, bound by the test, 7.R1). Agreement with a native spectrum (Jacobi's method, v0.1
-- array.lut:95-154) is a corollary (4.R10) and is not restated here.
-- spec 11.S18, P11
ClearFloor : U := { f : RankFloor | f < 0.001 }
ClearDiagonal : U := { d : Vec Float64 | forallBelow d.n (fn k { d.f k == 0.0 or (1.0 <= abs (d.f k) and abs (d.f k) <= 1000.0) }) }
Orthogonal (tol : Tolerance) (k : Int) : U := { q : MatOf k k | approxMat tol (matMulDef (transposeDef q) q) (identity k) }
RankOfDiagonal (m : Arrays) (fl : ClearFloor) (d : ClearDiagonal) : Bool :=
  m.retainedRank fl (diagonal d) == countBelow d.n (fn k { 0.0 < d.f k })
RankOfZeroAndIdentity (m : Arrays) (fl : RankFloor) (k : Dim) : Bool :=
  m.retainedRank fl (zeroMat k k) == 0 and m.retainedRank fl (identity k) == k
RankBounded (m : Arrays) (fl : RankFloor) (s : SymmetricMatrix) : Bool := 0 <= m.retainedRank fl s and m.retainedRank fl s <= s.m
-- [proposed, 2026-10-15, L9.14] a scale drawn within the size leaves an absolute floor unseen (one
-- of 1e-3 passed, report-mutants.md), so the law also scales s relative to its magnitude, to a
-- Frobenius norm (a bound on every eigenvalue in magnitude) of c times the floor: there every
-- eigenvalue is below any absolute floor above c fl, while a floor relative to the largest
-- retains what it retained in s. A zero floor or a zero matrix has nothing to scale to.
RankScales (m : Arrays) (fl : RankFloor) (c : Positive) (s : SymmetricMatrix) : Bool :=
  m.retainedRank fl (mscaleDef c s) == m.retainedRank fl s
  and (fl == 0.0 or frobDef s == 0.0 or m.retainedRank fl (mscaleDef (c * fl / frobDef s) s) == m.retainedRank fl s)
RankUnderRotation (m : Arrays) (tol : Tolerance) (fl : RankFloor) (k : Dim) (q : Orthogonal tol k) (s : SymmetricOf k) : Bool :=
  m.retainedRank fl (m.matMul (m.transpose q) (m.matMul s q)) == m.retainedRank fl s

-- The trace: of the identity its size, exactly (a sum of ones); linear and cyclic within the
-- theory's bounds, the cyclic law relative to the magnitudes of the products summed (both
-- sides sum the same r c products in different orders, 11.S14); and within the bound of the
-- native sum relative to the magnitudes of the diagonal (v0.1 array.lut:247-252 held a
-- tolerance; core bite 11 and bite C1 replaced it by the theory's bound, D-2026-10-18-j).
-- [bite C1] Linearity as a `Within` law: the sum of two matrices rounds each diagonal entry once,
-- each trace sums k entries (`gamma k` relative to their magnitudes), and the sum of two traces
-- rounds once: `3 gamma (k + 1)` times the magnitudes of both diagonals bounds the difference.
-- spec 11.S14
TraceOfIdentity (m : Arrays) (k : Dim) : Bool := m.trace (identity k) == toFloat64 k
TraceAdditive (m : Arrays) (fp : Doubles Float64) (k : Dim) (a b : MatOf k k) : Law :=
  if sumRange k and moderateMat a and moderateMat b
  then Within Float64 absDistance (3.0 * gammaN fp (k + 1) * (absSumTo k (fn i { a.f i i }) + absSumTo k (fn i { b.f i i })))
    (m.trace (m.madd a b)) (m.trace a + m.trace b)
  else Case true
-- [core bite 11; D-2026-10-18-j] the cyclic law and the agreement with the native sum take §3's
-- bounds, not the demand's tolerance: each side of the cyclic law sums the r c products twice
-- nested, within `gamma (r + c)` of the exact sum relative to their magnitudes (Higham 2002,
-- Lemma 3.3: (1 + gamma c)(1 + gamma r) <= 1 + gamma (r + c)); the trace sums k entries
TraceCyclic (m : Arrays) (fp : Doubles Float64) (r c : Dim) (a : MatOf r c) (b : MatOf c r) : Bool :=
  not (sumRange (r + c) and moderateMat a and moderateMat b) or Ball Float64 absDistance (fn p q { 3.0 * gammaN fp (r + c) * absSumTo r (fn i { absSumTo c (fn j { a.f i j * b.f j i }) }) })
    (m.trace (m.matMul a b)) (m.trace (m.matMul b a))
TraceAgrees (m : Arrays) (fp : Doubles Float64) (k : Dim) (a : MatOf k k) : Bool :=
  not (sumRange k and moderateMat a) or Ball Float64 absDistance (fn p q { 3.0 * gammaN fp k * absSumTo k (fn i { a.f i i }) }) (m.trace a) (traceDef a)

-- The pseudo-inverse of a symmetric matrix on its retained subspace, at the same floor as the
-- rank (P11; v0.1 array.lut:157 held `n eps` inside): P = V diag(1 / w on the retained, 0) V^T.
-- Characterized where the spectrum is read off: a diagonal clear of the floor, the zero matrix
-- (nothing retained), the identity; and on any symmetric matrix by what holds of the projector
-- S P = V_r V_r^T whatever is discarded: P S P = P, S P symmetric, P symmetric, the trace of S P
-- the retained rank; S P S = S up to the part of S discarded, which is below the floor times the
-- largest eigenvalue in magnitude, itself below the Frobenius norm (the slack); P at a positive
-- scale is P over the scale (the floor is relative). Each within the demand's tolerance, which
-- 11.S18 says depends on the conditioning (so the demand sets it); agreement with a native
-- spectrum is a corollary (4.R10) and is not restated.
-- spec 11.S18, P11
PinvOfDiagonal (m : Arrays) (tol : Tolerance) (fl : ClearFloor) (d : ClearDiagonal) : Bool :=
  approxMat tol (m.pinvSym fl (diagonal d)) (pinvOfDiagonal fl d)
PinvOfZero (m : Arrays) (fl : RankFloor) (k : Dim) : Bool := approxMat exact (m.pinvSym fl (zeroMat k k)) (zeroMat k k)
PinvOfIdentity (m : Arrays) (tol : Tolerance) (fl : RankFloor) (k : Dim) : Bool := approxMat tol (m.pinvSym fl (identity k)) (identity k)
-- [proposed, 2026-10-14, on the evidence report's Findings] Two changes.
-- (1) PinvRestricts is stated over the matrices that are positive semidefinite at the floor,
-- `PsdAt m fl`: the retained rank at the floor of the negative of the matrix is zero, that is,
-- every eigenvalue of s is at least minus the floor times the largest in magnitude. Reading
-- taken: the one the leaf `retainedRank` already gives, so the predicate needs no spectrum of its
-- own and is the predicate of the slack (the part dropped is then at most the floor times the
-- largest eigenvalue in magnitude, below `fl * frobDef s`, 11.S18). Rejected: the dropped part's
-- norm as the slack (needs the spectrum, which the law has no leaf for), and quadratic forms on a
-- listed basis (do not decide semidefiniteness). On an indefinite matrix pinvSym drops the
-- negative eigenvalues by design, and s p s differs from s by the negative part.
-- (2) PinvProjects, PinvSymmetric, PinvScales compare relative to the magnitudes (11.S14): the
-- entries of p s p are sums of products, compared to p within the tolerance times the sum of the
-- magnitudes of those products; the symmetry laws likewise with the scale of the matrix compared;
-- and P at a scale is compared with a scale of the condition of s read from the retained
-- spectrum, `frobDef s * frobDef p` (a bound on the condition number of s on its retained
-- subspace), since the error of p is of order cond times eps (11.S18: the tolerance depends on the
-- conditioning). The tolerance stays a parameter of each law (D-2026-10-14-c).
-- spec 11.S14, 11.S18
PsdAt (m : Arrays) (fl : RankFloor) : U := { s : SymmetricMatrix | m.retainedRank fl (mscaleDef (0.0 - 1.0) s) == 0 }
PinvProjects (m : Arrays) (tol : Tolerance) (fl : RankFloor) (s : SymmetricMatrix) : Bool :=
  { p := m.pinvSym fl s
    approxMatOf tol (matMulDef (absMat p) (matMulDef (absMat s) (absMat p))) (m.matMul p (m.matMul s p)) p }
-- [proposed, 2026-10-17; 3j j2a finding 1, the coordinator's answer] PinvSymmetric and PinvScales
-- compare with the scale of both entries compared and a normwise term (`approxMatBoth`, Higham 2002
-- section 3.5): with the scale of one entry only they were refuted on the rank-deficient family,
-- where an exact zero (s p)[3,5] faced a rounded -1.75e-16 at [5,3] (a 10 x 10 matrix of rank 9),
-- and pinv(c s)[2,1] = -5.06e-19 faced p[2,1] / c = 0. The error model was wrong, numpy within
-- rounding; the evidence is in record/archive/stores-2026-10-17/. The normwise terms: the norm of p
-- for p against its transpose, the product of the norms for s p, and the norm of p over c, times
-- the condition read as before, for P at a scale.
PinvSymmetric (m : Arrays) (tol : Tolerance) (fl : RankFloor) (s : SymmetricMatrix) : Bool :=
  { p := m.pinvSym fl s
    sp := m.matMul s p
    scale := matMulDef (absMat s) (absMat p)
    approxMatBoth tol (absMat p) (transposeDef (absMat p)) (frobDef p) p (m.transpose p)
      and approxMatBoth tol scale (transposeDef scale) (frobDef s * frobDef p) sp (m.transpose sp) }
PinvRestricts (m : Arrays) (tol : Tolerance) (fl : RankFloor) (s : PsdAt m fl) : Bool :=
  { p := m.pinvSym fl s
    -- [proposed, 2026-10-15; 11.S14] the rounding of s p s is of the magnitudes (cond times eps, as
    -- its siblings, 7032d7b), not a flat constant: scale |s||p||s|; the slack stays for the dropped part
    approxMatSlackOf (fl * frobDef s) tol (matMulDef (absMat s) (matMulDef (absMat p) (absMat s))) (m.matMul s (m.matMul p s)) s }
PinvTraceIsRank (m : Arrays) (tol : Tolerance) (fl : RankFloor) (s : SymmetricMatrix) : Bool :=
  within tol (m.trace (m.matMul s (m.pinvSym fl s))) (toFloat64 (m.retainedRank fl s))
-- [proposed, 2026-10-15, L9.14] as RankScales (15caf52): a scale drawn within the size leaves an
-- absolute floor unseen (one of 1e-3 passed, record/IA/controls-2026-10-15/report-tail.md), so the
-- law also scales s to a Frobenius norm of c times the floor, where every eigenvalue is below any
-- absolute floor above c fl, while a floor relative to the largest retains what it retained in s;
-- P there is P over that scale, compared as at c. A zero floor or a zero matrix has nothing to
-- scale to.
-- P at the scale k against P over k, each entry scaled by both sides, the norm of P over k the
-- normwise term, all times the condition read from the retained spectrum (`approxMatBoth`)
pinvAtScale (m : Arrays) (tol : Tolerance) (fl : RankFloor) (s p : Mat Float64) (k : Float64) : Bool :=
  { q := m.pinvSym fl (mscaleDef k s)
    approxMatBoth (frobDef s * frobDef p * tol) (absMat q) (mscaleDef (1.0 / k) (absMat p)) (frobDef p / k) q
      (mscaleDef (1.0 / k) p) }
PinvScales (m : Arrays) (tol : Tolerance) (fl : RankFloor) (c : Positive) (s : SymmetricMatrix) : Bool :=
  { p := m.pinvSym fl s
    pinvAtScale m tol fl s p c and (fl == 0.0 or frobDef s == 0.0 or pinvAtScale m tol fl s p (c * fl / frobDef s)) }

Arrays := AddPointwise & SubPointwise & ScalePointwise & TransposePointwise & MaddPointwise & MsubPointwise & MscalePointwise
  & DotCommutative & DotOnBasis & DotStable & DotSensitive & NormOfBasis & NormOfDot & NormScales
  & MatVecOnBasis & MatVecAgrees & MatMulNeutral & MatMulByIdentity & MatMulTransposes & MatMulAgrees
  & RankOfDiagonal & RankOfZeroAndIdentity & RankBounded & RankScales & RankUnderRotation
  & TraceOfIdentity & TraceAdditive & TraceCyclic & TraceAgrees
  & PinvOfDiagonal & PinvOfZero & PinvOfIdentity & PinvProjects & PinvSymmetric & PinvRestricts & PinvTraceIsRank & PinvScales

-- ---------------------------------------------------------------- §5 The degenerate cases

import "generators.lth" DegenerateCase Degeneracies

-- [D-2026-10-16-j; written 2026-10-17 by Claude Fable 5.1, an agent of the coordinating session,
-- on record/IA/regions-2026-10-17/prompt-theory.md] The cases a law over matrices turns on,
-- declared once and shared by every law of §4 (generators.lth §9: a named predicate with a
-- witness; the tester classifies each case it draws or lists by the predicates and keeps the
-- evidence per case, certification.lth §2). For `Mat Float64`: the zero matrix, the empty matrix
-- 0 x 0, the 1 x 1 matrix, and rank deficiency. [proposed] The rank deficiency a general matrix's
-- entries decide exactly, with no spectrum and no floor: a zero row, or two equal rows (the
-- decision names the case; the predicate names the part of it the type can see). For `SymmetricMatrix`
-- the same three and rank deficiency at a floor, through the leaf that decides it
-- (`retainedRank`, §4; P11: the floor is a parameter), so the declaration takes the model and the
-- floor as the laws of §4 do. A row of zeros is a degenerate case and a case of rank deficiency
-- both: a value is in every case whose predicate it meets.
zeroRow (a : Mat Float64) (i : Fin a.m) : Bool := forallBelow a.n (fn j { a.f i j == 0.0 })
sameRows (a : Mat Float64) (i k : Fin a.m) : Bool := forallBelow a.n (fn j { a.f i j == a.f k j })
isZeroMat (a : Mat Float64) : Bool := forallBelow a.m (fn i { zeroRow a i })
isEmptyMat (a : Mat Float64) : Bool := a.m == 0 and a.n == 0
isOneByOne (a : Mat Float64) : Bool := a.m == 1 and a.n == 1
rowsRepeatOrVanish (a : Mat Float64) : Bool :=
  existsBelow a.m (fn i { zeroRow a i or existsBelow a.m (fn k { not (i == k) and sameRows a i k }) })
oneByOne : Mat Float64 := mat Float64 1 1 (fn i j { 1.0 })
-- diag(1, 0): symmetric, rank one of two
rankOneOfTwo : Mat Float64 := mat Float64 2 2 (fn i j { if i == j and i == 0 then 1.0 else 0.0 })
matDegeneracies : Degeneracies (Mat Float64) := { cases := [
  { name := "zero", holds := fn a { isZeroMat a }, witness := zeroMat 2 2 },
  { name := "0 x 0", holds := fn a { isEmptyMat a }, witness := zeroMat 0 0 },
  { name := "1 x 1", holds := fn a { isOneByOne a }, witness := oneByOne },
  { name := "rank deficient", holds := fn a { rowsRepeatOrVanish a }, witness := rankOneOfTwo } ] }
symmetricDegeneracies (m : Arrays) (fl : RankFloor) : Degeneracies SymmetricMatrix := { cases := [
  { name := "zero", holds := fn s { isZeroMat s }, witness := zeroMat 2 2 },
  { name := "0 x 0", holds := fn s { isEmptyMat s }, witness := zeroMat 0 0 },
  { name := "1 x 1", holds := fn s { isOneByOne s }, witness := oneByOne },
  { name := "rank deficient", holds := fn s { m.retainedRank fl s < s.m }, witness := rankOneOfTwo } ] }
