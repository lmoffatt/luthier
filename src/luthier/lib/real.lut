-- The functions on Float64. `Float64` is primitive (core.lut, 06 §2): the finite doubles, with
-- their literals and the machine's arithmetic. This library declares the functions on them without
-- a body; real_python.lut binds them to Python's math. It also gives the equality of Float64
-- within rounding and the tolerances of the laws that compare computed values.

-- the magnitude: x or -x, whichever is not negative
AbsIsMagnitude (f : Float64 -> NonNegative) (x : Float64) : Bool := f x >= 0.0 and (f x == x or f x == 0.0 - x)
abs  : { f : Float64 -> NonNegative | AbsIsMagnitude f }
-- the nearest double to an integer, exact below 2^53. A conversion with one implementation, not a
-- function a model chooses (as sqrt or exp are), so it is bound here: the generator of Float64 in
-- random.lut uses it, and a program that does not import real_python still draws numbers
toFloat64 : Int -> Float64 := extern "python:builtins.float"
ulp  : Float64 -> Float64         -- the distance to the next double
sqrt : Float64 -> Float64
cbrt : Float64 -> Float64
exp  : Float64 -> Float64
log  : Float64 -> Float64
erf  : Float64 -> Float64
round : Float64 -> Int            -- the nearest whole number

-- the machine epsilon: the ulp of one, 2^-52. The rounding error of one operation is at
-- most half of it; of a sum of n terms, about n times it.
eps : Float64 := ulp 1.0

-- Equal within a tolerance relative to the size of the values, |a - b| <= tol (1 + |a| + |b|):
-- the equality of Float64 as a realization of Real (06 §4). With tol 0 it is exact equality.
approx (tol a b : Float64) : Bool := abs (a - b) <= tol * (1.0 + abs a + abs b)

NonNegative : U := { x : Float64 | x >= 0.0 }

-- The tolerance of a law: a sum of n products rounds to about n eps times the size of the
-- terms, and the terms can cancel, so a law whose sides may be near zero scales its tolerance
-- by the norms involved, not by the result. The slack covers the few extra operations each
-- side performs. Declared once, here.
roundingSlack : Float64 := 8.0
tolOf (n : Int) : Float64 := roundingSlack * toFloat64 n * eps
scaledTol (n : Int) (magnitude : Float64) : Float64 := tolOf n * (1.0 + magnitude)
