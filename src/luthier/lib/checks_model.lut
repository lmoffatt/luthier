-- checks_model.lut: the projections and the composition of checks, as models of checks.lth.
--
-- Draft 0, 2026-10-13, by Claude Opus 5.5 in the session (step 3.3). The projections of a check
-- are computed from its failures, once (5.S9); `both` and `either` are 5.S11's.

import "checks.lth" Failures Reason ok failed Projections Composition isEmpty take concatFailures

projectionsOf (T E : U) (c : T -> Failures E) : Projections T E := {
  failures := c,
  holds := \ x { isEmpty E (c x) },
  first := \ n x { take E n (c x) },
  reason := \ x { match c x { nil -> ok x ; cons f rest -> failed f } },
  refine := \ x { if isEmpty E (c x) then just x else nothing },
}

composition (T E : U) : Composition T E := {
  both := \ c d x { concatFailures E (c x) (d x) },
  either := \ c d x { if isEmpty E (c x) or isEmpty E (d x) then nil else concatFailures E (c x) (d x) },
}
