-- translation.lth: the elaboration of the surface program into the kernel term, as a theory.
--
-- Draft 0, 2026-10-13, by Claude Opus 5.5 in the session (step 2.4 of
-- record/plan-from-zero-2026-10-13-execution.md). Sources: spec 2.S12 (the table, one law per
-- row), 2.S13, 2.S17; 3.S4, 3.S30; 4.R13 (operators by type), 4.S23 (implicit arguments). The
-- surface tree is grammar.lth's, the kernel term term.lth's; this file reads both and changes
-- neither. Pattern of ebnf.lth: a theory, its laws over a model, `T := laws`.
--
-- What this file states. Elaboration is type-directed: what `->`, `*`, `+` and `if` become
-- depends on the types of their operands (2.S13 leaves it to the checker), and a block's names,
-- a lambda's tuple parameter, a projection need a type or a fresh name. So the laws are case laws,
-- as the tree laws of grammar.lth: each row of 2.S12 is stated on a small program that gives the
-- names it uses their types, and the result is compared up to alpha-equivalence (term.lth §2),
-- since fresh names are the model's. A model is the elaborator; the Python checker's is a
-- specimen (step 4), certified against these laws.
--
-- Index. Status of each section: done, or todo with what it needs. A session or Codex continuing
-- this file takes the first todo, writes it in the pattern of the done ones, checks it with
-- `luthier parse src/luthier/lib/translation.lth`, sets its status to done here, and commits.
--
--   §1 The theory `Elaboration`, its helpers, and the acts: a definition with binders
--      curried, a declaration, a datum, an alias expanded (2.S12 rows 1, 2).           done
--   §2 Terms without types: names, constants, `U`, `W`, application, lambdas with
--      typed parameters, `match` with its patterns, lists, sums, record types,
--      `data` (2.S12; 3.S4).                                                           done
--   §3 Terms by type: `->`, `*`, `+` on types and on numbers; `and`, `or`,
--      implication; negation; `if` on `Bool` and on `Failures E`; the operators of a
--      type's model (4.R13).                                                         done
--   §4 Terms by context: record values, projection, named arguments and defaults,
--      implicit arguments (4.S23), blocks and `<-`, tuple parameters, clauses.        done
--   §5 `Elaboration :=` the conjunction.                                             done

import "grammar.lth" SurfaceProgram SurfaceAct Surface SurfacePattern Literal Field Item Body Clause Binder
  LambdaParam declare define alias datum operatorAct explicit implicit termBody dataBody clausesBody name
  literal universe world app binop neg tuple pi sigma record subtype recordValue block sum list lambda
  matchOf namedArg ifThen proj intLit floatLit stringLit pWild pApp pLit pTuple plainParam typedParam
  shapeParam bind rebind
import "term.lth" Term Program Act Pattern Constant Alpha Var Lit Universe World Lam App Pi Sigma Pair
  Match Inj Sum Data Subtype Record RecordValue Proj Let Declare Define Datum IntConst FloatConst StringConst PVar
  PWild PCon PPair PLit

-- ---------------------------------------------------------------- §1 The theory and the acts

-- An elaborator: a program's acts in the kernel, and a term in the context of a program, whose
-- declarations and definitions give the names their types; `nothing` when the term does not
-- elaborate (it does not type). Results are compared up to alpha-equivalence.
Elaboration (a : Alpha) : {
  elaborate : SurfaceProgram -> Program,
  term : SurfaceProgram -> Surface -> Maybe Term,
}

gives (a : Alpha) (r : Maybe Term) (u : Term) : Bool := match r { nothing -> false ; just v -> a.alphaEq v u }
sameAct (a : Alpha) (x y : Act) : Bool := match x {
  Declare n t -> (match y { Declare m u -> n == m and a.alphaEq t u ; _ -> false }) ;
  Define n t b -> (match y { Define m u c -> n == m and a.alphaEq t u and a.alphaEq b c ; _ -> false }) ;
  Datum t -> (match y { Datum u -> a.alphaEq t u ; _ -> false }) ;
}
sameProgram (a : Alpha) (xs ys : Program) : Bool := match xs {
  nil -> (match ys { nil -> true ; cons y rest -> false }) ;
  cons x rest -> match ys { nil -> false ; cons y more -> sameAct a x y and sameProgram a rest more } }
nm (s : String) : Surface := name s
pvar (s : String) : SurfacePattern := pApp s []
aType (s : String) : SurfaceAct := declare s [] universe
of (x t : String) : SurfaceAct := declare x [] (nm t)

-- 2.S12 rows 1 and 2: a definition with binders is a curried lambda at a dependent function type;
-- `(x y : A)` is two binders; a default changes no type (it is the call's, §4)
ActsCurried (a : Alpha) (e : Elaboration a) : Bool :=
  sameProgram a (e.elaborate [define "f" [explicit ["x"] (nm "A") nothing, explicit ["y", "z"] (nm "B") (just (nm "w"))]
                                       (just (nm "C")) (termBody (nm "x"))])
    [Define "f" (Pi "x" (Var "A") (Pi "y" (Var "B") (Pi "z" (Var "B") (Var "C"))))
                (Lam "x" (Var "A") (Lam "y" (Var "B") (Lam "z" (Var "B") (Var "x"))))]
-- a declaration is a hole of its type, a datum is kept, and an alias is expanded and leaves no act
-- (3.S15, 4.R7); an operator act and an import leave none either, being resolved (§3, spec 12)
ActsKept (a : Alpha) (e : Elaboration a) : Bool :=
  sameProgram a (e.elaborate [aType "A", aType "B", alias "P" [] (binop "*" (nm "A") (nm "B")), of "x" "P",
                              datum (app (nm "test") (nm "x"))])
    [Declare "A" Universe, Declare "B" Universe, Declare "x" (Sigma "_" (Var "A") (Var "B")),
     Datum (App (Var "test") (Var "x"))]

-- ---------------------------------------------------------------- §2 Terms without types

-- names, constants, the universe and the world, application
Atoms (a : Alpha) (e : Elaboration a) : Bool :=
  gives a (e.term [] (nm "x")) (Var "x") and gives a (e.term [] (literal (intLit 3))) (Lit (IntConst 3))
  and gives a (e.term [] (literal (stringLit "s"))) (Lit (StringConst "s"))
  and gives a (e.term [] universe) Universe and gives a (e.term [] world) World
  and gives a (e.term [] (app (nm "f") (nm "x"))) (App (Var "f") (Var "x"))
-- a lambda with typed parameters is nested lambdas (2.S12; its body a block, §4)
Lambdas (a : Alpha) (e : Elaboration a) : Bool :=
  gives a (e.term [] (lambda [typedParam ["x", "y"] (nm "A")] [] (nm "x"))) (Lam "x" (Var "A") (Lam "y" (Var "A") (Var "x")))
-- a `match` and its patterns: a name applied, or a constructor of the program's `data`, is a
-- constructor pattern; a bare name otherwise a variable (2.S10, 2.S13); a tuple a pair
Patterns (a : Alpha) (e : Elaboration a) : Bool :=
  gives a (e.term [define "C" [] (just universe) (dataBody [("r", nm "C"), ("s", nm "C")]), of "m" "C"]
                  (matchOf (nm "m") [(pvar "r", literal (intLit 1)), (pWild, literal (intLit 2))]))
          (Match (Var "m") [(PCon "r" [], Lit (IntConst 1)), (PWild, Lit (IntConst 2))])
  and gives a (e.term [] (matchOf (nm "m") [(pApp "just" [pvar "y"], nm "y"), (pTuple [pvar "p", pvar "q"], nm "p"),
                                           (pLit (intLit 0), nm "z"), (pvar "w", nm "w")]))
          (Match (Var "m") [(PCon "just" [PVar "y"], Var "y"), (PPair (PVar "p") (PVar "q"), Var "p"),
                            (PLit (IntConst 0), Var "z"), (PVar "w", Var "w")])
-- a list is `cons` and `nil` (2.S12)
Lists (a : Alpha) (e : Elaboration a) : Bool :=
  gives a (e.term [] (list [nm "x", nm "y"])) (App (App (Var "cons") (Var "x")) (App (App (Var "cons") (Var "y")) (Var "nil")))
-- a sum, a record type, a `data` (2.S12; 3.S4). A record type keeps its names in the kernel: it is
-- a product whose projections are named (D-2026-10-13-x).
TypeForms (a : Alpha) (e : Elaboration a) : Bool :=
  gives a (e.term [] (sum [("x", nm "A"), ("y", nm "B")])) (Sum [("x", Var "A"), ("y", Var "B")])
  and gives a (e.term [] (record [{ names := ["x"], type := nm "A" }, { names := ["y"], type := nm "B" }] nothing))
          (Record [("x", Var "A"), ("y", Var "B")])
  and sameProgram a (e.elaborate [define "C" [] (just universe) (dataBody [("r", nm "C"), ("s", app (nm "List") (nm "C"))])])
          [Define "C" Universe (Data "C" [("r", Var "C"), ("s", App (Var "List") (Var "C"))])]

-- ---------------------------------------------------------------- §3 Terms by type

-- the context of this section: two types, two integers, two Booleans, a failure list
typesAndValues : SurfaceProgram := [aType "A", aType "B", of "i" "Int", of "j" "Int", of "c" "Bool", of "q" "Bool",
  declare "f" [] (app (nm "Failures") (nm "E"))]
bin (o : String) (x y : Term) : Term := App (App (Var o) x) y

-- `->`, `*`, `+` on types are the dependent forms with an unused name and the anonymous sum
-- (3.S4); on numbers they are the operators; `->` on Booleans is implication (2.S12, 2.S13)
OperatorsByType (a : Alpha) (e : Elaboration a) : Bool :=
  gives a (e.term typesAndValues (binop "->" (nm "A") (nm "B"))) (Pi "_" (Var "A") (Var "B"))
  and gives a (e.term typesAndValues (binop "*" (nm "A") (nm "B"))) (Sigma "_" (Var "A") (Var "B"))
  and gives a (e.term typesAndValues (binop "+" (nm "A") (nm "B"))) (Sum [("left", Var "A"), ("right", Var "B")])
  and gives a (e.term typesAndValues (binop "*" (nm "i") (nm "j"))) (bin "*" (Var "i") (Var "j"))
  and gives a (e.term typesAndValues (binop "+" (nm "i") (nm "j"))) (bin "+" (Var "i") (Var "j"))
  and gives a (e.term typesAndValues (binop "->" (nm "c") (nm "q"))) (bin "implies" (Var "c") (Var "q"))
  and gives a (e.term typesAndValues (binop "and" (nm "c") (nm "q"))) (bin "and" (Var "c") (Var "q"))
  and gives a (e.term typesAndValues (binop "or" (nm "c") (nm "q"))) (bin "or" (Var "c") (Var "q"))
-- negation is subtraction from zero, of the operand's type (2.S12)
Negation (a : Alpha) (e : Elaboration a) : Bool :=
  gives a (e.term typesAndValues (neg (nm "i"))) (bin "-" (Lit (IntConst 0)) (Var "i"))

-- `if` on a `Bool` is a `match` on `true` and `false`; without `else` it gives a `Maybe`
-- (D-2026-10-11-b); on `Failures E` the condition is first projected by `holds`, and without
-- `else` it gives the reason form (2.S12, 5.S9). `true` and `false` are constructors of `Bool`
-- (D-2026-10-13-t makes `Bool` a definition with laws).
Conditions (a : Alpha) (e : Elaboration a) : Bool :=
  gives a (e.term typesAndValues (ifThen (nm "c") (nm "i") (just (nm "j"))))
          (Match (Var "c") [(PCon "true" [], Var "i"), (PCon "false" [], Var "j")])
  and gives a (e.term typesAndValues (ifThen (nm "c") (nm "i") nothing))
          (Match (Var "c") [(PCon "true" [], App (Var "just") (Var "i")), (PCon "false" [], Var "nothing")])
  and gives a (e.term typesAndValues (ifThen (nm "f") (nm "i") (just (nm "j"))))
          (Match (App (Var "holds") (Var "f")) [(PCon "true" [], Var "i"), (PCon "false" [], Var "j")])
  and gives a (e.term typesAndValues (ifThen (nm "f") (nm "i") nothing))
          (Match (Var "f") [(PCon "nil" [], App (Var "ok") (Var "i")),
                            (PCon "cons" [PVar "x", PVar "xs"], App (Var "failed") (Var "x"))])

-- 4.R13: an operator on the values of a type is that of the model the type names, bound by an
-- `operator` act; `Int`'s own when none is bound
OperatorOfTheModel (a : Alpha) (e : Elaboration a) : Bool :=
  gives a (e.term [aType "Z7", of "z" "Z7", declare "addZ7" [] (binop "->" (nm "Z7") (binop "->" (nm "Z7") (nm "Z7"))),
                   operatorAct "+" (nm "addZ7")]
                  (binop "+" (nm "z") (nm "z")))
          (bin "addZ7" (Var "z") (Var "z"))

-- ---------------------------------------------------------------- §4 Terms by context

-- a record value is the introduction of its record type, and a projection the arrow of that name
-- (D-2026-10-13-x, which replaces 2.S12's pair and one-branch `match`)
pairType : Surface := record [{ names := ["x"], type := nm "A" }, { names := ["y"], type := nm "B" }] nothing
Records (a : Alpha) (e : Elaboration a) : Bool :=
  gives a (e.term [aType "A", aType "B", of "u" "A", of "v" "B"] (recordValue [("x", nm "u"), ("y", nm "v")]))
          (RecordValue [("x", Var "u"), ("y", Var "v")])
  and gives a (e.term [aType "A", aType "B", declare "r" [] pairType] (proj (nm "r") "y"))
          (Proj (Var "r") "y")

-- arguments by name go to their parameter's position, and a parameter not given takes its default
-- (2.S7, 2.S12); an implicit argument is inferred from the types of the explicit ones and from
-- the type the context expects (4.S23)
withDefault : SurfaceAct :=
  declare "g" [explicit ["x"] (nm "Int") nothing, explicit ["tol"] (nm "Int") (just (literal (intLit 1)))] (nm "Int")
Arguments (a : Alpha) (e : Elaboration a) : Bool :=
  gives a (e.term [withDefault, of "i" "Int", of "j" "Int"] (app (app (nm "g") (nm "i")) (namedArg "tol" (nm "j"))))
          (App (App (Var "g") (Var "i")) (Var "j"))
  and gives a (e.term [withDefault, of "i" "Int"] (app (nm "g") (nm "i")))
          (App (App (Var "g") (Var "i")) (Lit (IntConst 1)))
  and gives a (e.term [declare "id" [implicit ["T"] universe, explicit ["y"] (nm "T") nothing] (nm "T"), of "i" "Int"]
                      (app (nm "id") (nm "i")))
          (App (App (Var "id") (Var "Int")) (Var "i"))

-- a block is its items, each a local definition of a fresh name, and its final term: nested
-- `Let`s, so that inside the block a name is its value definitionally (D-2026-10-13-aa, Q1); a
-- `<-` binds a fresh name that every later use means (2.S12, 2.S17, 4.R12)
Blocks (a : Alpha) (e : Elaboration a) : Bool :=
  gives a (e.term [] (block [bind "x" (literal (intLit 1))] (nm "x")))
          (Let "x" (Var "Int") (Lit (IntConst 1)) (Var "x"))
  and gives a (e.term [] (block [rebind "y" (literal (intLit 1)), rebind "y" (binop "+" (nm "y") (literal (intLit 1)))] (nm "y")))
          (Let "y0" (Var "Int") (Lit (IntConst 1)) (Let "y1" (Var "Int") (bin "+" (Var "y0") (Lit (IntConst 1))) (Var "y1")))

-- a tuple parameter is a lambda whose body matches its argument (2.S12); a definition by clauses
-- is a lambda over its parameters matching their tuple, or the one parameter itself (D-2026-10-13-p)
Shapes (a : Alpha) (e : Elaboration a) : Bool :=
  sameProgram a (e.elaborate [aType "A", aType "B",
                              define "h" [] (just (binop "->" (binop "*" (nm "A") (nm "B")) (nm "A")))
                                     (termBody (lambda [shapeParam [pvar "x", pvar "y"]] [] (nm "x")))])
    [Declare "A" Universe, Declare "B" Universe,
     Define "h" (Pi "_" (Sigma "_" (Var "A") (Var "B")) (Var "A"))
                (Lam "p" (Sigma "_" (Var "A") (Var "B")) (Match (Var "p") [(PPair (PVar "x") (PVar "y"), Var "x")]))]
  and sameProgram a (e.elaborate [define "nt" [explicit ["b"] (nm "Bool") nothing] (just (nm "Bool"))
                                    (clausesBody [{ patterns := [pvar "true"], body := nm "false" },
                                                  { patterns := [pvar "false"], body := nm "true" }])])
    [Define "nt" (Pi "b" (Var "Bool") (Var "Bool"))
                 (Lam "b" (Var "Bool") (Match (Var "b") [(PCon "true" [], Var "false"), (PCon "false" [], Var "true")]))]

-- ---------------------------------------------------------------- §5 Elaboration

-- `Bool`, `Maybe` and `Failures` are definitions of core and checks.lth, not rows of elaboration;
-- `quote` gives the `Term` of its term, the value term.lth's `Evaluation` states.
Elaboration (a : Alpha) := ActsCurried a & ActsKept a & Atoms a & Lambdas a & Patterns a & Lists a & TypeForms a
  & OperatorsByType a & Negation a & Conditions a & OperatorOfTheModel a & Records a & Arguments a & Blocks a & Shapes a
