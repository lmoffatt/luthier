-- Random generation, in Luthier. A generator takes a size and a seed and returns a value
-- and the next seed. The size bounds the value: the range of an Int, the length of a list.
-- `test` calls the generator for each variable of a law with sizes growing over the run,
-- and records which generator it used.

import "real"

Gen (A : U) = Nat -> Int -> A * Int    -- size, seed -> value, next seed

nextSeed (s : Int) : Int := (s * 1103515245 + 12345) mod 2147483648

-- a number in [0, n) and the next seed. The high 15 bits of two steps give 30 bits; the low
-- bits of a congruential generator are poor, and one step alone never exceeds 32767.
randBelow (n : Int) (s : Int) : Int * Int :=
  match nextSeed s { s2 -> match nextSeed s2 { s3 -> (((s2 / 65536) * 32768 + s3 / 65536) mod n, s3) } }

genIntBetween (lo hi : Int) : Gen Int := \ size s { match randBelow (hi - lo + 1) s { (k, s2) -> (lo + k, s2) } }

genInt  : Gen Int  := \ size s { genIntBetween (0 - size) size size s }
genNat  : Gen Nat  := \ size s { genIntBetween 0 size size s }
genBool : Gen Bool := \ size s { match randBelow 2 s { (k, s2) -> (k == 1, s2) } }
genR    : Gen R    := \ size s { match randBelow 2000001 s { (k, s2) -> (toR (k - 1000000) / 1000000.0 * toR size, s2) } }

genListN (A : U) (g : Gen A) (len : Int) (size : Nat) (s : Int) : List A * Int :=
  if len <= 0 then (nil A, s)
  else match g size s { (x, s2) -> match genListN A g (len - 1) size s2 { (xs, s3) -> (cons A x xs, s3) } }

genList (A : U) (g : Gen A) : Gen (List A) := \ size s { match randBelow (size + 1) s { (len, s2) -> genListN A g len size s2 } }

gen Int  := genInt
gen Nat  := genNat
gen Bool := genBool
gen R    := genR
