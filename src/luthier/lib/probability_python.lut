-- The generator of standard normals and the Kolmogorov distance of probability.lut, bound to numpy,
-- and their certification.

import "real"
import "algebra"
import "array"
import "array_python"
import "probability"

normalVec := extern "python:luthier.arrays.normal_vec"
kolmogorovDistance := extern "python:luthier.arrays.kolmogorov_distance"

test normalVec with 20
test kolmogorovDistance with 200
