-- test.lth: a test as data, what running it gives, and the grade of what it gives.
--
-- Draft 0, 2026-10-13, by Claude Opus 5.5 in the session (layer 2 of
-- record/plan/luthier-from-zero/plan-from-zero-2026-10-13-execution.md, step 5.1). Sources: spec 7.S20 (`test` is a
-- function with named arguments), 7.R1 (a test names its generators), 7.S8 (budgets), 7.S9 (an
-- entry's identity includes its binding), 7.S10 (grades), 7.S12 (`n` counts evaluated cases),
-- 7.S13 (a known outcome is not recomputed); D9 of record/plan/archive/plan-implementation-2026-10-13-decisions.md
-- (top-level `test` lines are data, `test "x.lut"` the action); laws.lth (evidence and what it
-- settles); generators.lth. Pattern of ebnf.lth.
--
-- What this file states. `test` builds a `TestSpec`, a value the module keeps (D9): what law to
-- test, under which functor and metric, how many cases, at what size, from which seed, with which
-- bindings and budgets. Running it is an action, the module's `test "x.lut"` or `luthier test`;
-- a model of `Tester` runs a spec and gives the evidence of laws.lth, whose coverage is the mode's
-- and whose points number the cases asked unless a budget ran out. The grade is read from the
-- verdict and the evidence.
--
-- Index (all sections written in this draft):
--   §1 The spec: modes, `TestSpec`, `test` with its defaults (7.S20, 7.R1, 7.S8).            done
--   §2 Running: the evidence a run gives, its coverage and its count (7.S12, 7.S13).         done
--   §3 Grades: read from the verdict and the coverage (7.S10).                               done

import "generators.lth" Seed Binding Budgets
import "laws.lth" Evidence Points At Coverage Exhaustive Listed Drawn Verdict Confirmed Refuted Supported
  Unsettled Cites Assumes

-- ---------------------------------------------------------------- §1 The spec

-- How the cases of a test are chosen (7.R1): every value of a finite type, a census listed by
-- hand, or a sample with a metric. Roles: `ModeGivesCoverage`.
MetricName : U := data {
  LinearMetric : MetricName ;
  LogMetric : MetricName ;
}
Mode : U := data {
  ExhaustiveMode : Mode ;
  CensusMode : Mode ;
  SampledMode : MetricName -> Mode ;
}

-- what to test and how (D9: a value the module keeps): the law, the mode, the cases asked, the
-- largest size, the seed, the bindings in `where` and the profile's, the budgets (7.S8, 7.S9)
TestSpec = { law : String, mode : Mode, cases : Nat, size : Nat, seed : Seed,
             whereBindings : List Binding, profile : List Binding, budgets : Budgets }

-- `test`: every option a named argument with a default (7.S20); the budgets' defaults are the
-- numbers today's code holds, named here as defaults and not as constants (7.S8, L5.18)
defaultBudgets : Budgets := { tries := 2000, redraws := 50, probes := 5, drawsPerCase := 10, largestSize := 10,
                              coveringAbove := 20000 }
test (law : String) (mode : Mode <- SampledMode LinearMetric) (cases : Nat <- 100) (size : Nat <- 10)
     (seed : Seed <- 0) (whereBindings : List Binding <- nil) (profile : List Binding <- nil)
     (budgets : Budgets <- defaultBudgets) : TestSpec :=
  { law := law, mode := mode, cases := cases, size := size, seed := seed, whereBindings := whereBindings,
    profile := profile, budgets := budgets }

-- ---------------------------------------------------------------- §2 Running

-- A tester runs a spec and gives the evidence of the law it names (laws.lth): points of the law's
-- domain with their evidence and the coverage the mode gives. It is the action `test "x.lut"`
-- (D9); deterministic given the code, the binding, the seed and `n`, so a known outcome is not
-- recomputed (7.S13), which is the store's and not a law here.
Tester : { run : TestSpec -> Evidence }

coverageOf (e : Evidence) : Maybe Coverage := match e { Points A pts c -> just c ; _ -> nothing }
pointCount (e : Evidence) : Nat := match e { Points A pts c -> countPoints A pts ; _ -> 0 }
countPoints (A : U) (pts : List (A * Evidence)) : Nat := match pts { nil -> 0 ; cons x rest -> 1 + countPoints A rest }
modeCoverage (m : Mode) (s : Seed) : Coverage := match m {
  ExhaustiveMode -> Exhaustive ; CensusMode -> Listed ; SampledMode k -> Drawn s }

-- the coverage of a run is its mode's: exhaustive, a census, or a draw from the spec's seed
ModeGivesCoverage (t : Tester) (s : TestSpec) : Bool :=
  match coverageOf (t.run s) { nothing -> true ; just c -> c == modeCoverage s.mode s.seed }
-- a sampled run gives at most the cases asked, counting the cases evaluated (7.S12); fewer only
-- when a budget ran out, which the entry records
CountsCases (t : Tester) (s : TestSpec) : Bool :=
  match s.mode { SampledMode k -> pointCount (t.run s) <= s.cases ; _ -> true }
Tester := ModeGivesCoverage & CountsCases

-- ---------------------------------------------------------------- §3 Grades

-- The grades of Terms (7.S10): proved, exhaustive, cases, sampled, assumed. A run's grade is read
-- from its verdict and its coverage: a confirmation over all of a finite type is exhaustive, one
-- over a census is cases, a draw is sampled, a citation stands as proved (its source's proof, spec
-- 6), an assumption is assumed; a refutation or nothing settled has no grade.
Grade : U := data {
  Proved : Grade ;
  ExhaustiveGrade : Grade ;
  Cases : Grade ;
  Sampled : Grade ;
  Assumed : Grade ;
}
grade (v : Verdict) (c : Maybe Coverage) : Maybe Grade := match v {
  Confirmed -> (match c { just k -> (match k { Exhaustive -> just ExhaustiveGrade ; Listed -> just Cases ; Drawn s -> just Sampled }) ;
                          nothing -> just Cases }) ;
  Supported -> (match c { just k -> (match k { Drawn s -> just Sampled ; _ -> just Cases }) ; nothing -> just Cases }) ;
  Cites r -> just Proved ;
  Assumes -> just Assumed ;
  _ -> nothing }
-- the roles of the grades: each is the grade of the evidence it names
Grading : { gradeOf : Verdict -> Maybe Coverage -> Maybe Grade }
GradesAsTerms (g : Grading) (s : Seed) (r : String) : Bool :=
  g.gradeOf Confirmed (just Exhaustive) == just ExhaustiveGrade and g.gradeOf Supported (just Listed) == just Cases
  and g.gradeOf Supported (just (Drawn s)) == just Sampled and g.gradeOf (Cites r) nothing == just Proved
  and g.gradeOf Assumes nothing == just Assumed and g.gradeOf Refuted (just Exhaustive) == nothing
Grading := GradesAsTerms
