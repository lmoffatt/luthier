-- program.lth: the rules of the checker as the laws of `WellFormed`.
--
-- Draft 0, 2026-10-13, by Claude Opus 5.5 in the session (step 3.1 of
-- record/plan-from-zero-2026-10-13-execution.md). Sources: spec 4, its rules 4.R1 to 4.R13 and the
-- statements 4.S14, 4.S17, 4.S21, 4.S23, 4.S24; spec 1.S7 (D(n), B(n)); spec 5.S9, 5.S10
-- (`Failures E`); L2.7, L14. The pattern is that of ebnf.lth and term.lth.
--
-- What this file states (4.S21). A model of `WellFormed` is a checker: from a program it gives the
-- failures it finds. Each rule of chapter 4 is a predicate, `violates`, written here as the rule
-- says it, and one generic law, `ReportsExactly`, says the checker reports a failure of that rule
-- for a name exactly when the name violates it. So the rule is stated once, as a predicate, and
-- the checker is held to it; the accept and reject programs of `tests/spec/` are its cases. The
-- Python checker (step 4) is a specimen.
--
-- Which program. The rules read what is written: whether an alias is written with `=` (4.R7),
-- `:=` against `<-` (4.R12), a body that is an `extern` (4.R5). So `WellFormed` takes the surface
-- program of grammar.lth; the rules that need the type of a term (4.R8, 4.R9, 4.R11, 4.R13) read
-- it through a typing, a theory of its own (§4), over the elaborated `Term` of term.lth.
--
-- Index. Status of each section: done, or todo with what it needs. A session or Codex continuing
-- this file takes the first todo, writes it in the pattern of the done ones, checks it with
-- `luthier parse src/luthier/lib/program.lth`, sets its status to done here, and commits.
--
--   §1 Failures and the theory: `Failure`, `WellFormed`, the generic law
--      `ReportsExactly` (4.S21; 5.S9; checks.lth will hold `Failures E`, 5.S10).        done
--   §2 Names: the acts' names, D(n) and B(n) on the surface tree (1.S7). Type and
--      term position (4.S2) still to add, for 4.R2.                                 done
--   §3 The rules that read names and forms: 4.R1, 4.R2, 4.R3 (with L2.7 on `data`),
--      4.R4, 4.R5, 4.R7, 4.R12 (top level), 4.S14; 4.R6 needs types (§5); 4.R2
--      past existence and 4.R12 in blocks still to add; 4.S17 a report (§6).           done
--   §4 Typing: a theory `Typing` giving the type of an elaborated term, held to
--      the formers of 3 §2; what the rules below need of it, nothing more.           todo
--   §5 The rules that read types: 4.R8, 4.R9, 4.R11, 4.R13, 4.S23 (implicit
--      arguments).                                                                   todo
--   §6 What a test cannot decide: 4.R10 (a law characterizes) and 4.S20 are
--      reports, not failures (4.S19, 4.S20); stated as such.                          todo
--   §7 `WellFormed :=` the conjunction, one `ReportsExactly` per rule.                 todo

import "grammar.lth" SurfaceProgram SurfaceAct Surface SurfacePattern LambdaParam Item Field Binder Body
  Clause ImportName declare define alias importAct operatorAct datum explicit implicit termBody dataBody
  clausesBody name literal universe world app binop neg tuple pi sigma sigmaNamed sumNamed record
  subtype recordValue block sum list lambda matchOf namedArg ifThen proj quoted pWild pApp pLit pTuple
  plainParam typedParam shapeParam bind rebind

-- ---------------------------------------------------------------- §1 Failures and the theory

-- A failure names its rule, the name it is about, and says why (5.S9: a check is written in the
-- form that explains its failures). `Failures E` of 5.S9 is the list of them; its projections are
-- checks.lth's (5.S10, step 3.3).
Failure = { rule : String, name : String, message : String }

-- A checker: the failures it finds in a program (4.S21).
WellFormed : { check : SurfaceProgram -> List Failure }

member (x : String) (xs : List String) : Bool := match xs { nil -> false ; cons y rest -> x == y or member x rest }
concat (xs ys : List String) : List String := match xs { nil -> ys ; cons x rest -> cons x (concat rest ys) }
remove (x : String) (xs : List String) : List String :=
  match xs { nil -> nil ; cons y rest -> if x == y then remove x rest else cons y (remove x rest) }
removeAll (xs ys : List String) : List String := match xs { nil -> ys ; cons x rest -> removeAll rest (remove x ys) }

reported (fs : List Failure) (rule n : String) : Bool :=
  match fs { nil -> false ; cons f rest -> (f.rule == rule and f.name == n) or reported rest rule n }

-- a program and one of the names its acts introduce: what a rule is about; drawn from the program,
-- since a random name is almost never one of them (7.S12)
NamedIn : U := { p : SurfaceProgram, n : String | member n (actNames p) }

-- The one law: for each rule, the checker reports a failure of that rule for a name exactly when
-- the name violates the rule. The rule and its predicate come first, so `ReportsExactly "4.R1"
-- violatesR1` is the law of 4.R1 (§7).
ReportsExactly (rule : String) (violates : SurfaceProgram -> String -> Bool) (w : WellFormed) (c : NamedIn) : Bool :=
  reported (w.check c.p) rule c.n == violates c.p c.n
-- and it reports nothing about names the program does not introduce
ReportsOnItsNames (w : WellFormed) (p : SurfaceProgram) : Bool := failuresNamed (w.check p) (actNames p)
failuresNamed (fs : List Failure) (ns : List String) : Bool :=
  match fs { nil -> true ; cons f rest -> member f.name ns and failuresNamed rest ns }

-- ---------------------------------------------------------------- §2 Names

-- the name an act introduces, if any, and the names of a program
actName (a : SurfaceAct) : Maybe String := match a {
  declare x bs t -> just x ; define x bs t b -> just x ; alias x bs t -> just x ;
  importAct f ns -> nothing ; operatorAct o t -> nothing ; datum t -> nothing ;
}
actNames (p : SurfaceProgram) : List String :=
  match p { nil -> nil ; cons a rest -> match actName a { nothing -> actNames rest ; just x -> cons x (actNames rest) } }
importedNames (p : SurfaceProgram) : List String := match p { nil -> nil ;
  cons a rest -> match a { importAct f ns -> concat (importNames ns) (importedNames rest) ; _ -> importedNames rest } }
importNames (ns : List ImportName) : List String := match ns { nil -> nil ;
  cons i rest -> cons (match i.asName { nothing -> i.name ; just y -> y }) (importNames rest) }

isDeclared (p : SurfaceProgram) (n : String) : Bool :=
  match p { nil -> false ; cons a rest -> match a { declare x bs t -> x == n or isDeclared rest n ; _ -> isDeclared rest n } }
isDefined (p : SurfaceProgram) (n : String) : Bool :=
  match p { nil -> false ; cons a rest -> match a { define x bs t b -> x == n or isDefined rest n ; _ -> isDefined rest n } }
isAlias (p : SurfaceProgram) (n : String) : Bool :=
  match p { nil -> false ; cons a rest -> match a { alias x bs t -> x == n or isAlias rest n ; _ -> isAlias rest n } }
-- a name is known when the program introduces it, imports it, or core gives it (`core` the list of
-- core's names, a parameter of the rules: core is not written yet, 12.S21)
known (core : List String) (p : SurfaceProgram) (n : String) : Bool :=
  member n (actNames p) or member n (importedNames p) or member n core

-- The constructors of the `data` of a program: a pattern `name` is one of them if it names one,
-- and a variable otherwise (2.S10, 2.S13).
constructors (p : SurfaceProgram) : List String := match p { nil -> nil ;
  cons a rest -> match a { define x bs t b -> concat (bodyConstructors b) (constructors rest) ; _ -> constructors rest } }
bodyConstructors (b : Body) : List String := match b { dataBody cs -> pairNames cs ; _ -> nil }
pairNames (kvs : List (String * Surface)) : List String := match kvs { nil -> nil ; cons (k, v) rest -> cons k (pairNames rest) }

-- the variables a pattern binds, given the constructors `k`
patternBinds (k : List String) (q : SurfacePattern) : List String := match q {
  pWild -> nil ; pLit l -> nil ;
  pApp n qs -> if member n k then patternsBind k qs else (match qs { nil -> [n] ; _ -> patternsBind k qs }) ;
  pTuple qs -> patternsBind k qs ;
}
patternsBind (k : List String) (qs : List SurfacePattern) : List String :=
  match qs { nil -> nil ; cons q rest -> concat (patternBinds k q) (patternsBind k rest) }

-- spec 1.S7: the names found in a term, less those it binds; operators are core's and not counted
namesIn (k : List String) (t : Surface) : List String := match t {
  name s -> [s] ;
  literal l -> nil ; universe -> nil ; world -> nil ;
  app f a -> concat (namesIn k f) (namesIn k a) ;
  binop o a b -> concat (namesIn k a) (namesIn k b) ;
  neg a -> namesIn k a ; quoted a -> namesIn k a ; namedArg x a -> namesIn k a ; proj a x -> namesIn k a ;
  tuple ts -> namesInAll k ts ; list ts -> namesInAll k ts ;
  pi xs a b -> concat (namesIn k a) (removeAll xs (namesIn k b)) ;
  sigma xs a b -> concat (namesIn k a) (removeAll xs (namesIn k b)) ;
  sigmaNamed x a y b -> concat (namesIn k a) (remove x (remove y (namesIn k b))) ;
  sumNamed x a y b -> concat (namesIn k a) (namesIn k b) ;
  record fs law -> concat (fieldsNames k fs) (match law { nothing -> nil ; just l -> removeAll (fieldLabels fs) (namesIn k l) }) ;
  subtype q a law -> concat (namesIn k a) (removeAll (patternBinds k q) (namesIn k law)) ;
  recordValue kvs -> pairsNames k kvs ; sum kvs -> pairsNames k kvs ;
  block items e -> itemsNames k items e ;
  lambda ps items e -> concat (paramsNames k ps) (removeAll (paramsBind k ps) (itemsNames k items e)) ;
  matchOf s arms -> concat (namesIn k s) (armsNames k arms) ;
  ifThen c a b -> concat (namesIn k c) (concat (namesIn k a) (match b { nothing -> nil ; just e -> namesIn k e })) ;
}
namesInAll (k : List String) (ts : List Surface) : List String :=
  match ts { nil -> nil ; cons t rest -> concat (namesIn k t) (namesInAll k rest) }
pairsNames (k : List String) (kvs : List (String * Surface)) : List String :=
  match kvs { nil -> nil ; cons (x, v) rest -> concat (namesIn k v) (pairsNames k rest) }
fieldLabels (fs : List Field) : List String := match fs { nil -> nil ; cons f rest -> concat f.names (fieldLabels rest) }
fieldsNames (k : List String) (fs : List Field) : List String :=
  match fs { nil -> nil ; cons f rest -> concat (namesIn k f.type) (fieldsNames k rest) }
-- a block's items bind in what follows them
itemsNames (k : List String) (items : List Item) (e : Surface) : List String := match items {
  nil -> namesIn k e ;
  cons it rest -> match it {
    bind x t -> concat (namesIn k t) (remove x (itemsNames k rest e)) ;
    rebind x t -> concat (namesIn k t) (itemsNames k rest e) } }
paramsBind (k : List String) (ps : List LambdaParam) : List String := match ps { nil -> nil ;
  cons q rest -> concat (match q { plainParam x -> [x] ; typedParam xs t -> xs ; shapeParam qs -> patternsBind k qs })
                        (paramsBind k rest) }
paramsNames (k : List String) (ps : List LambdaParam) : List String := match ps { nil -> nil ;
  cons q rest -> concat (match q { typedParam xs t -> namesIn k t ; _ -> nil }) (paramsNames k rest) }
armsNames (k : List String) (arms : List (SurfacePattern * Surface)) : List String := match arms { nil -> nil ;
  cons (q, b) rest -> concat (removeAll (patternBinds k q) (namesIn k b)) (armsNames k rest) }

-- D(n) and B(n) of 1.S7: the names in the declared type of `n` (its binders included) and in its
-- body, each less the binders' own names
binderNames (k : List String) (bs : List Binder) : List String := match bs { nil -> nil ;
  cons b rest -> concat (match b { explicit xs t d -> concat (namesIn k t) (match d { nothing -> nil ; just e -> namesIn k e }) ;
                                   implicit xs t -> namesIn k t })
                        (binderNames k rest) }
binderBound (bs : List Binder) : List String := match bs { nil -> nil ;
  cons b rest -> concat (match b { explicit xs t d -> xs ; implicit xs t -> xs }) (binderBound rest) }
bodyNames (k : List String) (b : Body) : List String := match b {
  termBody t -> namesIn k t ;
  dataBody cs -> pairsNames k cs ;
  clausesBody cs -> clausesNames k cs ;
}
clausesNames (k : List String) (cs : List Clause) : List String := match cs { nil -> nil ;
  cons c rest -> concat (removeAll (patternsBind k c.patterns) (namesIn k c.body)) (clausesNames k rest) }
dOf (p : SurfaceProgram) (a : SurfaceAct) : List String := match a {
  declare x bs t -> concat (binderNames (constructors p) bs) (removeAll (binderBound bs) (namesIn (constructors p) t)) ;
  define x bs t b -> concat (binderNames (constructors p) bs)
                            (match t { nothing -> nil ; just u -> removeAll (binderBound bs) (namesIn (constructors p) u) }) ;
  alias x bs t -> concat (binderNames (constructors p) bs) (removeAll (binderBound bs) (namesIn (constructors p) t)) ;
  _ -> nil ;
}
bOf (p : SurfaceProgram) (a : SurfaceAct) : List String := match a {
  define x bs t b -> removeAll (binderBound bs) (bodyNames (constructors p) b) ;
  _ -> nil ;
}

-- ---------------------------------------------------------------- §3 The rules that read names and forms

-- core's names: core encloses every file (12.S21) and is not written yet, so its names are a hole
coreNames : List String

actsNamed (p : SurfaceProgram) (n : String) : List SurfaceAct := match p { nil -> nil ;
  cons a rest -> match actName a { just x -> if x == n then cons a (actsNamed rest n) else actsNamed rest n ;
                                   nothing -> actsNamed rest n } }
anyUnknown (p : SurfaceProgram) (ms : List String) : Bool :=
  match ms { nil -> false ; cons m rest -> not (known coreNames p m) or anyUnknown p rest }
anyAct (f : SurfaceAct -> Bool) (acts : List SurfaceAct) : Bool :=
  match acts { nil -> false ; cons a rest -> f a or anyAct f rest }
count (n : String) (xs : List String) : Nat := match xs { nil -> 0 ; cons x rest -> (if x == n then 1 else 0) + count n rest }
definedNames (p : SurfaceProgram) : List String :=
  match p { nil -> nil ; cons a rest -> match a { define x bs t b -> cons x (definedNames rest) ; _ -> definedNames rest } }

-- 4.R1: a declaration mentions only names that exist, declared or defined (or imported, or core's)
violatesR1 (p : SurfaceProgram) (n : String) : Bool :=
  anyAct (\ a { match a { declare x bs t -> anyUnknown p (dOf p a) ; _ -> false } }) (actsNamed p n)

-- 4.R2, the part that reads names: the names a definition mentions exist. That a name in type
-- position is defined unless it is in the definition's own theory needs type position (4.S2) and
-- the theories (4.S3, the strongly connected components): todo, §2.
violatesR2Exists (p : SurfaceProgram) (n : String) : Bool :=
  anyAct (\ a { match a { define x bs t b -> anyUnknown p (concat (dOf p a) (bOf p a)) ; _ -> false } }) (actsNamed p n)

-- 4.R3: a predicate touches what it is over: every label of a record with a law, the variables of
-- a subtype's pattern; and (L2.7, D-2026-10-13-p) every constructor of a `data` is mentioned by
-- some law. A law is read here as a definition whose declared type is `Bool`, until typing (§4)
-- can say which definitions are laws; whether the law states the constructor's role, and not
-- only lists it, a test cannot decide (4.S19 reports it).
untouched (k : List String) (labels : List String) (law : Surface) : Bool :=
  match labels { nil -> false ; cons l rest -> not (member l (namesIn k law)) or untouched k rest law }
predicateUntouched (k : List String) (t : Surface) : Bool := match t {
  record fs law -> match law { nothing -> false ; just l -> untouched k (fieldLabels fs) l } ;
  subtype q a law -> untouched k (patternBinds k q) law ;
  _ -> false ;
}
lawNames (p : SurfaceProgram) : List String := match p { nil -> nil ; cons a rest -> match a {
  define x bs t b -> (match t { just (name "Bool") -> concat (bOf p a) (lawNames rest) ; _ -> lawNames rest }) ;
  _ -> lawNames rest } }
anyUnclaimed (p : SurfaceProgram) (cs : List String) : Bool :=
  match cs { nil -> false ; cons c rest -> not (member c (lawNames p)) or anyUnclaimed p rest }
violatesR3 (p : SurfaceProgram) (n : String) : Bool :=
  anyAct (\ a { match a {
    define x bs t b -> (match b { termBody u -> predicateUntouched (constructors p) u ;
                                  dataBody cs -> anyUnclaimed p (pairNames cs) ; _ -> false }) ;
    _ -> false } }) (actsNamed p n)

-- 4.R4: a definition at `U` makes a new type only with laws or a `data`; an anonymous structural
-- body (a product, an exponential, a sum, a record without a law) is to be an alias
structural (t : Surface) : Bool := match t {
  binop o a b -> o == "*" or o == "->" or o == "+" ;
  pi xs a b -> true ; sigma xs a b -> true ; sigmaNamed x a y b -> true ; sumNamed x a y b -> true ;
  sum kvs -> true ; record fs law -> law == nothing ;
  _ -> false ;
}
violatesR4 (p : SurfaceProgram) (n : String) : Bool :=
  anyAct (\ a { match a { define x bs t b -> t == just universe and (match b { termBody u -> structural u ; _ -> false }) ;
                          _ -> false } }) (actsNamed p n)

-- 4.R5: an extern gives a value, never a type, unless it is provisional
isExtern (t : Surface) : Bool := match t { app f a -> isExtern f ; name s -> s == "extern" ; _ -> false }
isProvisional (t : Surface) : Bool :=
  match t { app f a -> (match a { namedArg x v -> x == "provisional" ; _ -> false }) or isProvisional f ; _ -> false }
violatesR5 (p : SurfaceProgram) (n : String) : Bool :=
  anyAct (\ a { match a { define x bs t b -> t == just universe
                            and (match b { termBody u -> isExtern u and not (isProvisional u) ; _ -> false }) ;
                          _ -> false } }) (actsNamed p n)

-- 4.R7: an alias is neither declared nor defined
violatesR7 (p : SurfaceProgram) (n : String) : Bool := isAlias p n and (isDeclared p n or isDefined p n)

-- 4.R12 at the top level: `:=` defines once (a `<-` there does not parse, 2.R5). Inside blocks,
-- `:=` of a name already bound and `<-` of a name bound with `:=`: todo, a walk of the bodies.
violatesR12 (p : SurfaceProgram) (n : String) : Bool := count n (definedNames p) >= 2

-- 4.S14: a law no type claims defines nothing; read, as in 4.R3, as a definition at `Bool` that
-- no other definition's body mentions
otherBodies (p : SurfaceProgram) (n : String) : List String := match p { nil -> nil ; cons a rest -> match a {
  define x bs t b -> if x == n then otherBodies rest n else concat (bOf p a) (otherBodies rest n) ;
  _ -> otherBodies rest n } }
violatesS14 (p : SurfaceProgram) (n : String) : Bool :=
  anyAct (\ a { match a { define x bs t b -> t == just (name "Bool") and not (member n (otherBodies p n)) ; _ -> false } })
         (actsNamed p n)

-- 4.S17, no loose functions, rejects only once local definitions exist; until then it is a report
-- (§6), and the theory files themselves hold such helpers, as 12.S23 allows.
