-- Equality demands parts: term.lth at 924df6b; Claude Sonnet agent, recorded in codex.md.
-- These are candidate models: parse does not certify the laws. See the report's manual audit.
import "term.lth" Constant Pattern Term Act Program Alpha Substitution CanonicalForm Reduction
  IntConst FloatConst StringConst PVar PWild PCon PPair PLit PInj
  Var Lit Universe World Lam App Pi Sigma Pair Match Inj Sum Data Subtype Extern Primitive Axiom Hole Record RecordValue Proj Let
  Declare Define Datum member remove concat removeAll freeVars patternVars patternsVars swap swapPattern
  partsAgree sameNames free

-- Spec 11 gives String equality but no text decomposition, concatenation or Nat rendering.
-- Parameters (holes), not invented core primitives. Required contracts: Unicode scalar sequence
-- round trip; join concatenates; decimal renders a Nat without leading zeros (0 becomes "0").
textParts : String -> List String
textJoin : List String -> String
natDecimal : Nat -> String
textAppend (x y : String) : String := textJoin (appendText (textParts x) (textParts y))
appendText (xs ys : List String) : List String := match xs {
  nil -> ys ; cons x rest -> cons x (appendText rest ys) }
unqualified (s : String) : String := textJoin (lastComponent (textParts s) nil)
lastComponent (xs acc : List String) : List String := match xs {
  nil -> acc ; cons x rest -> lastComponent rest (if x == "." then nil else appendText acc [x]) }
freshName (x : String) (avoid : List String) : String :=
  if member x avoid then freshName (textAppend x "'") avoid else x

-- All variable and binder names, including shadowed ones: nominal swapping needs more than FV.
allNames (t : Term) : List String := match t {
  Var x -> [x] ;
  Lam x a b -> cons x (concat (allNames a) (allNames b)) ;
  Pi x a b -> cons x (concat (allNames a) (allNames b)) ;
  Sigma x a b -> cons x (concat (allNames a) (allNames b)) ;
  Subtype x a b -> cons x (concat (allNames a) (allNames b)) ;
  Let x ty v b -> cons x (concat (allNames ty) (concat (allNames v) (allNames b))) ;
  App a b -> concat (allNames a) (allNames b) ; Pair a b -> concat (allNames a) (allNames b) ;
  Inj l a -> allNames a ; Match a arms -> concat (allNames a) (armNames arms) ;
  Sum kvs -> pairNames kvs ; Data x cs -> cons x (pairNames cs) ;
  Record kvs -> pairNames kvs ; RecordValue kvs -> pairNames kvs ; Proj r x -> allNames r ; _ -> nil ; }
armNames (xs : List (Pattern * Term)) : List String := match xs {
  nil -> nil ; cons (p, b) rest -> concat (patternVars p) (concat (allNames b) (armNames rest)) }
pairNames (xs : List (String * Term)) : List String := match xs {
  nil -> nil ; cons (k, b) rest -> concat (allNames b) (pairNames rest) }

-- Exact recursive parts, with per-arm free-name agreement to prevent capture.
-- §2 compares Data through underBinderPairs and patterns through simultaneous renameAll.
-- Repeated pattern names must occupy the same positions on both sides; linear patterns
-- always pass this additional check. No pattern variable is compared literally.
appendEnv (xs ys : List (String * String)) : List (String * String) := match xs {
  nil -> ys ; cons x rest -> cons x (appendEnv rest ys) }
armScopesAgree (ps qs : List (Pattern * Term)) : Bool := match (ps, qs) {
  (nil, nil) -> true ; (cons (p, b) rest, cons (q, c) more) ->
    sameNames (removeAll (patternVars p) (freeVars b)) (removeAll (patternVars q) (freeVars c))
    and bindingPositionsAgree (patternVars p) (patternVars q) and armScopesAgree rest more ; _ -> false }
bindingPositionsAgree (xs ys : List String) : Bool := match (xs, ys) {
  (nil, nil) -> true ; (cons x rest, cons y more) ->
    repeatsAgree x y rest more and bindingPositionsAgree rest more ; _ -> false }
repeatsAgree (x y : String) (xs ys : List String) : Bool := match (xs, ys) {
  (nil, nil) -> true ; (cons u rest, cons v more) ->
    (x == u) == (y == v) and repeatsAgree x y rest more ; _ -> false }
alphaParts (s t : Term) : Bool :=
  sameNames (freeVars s) (freeVars t) and partsAgree alpha s t
  and (match (s, t) { (Match u ps, Match v qs) -> armScopesAgree ps qs ; _ -> true })
alpha : Alpha := { alphaEq := alphaParts }

-- Substitution short-circuits when absent; types are outside their binder's scope.
substTerm (x : String) (s t : Term) : Term :=
  if not (member x (freeVars t)) then t else match t {
  Var y -> if x == y then s else t ;
  Lam y a b -> match substBody x s y b { (z, c) -> Lam z (substTerm x s a) c } ;
  Pi y a b -> match substBody x s y b { (z, c) -> Pi z (substTerm x s a) c } ;
  Sigma y a b -> match substBody x s y b { (z, c) -> Sigma z (substTerm x s a) c } ;
  Subtype y a b -> match substBody x s y b { (z, c) -> Subtype z (substTerm x s a) c } ;
  Let y ty v b -> match substBody x s y b {
    (z, c) -> Let z (substTerm x s ty) (substTerm x s v) c } ;
  App a b -> App (substTerm x s a) (substTerm x s b) ;
  Pair a b -> Pair (substTerm x s a) (substTerm x s b) ;
  Inj l a -> Inj l (substTerm x s a) ; Match a arms -> Match (substTerm x s a) (substArms x s arms) ;
  Sum kvs -> Sum (substPairs x s kvs) ;
  Record kvs -> Record (substPairs x s kvs) ;
  RecordValue kvs -> RecordValue (substPairs x s kvs) ;
  Proj r l -> Proj (substTerm x s r) l ;
  Data y cs -> if x == y then t else match freshData x s y cs { (z, ds) -> Data z (substPairs x s ds) } ;
  _ -> t ; }
substBody (x : String) (s : Term) (y : String) (b : Term) : String * Term :=
  if x == y or not (member x (freeVars b)) then (y, b)
  else if member y (freeVars s) then substRenamed x s y b (freshName y (cons x (concat (allNames s) (allNames b))))
  else (y, substTerm x s b)
substRenamed (x : String) (s : Term) (y : String) (b : Term) (z : String) : String * Term :=
  (z, substTerm x s (swap y z b))
freshData (x : String) (s : Term) (y : String) (cs : List (String * Term)) : String * List (String * Term) :=
  if member y (freeVars s) then renameData y cs (freshName y (cons x (concat (allNames s) (pairNames cs)))) else (y, cs)
renameData (y : String) (cs : List (String * Term)) (z : String) : String * List (String * Term) :=
  (z, swapLocalPairs y z cs)
swapLocalPairs (y z : String) (cs : List (String * Term)) : List (String * Term) := match cs {
  nil -> nil ; cons (k, b) rest -> cons (k, swap y z b) (swapLocalPairs y z rest) }
substPairs (x : String) (s : Term) (cs : List (String * Term)) : List (String * Term) := match cs {
  nil -> nil ; cons (k, b) rest -> cons (k, substTerm x s b) (substPairs x s rest) }
substArms (x : String) (s : Term) (arms : List (Pattern * Term)) : List (Pattern * Term) := match arms {
  nil -> nil ; cons (p, b) rest -> cons (substArm x s p b) (substArms x s rest) }
substArm (x : String) (s : Term) (p : Pattern) (b : Term) : Pattern * Term :=
  if member x (patternVars p) or not (member x (freeVars b)) then (p, b)
  else match freshArm x s (patternVars p) p b { (q, c) -> (q, substTerm x s c) }
freshArm (x : String) (s : Term) (vs : List String) (p : Pattern) (b : Term) : Pattern * Term := match vs {
  nil -> (p, b) ; cons y rest ->
    if member y (freeVars s) then renameArm x s y rest p b
      (freshName y (cons x (concat (allNames s) (concat (patternVars p) (allNames b)))))
    else freshArm x s rest p b }
renameArm (x : String) (s : Term) (y : String) (rest : List String) (p : Pattern) (b : Term) (z : String) : Pattern * Term :=
  freshArm x s (remove y rest) (swapPattern y z p) (swap y z b)
substitute : Substitution alpha := { subst := substTerm }

-- A global preorder counter, skipping every unqualified free name, prevents capture.
-- Tags/labels, extern routes and hole identities stay literal: they are not module variables.
canonName (n : Nat) : String := textAppend "x" (natDecimal n)
nextBinder (avoid : List String) (n : Nat) : String * Nat :=
  if member (canonName n) avoid then nextBinder avoid (n + 1) else (canonName n, n + 1)
freeCanonical (xs : List String) : List String := match xs {
  nil -> nil ; cons x rest -> cons (unqualified x) (freeCanonical rest) }
resolveName (env : List (String * String)) (x : String) : String := match env {
  nil -> unqualified x ; cons (a, b) rest -> if x == a then b else resolveName rest x }
canonTerm (avoid : List String) (env : List (String * String)) (n : Nat) (t : Term) : Term * Nat := match t {
  Var x -> (Var (resolveName env x), n) ;
  Lam x a b -> match nextBinder avoid n { (y, n1) ->
    match canonTerm avoid env n1 a { (c, n2) ->
      match canonTerm avoid (cons (x, y) env) n2 b { (d, n3) -> (Lam y c d, n3) } } } ;
  Pi x a b -> match nextBinder avoid n { (y, n1) ->
    match canonTerm avoid env n1 a { (c, n2) ->
      match canonTerm avoid (cons (x, y) env) n2 b { (d, n3) -> (Pi y c d, n3) } } } ;
  Sigma x a b -> match nextBinder avoid n { (y, n1) ->
    match canonTerm avoid env n1 a { (c, n2) ->
      match canonTerm avoid (cons (x, y) env) n2 b { (d, n3) -> (Sigma y c d, n3) } } } ;
  Subtype x a b -> match nextBinder avoid n { (y, n1) ->
    match canonTerm avoid env n1 a { (c, n2) ->
      match canonTerm avoid (cons (x, y) env) n2 b { (d, n3) -> (Subtype y c d, n3) } } } ;
  Let x ty v b -> match nextBinder avoid n { (y, n1) ->
    match canonTerm avoid env n1 ty { (d, n2) ->
      match canonTerm avoid env n2 v { (w, n3) ->
        match canonTerm avoid (cons (x, y) env) n3 b { (c, n4) -> (Let y d w c, n4) } } } } ;
  App a b -> match canonTerm avoid env n a { (c, n1) ->
    match canonTerm avoid env n1 b { (d, n2) -> (App c d, n2) } } ;
  Pair a b -> match canonTerm avoid env n a { (c, n1) ->
    match canonTerm avoid env n1 b { (d, n2) -> (Pair c d, n2) } } ;
  Inj l a -> match canonTerm avoid env n a { (b, n1) -> (Inj l b, n1) } ;
  Sum kvs -> match canonPairs avoid env n kvs { (cs, n1) -> (Sum cs, n1) } ;
  Record kvs -> match canonPairs avoid env n kvs { (cs, n1) -> (Record cs, n1) } ;
  RecordValue kvs -> match canonPairs avoid env n kvs { (cs, n1) -> (RecordValue cs, n1) } ;
  Proj r x -> match canonTerm avoid env n r { (s, n1) -> (Proj s x, n1) } ;
  Data x kvs -> match nextBinder avoid n { (y, n1) ->
    match canonPairs avoid (cons (x, y) env) n1 kvs { (cs, n2) -> (Data y cs, n2) } } ;
  Match a arms -> match canonTerm avoid env n a { (b, n1) ->
    match canonArms avoid env n1 arms { (bs, n2) -> (Match b bs, n2) } } ;
  _ -> (t, n) ; }
canonPairs (avoid : List String) (env : List (String * String)) (n : Nat) (xs : List (String * Term)) : List (String * Term) * Nat := match xs {
  nil -> (nil, n) ; cons (k, a) rest -> match canonTerm avoid env n a { (b, n1) ->
    match canonPairs avoid env n1 rest { (bs, n2) -> (cons (k, b) bs, n2) } } }
canonBindings (avoid : List String) (n : Nat) (xs : List String) : List (String * String) * Nat := match xs {
  nil -> (nil, n) ; cons x rest -> match nextBinder avoid n { (y, n1) ->
    match canonBindings avoid n1 (remove x rest) { (bs, n2) -> (cons (x, y) bs, n2) } } }
canonPattern (env : List (String * String)) (p : Pattern) : Pattern := match p {
  PVar x -> PVar (resolveName env x) ; PCon c ps -> PCon c (canonPatterns env ps) ;
  PPair a b -> PPair (canonPattern env a) (canonPattern env b) ;
  PInj l q -> PInj l (canonPattern env q) ; _ -> p ; }
canonPatterns (env : List (String * String)) (ps : List Pattern) : List Pattern := match ps {
  nil -> nil ; cons p rest -> cons (canonPattern env p) (canonPatterns env rest) }
canonArms (avoid : List String) (env : List (String * String)) (n : Nat) (xs : List (Pattern * Term)) : List (Pattern * Term) * Nat := match xs {
  nil -> (nil, n) ; cons (p, a) rest -> match canonBindings avoid n (patternVars p) { (bs, n1) ->
    match canonTerm avoid (appendEnv bs env) n1 a { (b, n2) ->
      match canonArms avoid env n2 rest { (cs, n3) -> (cons (canonPattern bs p, b) cs, n3) } } } }
canonicalTerm (t : Term) : Term := match canonTerm (freeCanonical (freeVars t)) nil 0 t { (b, n) -> b }
canonical : CanonicalForm alpha := { canon := canonicalTerm, unqualify := unqualified }

-- One exact weak-head transition; Done is a value or a stuck term.
-- The step results here are the model's own bookkeeping: no law states a role for their
-- alternatives, so they are aliases of sums and not `data` (4.R3, L2.7, D-2026-10-13-aa); an
-- alternative of type `Unit` is injected by its label alone (3.S4).
HeadStep = { Done : Term || Next : Term }
lookupBody (p : Program) (x : String) : Maybe Term := match p {
  nil -> nothing ; cons act rest -> match act {
    Define y ty b -> if x == y then just b else lookupBody rest x ;
    _ -> lookupBody rest x } }
Bindings = List (String * Term)
appendBindings (xs ys : Bindings) : Bindings := match xs {
  nil -> ys ; cons x rest -> cons x (appendBindings rest ys) }
bindingNames (xs : Bindings) : List String := match xs {
  nil -> nil ; cons (x, v) rest -> cons x (bindingNames rest) }
bindingTermNames (xs : Bindings) : List String := match xs {
  nil -> nil ; cons (x, v) rest -> concat (allNames v) (bindingTermNames rest) }
linearBindings (xs : Bindings) : Bool := match xs {
  nil -> true ; cons (x, v) rest -> not (member x (bindingNames rest)) and linearBindings rest }
-- Rename every bound occurrence to a distinct temporary absent from the body and
-- every replacement, then substitute replacements. No replacement is revisited.
applyBindings (xs : Bindings) (b : Term) : Term := match xs {
  nil -> b ; cons (x, v) nil -> substTerm x v b ;
  _ -> stageBindings xs b (concat (allNames b) (concat (bindingNames xs) (bindingTermNames xs))) nil }
stageBindings (xs : Bindings) (b : Term) (avoid : List String) (ready : Bindings) : Term := match xs {
  nil -> finishBindings ready b ; cons (x, v) rest ->
    stageBinding x v rest b avoid ready (freshName x avoid) }
stageBinding (x : String) (v : Term) (rest : Bindings) (b : Term)
             (avoid : List String) (ready : Bindings) (z : String) : Term :=
  stageBindings rest (substTerm x (Var z) b) (cons z avoid) (cons (z, v) ready)
finishBindings (xs : Bindings) (b : Term) : Term := match xs {
  nil -> b ; cons (x, v) rest -> finishBindings rest (substTerm x v b) }
truthTerm (b : Bool) : Term := Var (if b then "true" else "false")
primitiveResult (op : String) (i j : Term) : Maybe Term := match (i, j) {
  (Lit (IntConst a), Lit (IntConst b)) ->
    if op == "+" then just (Lit (IntConst (a + b)))
    else if op == "*" then just (Lit (IntConst (a * b)))
    else if op == "-" then just (Lit (IntConst (a - b)))
    else if op == "<" then just (truthTerm (a < b))
    else if op == "==" then just (truthTerm (a == b)) else nothing ;
  (Lit (FloatConst a), Lit (FloatConst b)) ->
    if op == "+" then just (Lit (FloatConst (a + b))) else nothing ;
  (Lit (StringConst a), Lit (StringConst b)) ->
    if op == "==" then just (truthTerm (a == b)) else nothing ; _ -> nothing }
-- Equality has its own closed-value domain; the permissive Iota classifier is not enough.
-- Check both entire values before comparing, even when an outer label already differs.
constructorType (env : Program) (x : String) : Maybe Term := match env {
  nil -> nothing ; cons act rest -> match act {
    Define t ty (Data self cs) -> match lookupField cs x {
      just a -> just a ; nothing -> constructorType rest x } ;
    _ -> constructorType rest x } }
saturatedParts (ty : Term) (args : List Term) : Bool := match (ty, args) {
  (Pi x a b, cons v rest) -> saturatedParts b rest ;
  (Pi x a b, nil) -> false ; (_, nil) -> true ; _ -> false }
equalityConstructor (p : Program) (t : Term) : Maybe (String * List Term) :=
  match constructorTerms p t nil { nothing -> nothing ; just (c, vs) ->
    match constructorType p c { nothing -> nothing ; just ty ->
      if saturatedParts ty vs then just (c, vs) else nothing } }
concreteValue (p : Program) (t : Term) : Bool := match t {
  Lit c -> true ; Pair a b -> concreteValue p a and concreteValue p b ;
  Inj l a -> concreteValue p a ; RecordValue fs -> concreteFields p fs ;
  _ -> match equalityConstructor p t { nothing -> false ; just (c, vs) -> concreteTerms p vs } }
concreteFields (p : Program) (fs : List (String * Term)) : Bool := match fs {
  nil -> true ; cons (k, v) rest -> concreteValue p v and concreteFields p rest }
concreteTerms (p : Program) (vs : List Term) : Bool := match vs {
  nil -> true ; cons v rest -> concreteValue p v and concreteTerms p rest }
-- These comparisons are called only after the complete concrete-value check.
equalValues (p : Program) (s t : Term) : Bool := match (s, t) {
  (Lit (IntConst a), Lit (IntConst b)) -> a == b ;
  (Lit (FloatConst a), Lit (FloatConst b)) -> a == b ;
  (Lit (StringConst a), Lit (StringConst b)) -> a == b ;
  (Pair a b, Pair c d) -> equalValues p a c and equalValues p b d ;
  (Inj l a, Inj k b) -> l == k and equalValues p a b ;
  (RecordValue fs, RecordValue gs) -> equalFields p fs gs and equalFields p gs fs ;
  _ -> match (equalityConstructor p s, equalityConstructor p t) {
    (just (c, vs), just (d, ws)) -> c == d and equalTerms p vs ws ; _ -> false } }
equalTerms (p : Program) (vs ws : List Term) : Bool := match (vs, ws) {
  (nil, nil) -> true ; (cons v rest, cons w more) -> equalValues p v w and equalTerms p rest more ;
  _ -> false }
equalFields (p : Program) (fs gs : List (String * Term)) : Bool := match fs {
  nil -> true ; cons (k, v) rest -> match lookupField gs k {
    nothing -> false ; just w -> equalValues p v w and equalFields p rest gs } }
-- EqualityDemandsParts: a part that is not yet a value is reduced in place, leftmost first,
-- after the operand's head has stepped; a part that cannot become a value leaves == stuck.
stepValue (p : Program) (t : Term) : Maybe Term := match stepHead p t {
  Next k -> just k ; Done k -> demandParts p t }
demandParts (p : Program) (t : Term) : Maybe Term := match t {
  Pair a b -> if concreteValue p a
    then (match stepValue p b { just d -> just (Pair a d) ; nothing -> nothing })
    else (match stepValue p a { just c -> just (Pair c b) ; nothing -> nothing }) ;
  Inj l a -> match stepValue p a { just c -> just (Inj l c) ; nothing -> nothing } ;
  RecordValue fs -> match demandFields p fs { just gs -> just (RecordValue gs) ; nothing -> nothing } ;
  _ -> match constructorTerms p t nil { nothing -> nothing ; just (c, vs) ->
    if dataConstructor p c
    then (match demandTerms p vs { just ws -> just (rebuildConstructor c ws) ; nothing -> nothing })
    else nothing } }
demandFields (p : Program) (fs : List (String * Term)) : Maybe (List (String * Term)) := match fs {
  nil -> nothing ; cons (k, v) rest -> if concreteValue p v
    then (match demandFields p rest { just gs -> just (cons (k, v) gs) ; nothing -> nothing })
    else (match stepValue p v { just w -> just (cons (k, w) rest) ; nothing -> nothing }) }
demandTerms (p : Program) (vs : List Term) : Maybe (List Term) := match vs {
  nil -> nothing ; cons v rest -> if concreteValue p v
    then (match demandTerms p rest { just ws -> just (cons v ws) ; nothing -> nothing })
    else (match stepValue p v { just w -> just (cons w rest) ; nothing -> nothing }) }
stepEquality (p : Program) (i j : Term) : HeadStep :=
  if concreteValue p i and concreteValue p j then Next (truthTerm (equalValues p i j))
  else match stepValue p i {
    just k -> Next (App (App (Primitive "==") k) j) ; nothing ->
      if concreteValue p i then match stepValue p j {
        just l -> Next (App (App (Primitive "==") i) l) ;
        nothing -> Done (App (App (Primitive "==") i) j) }
      else Done (App (App (Primitive "==") i) j) }
stepHead (p : Program) (t : Term) : HeadStep := match t {
  Var x -> match lookupBody p x { nothing -> Done t ; just b -> Next b } ;
  Let x ty v b -> Next (substTerm x v b) ;
  App f a -> stepApplication p f a ; Match s arms -> stepMatch p s arms ;
  Proj r x -> stepProjection p r x ; _ -> Done t }
-- Field names are literal and ordered; duplicate names select the first occurrence.
lookupField (kvs : List (String * Term)) (x : String) : Maybe Term := match kvs {
  nil -> nothing ; cons (y, v) rest -> if x == y then just v else lookupField rest x }
stepProjection (p : Program) (r : Term) (x : String) : HeadStep := match stepHead p r {
  Next s -> Next (Proj s x) ; Done s -> match s {
    RecordValue kvs -> match lookupField kvs x { just v -> Next v ; nothing -> Done (Proj r x) } ;
    _ -> Done (Proj r x) } }
stepApplication (p : Program) (f a : Term) : HeadStep := match stepHead p f {
  Next g -> Next (App g a) ; Done g -> match g {
    Lam x ty b -> Next (substTerm x a b) ;
    App (Primitive name) i -> stepPrimitive p name i a ; _ -> Done (App f a) } }
stepPrimitive (p : Program) (name : String) (i j : Term) : HeadStep :=
  if name == "==" then stepEquality p i j else match primitiveResult name i j { just v -> Next v ; nothing -> match stepHead p i {
    Next k -> Next (App (App (Primitive name) k) j) ; Done k -> match i {
      Lit c -> match stepHead p j {
        Next l -> Next (App (App (Primitive name) i) l) ; Done l -> Done (App (App (Primitive name) i) j) } ;
      _ -> Done (App (App (Primitive name) i) j) } } }
-- Blocked is distinct from Miss: an inspecting arm cannot skip a hole.
PatternStep = { Hit : Bindings || Miss : Unit || Blocked : Unit || Demand : Term }
stepPattern (env : Program) (p : Pattern) (v : Term) : PatternStep := match p {
  PVar x -> Hit [(x, v)] ; PWild -> Hit nil ;
  PLit c -> match v { Lit d -> if c == d then Hit nil else Miss ; _ -> demandHead env v } ;
  PPair a b -> match v { Pair c d -> stepPairPattern env a b c d ; _ -> demandHead env v } ;
  PInj l q -> match v { Inj k a -> if l == k then match stepPattern env q a {
    Hit bs -> Hit bs ; Miss -> Miss ; Blocked -> Blocked ; Demand b -> Demand (Inj k b) }
    else Miss ; _ -> demandHead env v } ;
  PCon c ps -> stepConstructorPattern env c ps v }
-- Data constructor keys are values, bare or applied; explicit acts keep priority.
-- Free applied names remain admissible for Iota; other bare names remain holes.
dataConstructor (env : Program) (x : String) : Bool := match env {
  nil -> false ; cons act rest -> match act {
    Define t ty (Data self cs) -> constructorKey cs x or dataConstructor rest x ;
    _ -> dataConstructor rest x } }
constructorKey (cs : List (String * Term)) (x : String) : Bool := match cs {
  nil -> false ; cons (c, ty) rest -> c == x or constructorKey rest x }
constructorTerms (env : Program) (v : Term) (args : List Term) : Maybe (String * List Term) := match v {
  Var x -> if not (free env x) then nothing
    else if dataConstructor env x then just (x, args)
    else match args { nil -> nothing ; cons a rest -> just (x, args) } ;
  App f a -> constructorTerms env f (cons a args) ; _ -> nothing }
knownHead (env : Program) (v : Term) : Bool := match v {
  Var x -> free env x and dataConstructor env x ;
  Hole x -> false ; Axiom r -> false ; Match s arms -> false ; Proj r l -> false ;
  App f a -> match constructorTerms env v nil { just cs -> true ; nothing -> false } ; _ -> true }
demandHead (env : Program) (v : Term) : PatternStep := match stepHead env v {
  Next w -> Demand w ; Done w -> if knownHead env v then Miss else Blocked }
stepPairPattern (env : Program) (a b : Pattern) (c d : Term) : PatternStep := match stepPattern env a c {
  Miss -> Miss ; Blocked -> Blocked ; Demand e -> Demand (Pair e d) ; Hit xs -> match stepPattern env b d {
    Miss -> Miss ; Blocked -> Blocked ; Demand e -> Demand (Pair c e) ; Hit ys -> Hit (appendBindings xs ys) } }
stepConstructorPattern (env : Program) (c : String) (ps : List Pattern) (v : Term) : PatternStep :=
  match constructorTerms env v nil { nothing -> demandHead env v ; just (d, vs) ->
    if c == d then match stepPatternList env ps vs {
      ListHit bs -> Hit bs ; ListMiss -> Miss ; ListBlocked -> Blocked ;
      ListDemand ws -> Demand (rebuildConstructor d ws) } else Miss }
PatternListStep = { ListHit : Bindings || ListMiss : Unit || ListBlocked : Unit || ListDemand : List Term }
stepPatternList (env : Program) (ps : List Pattern) (vs : List Term) : PatternListStep := match (ps, vs) {
  (nil, nil) -> ListHit nil ;
  (cons p rest, cons v more) -> match stepPattern env p v {
    Miss -> ListMiss ; Blocked -> ListBlocked ; Demand w -> ListDemand (cons w more) ;
    Hit xs -> match stepPatternList env rest more {
      ListMiss -> ListMiss ; ListBlocked -> ListBlocked ; ListDemand ws -> ListDemand (cons v ws) ;
      ListHit ys -> ListHit (appendBindings xs ys) } } ; _ -> ListMiss }
rebuildConstructor (c : String) (args : List Term) : Term := applyArguments (Var c) args
applyArguments (f : Term) (args : List Term) : Term := match args {
  nil -> f ; cons a rest -> applyArguments (App f a) rest }
ArmStep = { Selected : Term || ScrutineeNext : Term || NoArm : Unit }
chooseArm (p : Program) (s : Term) (arms : List (Pattern * Term)) : ArmStep := match arms {
  nil -> NoArm ; cons (pat, b) rest -> match stepPattern p pat s {
    Demand v -> ScrutineeNext v ; Miss -> chooseArm p s rest ; Blocked -> NoArm ;
    Hit bs -> if linearBindings bs then Selected (applyBindings bs b) else NoArm } }
stepMatch (p : Program) (s : Term) (arms : List (Pattern * Term)) : HeadStep := match stepHead p s {
  Next v -> Next (Match v arms) ; Done v -> match chooseArm p s arms {
    Selected b -> Next b ; ScrutineeNext w -> Next (Match w arms) ; NoArm -> Done (Match s arms) } }
stepTerm (p : Program) (t : Term) : Maybe Term := match stepHead p t {
  Done v -> nothing ; Next v -> just v }
stepper : Reduction alpha substitute := { step := stepTerm }
