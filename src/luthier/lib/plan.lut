-- An order of execution as a value, and the law that two orders are equivalent (L19, L9; the
-- fourth round of 2026-10-11). A dataflow over n nodes says what each node depends on and how it is
-- computed from the values of the others; a schedule is a permutation of the nodes; it linearizes
-- the dataflow when no node comes before one it depends on; running a schedule computes the nodes
-- in its order. Confluence, that every linearization gives the same values, is L18 as a theorem,
-- and here it is a law a dataflow is certified against: two actions that share no dependency are
-- unordered, and running them in either order is one more schedule the law covers.

import "algebra"

-- `deps i j`: node i depends on node j. `step i env`: the value of node i from the values so far.
Dataflow (A : U) (n : Int) = { init : A, deps : Fin n -> Fin n -> Bool, step : Fin n -> (Fin n -> A) -> A }

Injective (n : Int) (s : Fin n -> Fin n) : Bool := forallPairs n (\ a b { s a == s b -> a == b })
Schedule (n : Int) : U := { s : Fin n -> Fin n | Injective n s }

-- position a comes before position b, so the node at a must not depend on the node at b
Linearizes (A : U) (n : Int) (d : Dataflow A n) (s : Schedule n) : Bool :=
  forallPairs n (\ a b { a < b -> not (d.deps (s a) (s b)) })

update (A : U) (n : Int) (env : Fin n -> A) (i : Fin n) (v : A) : Fin n -> A :=
  \ j { if j == i then v else env j }

runFrom (A : U) (n : Int) (d : Dataflow A n) (s : Schedule n) (k : Nat) (env : Fin n -> A) : Fin n -> A :=
  if k >= n then env else runFrom A n d s (k + 1) (update A n env (s k) (d.step (s k) env))

run (A : U) (n : Int) (d : Dataflow A n) (s : Schedule n) : Fin n -> A := runFrom A n d s 0 (\ j { d.init })

-- two orders are equivalent when every node gets the same value under both
Equivalent (A : U) (eq : A -> A -> Bool) (n : Int) (d : Dataflow A n) (s1 s2 : Schedule n) : Bool :=
  forallBelow n (\ i { eq (run A n d s1 i) (run A n d s2 i) })

-- the law: any two linearizations are equivalent
Confluent (A : U) (eq : A -> A -> Bool) (n : Int) (d : Dataflow A n) (s1 s2 : Schedule n) : Bool :=
  Linearizes A n d s1 and Linearizes A n d s2 -> Equivalent A eq n d s1 s2

Planned (A : U) (eq : A -> A -> Bool) (n : Int) : U := { d : Dataflow A n | Confluent A eq n d }
