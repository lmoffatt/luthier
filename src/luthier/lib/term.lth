-- term.lth: the kernel term as data, and the theories of its names, substitution, canonical form
-- and reduction.
--
-- Draft 0, 2026-10-13, by Claude Opus 5.5 in the session (step 2.2 of
-- record/plan/luthier-from-zero/plan-from-zero-2026-10-13-execution.md). Sources: spec 3 §4 (3.S14 to 3.S20, the five
-- rules of reduction), §6 (3.S29 to 3.S35, programs as data), 3.S38 (this file), 3.S11 (fuel);
-- L2.7 (each constructor has a law of its role); D-2026-10-12-x, D-2026-10-12-ah. The pattern is
-- that of ebnf.lth: a theory is a record type of its operations, laws over a model, `T := laws`;
-- its model is a value in a `.lut`. Here the main model is `reduce`, the interpreter written in
-- Luthier (3.S33), in term_model.lut; the host's evaluator is a second specimen of the same theory
-- (L14.3), as `backtrack` and the Python recognizer are of `Derives`.
--
-- On meaning (L2.7). The constructors of `Term` that compute get their roles from the laws of
-- `Reduction` (§5): `Lam` and `App` from `Beta`, `Var` from `Delta`, `Match`, `Inj`, `Pair` and the
-- patterns from `Iota`, `RecordValue` and `Proj` from `ProjOfRecord`, `Lit` (of every kind) and
-- `Primitive` from `Prim`, `Extern` from `ExternIsValue`, `Hole` and `Axiom` from `HolesStay`,
-- `Datum` from `DatumIsInert`, `Let` from `Zeta`. The type
-- formers (`Universe`, `World`, `Pi`, `Sigma`, `Sum`, `Data`, `Subtype`) are values for reduction
-- (`ValuesStay`); their roles are the checker's, laws of `WellFormed` in program.lth (step 3.1).
--
-- Names: the constructors are 3.S29's, capitalized as there, so that they do not clash with the
-- surface tree of grammar.lth when the translation of 2.S12 imports both; `U` is a keyword, so the
-- universe is `Universe`; `World` is added for `W` (D-2026-10-13-b), which 3.S29 predates.
--
-- Index. Status of each section: done, or todo with what it needs. A session or Codex continuing
-- this file takes the first todo, writes it in the pattern of the done ones and of kernel_laws.lth,
-- checks it with `luthier parse src/luthier/lib/term.lth`, sets its status to done here, commits.
--
--   §1 The data: `Constant`, `Pattern`, `Term`, `Act`, `Program` (3.S29 to 3.S31).     done
--   §2 Names: free variables, renaming, alpha-equivalence as an object with the
--      law of renaming a bound variable (3.S31, L3.3; `Object` of kernel_laws.lth).     done
--   §3 Substitution, capture-avoiding (3.S14's `t[a/x]`).                               done
--   §4 Canonical form: alpha-invariant and idempotent; module prefixes removed (3.S34).  done
--   §5 Reduction: `Beta`, `Delta`, `Iota`, `Prim`, `ExternIsValue`, `HolesStay`,
--      `ValuesStay`, with fuel (3.S11, 3.S14 to 3.S20, 3.S33).                         done
--   §6 Quote and eval (3.S32): cases on literals and closed terms.                      done
--   §7 The models, to write in term_model.lut: `reduce` (the interpreter in Luthier),
--      `alpha`, `substitute`, `canonical`; by Codex (record/IA/term-2026-10-13/
--      codex-models.md, its report codex.md).                                      done

import "kernel_laws.lth" Object

-- ---------------------------------------------------------------- §1 The data

-- A constant of the kernel: an integer, a double or a string (3.S17, spec 11). Named apart from
-- the surface `Literal` of grammar.lth, which is unsigned; after elaboration a constant may be
-- negative. Roles: `Prim` (§5).
Constant : U := data {
  IntConst : Int -> Constant ;
  FloatConst : Float64 -> Constant ;
  StringConst : String -> Constant ;
}

-- A pattern of a `match` (3.S10, 3.S29): a variable, `_`, a constructor applied to patterns, a
-- pair, a constant, a label's injection. Roles: `Iota` (§5).
Pattern : U := data {
  PVar : String -> Pattern ;
  PWild : Pattern ;
  PCon : String -> List Pattern -> Pattern ;
  PPair : Pattern -> Pattern -> Pattern ;
  PLit : Constant -> Pattern ;
  PInj : String -> Pattern -> Pattern ;
}

-- The kernel term after elaboration (3.S29, 3.S30): the sugar of spec 2 translated away, names as
-- strings (3.S31), a qualified name `m.f` as one string. A constructor of a `data` is a `Var`
-- applied to its arguments. `Lam`, `Pi`, `Sigma` and `Subtype` bind their string in their last
-- term; `Lam` and `Pi` carry the variable's type. A record is a product whose projections are
-- named (D-2026-10-13-x): `Record` its type, `RecordValue` its introduction, `Proj` the projection
-- by name, an arrow of the product, so the names are part of the term and of its hash; the labels
-- of a `Sum` are likewise its injections (`Inj`). Roles: the laws of §5 and, for the type formers,
-- of `WellFormed` (program.lth). `Let x ty v b` is a local definition: inside `b`, `x` is `v`
-- definitionally (D-2026-10-13-aa, Q1 of the review of layers 0-1: a block elaborates to nested
-- `Let`s, since under a lambda applied the body would not know `x ≡ v` and a dependent type such as
-- `Vec n` with `n := 3` would not check).
Term : U := data {
  Var : String -> Term ;
  Lit : Constant -> Term ;
  Universe : Term ;
  World : Term ;
  Lam : String -> Term -> Term -> Term ;
  App : Term -> Term -> Term ;
  Pi : String -> Term -> Term -> Term ;
  Sigma : String -> Term -> Term -> Term ;
  Pair : Term -> Term -> Term ;
  Match : Term -> List (Pattern * Term) -> Term ;
  Inj : String -> Term -> Term ;
  Sum : List (String * Term) -> Term ;
  Data : String -> List (String * Term) -> Term ;
  Subtype : String -> Term -> Term -> Term ;
  Extern : String -> Term ;
  Primitive : String -> Term ;
  Axiom : String -> Term ;
  Hole : String -> Term ;
  Record : List (String * Term) -> Term ;
  RecordValue : List (String * Term) -> Term ;
  Proj : Term -> String -> Term ;
  Let : String -> Term -> Term -> Term -> Term ;
}

-- An act of an elaborated program (3.S1, 3.S29, D-2026-10-13-o): a declaration is a name with its
-- type and no body, a hole (3.S9); a definition a name with its type and its body; a datum a term
-- the module keeps. Aliases are expanded before checking and never reach evaluation (3.S15), and
-- imports are resolved into qualified names, so neither is an act here. Roles: `Delta` and
-- `HolesStay` (§5).
Act : U := data {
  Declare : String -> Term -> Act ;
  Define : String -> Term -> Term -> Act ;
  Datum : Term -> Act ;
}

-- A program is its acts, a structure (3.S29); its role is the environment of `Delta`.
Program = List Act

-- ---------------------------------------------------------------- §2 Names

-- definitions the laws need: names as lists, the free variables of a term, and the swap of two
-- names everywhere in a term (binders included), the nominal way to rename without capture
member (x : String) (xs : List String) : Bool := match xs { nil -> false ; cons y rest -> x == y or member x rest }
remove (x : String) (xs : List String) : List String :=
  match xs { nil -> nil ; cons y rest -> if x == y then remove x rest else cons y (remove x rest) }
concat (xs ys : List String) : List String := match xs { nil -> ys ; cons x rest -> cons x (concat rest ys) }
removeAll (xs ys : List String) : List String := match xs { nil -> ys ; cons x rest -> removeAll rest (remove x ys) }

patternVars (p : Pattern) : List String := match p {
  PVar x -> [x] ; PWild -> nil ; PLit c -> nil ;
  PCon c ps -> patternsVars ps ;
  PPair a b -> concat (patternVars a) (patternVars b) ;
  PInj l q -> patternVars q ;
}
patternsVars (ps : List Pattern) : List String :=
  match ps { nil -> nil ; cons p rest -> concat (patternVars p) (patternsVars rest) }

-- spec 3.S9, 3.S31: the variables a term mentions and does not bind. A `Hole` names a declaration,
-- not a variable; a `Data` binds its own name in its constructors' types.
freeVars (t : Term) : List String := match t {
  Var x -> [x] ;
  Lit c -> nil ; Universe -> nil ; World -> nil ; Extern r -> nil ; Primitive r -> nil ; Axiom r -> nil ;
  Hole x -> nil ;
  Lam x a b -> concat (freeVars a) (remove x (freeVars b)) ;
  Pi x a b -> concat (freeVars a) (remove x (freeVars b)) ;
  Sigma x a b -> concat (freeVars a) (remove x (freeVars b)) ;
  Subtype x a b -> concat (freeVars a) (remove x (freeVars b)) ;
  App f a -> concat (freeVars f) (freeVars a) ;
  Pair a b -> concat (freeVars a) (freeVars b) ;
  Inj l a -> freeVars a ;
  Match s arms -> concat (freeVars s) (armsFree arms) ;
  Sum kvs -> pairsFree kvs ;
  Data n cs -> remove n (pairsFree cs) ;
  Record kvs -> pairsFree kvs ; RecordValue kvs -> pairsFree kvs ;
  Proj r x -> freeVars r ;
  Let x ty v b -> concat (freeVars ty) (concat (freeVars v) (remove x (freeVars b))) ;
}
armsFree (arms : List (Pattern * Term)) : List String := match arms { nil -> nil ;
  cons (p, b) rest -> concat (removeAll (patternVars p) (freeVars b)) (armsFree rest) }
pairsFree (kvs : List (String * Term)) : List String :=
  match kvs { nil -> nil ; cons (k, v) rest -> concat (freeVars v) (pairsFree rest) }

swapName (x y n : String) : String := if n == x then y else if n == y then x else n
swapPattern (x y : String) (p : Pattern) : Pattern := match p {
  PVar n -> PVar (swapName x y n) ; PWild -> PWild ; PLit c -> PLit c ;
  PCon c ps -> PCon c (swapPatterns x y ps) ;
  PPair a b -> PPair (swapPattern x y a) (swapPattern x y b) ;
  PInj l q -> PInj l (swapPattern x y q) ;
}
swapPatterns (x y : String) (ps : List Pattern) : List Pattern :=
  match ps { nil -> nil ; cons p rest -> cons (swapPattern x y p) (swapPatterns x y rest) }
swap (x y : String) (t : Term) : Term := match t {
  Var n -> Var (swapName x y n) ;
  Lam n a b -> Lam (swapName x y n) (swap x y a) (swap x y b) ;
  Pi n a b -> Pi (swapName x y n) (swap x y a) (swap x y b) ;
  Sigma n a b -> Sigma (swapName x y n) (swap x y a) (swap x y b) ;
  Subtype n a b -> Subtype (swapName x y n) (swap x y a) (swap x y b) ;
  App f a -> App (swap x y f) (swap x y a) ;
  Pair a b -> Pair (swap x y a) (swap x y b) ;
  Inj l a -> Inj l (swap x y a) ;
  Match s arms -> Match (swap x y s) (swapArms x y arms) ;
  Sum kvs -> Sum (swapPairs x y kvs) ;
  Data n cs -> Data (swapName x y n) (swapPairs x y cs) ;
  Record kvs -> Record (swapPairs x y kvs) ; RecordValue kvs -> RecordValue (swapPairs x y kvs) ;
  Proj r l -> Proj (swap x y r) l ;
  Let n ty v b -> Let (swapName x y n) (swap x y ty) (swap x y v) (swap x y b) ;
  _ -> t ;
}
swapArms (x y : String) (arms : List (Pattern * Term)) : List (Pattern * Term) := match arms { nil -> nil ;
  cons (p, b) rest -> cons (swapPattern x y p, swap x y b) (swapArms x y rest) }
swapPairs (x y : String) (kvs : List (String * Term)) : List (String * Term) :=
  match kvs { nil -> nil ; cons (k, v) rest -> cons (k, swap x y v) (swapPairs x y rest) }

-- Alpha-equivalence (3.S31, L3.3): two terms equal up to the names of their bound variables. A
-- model says when; its laws: it is an object (kernel_laws.lth §1), reflexive, symmetric and
-- transitive, carried by `alphaObject`, whose type owes those laws, and not substitutive over every
-- function (a function may read a binder's name), but a congruence (`AlphaCongruent`); a free variable is its own name; a bound one may be renamed to a
-- name fresh for the body; alpha-equal terms have one head and one set of free variables.
Alpha : { alphaEq : Term -> Term -> Bool }
alphaObject (a : Alpha) : Object Term := { eq := a.alphaEq }

-- the head constructor of a term, so that equal heads can be compared
head (t : Term) : String := match t {
  Var x -> "Var" ; Lit c -> "Lit" ; Universe -> "Universe" ; World -> "World" ; Lam x a b -> "Lam" ;
  App f a -> "App" ; Pi x a b -> "Pi" ; Sigma x a b -> "Sigma" ; Pair a b -> "Pair" ;
  Match s arms -> "Match" ; Inj l a -> "Inj" ; Sum kvs -> "Sum" ; Data n cs -> "Data" ;
  Subtype x a b -> "Subtype" ; Extern r -> "Extern" ; Primitive r -> "Primitive" ; Axiom r -> "Axiom" ;
  Hole x -> "Hole" ; Record kvs -> "Record" ; RecordValue kvs -> "RecordValue" ; Proj r x -> "Proj" ; Let x ty v b -> "Let" ;
}
sameNames (xs ys : List String) : Bool := removeAll xs ys == nil and removeAll ys xs == nil

-- a name and a term in which it is not free: the fresh names a binder may be renamed to; random
-- names are almost always fresh, so drawing them is cheap
Fresh : U := { y : String, t : Term | not (member y (freeVars t)) }
AlphaPair (a : Alpha) : U := { s t : Term | a.alphaEq s t }

FreeVariablesAreNames (a : Alpha) (x y : String) : Bool := a.alphaEq (Var x) (Var y) == (x == y)
-- every binder may be renamed to a fresh name: the four binding formers, and a pattern variable
-- (Fable, review of layers 0-1)
RenameBound (a : Alpha) (x : String) (ty s : Term) (f : Fresh) : Bool :=
  a.alphaEq (Lam x ty f.t) (Lam f.y ty (swap x f.y f.t))
  and a.alphaEq (Pi x ty f.t) (Pi f.y ty (swap x f.y f.t))
  and a.alphaEq (Sigma x ty f.t) (Sigma f.y ty (swap x f.y f.t))
  and a.alphaEq (Subtype x ty f.t) (Subtype f.y ty (swap x f.y f.t))
  and a.alphaEq (Match s [(PVar x, f.t)]) (Match s [(PVar f.y, swap x f.y f.t)])
  and a.alphaEq (Let x ty s f.t) (Let f.y ty s (swap x f.y f.t))
AlphaKeepsHead (a : Alpha) (p : AlphaPair a) : Bool := head p.s == head p.t
AlphaKeepsFree (a : Alpha) (p : AlphaPair a) : Bool := sameNames (freeVars p.s) (freeVars p.t)
-- a congruence: alpha-equal parts give alpha-equal wholes, for every constructor with parts; a
-- binder keeps its name on both sides (renaming it is `RenameBound`)
AlphaCongruent (a : Alpha) (p q : AlphaPair a) (x l : String) : Bool :=
  a.alphaEq (App p.s q.s) (App p.t q.t) and a.alphaEq (Pair p.s q.s) (Pair p.t q.t)
  and a.alphaEq (Lam x p.s q.s) (Lam x p.t q.t) and a.alphaEq (Pi x p.s q.s) (Pi x p.t q.t)
  and a.alphaEq (Sigma x p.s q.s) (Sigma x p.t q.t) and a.alphaEq (Subtype x p.s q.s) (Subtype x p.t q.t)
  and a.alphaEq (Inj l p.s) (Inj l p.t) and a.alphaEq (Proj p.s l) (Proj p.t l)
  and a.alphaEq (Sum [(l, p.s)]) (Sum [(l, p.t)]) and a.alphaEq (Data x [(l, p.s)]) (Data x [(l, p.t)])
  and a.alphaEq (Record [(l, p.s)]) (Record [(l, p.t)]) and a.alphaEq (RecordValue [(l, p.s)]) (RecordValue [(l, p.t)])
  and a.alphaEq (Match p.s [(PWild, q.s)]) (Match p.t [(PWild, q.t)])
  and a.alphaEq (Let x p.s p.s q.s) (Let x p.t p.t q.t)

-- and the converse: alpha-equal wholes have the same head, the same constants, labels and names
-- that are not binders, and alpha-equal parts, a binder's body compared after renaming its
-- variable to the other's. Without it every law above holds of a model that equates far too much
-- (`head s == head t` and the same free names equates `Lit 1` with `Lit 2`), and every theory
-- below, stated up to alpha, weakens with it (Fable, review of layers 0-1).
renamedTo (x y : String) (t : Term) : Term := if x == y then t else swap x y t
underBinder (a : Alpha) (x y : String) (b c : Term) : Bool :=
  (x == y and a.alphaEq b c) or (not (member x (freeVars c)) and a.alphaEq b (renamedTo y x c))
-- a `data` binds its own name in its constructors' types (`freeVars`, `swap`), so its name is
-- compared as a binder (Codex, writing kernel.py: `RenameBound` renamed it and `AlphaPartsAgree`
-- asked it fixed)
underBinderPairs (a : Alpha) (x y : String) (cs ds : List (String * Term)) : Bool :=
  (x == y and pairsAgree a cs ds) or (not (member x (pairsFree ds)) and pairsAgree a cs (renamePairs y x ds))
renamePairs (y x : String) (kvs : List (String * Term)) : List (String * Term) :=
  match kvs { nil -> nil ; cons (k, v) rest -> cons (k, renamedTo y x v) (renamePairs y x rest) }
pairsAgree (a : Alpha) (xs ys : List (String * Term)) : Bool := match xs {
  nil -> (match ys { nil -> true ; cons y rest -> false }) ;
  cons (k, u) rest -> match ys { nil -> false ; cons (j, v) more -> k == j and a.alphaEq u v and pairsAgree a rest more } }
-- a pattern's shape with its variables in order: two arms agree when their patterns have one shape
-- and their bodies agree after renaming the variables positionally (patterns are linear, 3.S10)
patternShape (q : Pattern) : Pattern := match q {
  PVar x -> PVar "_" ; PWild -> PWild ; PLit c -> PLit c ;
  PCon c qs -> PCon c (shapes qs) ; PPair l r -> PPair (patternShape l) (patternShape r) ;
  PInj l r -> PInj l (patternShape r) }
shapes (qs : List Pattern) : List Pattern := match qs { nil -> nil ; cons q rest -> cons (patternShape q) (shapes rest) }
-- renaming `ys` to `xs` position by position, at once: each swap is applied to the term and to the
-- names still to rename, so a later pair sees the names the earlier swaps left (a permutation as a
-- product of transpositions; Codex, writing kernel.py: one swap after another without this turned
-- `(x, y)` into `(y, x)` back again)
renameAll (xs ys : List String) (t : Term) : Term := match xs { nil -> t ;
  cons x rest -> match ys { nil -> t ;
    cons y more -> renameAll rest (swapNames y x more) (renamedTo y x t) } }
swapNames (y x : String) (ns : List String) : List String :=
  match ns { nil -> nil ; cons n rest -> cons (swapName y x n) (swapNames y x rest) }
armsAgree (a : Alpha) (xs ys : List (Pattern * Term)) : Bool := match xs {
  nil -> (match ys { nil -> true ; cons y rest -> false }) ;
  cons (p, b) rest -> match ys { nil -> false ;
    cons (q, c) more -> patternShape p == patternShape q
                        and a.alphaEq b (renameAll (patternVars p) (patternVars q) c) and armsAgree a rest more } }
partsAgree (a : Alpha) (s t : Term) : Bool := match s {
  Var x -> t == Var x ; Lit c -> t == Lit c ; Universe -> t == Universe ; World -> t == World ;
  Axiom r -> t == Axiom r ; Hole x -> t == Hole x ; Extern r -> t == Extern r ; Primitive r -> t == Primitive r ;
  App f x -> (match t { App g y -> a.alphaEq f g and a.alphaEq x y ; _ -> false }) ;
  Pair u v -> (match t { Pair w z -> a.alphaEq u w and a.alphaEq v z ; _ -> false }) ;
  Inj l u -> (match t { Inj k v -> l == k and a.alphaEq u v ; _ -> false }) ;
  Proj u l -> (match t { Proj v k -> l == k and a.alphaEq u v ; _ -> false }) ;
  Lam x d b -> (match t { Lam y e c -> a.alphaEq d e and underBinder a x y b c ; _ -> false }) ;
  Pi x d b -> (match t { Pi y e c -> a.alphaEq d e and underBinder a x y b c ; _ -> false }) ;
  Sigma x d b -> (match t { Sigma y e c -> a.alphaEq d e and underBinder a x y b c ; _ -> false }) ;
  Subtype x d b -> (match t { Subtype y e c -> a.alphaEq d e and underBinder a x y b c ; _ -> false }) ;
  Sum kvs -> (match t { Sum jws -> pairsAgree a kvs jws ; _ -> false }) ;
  Record kvs -> (match t { Record jws -> pairsAgree a kvs jws ; _ -> false }) ;
  RecordValue kvs -> (match t { RecordValue jws -> pairsAgree a kvs jws ; _ -> false }) ;
  Data n cs -> (match t { Data m ds -> underBinderPairs a n m cs ds ; _ -> false }) ;
  Match u arms -> (match t { Match v brs -> a.alphaEq u v and armsAgree a arms brs ; _ -> false }) ;
  Let x d v b -> (match t { Let y e w c -> a.alphaEq d e and a.alphaEq v w and underBinder a x y b c ; _ -> false }) }
AlphaPartsAgree (a : Alpha) (p : AlphaPair a) : Bool := partsAgree a p.s p.t

Alpha := FreeVariablesAreNames & RenameBound & AlphaKeepsHead & AlphaKeepsFree & AlphaCongruent & AlphaPartsAgree

-- ---------------------------------------------------------------- §3 Substitution

-- `subst x s t` is `t[s/x]` of 3.S14: `t` with `s` in place of the free occurrences of `x`, with
-- no capture. Results are compared up to alpha-equivalence, so the model is held to an `Alpha`.
-- Random names almost never coincide, so the laws that need two names distinct state it as an
-- alternative (`x == y or ...`) rather than a premise.
Substitution (a : Alpha) : { subst : String -> Term -> Term -> Term }

-- a name and a term in which it is not free, for the binder that substitution passes under
NotFreeIn : U := { y : String, s : Term | not (member y (freeVars s)) }

SubstHits (a : Alpha) (m : Substitution a) (x : String) (s : Term) : Bool := a.alphaEq (m.subst x s (Var x)) s
SubstMisses (a : Alpha) (m : Substitution a) (x y : String) (s : Term) : Bool :=
  x == y or a.alphaEq (m.subst x s (Var y)) (Var y)
-- substitution goes into every part of every constructor without a binder (review of layers 0-1,
-- A: stated before on three constructors only, so a model that skipped the rest passed)
SubstGoesInside (a : Alpha) (m : Substitution a) (x : String) (s f b : Term) (l : String) : Bool :=
  a.alphaEq (m.subst x s (App f b)) (App (m.subst x s f) (m.subst x s b))
  and a.alphaEq (m.subst x s (Pair f b)) (Pair (m.subst x s f) (m.subst x s b))
  and a.alphaEq (m.subst x s (Inj l f)) (Inj l (m.subst x s f))
  and a.alphaEq (m.subst x s (Proj f l)) (Proj (m.subst x s f) l)
  and a.alphaEq (m.subst x s (Sum [(l, f)])) (Sum [(l, m.subst x s f)])
  and a.alphaEq (m.subst x s (Record [(l, f)])) (Record [(l, m.subst x s f)])
  and a.alphaEq (m.subst x s (RecordValue [(l, f)])) (RecordValue [(l, m.subst x s f)])
  and a.alphaEq (m.subst x s (Match f [(PWild, b)])) (Match (m.subst x s f) [(PWild, m.subst x s b)])
-- a binder of the same name shadows: the body is left alone, the binder's type (and a `Let`'s
-- value) are not; for each binding former
SubstStopsAtShadow (a : Alpha) (m : Substitution a) (x : String) (s ty b : Term) : Bool :=
  a.alphaEq (m.subst x s (Lam x ty b)) (Lam x (m.subst x s ty) b)
  and a.alphaEq (m.subst x s (Pi x ty b)) (Pi x (m.subst x s ty) b)
  and a.alphaEq (m.subst x s (Sigma x ty b)) (Sigma x (m.subst x s ty) b)
  and a.alphaEq (m.subst x s (Subtype x ty b)) (Subtype x (m.subst x s ty) b)
  and a.alphaEq (m.subst x s (Let x ty s b)) (Let x (m.subst x s ty) (m.subst x s s) b)
  and a.alphaEq (m.subst x s (Match ty [(PVar x, b)])) (Match (m.subst x s ty) [(PVar x, b)])
-- under a binder whose name is not free in `s`, substitution goes in
SubstPassesBinder (a : Alpha) (m : Substitution a) (x : String) (f : NotFreeIn) (ty b : Term) : Bool :=
  x == f.y or (a.alphaEq (m.subst x f.s (Lam f.y ty b)) (Lam f.y (m.subst x f.s ty) (m.subst x f.s b))
               and a.alphaEq (m.subst x f.s (Pi f.y ty b)) (Pi f.y (m.subst x f.s ty) (m.subst x f.s b))
               and a.alphaEq (m.subst x f.s (Sigma f.y ty b)) (Sigma f.y (m.subst x f.s ty) (m.subst x f.s b))
               and a.alphaEq (m.subst x f.s (Subtype f.y ty b)) (Subtype f.y (m.subst x f.s ty) (m.subst x f.s b))
               and a.alphaEq (m.subst x f.s (Let f.y ty ty b)) (Let f.y (m.subst x f.s ty) (m.subst x f.s ty) (m.subst x f.s b)))
-- and under a binder whose name is free in `s`, without capture: the result is the binder renamed
-- to a name fresh for both, then substituted into (review of layers 0-1, A: the capture case was
-- never drawn). Its domain is drawn from `s`'s free names, so the case is not rare.
capturable (y z : String) (s b : Term) : Bool :=
  member y (freeVars s) and not (member z (freeVars s)) and not (member z (freeVars b)) and not (y == z)
CaptureCase : U := { y z : String, s b : Term | capturable y z s b }
SubstAvoidsCapture (a : Alpha) (m : Substitution a) (x : String) (c : CaptureCase) (ty : Term) : Bool :=
  x == c.y or x == c.z
  or a.alphaEq (m.subst x c.s (Lam c.y ty c.b)) (Lam c.z (m.subst x c.s ty) (m.subst x c.s (swap c.y c.z c.b)))
-- a name not free in `t` changes nothing
SubstNotFree (a : Alpha) (m : Substitution a) (f : NotFreeIn) (s : Term) : Bool :=
  a.alphaEq (m.subst f.y s f.s) f.s
-- alpha-equal terms give alpha-equal results
SubstRespectsAlpha (a : Alpha) (m : Substitution a) (x : String) (s : Term) (p : AlphaPair a) : Bool :=
  a.alphaEq (m.subst x s p.s) (m.subst x s p.t)

Substitution (a : Alpha) := SubstHits a & SubstMisses a & SubstGoesInside a & SubstStopsAtShadow a
  & SubstPassesBinder a & SubstAvoidsCapture a & SubstNotFree a & SubstRespectsAlpha a

-- ---------------------------------------------------------------- §4 Canonical form

-- The canonical form (3.S34) renames bound variables canonically and removes module prefixes, so
-- that alpha-equal terms, and terms that differ only in the module holding a definition, have one
-- form and so one hash (spec 6). `unqualify` takes a name to its name without module prefix (`m.f`
-- to `f`); what a prefix is, is the model's, by the lexical form of a dotted name (2.S1).
CanonicalForm (a : Alpha) : { canon : Term -> Term, unqualify : String -> String }

-- one form for alpha-equal terms, compared by structural equality: that is what makes it canonical
CanonOfAlpha (a : Alpha) (m : CanonicalForm a) (p : AlphaPair a) : Bool := m.canon p.s == m.canon p.t
CanonIdempotent (a : Alpha) (m : CanonicalForm a) (t : Term) : Bool := m.canon (m.canon t) == m.canon t
-- a name loses its module prefix, once
CanonOfName (a : Alpha) (m : CanonicalForm a) (x : String) : Bool := m.canon (Var x) == Var (m.unqualify x)
UnqualifyIdempotent (a : Alpha) (m : CanonicalForm a) (x : String) : Bool :=
  m.unqualify (m.unqualify x) == m.unqualify x
-- and it does remove a prefix: without this, `unqualify` the identity passed (review of layers 0-1,
-- A); stated on names of each shape
UnqualifyRemoves (a : Alpha) (m : CanonicalForm a) : Bool :=
  m.unqualify "m.f" == "f" and m.unqualify "a.b.c" == "c" and m.unqualify "f" == "f"
-- the canonical form of a term without module prefixes means the same term: alpha-equal to it
CanonKeepsTerm (a : Alpha) (m : CanonicalForm a) (t : Term) : Bool :=
  not (allUnqualified m.unqualify (freeVars t)) or a.alphaEq (m.canon t) t
allUnqualified (u : String -> String) (xs : List String) : Bool :=
  match xs { nil -> true ; cons x rest -> u x == x and allUnqualified u rest }

CanonicalForm (a : Alpha) := CanonOfAlpha a & CanonIdempotent a & CanonOfName a & UnqualifyIdempotent a
  & CanonKeepsTerm a & UnqualifyRemoves a

-- ---------------------------------------------------------------- §5 Reduction

-- The five rules of 3.S14 to 3.S18 are definitional equalities, stated on one step: `step p t` is
-- `just` the term `t` becomes in one weak-head step in the program `p`, or `nothing` when `t` is in
-- weak head normal form (a value, or stuck on a hole). Evaluation under fuel (3.S11) is the
-- iteration of the step, `reduce`, a definition and not a field, so fuel exhaustion is not a
-- verdict of any law (GPT, DeepSeek, Fable, review of layers 0-1: a law that took `nothing` for
-- agreement let a reducer that always answers `nothing` pass). The strategy is weak head: the
-- head of an application, the scrutinee of a match and the record of a projection step first, and
-- nothing steps under a binder. The laws give the computing constructors of `Term` their roles
-- (L2.7). The model is term_model.lut's; the host's evaluator, kernel.py, a second specimen (L14.3).
Reduction (a : Alpha) (sb : Substitution a) : { step : Program -> Term -> Maybe Term }

-- evaluation with fuel: `nothing` when the fuel runs out, otherwise the weak head normal form
reduce (a : Alpha) (sb : Substitution a) (m : Reduction a sb) (p : Program) (n : Nat) (t : Term) : Maybe Term :=
  if n == 0 then nothing else match m.step p t { nothing -> just t ; just u -> reduce a sb m p (n - 1) u }

stepsTo (a : Alpha) (r : Maybe Term) (u : Term) : Bool := match r { nothing -> false ; just v -> a.alphaEq v u }
isNormal (r : Maybe Term) : Bool := match r { nothing -> true ; just u -> false }
-- the definition of a name in a program, wherever it stands: a program is a set of acts (3.S1)
definition (p : Program) (x : String) : Maybe Term := match p { nil -> nothing ;
  cons act rest -> match act { Define y t b -> if y == x then just b else definition rest x ; _ -> definition rest x } }
-- a program that gives a name neither a definition nor a declaration: where a law uses that name
-- as a constructor or a label, the program does not redefine it
free (p : Program) (x : String) : Bool := match p { nil -> true ;
  cons act rest -> (match act { Declare y t -> not (y == x) ; Define y t b -> not (y == x) ; Datum t -> true }) and free rest x }

-- 3.S14, beta: a lambda applied steps to its body with the argument for its variable
Beta (a : Alpha) (sb : Substitution a) (m : Reduction a sb) (p : Program) (x : String) (ty body arg : Term) : Bool :=
  stepsTo a (m.step p (App (Lam x ty body) arg)) (sb.subst x arg body)

-- 3.S15, delta: a defined name in head position steps to its body, wherever the program defines
-- it, a declaration before it included (3.S1: a program has no order, and a definition fills a
-- declaration); always, in head position (3.S15 as revised, D-2026-10-13-aa, Q7: a stuck term is
-- what reduction leaves, the same for every specimen)
Delta (a : Alpha) (sb : Substitution a) (m : Reduction a sb) (p : Program) (f : String) (ty b : Term) : Bool :=
  stepsTo a (m.step (cons (Define f ty b) p) (Var f)) b
  and stepsTo a (m.step [Declare f ty, Define f ty b] (Var f)) b

-- the strategy: the head of an application, the scrutinee of a match and the record of a
-- projection step first, shown on a beta redex in each position
HeadFirst (a : Alpha) (sb : Substitution a) (m : Reduction a sb) (p : Program) (x l : String) (ty body u arg : Term)
          (arms : List (Pattern * Term)) : Bool :=
  stepsTo a (m.step p (App (App (Lam x ty body) u) arg)) (App (sb.subst x u body) arg)
  and stepsTo a (m.step p (Match (App (Lam x ty body) u) arms)) (Match (sb.subst x u body) arms)
  and stepsTo a (m.step p (Proj (App (Lam x ty body) u) l)) (Proj (sb.subst x u body) l)

-- 3.S9, 3.S19: a declared name is a hole and does not step; nor does a term that needs its value,
-- a match whose arm must inspect it; a match whose first arm needs no value still steps
HolesStay (a : Alpha) (sb : Substitution a) (m : Reduction a sb) (f : String) (ty arg b c : Term) (k : Constant) : Bool :=
  isNormal (m.step [Declare f ty] (Var f)) and isNormal (m.step [Declare f ty] (App (Var f) arg))
  and isNormal (m.step [Declare f ty] (Match (Var f) [(PLit k, b), (PWild, c)]))
  and stepsTo a (m.step [Declare f ty] (Match (Var f) [(PWild, c)])) c
  and isNormal (m.step [] (Hole f)) and isNormal (m.step [] (Axiom f))

-- 3.S16, iota: a match on an injection, a pair, a constructor or a constant takes the first arm
-- whose pattern matches, its variables substituted together; a variable arm takes anything; an arm
-- that does not match is passed over
Iota (a : Alpha) (sb : Substitution a) (m : Reduction a sb) (p : Program) (l y : String) (v b : Term) (k : Constant) : Bool :=
  stepsTo a (m.step p (Match (Inj l v) [(PInj l (PVar y), b)])) (sb.subst y v b)
  and (not (free p l) or stepsTo a (m.step p (Match (App (Var l) v) [(PCon l [PVar y], b)])) (sb.subst y v b))
  and stepsTo a (m.step p (Match (Lit k) [(PLit k, b)])) b
  and stepsTo a (m.step p (Match (Lit k) [(PVar y, b)])) (sb.subst y (Lit k) b)
  and stepsTo a (m.step p (Match (Lit k) [(PWild, b)])) b
-- a pair binds both variables at once: each value stands for its own variable, in both orders
-- (Fable: one order alone let a sequential substitution pass)
IotaPair (a : Alpha) (sb : Substitution a) (m : Reduction a sb) (p : Program) (y : String) (f : NotFreeIn) (b : Term) : Bool :=
  y == f.y or (stepsTo a (m.step p (Match (Pair f.s (Var y)) [(PPair (PVar y) (PVar f.y), b)]))
                         (sb.subst f.y (Var y) (sb.subst y f.s b))
               and stepsTo a (m.step p (Match (Pair (Var f.y) f.s) [(PPair (PVar f.y) (PVar y), b)]))
                             (sb.subst f.y (Var f.y) (sb.subst y f.s b)))
IotaSkips (a : Alpha) (sb : Substitution a) (m : Reduction a sb) (p : Program) (l k y : String) (v b c : Term) : Bool :=
  l == k or stepsTo a (m.step p (Match (Inj l v) [(PInj k PWild, b), (PInj l (PVar y), c)])) (sb.subst y v c)

-- a match on a constructor of a `data` of the program, alone or applied, takes the arm of that
-- constructor and passes over the arms of the others: two constructors of one `data` are
-- distinct values, so an arm of another constructor does not match (3.S16, 3.R3). Stated on a
-- `data` `t` with two nullary constructors and two unary ones, added to the program; the names are
-- distinct and the program does not define them otherwise (the specimens, writing kernel.py: a
-- constructor that differed from an arm's was read as a name the program might define, and a match
-- on a `data` stayed stuck)
IotaConstructors (a : Alpha) (sb : Substitution a) (m : Reduction a sb) (p : Program) (t c k f g y : String) (v b d : Term) : Bool :=
  not (distinctNames [t, c, k, f, g]) or not (allFree p [t, c, k, f, g])
  or (stepsTo a (m.step (withData t c k f g p) (Match (Var c) [(PCon c [], b)])) b
      and stepsTo a (m.step (withData t c k f g p) (Match (Var c) [(PCon k [], b), (PCon c [], d)])) d
      and stepsTo a (m.step (withData t c k f g p) (Match (Var k) [(PCon c [], b), (PWild, d)])) d
      and stepsTo a (m.step (withData t c k f g p) (Match (App (Var f) v) [(PCon g [PVar y], b), (PCon f [PVar y], d)]))
                    (sb.subst y v d))
-- the program with a `data` `t` whose constructors are `c`, `k` (nullary) and `f`, `g` (unary)
withData (t c k f g : String) (p : Program) : Program :=
  cons (Define t Universe (Data t [(c, Var t), (k, Var t), (f, Pi "_" (Var t) (Var t)), (g, Pi "_" (Var t) (Var t))])) p
distinctNames (xs : List String) : Bool := match xs { nil -> true ; cons x rest -> not (member x rest) and distinctNames rest }
allFree (p : Program) (xs : List String) : Bool := match xs { nil -> true ; cons x rest -> free p x and allFree p rest }

-- a local definition steps to its body with the value for its name (zeta; D-2026-10-13-aa, Q1)
Zeta (a : Alpha) (sb : Substitution a) (m : Reduction a sb) (p : Program) (x : String) (ty v b : Term) : Bool :=
  stepsTo a (m.step p (Let x ty v b)) (sb.subst x v b)

-- the projection of a record value by a name is the value at that name (D-2026-10-13-x)
ProjOfRecord (a : Alpha) (sb : Substitution a) (m : Reduction a sb) (p : Program) (x y : String) (u v : Term) : Bool :=
  x == y or (stepsTo a (m.step p (Proj (RecordValue [(x, u), (y, v)]) x)) u
             and stepsTo a (m.step p (Proj (RecordValue [(x, u), (y, v)]) y)) v)

-- 3.S17, prim: a `Primitive` body applied to constants is the host's operation (3.S2: `primitive`
-- is the body that means the host; an undefined name is a hole, 3.S9, so it is the body and not
-- the name that computes). Core defines `+`, `*`, `-`, `==`, `<` with these bodies, so the infix
-- forms of 2.S12 reach them by delta. Arithmetic on integers and doubles, comparison on integers
-- and strings; `true`, `false` the constructors of `Bool`.
bin (o : String) (x y : Term) : Term := App (App (Primitive o) x) y
truth (b : Bool) : Term := Var (if b then "true" else "false")
Prim (a : Alpha) (sb : Substitution a) (m : Reduction a sb) (p : Program) (i j : Int) (u v : Float64) (s t : String) : Bool :=
  stepsTo a (m.step p (bin "+" (Lit (IntConst i)) (Lit (IntConst j)))) (Lit (IntConst (i + j)))
  and stepsTo a (m.step p (bin "*" (Lit (IntConst i)) (Lit (IntConst j)))) (Lit (IntConst (i * j)))
  and stepsTo a (m.step p (bin "-" (Lit (IntConst i)) (Lit (IntConst j)))) (Lit (IntConst (i - j)))
  and stepsTo a (m.step p (bin "<" (Lit (IntConst i)) (Lit (IntConst j)))) (truth (i < j))
  and stepsTo a (m.step p (bin "==" (Lit (IntConst i)) (Lit (IntConst j)))) (truth (i == j))
  and stepsTo a (m.step p (bin "+" (Lit (FloatConst u)) (Lit (FloatConst v)))) (Lit (FloatConst (u + v)))
  and stepsTo a (m.step p (bin "==" (Lit (StringConst s)) (Lit (StringConst t)))) (truth (s == t))
-- The rest of 3.S17, which the slice of sonolocalización needs computed (inventory row 9;
-- record/IA/slice-theories-2026-10-14/, appended to `Prim` by its agent with the owner paused):
-- what each operation is, is numbers.lth's; here only that the kernel steps to it. On integers,
-- the quotient and the remainder of the host's floor division (`IntegerDivision`) and the four
-- other comparisons; a zero divisor does not step, the error being the host's (11.S7) and no
-- term [proposed: the model answers `nothing`, the host raises].
PrimInt (a : Alpha) (sb : Substitution a) (m : Reduction a sb) (p : Program) (i j : Int) : Bool :=
  (j == 0 or (stepsTo a (m.step p (bin "/" (Lit (IntConst i)) (Lit (IntConst j)))) (Lit (IntConst (i / j)))
              and stepsTo a (m.step p (bin "mod" (Lit (IntConst i)) (Lit (IntConst j)))) (Lit (IntConst (i mod j)))))
  and stepsTo a (m.step p (bin "<=" (Lit (IntConst i)) (Lit (IntConst j)))) (truth (i <= j))
  and stepsTo a (m.step p (bin ">" (Lit (IntConst i)) (Lit (IntConst j)))) (truth (i > j))
  and stepsTo a (m.step p (bin ">=" (Lit (IntConst i)) (Lit (IntConst j)))) (truth (i >= j))
  and stepsTo a (m.step p (bin "/=" (Lit (IntConst i)) (Lit (IntConst j)))) (truth (i /= j))
  and isNormal (m.step p (bin "/" (Lit (IntConst i)) (Lit (IntConst 0))))
  and isNormal (m.step p (bin "mod" (Lit (IntConst i)) (Lit (IntConst 0))))
-- on doubles of moderate size, where the result of an operation of two is finite (11.S7: NaN and
-- an overflow are errors, and no constant is one; the range of 11.S13), the three other
-- operations, rounded by the machine (11.S4), and the comparisons; division by zero does not step
ModerateDouble : U := { x : Float64 | x == 0.0 or (1.0e-150 <= x and x <= 1.0e150) or (-1.0e150 <= x and x <= -1.0e-150) }
PrimFloat (a : Alpha) (sb : Substitution a) (m : Reduction a sb) (p : Program) (u v : ModerateDouble) : Bool :=
  stepsTo a (m.step p (bin "-" (Lit (FloatConst u)) (Lit (FloatConst v)))) (Lit (FloatConst (u - v)))
  and stepsTo a (m.step p (bin "*" (Lit (FloatConst u)) (Lit (FloatConst v)))) (Lit (FloatConst (u * v)))
  and (v == 0.0 or stepsTo a (m.step p (bin "/" (Lit (FloatConst u)) (Lit (FloatConst v)))) (Lit (FloatConst (u / v))))
  and stepsTo a (m.step p (bin "<" (Lit (FloatConst u)) (Lit (FloatConst v)))) (truth (u < v))
  and stepsTo a (m.step p (bin "<=" (Lit (FloatConst u)) (Lit (FloatConst v)))) (truth (u <= v))
  and stepsTo a (m.step p (bin ">" (Lit (FloatConst u)) (Lit (FloatConst v)))) (truth (u > v))
  and stepsTo a (m.step p (bin ">=" (Lit (FloatConst u)) (Lit (FloatConst v)))) (truth (u >= v))
  and stepsTo a (m.step p (bin "/=" (Lit (FloatConst u)) (Lit (FloatConst v)))) (truth (u /= v))
  and isNormal (m.step p (bin "/" (Lit (FloatConst u)) (Lit (FloatConst 0.0))))
-- `+` on strings is concatenation (core.lut `stringAppend`; the monoid of numbers_model.lut)
PrimString (a : Alpha) (sb : Substitution a) (m : Reduction a sb) (p : Program) (s t : String) : Bool :=
  stepsTo a (m.step p (bin "+" (Lit (StringConst s)) (Lit (StringConst t)))) (Lit (StringConst (s + t)))
-- `toFloat64` (11.S5, core.lut): a `Primitive` applied to an integer constant steps to the
-- nearest double
PrimConvert (a : Alpha) (sb : Substitution a) (m : Reduction a sb) (p : Program) (i : Int) : Bool :=
  stepsTo a (m.step p (App (Primitive "toFloat64") (Lit (IntConst i)))) (Lit (FloatConst (toFloat64 i)))
-- and `==` on values of structures with structural equality (3.S17, 4.R8): pairs, records,
-- injections and constructors of concrete parts compare part by part, labels included
PrimStructural (a : Alpha) (sb : Substitution a) (m : Reduction a sb) (p : Program) (i j : Int) (x y : String) : Bool :=
  stepsTo a (m.step p (bin "==" (Pair (Lit (IntConst i)) (Lit (IntConst j))) (Pair (Lit (IntConst i)) (Lit (IntConst j))))) (truth true)
  and stepsTo a (m.step p (bin "==" (Pair (Lit (IntConst i)) (Lit (IntConst j))) (Pair (Lit (IntConst j)) (Lit (IntConst i))))) (truth (i == j))
  and stepsTo a (m.step p (bin "==" (RecordValue [(x, Lit (IntConst i))]) (RecordValue [(x, Lit (IntConst j))]))) (truth (i == j))
  and stepsTo a (m.step p (bin "==" (Inj x (Lit (IntConst i))) (Inj y (Lit (IntConst i))))) (truth (x == y))
  and stepsTo a (m.step p (bin "==" (Lit (FloatConst 1.5)) (Lit (FloatConst 1.5)))) (truth true)
-- constructors of a `data` of the program compare by constructor, then part by part (lists among
-- them: `cons`, `nil` of core); stated on the data of `IotaConstructors`
PrimConstructors (a : Alpha) (sb : Substitution a) (m : Reduction a sb) (p : Program) (t c k f g : String) (i j : Int) : Bool :=
  not (distinctNames [t, c, k, f, g]) or not (allFree p [t, c, k, f, g])
  or (stepsTo a (m.step (withData t c k f g p) (bin "==" (Var c) (Var c))) (truth true)
      and stepsTo a (m.step (withData t c k f g p) (bin "==" (Var c) (Var k))) (truth false)
      and stepsTo a (m.step (withData t c k f g p) (bin "==" (App (Var f) (Lit (IntConst i))) (App (Var f) (Lit (IntConst j)))))
                    (truth (i == j))
      and stepsTo a (m.step (withData t c k f g p) (bin "==" (App (Var f) (Lit (IntConst i))) (App (Var g) (Lit (IntConst i)))))
                    (truth false))
-- `==` compares values, so it demands its parts as a match demands what its patterns inspect:
-- when a compared part is not yet a value, the step reduces that part in place, the leftmost
-- first (the coordinator, running `agreement`: a pair with an unreduced part was read as stuck)
EqualityDemandsParts (a : Alpha) (sb : Substitution a) (m : Reduction a sb) (p : Program) (x : String) (ty b u v : Term) : Bool :=
  stepsTo a (m.step p (bin "==" (Pair (App (Lam x ty b) u) v) v)) (bin "==" (Pair (sb.subst x u b) v) v)
  and stepsTo a (m.step p (bin "==" (Lit (IntConst 1)) (App (Lam x ty b) u))) (bin "==" (Lit (IntConst 1)) (sb.subst x u b))
  and stepsTo a (m.step p (bin "==" (RecordValue [(x, App (Lam x ty b) u)]) v)) (bin "==" (RecordValue [(x, sb.subst x u b)]) v)
-- and `==` does not step where equality is not structural (4.R8) or a part cannot become a value:
-- a lambda, an extern, a hole, an open term
EqualityStuck (a : Alpha) (sb : Substitution a) (m : Reduction a sb) (x f : String) (ty b : Term) (i : Int) : Bool :=
  isNormal (m.step [] (bin "==" (Lam x ty b) (Lam x ty b)))
  and isNormal (m.step [] (bin "==" (Extern f) (Extern f)))
  and isNormal (m.step [Declare f ty] (bin "==" (Var f) (Lit (IntConst i))))
  and isNormal (m.step [Declare f ty] (bin "==" (Pair (Var f) (Lit (IntConst i))) (Pair (Lit (IntConst i)) (Lit (IntConst i)))))

-- 3.S18, extern: an extern is a value until applied to as many closed arguments as its type has
-- parameters; then the host is called (spec 10), which this theory does not state: the answer is
-- the specimen's and its certificate's
ExternIsValue (a : Alpha) (sb : Substitution a) (m : Reduction a sb) (p : Program) (r : String) : Bool :=
  isNormal (m.step p (Extern r))

-- values do not step: lambdas (nothing under a binder), constants, introductions, the type
-- formers (whose roles are the checker's, program.lth), a primitive or an extern alone
ValuesStay (a : Alpha) (sb : Substitution a) (m : Reduction a sb) (p : Program) (x : String) (c : Constant)
           (ty b : Term) (kvs : List (String * Term)) : Bool :=
  isNormal (m.step p (Lam x ty b)) and isNormal (m.step p (Lit c)) and isNormal (m.step p Universe)
  and isNormal (m.step p World) and isNormal (m.step p (Pi x ty b)) and isNormal (m.step p (Sigma x ty b))
  and isNormal (m.step p (Sum kvs)) and isNormal (m.step p (Data x kvs)) and isNormal (m.step p (Subtype x ty b))
  and isNormal (m.step p (Record kvs)) and isNormal (m.step p (RecordValue kvs)) and isNormal (m.step p (Pair ty b))
  and isNormal (m.step p (Inj x b)) and isNormal (m.step p (Primitive x))

-- a datum changes no reduction: adding one to a program changes no step (the role of `Datum`)
DatumIsInert (a : Alpha) (sb : Substitution a) (m : Reduction a sb) (p : Program) (d t : Term) : Bool :=
  m.step (cons (Datum d) p) t == m.step p t

Reduction (a : Alpha) (sb : Substitution a) := Beta a sb & Delta a sb & Zeta a sb & HeadFirst a sb & HolesStay a sb & Iota a sb
  & IotaPair a sb & IotaSkips a sb & IotaConstructors a sb & ProjOfRecord a sb & Prim a sb & PrimInt a sb & PrimFloat a sb
  & PrimString a sb & PrimConvert a sb & PrimStructural a sb & PrimConstructors a sb & EqualityDemandsParts a sb & EqualityStuck a sb & ExternIsValue a sb & ValuesStay a sb
  & DatumIsInert a sb

-- ---------------------------------------------------------------- §6 Quote and eval

-- `quote { t }` is the `Term` of `t`, after elaboration, with no obligation; `eval A t` checks the
-- term `t` against the type `A` when it runs, and gives `just` its value or `nothing` (3.S32). The
-- model is core's `eval`; that `quote` gives the elaborated term is the translation's (2.S12).
-- `eval` gives the value the term reduces to, so its laws quantify over the terms whose value is
-- known, not over a few cases a lookup table could pass (review of layers 0-1, A).
Evaluation : { evalAt : (A : U) -> Term -> Maybe A }

QuoteGivesTheTerm (e : Evaluation) : Bool :=
  quote { 1 + 2 } == App (App (Var "+") (Lit (IntConst 1))) (Lit (IntConst 2))
EvalOfConstant (e : Evaluation) (i : Int) (s : String) : Bool :=
  e.evalAt Int (Lit (IntConst i)) == just i and e.evalAt String (Lit (StringConst s)) == just s
EvalChecks (e : Evaluation) (s : String) : Bool := e.evalAt Int (Lit (StringConst s)) == nothing
EvalOfQuote (e : Evaluation) : Bool := e.evalAt Int (quote { 1 + 2 }) == just 3
EvalComputes (e : Evaluation) (i j : Int) (x : String) : Bool :=
  e.evalAt Int (App (App (Var "+") (Lit (IntConst i))) (Lit (IntConst j))) == just (i + j)
  and e.evalAt Int (App (Lam x (Var "Int") (Var x)) (Lit (IntConst i))) == just i
  and e.evalAt Int (Let x (Var "Int") (Lit (IntConst i)) (Var x)) == just i

Evaluation := QuoteGivesTheTerm & EvalOfConstant & EvalChecks & EvalOfQuote & EvalComputes
