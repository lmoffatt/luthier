-- Luthier base library, version 0.
-- Everything here is written in Luthier itself; only Int, R and String are given.

Bool : U := data { true : Bool ; false : Bool }

not (b : Bool) : Bool := match b { true -> false ; false -> true }
and (a b : Bool) : Bool := match a { true -> b ; false -> false }
or (a b : Bool) : Bool := match a { true -> true ; false -> b }
implies (a b : Bool) : Bool := match a { true -> b ; false -> true }

Unit : U := data { unit : Unit }

N : U := data { zero : N ; succ : N -> N }

addN (m n : N) : N
  | m, zero   := m
  | m, succ k := succ (addN m k)

mulN (m n : N) : N
  | m, zero   := zero
  | m, succ k := addN (mulN m k) m

-- N is the conceptual natural, the one that reduces by hand. Int is the machine integer the
-- environment provides. They are two representations of one idea, related by a function with
-- laws (see examples/naturals.lut), not by a subtype: a natural is not an integer that happens
-- to be positive, any more than an integer is a real.
toInt (n : N) : Int
  | zero   := 0
  | succ k := 1 + toInt k

-- total on Int: negatives go to zero. The laws that make it an inverse of toInt live on Nat.
fromInt (k : Int) : N := if k <= 0 then zero else succ (fromInt (k - 1))

Nat : U := { k : Int | 0 <= k }

-- Two types are isomorphic when a pair of functions cancel both ways.
Iso (A B : U) : U := {
  to   : A -> B
  from : B -> A
  |
  \ (a : A) { from (to a) == a } & \ (b : B) { to (from b) == b }
}

Maybe (A : U) : U := data { nothing : Maybe A ; just : A -> Maybe A }

List (A : U) : U := data { nil : List A ; cons : A -> List A -> List A }

length (A : U) (xs : List A) : Int
  | A, nil       := 0
  | A, cons x xs := 1 + length A xs

-- Laws over a binary operation. The operation comes first, the quantified
-- variables last, so a partial application is a predicate the test can fill.

Associative   (A : U) (f : A -> A -> A) (x y z : A) : Bool := f (f x y) z == f x (f y z)
Commutative   (A : U) (f : A -> A -> A) (x y : A)   : Bool := f x y == f y x
LeftIdentity  (A : U) (f : A -> A -> A) (e : A) (x : A) : Bool := f e x == x
RightIdentity (A : U) (f : A -> A -> A) (e : A) (x : A) : Bool := f x e == x
LeftDistrib   (A : U) (f g : A -> A -> A) (x y z : A) : Bool := g x (f y z) == f (g x y) (g x z)
RightDistrib  (A : U) (f g : A -> A -> A) (x y z : A) : Bool := g (f y z) x == f (g y x) (g z x)
LeftInverse   (A : U) (f : A -> A -> A) (e : A) (inv : A -> A) (x : A) : Bool := f (inv x) x == e
RightInverse  (A : U) (f : A -> A -> A) (e : A) (inv : A -> A) (x : A) : Bool := f x (inv x) == e

-- Algebraic structures as subtypes with named components.

Monoid (A : U) : U := {
  op : A -> A -> A
  e  : A
  |
  Associative A op & LeftIdentity A op e & RightIdentity A op e
}

Semiring (A : U) : U := {
  add mul  : A -> A -> A
  zero one : A
  |
  Associative A add & Commutative A add
  & LeftIdentity A add zero & RightIdentity A add zero
  & Associative A mul & LeftIdentity A mul one & RightIdentity A mul one
  & LeftDistrib A add mul & RightDistrib A add mul
}

-- A ring is a semiring whose addition has inverses.
Ring (A : U) : U := {
  add mul  : A -> A -> A
  zero one : A
  neg      : A -> A
  |
  Associative A add & Commutative A add
  & LeftIdentity A add zero & RightIdentity A add zero
  & LeftInverse A add zero neg & RightInverse A add zero neg
  & Associative A mul & LeftIdentity A mul one & RightIdentity A mul one
  & LeftDistrib A add mul & RightDistrib A add mul
}
