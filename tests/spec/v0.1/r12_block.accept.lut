-- R12 and 02 §9: a block defines with := once and binds or rebinds with <-; a parameter of the
-- enclosing definition may be rebound; a lambda body is a block; a record value keeps its form;
-- a line break separates items and `;` is equivalent to it (D-2026-10-11-k).

step (x : Int) : Int := {
  y := x + 1
  x <- y * 2 ; x <- x + y
  x }

twice (f : Int -> Int) (a : Int) : Int := { b <- f a ; b <- f b ; b }

pairUp (a b : Int) : Int * Int := { p := (a, b) ; p }

Point = { x : Int, y : Int }
origin : Point := { x := 0, y := 0 }

shift (p : Point) : Point := {
  dx := 1
  { x := p.x + dx, y := p.y } }

main : Int := { r <- step 3 ; r <- twice (\ k { k + 1 }) r ; r }
