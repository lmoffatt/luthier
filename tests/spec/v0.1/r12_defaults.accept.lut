-- R12, D-2026-10-11-c: a parameter with a default, `(tol : T <- d)`, is filled once every parameter
-- without a default is given; an argument by name, `f a (tol <- v)`, goes to its parameter's position;
-- a default may mention the parameters before it.
approx (x y : Float64) (tol : Float64 <- 1.0e-6) : Bool := if x > y then x - y <= tol else y - x <= tol

a : Bool := approx 1.0 1.0000001
b : Bool := approx 1.0 1.5 (tol <- 1.0)
c : Bool := approx (tol <- 0.1) 1.0 1.05

scaled (x : Int) (k : Int <- x * 2) : Int := x + k
d : Int := scaled 3
e : Int := scaled 3 (k <- 1)
