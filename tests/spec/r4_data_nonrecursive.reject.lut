-- spec 4.S18, spec 4.R4, spec 3.R3, spec 4.R3: Non-recursive data with laws of both constructors is accepted; the retired verdict changes.
-- expect (v0.1): Color is not recursive; write Color = < red : Unit | green : Unit >
-- Source: tests/spec/v0.1/r4_data_nonrecursive.reject.lut at 310a9ba6682e982150584caea8f26dba643aa1e7;
-- sha256: 49bd9ba12ec7df38b7a08c3c37aa18e11c8709841f6b20c7d6ebae7f4d6e634f. Migration: spec-programs v1 (see README.md).

-- verdict: accept (flipped by spec 4.R4 and spec 3.R3).
-- A non-recursive data is allowed; both constructors have a role in alternation
-- (spec 4.R3), rather than being a collection observed by an accessor.
Color : U := data { red : Color ; green : Color }
Cycle : { next : Color -> Color }
NextRed (c : Cycle) : Bool := c.next red == green
NextGreen (c : Cycle) : Bool := c.next green == red
Cycle := NextRed & NextGreen
alternate : Cycle := { next := \ c { match c { red -> green ; green -> red } } }
