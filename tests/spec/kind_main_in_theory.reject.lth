-- spec 12.R2: `main`, the entry of a demand, belongs to a run (x.run.lut), not to a theory.
-- expect (proposed): belongs to a run
-- Written 2026-10-16 by Claude Opus 5.5, an agent of the coordinating session, on record/IA/code-follows-2026-10-16/prompt-file-kinds.md (D-2026-10-16-e).

Excluded (b : Bool) : Bool := b or not b
main : Bool := Excluded true
