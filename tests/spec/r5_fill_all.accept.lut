-- R5: the holes of a cycle are filled together, in one file.
import "r5_theory"

Table : U := extern "python:luthier.tables.Table"
nRows : Table -> Int := extern "python:luthier.tables.n_rows"
nCols : Table -> Int := extern "python:luthier.tables.n_cols"
sameTable : Table -> Table -> Bool := extern "python:luthier.tables.same"
gen Table := extern "python:luthier.tables.gen_table"

test NonNegative with 50
