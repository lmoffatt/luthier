-- a host table read back as the record crosses its names and kinds as Luthier lists of strings
-- (List String), so `==` on them steps: two tables parsed from texts with the same columns
import "world_model.lut" HostConsole host : HostConsole
import "tables.lth" Table
import "tables_model.lut" csv : Codec
parsed (s : String) : Table := match csv.parse s { just t -> t }
yes (b : Bool) : String := if b then "same" else "different"
main (w : W) : W * Unit :=
  match host.print w (yes ((parsed "a:int,b:str\n1,x\n").names == (parsed "a:int,b:str\n2,y\n3,z\n").names)) { (w1, u) ->
  match host.print w1 (yes ((parsed "a:int,b:str\n1,x\n").names == (parsed "a:int,c:str\n1,x\n").names)) { (w2, v) ->
  host.print w2 (yes ((parsed "a:int,b:str\n1,x\n").kinds == (parsed "a:int,b:str\n2,y\n").kinds)) } }
