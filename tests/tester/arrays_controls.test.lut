-- pinvSym's floor is an absolute 1e-3 instead of relative to the largest eigenvalue, read through
-- the relative leaf as rankAbs is (nothing retained when the norm is at most 1e-3); PinvScales held
-- on it before it scaled s to the size of the floor (record/IA/controls-2026-10-15/report-tail.md)
pinvAbs : Arrays := {
  add := numpy.add,
  sub := numpy.sub,
  scale := numpy.scale,
  dot := numpy.dot,
  norm := numpy.norm,
  matVec := numpy.matVec,
  matMul := numpy.matMul,
  madd := numpy.madd,
  msub := numpy.msub,
  mscale := numpy.mscale,
  transpose := numpy.transpose,
  retainedRank := numpy.retainedRank,
  trace := numpy.trace,
  pinvSym := fn fl a { if frobDef a <= 1.0e-3 then zeroMat a.m a.n else numpy.pinvSym (1.0e-3 / frobDef a) a },
}
ppinvAbs : List Binding := [
  { parameter := just "m", type := nothing, generator := "pinvAbs", coverage := Listed },
  { parameter := just "tol", type := nothing, generator := "tolerance", coverage := Listed },
  { parameter := just "fl", type := nothing, generator := "floor", coverage := Listed } ]

-- the listed symmetric matrices of arrays_laws.test.lut (copied): the positive semidefinite ones where
-- PinvRestricts is stated, and the ones PinvTraceIsRank runs on
diag3 (a b c : Float64) : Mat Float64 := mat Float64 3 3 (fn i j { if i == j then (if i == 0 then a else if i == 1 then b else c) else 0.0 })
symmetricMore : List (Mat Float64) := [
  mat Float64 3 3 (fn i j { toFloat64 ((i + 1) * (j + 1)) }),
  mat Float64 3 3 (fn i j { if i == j then toFloat64 (2 * i - 1) else 0.5 }),
  zeroMat 3 3,
  diag3 1.0 1.0e-13 2.0,
  diag3 1.0 1.0e-16 2.0,
  mat Float64 5 5 (fn i j { 1.0 / toFloat64 (i + j + 1) }),
  mat Float64 1 1 (fn i j { 0.0 - 2.0 }) ]
symmetricPsd : List (Mat Float64) := [
  mat Float64 3 3 (fn i j { toFloat64 ((i + 1) * (j + 1)) }),
  zeroMat 3 3,
  identity 3,
  diag3 1.0 1.0e-13 2.0,
  diag3 1.0 1.0e-16 2.0,
  mat Float64 5 5 (fn i j { 1.0 / toFloat64 (i + j + 1) }) ]
listedS : List Binding := [ { parameter := just "s", type := nothing, generator := "symmetricMore", coverage := Listed } ]
listedPsd : List Binding := [ { parameter := just "s", type := nothing, generator := "symmetricPsd", coverage := Listed } ]

-- the families the sampled lines draw a symmetric matrix and a rotation from (generators_model.lut):
-- a random matrix is symmetric or orthogonal only at 0 x 0 and 1 x 1, so the laws bind a generator
drawnS : List Binding := [byParameter "s" "symmetric"]
drawnRotation : List Binding := [byParameter "q" "orthogonal", byParameter "s" "symmetricOf"]

-- swapAdd: the sum is a difference
test "AddPointwise" (SampledMode linear) (seed <- 20261015) (profile <- pswapAdd) (control <- true)
-- swapSub: the difference is a sum
test "SubPointwise" (SampledMode linear) (seed <- 20261015) (profile <- pswapSub) (control <- true)
-- shiftScale: the entries are not c times x
test "ScalePointwise" (SampledMode linear) (seed <- 20261015) (profile <- pshiftScale) (control <- true)
-- noSwapT: the result is the matrix itself, not its transpose
test "TransposePointwise" (SampledMode linear) (seed <- 20261015) (profile <- pnoSwapT) (control <- true)
-- swapMadd: the sum is a difference
test "MaddPointwise" (SampledMode linear) (seed <- 20261015) (profile <- pswapMadd) (control <- true)
-- swapMsub: the difference is a sum
test "MsubPointwise" (SampledMode linear) (seed <- 20261015) (profile <- pswapMsub) (control <- true)
-- shiftMscale: the entries are not s times a
-- [2026-10-17, 3j j2a, the coordinator's answer to finding 1] Controls of the corrected error models
-- of PinvSymmetric and PinvScales (approxMatBoth, a normwise term added): a pinv perturbed just
-- beyond the bound must still be refuted, so the normwise term does not swallow a real break.
-- skewNormPinv: entry (0, 1) off by 1e-9 times the norm of p, three hundred times the bound
-- (1e-12 times |p01| + |p10| + the norm, at most three times the norm)
skewNormPinv : Arrays := {
  add := numpy.add,
  sub := numpy.sub,
  scale := numpy.scale,
  dot := numpy.dot,
  norm := numpy.norm,
  matVec := numpy.matVec,
  matMul := numpy.matMul,
  madd := numpy.madd,
  msub := numpy.msub,
  mscale := numpy.mscale,
  transpose := numpy.transpose,
  retainedRank := numpy.retainedRank,
  trace := numpy.trace,
  pinvSym := fn fl a { { p := numpy.pinvSym fl a
    numpy.madd p (mat Float64 a.m a.m (fn i j { if i == 0 and j == 1 then 1.0e-9 * frobDef p else 0.0 })) } },
}
pskewNormPinv : List Binding := [
  { parameter := just "m", type := nothing, generator := "skewNormPinv", coverage := Listed },
  { parameter := just "tol", type := nothing, generator := "tolerance", coverage := Listed },
  { parameter := just "fl", type := nothing, generator := "floor", coverage := Listed } ]

-- offsetPinv: 1e-6 added at entry (0, 0), an amount that does not scale as 1 / c
offsetPinv : Arrays := {
  add := numpy.add,
  sub := numpy.sub,
  scale := numpy.scale,
  dot := numpy.dot,
  norm := numpy.norm,
  matVec := numpy.matVec,
  matMul := numpy.matMul,
  madd := numpy.madd,
  msub := numpy.msub,
  mscale := numpy.mscale,
  transpose := numpy.transpose,
  retainedRank := numpy.retainedRank,
  trace := numpy.trace,
  pinvSym := fn fl a { numpy.madd (numpy.pinvSym fl a) (mat Float64 a.m a.m (fn i j { if i == 0 and j == 0 then 1.0e-6 else 0.0 })) },
}
poffsetPinv : List Binding := [
  { parameter := just "m", type := nothing, generator := "offsetPinv", coverage := Listed },
  { parameter := just "tol", type := nothing, generator := "tolerance", coverage := Listed },
  { parameter := just "fl", type := nothing, generator := "floor", coverage := Listed } ]

test "MscalePointwise" (SampledMode linear) (seed <- 20261015) (profile <- pshiftMscale) (control <- true)
-- skewDot: the two orders differ by the coordinates added
test "DotSymmetric" (SampledMode linear) (seed <- 20261015) (profile <- pskewDot) (control <- true)
-- dropDot: on the last basis vector the dot is 0, not x_j
test "DotOnBasis" (SampledMode linear) (seed <- 20261015) (profile <- pdropDot) (control <- true)
-- dropDot: the native sum has the last term
test "DotAgrees" (SampledMode linear) (seed <- 20261015) (profile <- pdropDot) (control <- true)
-- norm1: the norm of a basis vector is 2
test "NormOfBasis" (SampledMode linear) (seed <- 20261015) (profile <- pnorm1) (control <- true)
-- sqNorm: the norm is the inner product, not its root
test "NormOfDot" (SampledMode linear) (seed <- 20261015) (profile <- psqNorm) (control <- true)
-- sqNorm: the norm grows as c squared
test "NormScales" (SampledMode linear) (seed <- 20261015) (profile <- psqNorm) (control <- true)
-- doubleMV: the table on the basis is twice the matrix
test "MatVecOnBasis" (SampledMode linear) (seed <- 20261015) (profile <- pdoubleMV) (control <- true)
-- doubleMV: twice the native sum
test "MatVecAgrees" (SampledMode linear) (seed <- 20261015) (profile <- pdoubleMV) (control <- true)
-- doubleMM: a times the identity is twice a
test "MatMulIdentity" (SampledMode linear) (seed <- 20261015) (profile <- pdoubleMM) (control <- true)
-- noSwapT: the transpose of the product is the product itself, not b^T a^T
test "MatMulTransposes" (SampledMode linear) (seed <- 20261015) (profile <- pnoSwapT) (control <- true)
-- doubleMM: twice the native sum
test "MatMulAgrees" (SampledMode linear) (seed <- 20261015) (profile <- pdoubleMM) (control <- true)
-- rankFloor: a diagonal entry under 0.67 of the largest is dropped
test "RankOfDiagonal" (SampledMode linear) (seed <- 20261015) (profile <- prankFloor) (control <- true)
-- rankPlus1: the zero matrix has rank 1
test "RankOfZeroAndIdentity" (SampledMode linear) (seed <- 20261015) (profile <- prankPlus1) (control <- true)
-- rankPlus1: a full-rank matrix has rank m + 1
test "RankBounded" (SampledMode linear) (seed <- 20261015) (profile <- prankPlus1) (control <- true)
-- rankAbs: scaled to the size of the floor, every eigenvalue is below the absolute floor of 1e-3
test "RankScales" (SampledMode linear) (seed <- 20261015) (whereBindings <- drawnS) (profile <- prankAbs) (control <- true)
-- rankDiag: a rotation moves the diagonal, not the rank
test "RankUnderRotation" (SampledMode linear) (seed <- 20261015) (whereBindings <- drawnRotation) (profile <- prankDiag) (control <- true)
-- trace1: the trace of the identity is k + 1
test "TraceOfIdentity" (SampledMode linear) (seed <- 20261015) (profile <- ptrace1) (control <- true)
-- trace1: the offset is counted once on the left, twice on the right
test "TraceAdditive" (SampledMode linear) (seed <- 20261015) (profile <- ptrace1) (control <- true)
-- traceTwice: the entry added differs between a b and b a
test "TraceCyclic" (SampledMode linear) (seed <- 20261015) (profile <- ptraceTwice) (control <- true)
-- trace1: the native sum is one less
test "TraceAgrees" (SampledMode linear) (seed <- 20261015) (profile <- ptrace1) (control <- true)
-- invDiag: a negative entry is inverted, the law keeps it at zero
test "PinvOfDiagonal" (SampledMode linear) (seed <- 20261015) (profile <- pinvDiag) (control <- true)
-- ridge: the pseudo-inverse of the zero matrix is 1e-3 I, not zero
test "PinvOfZero" (SampledMode linear) (seed <- 20261015) (profile <- pridge) (control <- true)
-- ridge: the pseudo-inverse of the identity is 1.001 I
test "PinvOfIdentity" (SampledMode linear) (seed <- 20261015) (profile <- pridge) (control <- true)
-- ridge: p s p differs from p by the ridge
test "PinvProjects" (SampledMode linear) (seed <- 20261015) (profile <- pridge) (control <- true)
-- skewPinv: p is not symmetric
test "PinvSymmetric" (SampledMode linear) (seed <- 20261015) (whereBindings <- drawnS) (profile <- pskewPinv) (control <- true)
-- ridge: s p s differs from s by 1e-3 s squared, above the slack
test "PinvRestricts" ExhaustiveMode (whereBindings <- listedPsd) (profile <- pridge) (control <- true)
-- pinvFloor: an eigenvalue under 0.67 of the largest is dropped by the pinv but counted by the real rank
test "PinvTraceIsRank" ExhaustiveMode (whereBindings <- listedS) (profile <- ppinvFloor) (control <- true)
-- pinvAbs: scaled to the size of the floor, every eigenvalue is below the absolute floor of 1e-3
-- (before, ridge: the ridge does not scale as 1 / c; it saw a break of the size of the matrix)
test "PinvScales" (SampledMode linear) (seed <- 20261015) (whereBindings <- drawnS) (profile <- ppinvAbs) (control <- true)
-- skewNormPinv: p off its transpose by 1e-9 times its norm, beyond the normwise term (2026-10-17)
test "PinvSymmetric" (SampledMode linear) (seed <- 20261015) (whereBindings <- drawnS) (profile <- pskewNormPinv) (control <- true)
-- offsetPinv: an absolute 1e-6 at (0, 0), which P over c does not carry (2026-10-17)
test "PinvScales" (SampledMode linear) (seed <- 20261015) (whereBindings <- drawnS) (profile <- poffsetPinv) (control <- true)
