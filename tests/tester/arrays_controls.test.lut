-- retainedRank's floor is an absolute 1e-3 instead of relative to the largest eigenvalue: read
-- through the relative leaf as 1e-3 over the Frobenius norm (the largest eigenvalue is at most the
-- norm), and none retained when the norm is at most 1e-3 (report-weak-laws.md; before, an absolute
-- 1, the floor the law saw while it did not see 1e-3)
rankAbs : Arrays := {
  add := numpy.add,
  sub := numpy.sub,
  scale := numpy.scale,
  dot := numpy.dot,
  norm := numpy.norm,
  matVec := numpy.matVec,
  matMul := numpy.matMul,
  madd := numpy.madd,
  msub := numpy.msub,
  mscale := numpy.mscale,
  transpose := numpy.transpose,
  retainedRank := fn fl a { if frobDef a <= 1.0e-3 then 0 else numpy.retainedRank (1.0e-3 / frobDef a) a },
  trace := numpy.trace,
  pinvSym := numpy.pinvSym,
}
prankAbs : List Binding := [
  { parameter := just "m", type := nothing, generator := "rankAbs", coverage := Listed },
  { parameter := just "tol", type := nothing, generator := "tolerance", coverage := Listed },
  { parameter := just "fl", type := nothing, generator := "floor", coverage := Listed } ]

-- retainedRank counts the positive diagonal entries, as if the matrix were diagonal
rankDiag : Arrays := {
  add := numpy.add,
  sub := numpy.sub,
  scale := numpy.scale,
  dot := numpy.dot,
  norm := numpy.norm,
  matVec := numpy.matVec,
  matMul := numpy.matMul,
  madd := numpy.madd,
  msub := numpy.msub,
  mscale := numpy.mscale,
  transpose := numpy.transpose,
  retainedRank := fn fl a { countBelow a.m (fn i { 0.0 < a.f i i }) },
  trace := numpy.trace,
  pinvSym := numpy.pinvSym,
}
prankDiag : List Binding := [
  { parameter := just "m", type := nothing, generator := "rankDiag", coverage := Listed },
  { parameter := just "tol", type := nothing, generator := "tolerance", coverage := Listed },
  { parameter := just "fl", type := nothing, generator := "floor", coverage := Listed } ]

