-- tests/tester/arrays_controls.test.lut: the controls of arrays.lth's laws. Each line is written
-- `(control <- true)` (test.lth's `control`) and is expected to be refuted: it runs a law of
-- arrays_laws.test.lut on a model of `Arrays` broken on purpose (one leaf wrong, a plausible bug), so
-- that the law's passing on numpy is not vacuous (7.S19 as D-2026-10-15-a generalized it to every
-- law; L9.14). The tester records its outcome as a control's entry, never the law's failure.
-- Written 2026-10-15 by Claude Sonnet, an agent of the coordinating session, on
-- record/IA/controls-2026-10-15/prompt-mutants.md. Sampled lines keep arrays_laws.test.lut's `linear`
-- metric, tolerance and rank floor; seed 20261015. The broken models copy numpy's other fields.
-- PinvRestricts and PinvTraceIsRank run on listed matrices, as the laws do where sampling the
-- shape fails (see arrays_laws.test.lut).

import "test.lth" test ExhaustiveMode SampledMode
import "generators_model.lut" linear symmetric symmetricOf orthogonal
import "generators.lth" Binding byParameter
import "laws.lth" Listed
import "numbers.lth" Tolerance
import "arrays.lth" Arrays Vec Mat RankFloor mat vec identity zeroMat frobDef
  AddPointwise SubPointwise ScalePointwise TransposePointwise MaddPointwise MsubPointwise MscalePointwise
  DotSymmetric DotOnBasis DotAgrees NormOfBasis NormOfDot NormScales MatVecOnBasis MatVecAgrees
  MatMulIdentity MatMulTransposes MatMulAgrees RankOfDiagonal RankOfZeroAndIdentity RankBounded RankScales
  RankUnderRotation TraceOfIdentity TraceAdditive TraceCyclic TraceAgrees PinvOfDiagonal PinvOfZero
  PinvOfIdentity PinvProjects PinvSymmetric PinvRestricts PinvTraceIsRank PinvScales
import "arrays_model.lut" numpy

tolerance : Tolerance := 1.0e-12
floor : RankFloor := 6.661338147750939e-15

-- add is subtraction
swapAdd : Arrays := {
  add := numpy.sub,
  sub := numpy.sub,
  scale := numpy.scale,
  dot := numpy.dot,
  norm := numpy.norm,
  matVec := numpy.matVec,
  matMul := numpy.matMul,
  madd := numpy.madd,
  msub := numpy.msub,
  mscale := numpy.mscale,
  transpose := numpy.transpose,
  retainedRank := numpy.retainedRank,
  trace := numpy.trace,
  pinvSym := numpy.pinvSym,
}
pswapAdd : List Binding := [
  { parameter := just "m", type := nothing, generator := "swapAdd", coverage := Listed },
  { parameter := just "tol", type := nothing, generator := "tolerance", coverage := Listed },
  { parameter := just "fl", type := nothing, generator := "floor", coverage := Listed } ]

