-- pinvSym inverts every nonzero diagonal entry with no floor (negative ones too)
invDiag : Arrays := {
  add := numpy.add,
  sub := numpy.sub,
  scale := numpy.scale,
  dot := numpy.dot,
  norm := numpy.norm,
  matVec := numpy.matVec,
  matMul := numpy.matMul,
  madd := numpy.madd,
  msub := numpy.msub,
  mscale := numpy.mscale,
  transpose := numpy.transpose,
  retainedRank := numpy.retainedRank,
  trace := numpy.trace,
  pinvSym := fn fl a { mat Float64 a.m a.n (fn i j { if i == j then (if a.f i i == 0.0 then 0.0 else 1.0 / a.f i i) else 0.0 }) },
}
pinvDiag : List Binding := [
  { parameter := just "m", type := nothing, generator := "invDiag", coverage := Listed },
  { parameter := just "tol", type := nothing, generator := "tolerance", coverage := Listed },
  { parameter := just "fl", type := nothing, generator := "floor", coverage := Listed } ]

-- pinvSym adds a ridge 1e-3 I
ridge : Arrays := {
  add := numpy.add,
  sub := numpy.sub,
  scale := numpy.scale,
  dot := numpy.dot,
  norm := numpy.norm,
  matVec := numpy.matVec,
  matMul := numpy.matMul,
  madd := numpy.madd,
  msub := numpy.msub,
  mscale := numpy.mscale,
  transpose := numpy.transpose,
  retainedRank := numpy.retainedRank,
  trace := numpy.trace,
  pinvSym := fn fl a { numpy.madd (numpy.pinvSym fl a) (mat Float64 a.m a.m (fn i j { if i == j then 1.0e-3 else 0.0 })) },
}
pridge : List Binding := [
  { parameter := just "m", type := nothing, generator := "ridge", coverage := Listed },
  { parameter := just "tol", type := nothing, generator := "tolerance", coverage := Listed },
  { parameter := just "fl", type := nothing, generator := "floor", coverage := Listed } ]

