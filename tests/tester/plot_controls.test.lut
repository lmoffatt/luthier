-- tests/tester/plot_controls.test.lut: the controls of the laws of `Drawing` (plot.lth §5) and of
-- `Persistence` (world.lth §2) that tests/tester/plot_laws.test.lut certifies on matplotlib's drawing
-- and its store `files` (plot_model.lut). Each line is the law's line written `(control <- true)`
-- (test.lth's `control`), with the drawing or the store replaced by one broken on purpose, and is
-- expected to be refuted: it shows that the law can fail on a wrong model, so that its passing on
-- the real one is not vacuous (7.S19 as D-2026-10-15-a generalized it to every law; L9.14). The
-- tester records its outcome as a control's entry, never the law's failure. Written 2026-10-15 by
-- Claude Opus 5.5, an agent of the coordinating session, on
-- record/IA/controls-2026-10-15/prompt-mutants.md. The plots, worlds and censuses are
-- plot_cases.lut's, imported (until 2026-10-16 from plot_laws.test.lut; a test program is never
-- imported, D-2026-10-16-e). A broken image is matplotlib's with a mark appended that depends on
-- what the law says the image does not depend on (or with the title dropped): the file is then no
-- image, which no law here reads.

import "test.lth" test ExhaustiveMode
import "generators.lth" Binding
import "laws.lth" Listed
import "tables.lth" Table int real
import "plot.lth" Plot Drawing Layer retitle FileExistsAfter FormatByExtension ImageOfTheValue
  RowOrderInvariant LayerOrderInvariant ImageSeesTheTitle
import "world.lth" Persistence WriteThenRead WriteChangesOnlyItsPlace
import "world_model.lut" WorldState theWorld
import "plot_model.lut" matplotlibDrawing files
import "plot_cases.lut" parsed obsText pointsAndLine states plots again exts stems worlds tableNames obsTables perms
  margins positions titles paths contents bindTo

-- the store writes nothing: drawing leaves no file (FileExistsAfter)
writesNothing : Persistence WorldState := { world := theWorld, write := fn st p c { st } }
noFile : Drawing WorldState := { store := writesNothing, formats := matplotlibDrawing.formats,
  rasters := matplotlibDrawing.rasters, image := matplotlibDrawing.image, formatOf := matplotlibDrawing.formatOf }
-- the format reader reads every image as a PNG (FormatByExtension)
pngAlways : Drawing WorldState := { store := files, formats := matplotlibDrawing.formats, rasters := matplotlibDrawing.rasters,
  image := matplotlibDrawing.image, formatOf := fn b { "png" } }
-- the image reads a cell at a name the schema does not have (ImageOfTheValue): two tables with the
-- same cells may differ there
offCell (p : Plot) : String :=
  match lookup List String Table "obs" p.tables { nothing -> "" ; just t -> match t.cell "zz" 0 { nothing -> "" ; just c -> "zz" } }
readsOffSchema : Drawing WorldState := { store := files, formats := matplotlibDrawing.formats, rasters := matplotlibDrawing.rasters,
  image := fn p e { matplotlibDrawing.image p e <> offCell p }, formatOf := matplotlibDrawing.formatOf }
-- the image marks the first row of obs apart (RowOrderInvariant): the off-by-one of a reader that
-- takes the first row for something else
firstRow (p : Plot) : String :=
  match lookup List String Table "obs" p.tables { nothing -> "" ; just t -> if t.cell "x" 0 == just (real 1.0) then "first" else "" }
firstRowApart : Drawing WorldState := { store := files, formats := matplotlibDrawing.formats, rasters := matplotlibDrawing.rasters,
  image := fn p e { matplotlibDrawing.image p e <> firstRow p }, formatOf := matplotlibDrawing.formatOf }
-- the image depends on which table the first layer draws (LayerOrderInvariant), apart or not
firstLayer (p : Plot) : String := match nth Layer p.layers 0 { nothing -> "" ; just l -> l.table }
layerOrdered : Drawing WorldState := { store := files, formats := matplotlibDrawing.formats, rasters := matplotlibDrawing.rasters,
  image := fn p e { matplotlibDrawing.image p e <> firstLayer p }, formatOf := matplotlibDrawing.formatOf }
-- the image drops the title (ImageSeesTheTitle)
noTitle : Drawing WorldState := { store := files, formats := matplotlibDrawing.formats, rasters := matplotlibDrawing.rasters,
  image := fn p e { matplotlibDrawing.image (retitle p "") e }, formatOf := matplotlibDrawing.formatOf }

-- the store writes an empty file (WriteThenRead)
writesEmpty : Persistence WorldState := { world := theWorld, write := fn st p c { files.write st p "" } }
-- the store keeps only the file it writes (WriteChangesOnlyItsPlace)
keepsOnlyIt : Persistence WorldState := { world := theWorld, write := fn st p c { { stdout := st.stdout, files := [(p, c)] } } }

noFileList : List (Drawing WorldState) := [noFile]
pngAlwaysList : List (Drawing WorldState) := [pngAlways]
readsOffSchemaList : List (Drawing WorldState) := [readsOffSchema]
firstRowApartList : List (Drawing WorldState) := [firstRowApart]
layerOrderedList : List (Drawing WorldState) := [layerOrdered]
noTitleList : List (Drawing WorldState) := [noTitle]
writesEmptyList : List (Persistence WorldState) := [writesEmpty]
keepsOnlyItList : List (Persistence WorldState) := [keepsOnlyIt]

-- the second plot for ImageOfTheValue: obs with a cell at a name off its schema, the same plot by
-- `samePlot` (its cells compared at the schema's names)
leaky (t : Table) : Table := { nRows := t.nRows, names := t.names, kinds := t.kinds,
  cell := fn c r { if c == "zz" then just (int 1) else t.cell c r } }
plainPlots : List Plot := [pointsAndLine (parsed obsText)]
leakyPlots : List Plot := [pointsAndLine (leaky (parsed obsText))]

test "FileExistsAfter" ExhaustiveMode (seed <- 20261015) (whereBindings <- [bindTo "S" "states", bindTo "d" "noFileList",
  bindTo "p" "plots", bindTo "stem" "stems", bindTo "ext" "exts", bindTo "st" "worlds"]) (control <- true)
test "FormatByExtension" ExhaustiveMode (seed <- 20261015) (whereBindings <- [bindTo "S" "states", bindTo "d" "pngAlwaysList",
  bindTo "p" "plots", bindTo "ext" "exts"]) (control <- true)
test "ImageOfTheValue" ExhaustiveMode (seed <- 20261015) (whereBindings <- [bindTo "S" "states", bindTo "d" "readsOffSchemaList",
  bindTo "p" "plainPlots", bindTo "q" "leakyPlots", bindTo "ext" "exts"]) (control <- true)
test "RowOrderInvariant" ExhaustiveMode (seed <- 20261015) (whereBindings <- [bindTo "S" "states", bindTo "d" "firstRowApartList",
  bindTo "p" "plots", bindTo "name" "tableNames", bindTo "t" "obsTables", bindTo "f" "perms", bindTo "ext" "exts"]) (control <- true)
test "LayerOrderInvariant" ExhaustiveMode (seed <- 20261015) (whereBindings <- [bindTo "S" "states", bindTo "d" "layerOrderedList",
  bindTo "margin" "margins", bindTo "p" "plots", bindTo "i" "positions", bindTo "ext" "exts"]) (control <- true)
test "ImageSeesTheTitle" ExhaustiveMode (seed <- 20261015) (whereBindings <- [bindTo "S" "states", bindTo "d" "noTitleList",
  bindTo "p" "plots", bindTo "s" "titles", bindTo "ext" "exts"]) (control <- true)
test "WriteThenRead" ExhaustiveMode (seed <- 20261015) (whereBindings <- [bindTo "S" "states", bindTo "s" "writesEmptyList",
  bindTo "st" "worlds", bindTo "p" "paths", bindTo "c" "contents"]) (control <- true)
test "WriteChangesOnlyItsPlace" ExhaustiveMode (seed <- 20261015) (whereBindings <- [bindTo "S" "states", bindTo "s" "keepsOnlyItList",
  bindTo "st" "worlds", bindTo "p" "paths", bindTo "c" "contents", bindTo "q" "paths"]) (control <- true)
