-- tests/tester/plan_controls.test.lut: the controls of the laws of plan.lth that tests/tester/
-- plan_laws.test.lut certifies. Each line is the law's line written `(control <- true)` (test.lth's
-- `control`), with the model replaced by one broken on purpose, and is expected to be refuted: it
-- shows that the law can fail on a wrong model, so that its passing on the real one is not vacuous
-- (7.S19 as D-2026-10-15-a generalized it to every law; L9.14). The tester records its outcome as
-- a control's entry, never the law's failure. Written 2026-10-15 by Claude Opus 5.5, an agent of
-- the coordinating session, on record/IA/v04-2026-10-15/prompt-e.md. The broken models: for
-- `Dataflow`, a node named twice, two names that read each other, and `hidden`, whose `d` lists
-- only `b` and reads `c` too (the dataflow `Confluent` and `PlanIsConfluent` are refuted on: the
-- planner of those laws is right, and the break they see is the dataflow's); for `Planning`, a
-- planner whose live set is the whole graph, one whose schedule is reversed, one whose forward
-- plan drops its first name, one whose forward plan is the order of first demand, and one whose
-- call by need is the forward order. `KeyReadsOnlyTheCone`, restated 2026-10-17 so that the
-- planner enters it (plan.lth §4), is controlled by `wholeGraph`: its live set holds `e`, which the
-- entry `d` does not reach, so a value set on `e` enters its key. `KeyReadsTheType` is gone, plan.lth
-- §4 says why.

import "test.lth" test ExhaustiveMode
import "generators.lth" Binding
import "laws.lth" Listed
import "certification.lth" Value Number Printed
import "demand.lth" Demand RunRecord recorded
import "demand_model.lut" theDemand
import "plan.lth" Planning Dataflow Plan Schedule Strategy CallByNeed ForwardOnDemand reaches names firstDemand
  NamesAreUnique Acyclic StepIsLocal Confluent PlanIsTheLiveCone PlanLinearizes StrategiesAgree TheDefaultsAgree
  ForwardIsByLevels ByNeedIsFirstDemand PlanIsConfluent KeyReadsOnlyTheCone PureConeIsDeterminate MemoKey DemandKey Keying
  DigestSeparatesTheDemand DigestSeparatesTheCone DigestSeparatesTheMode DigestSeparatesTheSeed DigestSeparatesThePlan
  DigestSeparatesTheCertificates PlanDigestSeparatesTheSchedule LookupComparesTheFullKey ActionConeIsNeverServed KeyIsOfTheRecord
  ForwardOnDemand CallByNeed
import "generators.lth" Seed
import "certification.lth" Hash
import "plan_model.lut" planning keying planDigest strategyName example eqNat byNeed forward plan

types : List U := [Nat]
eqs : List (Nat -> Nat -> Bool) := [eqNat]
planners : List (Planning Nat eqNat) := [planning]

-- the dataflow of plan_laws.test.lut where first demand is not by levels
uneven : Dataflow Nat eqNat := {
  nodes := [{ name := "a", reads := nil }, { name := "b", reads := ["a"] }, { name := "c", reads := nil },
            { name := "d", reads := ["b", "c"] }],
  init := 0,
  step := fn n env { if n == "a" then 2 else if n == "b" then env "a" * 3 else if n == "c" then 5
                     else if n == "d" then env "b" + env "c" else 0 },
}

-- broken dataflows
-- a defined twice
twice : Dataflow Nat eqNat := {
  nodes := [{ name := "a", reads := nil }, { name := "a", reads := nil }, { name := "b", reads := ["a"] }],
  init := 0,
  step := fn n env { if n == "a" then 1 else if n == "b" then env "a" + 1 else 0 },
}
-- a reads b and b reads a
cyclic : Dataflow Nat eqNat := {
  nodes := [{ name := "a", reads := ["b"] }, { name := "b", reads := ["a"] }],
  init := 0,
  step := fn n env { if n == "a" then env "b" + 1 else if n == "b" then env "a" + 1 else 0 },
}
-- d lists b and reads c too; the entry f reads c and d, so c and d are both live and unordered
hidden : Dataflow Nat eqNat := {
  nodes := [{ name := "a", reads := nil }, { name := "b", reads := ["a"] }, { name := "c", reads := ["a"] },
            { name := "d", reads := ["b"] }, { name := "f", reads := ["c", "d"] }],
  init := 0,
  step := fn n env { if n == "a" then 1 else if n == "b" then env "a" + 1 else if n == "c" then env "a" * 2
                     else if n == "d" then env "b" + env "c" else if n == "f" then env "c" + env "d" else 0 },
}
twices : List (Dataflow Nat eqNat) := [twice]
cyclics : List (Dataflow Nat eqNat) := [cyclic]
hiddens : List (Dataflow Nat eqNat) := [hidden]
nodeNames : List String := ["a", "b", "c", "d", "f"]
everySeven (m : String) : Nat := 7
envs : List (String -> Nat) := [everySeven]
hiddenLives : List (List String) := [["a", "b", "c", "d", "f"]]
hiddenSchedules : List Schedule := [["a", "b", "c", "d", "f"], ["a", "b", "d", "c", "f"]]
choices : List (List Nat) := [nil, [1], [1, 1], [0, 1, 0], [2, 1, 1], [5]]

-- broken planners
reverseStrs (xs : List String) (acc : List String) : List String := reverse String xs <> acc
tailStrs (xs : List String) : List String := drop String 1 xs
-- the live set is every name of the graph, not what the entry reaches
wholePlan (A : U) (eq : A -> A -> Bool) (st : Strategy) (d : Dataflow A eq) (e : String) : Plan A :=
  { strategy := st, entry := e, live := names d.nodes, schedule := (plan A eq st d e).schedule }
wholeGraph : Planning Nat eqNat := { plan := wholePlan Nat eqNat }
-- the schedule reversed: each name before what it reads
reversedPlan (A : U) (eq : A -> A -> Bool) (st : Strategy) (d : Dataflow A eq) (e : String) : Plan A :=
  { strategy := st, entry := e, live := reaches A eq d e, schedule := reverseStrs (plan A eq st d e).schedule nil }
reversedSchedule : Planning Nat eqNat := { plan := reversedPlan Nat eqNat }
-- forward on demand drops the first name it places
dropsPlan (A : U) (eq : A -> A -> Bool) (st : Strategy) (d : Dataflow A eq) (e : String) : Plan A :=
  { strategy := st, entry := e, live := reaches A eq d e,
    schedule := (match st { CallByNeed -> byNeed A eq d e ; ForwardOnDemand -> tailStrs (forward A eq d (reaches A eq d e)) }) }
forwardDropsFirst : Planning Nat eqNat := { plan := dropsPlan Nat eqNat }
-- forward on demand in the order of first demand
asNeedPlan (A : U) (eq : A -> A -> Bool) (st : Strategy) (d : Dataflow A eq) (e : String) : Plan A :=
  { strategy := st, entry := e, live := reaches A eq d e, schedule := byNeed A eq d e }
forwardAsNeed : Planning Nat eqNat := { plan := asNeedPlan Nat eqNat }
-- call by need in the forward order
asForwardPlan (A : U) (eq : A -> A -> Bool) (st : Strategy) (d : Dataflow A eq) (e : String) : Plan A :=
  { strategy := st, entry := e, live := reaches A eq d e, schedule := forward A eq d (reaches A eq d e) }
needAsForward : Planning Nat eqNat := { plan := asForwardPlan Nat eqNat }
wholeGraphs : List (Planning Nat eqNat) := [wholeGraph]
reversedSchedules : List (Planning Nat eqNat) := [reversedSchedule]
forwardDropsFirsts : List (Planning Nat eqNat) := [forwardDropsFirst]
forwardAsNeeds : List (Planning Nat eqNat) := [forwardAsNeed]
needAsForwards : List (Planning Nat eqNat) := [needAsForward]
exampleOnly : List (Dataflow Nat eqNat) := [example]
unevenOnly : List (Dataflow Nat eqNat) := [uneven]
entryD : List String := ["d"]
entryF : List String := ["f"]
-- the demands, holes and values of plan_laws.test.lut: `e` is a name of `example` the entry `d`
-- does not reach, `z` is no name of it
demands : List Demand := [theDemand (entry <- "d"), theDemand (entry <- "d") (sets <- [("a", Number 1.0), ("z", Printed "x")])]
holes : List String := ["a", "e", "z"]
values : List Value := [Number 2.0, Printed "y"]

bind (p g : String) : Binding := { parameter := just p, type := nothing, generator := g, coverage := Listed }
onDataflow (d : String) : List Binding := [bind "A" "types", bind "eq" "eqs", bind "d" d]
onPlan (p d e : String) : List Binding := [bind "A" "types", bind "eq" "eqs", bind "p" p, bind "d" d, bind "e" e]

test "NamesAreUnique" ExhaustiveMode (seed <- 20261015) (whereBindings <- onDataflow "twices") (control <- true)
test "Acyclic" ExhaustiveMode (seed <- 20261015) (whereBindings <- onDataflow "cyclics") (control <- true)
test "StepIsLocal" ExhaustiveMode (seed <- 20261015) (whereBindings <- [bind "A" "types", bind "eq" "eqs",
  bind "d" "hiddens", bind "n" "nodeNames", bind "env" "envs"]) (control <- true)
test "Confluent" ExhaustiveMode (seed <- 20261015) (whereBindings <- [bind "A" "types", bind "eq" "eqs",
  bind "d" "hiddens", bind "live" "hiddenLives", bind "s1" "hiddenSchedules", bind "s2" "hiddenSchedules"]) (control <- true)
test "PlanIsTheLiveCone" ExhaustiveMode (seed <- 20261015) (whereBindings <- onPlan "wholeGraphs" "exampleOnly" "entryD") (control <- true)
test "PlanLinearizes" ExhaustiveMode (seed <- 20261015) (whereBindings <- onPlan "reversedSchedules" "exampleOnly" "entryD") (control <- true)
test "StrategiesAgree" ExhaustiveMode (seed <- 20261015) (whereBindings <- onPlan "forwardDropsFirsts" "exampleOnly" "entryD") (control <- true)
test "TheDefaultsAgree" ExhaustiveMode (seed <- 20261015) (whereBindings <- onPlan "forwardDropsFirsts" "exampleOnly" "entryD") (control <- true)
test "ForwardIsByLevels" ExhaustiveMode (seed <- 20261015) (whereBindings <- onPlan "forwardAsNeeds" "unevenOnly" "entryD") (control <- true)
test "ByNeedIsFirstDemand" ExhaustiveMode (seed <- 20261015) (whereBindings <- onPlan "needAsForwards" "unevenOnly" "entryD") (control <- true)
test "PlanIsConfluent" ExhaustiveMode (seed <- 20261015) (whereBindings <- [bind "A" "types", bind "eq" "eqs",
  bind "p" "planners", bind "d" "hiddens", bind "e" "entryF", bind "cs" "choices"]) (control <- true)
test "KeyReadsOnlyTheCone" ExhaustiveMode (seed <- 20261015) (whereBindings <- [bind "A" "types", bind "eq" "eqs",
  bind "p" "wholeGraphs", bind "d" "exampleOnly", bind "dm" "demands", bind "n" "holes", bind "v" "values"]) (control <- true)

-- §4 the digest and the lookup, broken (2026-10-23, Claude Sonnet 5.5, audit 3.4, A7), over the keys
-- and records of plan_laws.test.lut. A digest that is one constant name collides on every pair of
-- keys, so the laws that say the digest separates what differs are refuted; a lookup that trusts the
-- digest alone serves a key that is not the one asked, on the collision; a lookup that ignores
-- whether the cone is pure serves a cone with an action; a run's key that is a constant is not
-- the digest of `keyOf` of its record; a plan digest that leaves the schedule out does not see it.
chosenOnly (p : Plan Nat) : Hash :=
  planDigest { strategy := strategyName p.strategy, entry := p.entry, live := p.live, schedule := nil }
colliding : Keying Nat := { key := fn k { "h" }, planHash := keying.planHash, runKey := keying.runKey, serves := keying.serves }
byDigestAlone : Keying Nat := { key := fn k { "h" }, planHash := keying.planHash, runKey := keying.runKey,
  serves := fn pure stored asked { pure and "h" == "h" } }
ignoresPurity : Keying Nat := { key := keying.key, planHash := keying.planHash, runKey := keying.runKey,
  serves := fn pure stored asked { stored == asked } }
constantRunKey : Keying Nat := { key := keying.key, planHash := keying.planHash, runKey := fn r s p cs { "h" }, serves := keying.serves }
blindToSchedule : Keying Nat := { key := keying.key, planHash := chosenOnly, runKey := keying.runKey, serves := keying.serves }
collidings : List (Keying Nat) := [colliding]
byDigests : List (Keying Nat) := [byDigestAlone]
ignorers : List (Keying Nat) := [ignoresPurity]
constants : List (Keying Nat) := [constantRunKey]
blinds : List (Keying Nat) := [blindToSchedule]
key1 : MemoKey := { demand := { decoration := nothing, values := nil }, cone := "sha256:c1", mode := "plain", seed := 1,
  plan := "sha256:p1", certificates := ["sha256:e1"] }
key2 : MemoKey := { demand := { decoration := nothing, values := [("a", Number 1.0)] }, cone := "sha256:c2", mode := "checked", seed := 2,
  plan := "sha256:p2", certificates := nil }
keys : List MemoKey := [key1, key2]
demandKeys : List DemandKey := [{ decoration := nothing, values := nil }, { decoration := nothing, values := [("a", Number 1.0)] }]
cones : List Hash := ["sha256:c1", "sha256:c2"]
modes : List String := ["plain", "checked"]
seeds : List Seed := [1, 2, 3]
planHashes : List Hash := ["sha256:p1", "sha256:p2"]
certLists : List (List Hash) := [nil, ["sha256:e1"]]
somePlans : List (Plan Nat) := [{ strategy := ForwardOnDemand, entry := "d", live := ["a", "b", "c", "d"], schedule := ["a", "b", "c", "d"] }]
orders : List Schedule := [nil, ["a", "c", "b", "d"]]
records : List RunRecord := [recorded (theDemand (entry <- "d") (sets <- [("a", Number 1.0)])) "sha256:c1"]
strategies : List Strategy := [ForwardOnDemand, CallByNeed]
envLists : List (List (String -> Nat)) := [envs]
onKeys (g : String) (extra : List Binding) : List Binding := [bind "A" "types", bind "h" g] <> extra
test "DigestSeparatesTheDemand" ExhaustiveMode (seed <- 20261015) (whereBindings <- onKeys "collidings" [bind "k" "keys", bind "dk" "demandKeys"]) (control <- true)
test "DigestSeparatesTheCone" ExhaustiveMode (seed <- 20261015) (whereBindings <- onKeys "collidings" [bind "k" "keys", bind "c" "cones"]) (control <- true)
test "DigestSeparatesTheMode" ExhaustiveMode (seed <- 20261015) (whereBindings <- onKeys "collidings" [bind "k" "keys", bind "m" "modes"]) (control <- true)
test "DigestSeparatesTheSeed" ExhaustiveMode (seed <- 20261015) (whereBindings <- onKeys "collidings" [bind "k" "keys", bind "s" "seeds"]) (control <- true)
test "DigestSeparatesThePlan" ExhaustiveMode (seed <- 20261015) (whereBindings <- onKeys "collidings" [bind "k" "keys", bind "p" "planHashes"]) (control <- true)
test "DigestSeparatesTheCertificates" ExhaustiveMode (seed <- 20261015) (whereBindings <- onKeys "collidings" [bind "k" "keys", bind "hs" "certLists"]) (control <- true)
test "PlanDigestSeparatesTheSchedule" ExhaustiveMode (seed <- 20261015) (whereBindings <- onKeys "blinds" [bind "p" "somePlans", bind "s" "orders"]) (control <- true)
test "LookupComparesTheFullKey" ExhaustiveMode (seed <- 20261015) (whereBindings <- onKeys "byDigests" [bind "stored" "keys", bind "asked" "keys"]) (control <- true)
test "ActionConeIsNeverServed" ExhaustiveMode (seed <- 20261015) (whereBindings <- onKeys "ignorers" [bind "stored" "keys", bind "asked" "keys"]) (control <- true)
test "KeyIsOfTheRecord" ExhaustiveMode (seed <- 20261015) (whereBindings <- onKeys "constants" [bind "r" "records", bind "s" "seeds", bind "p" "somePlans", bind "cs" "certLists"]) (control <- true)
-- §5 a planner whose forward plan drops its first name breaks determinacy of a cone whose steps are local
test "PureConeIsDeterminate" ExhaustiveMode (seed <- 20261015) (whereBindings <- [bind "A" "types", bind "eq" "eqs", bind "p" "forwardDropsFirsts",
  bind "d" "exampleOnly", bind "e" "entryD", bind "envs" "envLists", bind "s1" "strategies", bind "s2" "strategies"]) (control <- true)
