-- tests/tester/world_controls.test.lut: the controls of the laws of `Console` (world.lth §4) that
-- tests/tester/world_laws.test.lut certifies on world_model.lut's `console`. Each line is the law's line
-- written `(control <- true)` (test.lth's `control`), with the console replaced by one broken on
-- purpose, and is expected to be refuted: it shows that the law can fail on a wrong console, so
-- that its passing on the real one is not vacuous (7.S19 as D-2026-10-15-a generalized it to every
-- law; L9.14). The tester records its outcome as a control's entry, never the law's failure.
-- Written 2026-10-15 by Claude Opus 5.5, an agent of the coordinating session, on
-- record/IA/controls-2026-10-15/prompt-mutants.md. The states, lines and places are those of
-- world_laws.test.lut.

import "test.lth" test ExhaustiveMode Grade Proved Cases Sampled AssumedGrade
import "generators.lth" Binding
import "laws.lth" Listed
import "term.lth" Term Var App
import "world.lth" Console appendStr lineOf PrintAppendsALine PrintChangesOnlyStdout ReadGivesThePlace
  ReadChangesNothing World Described OwnIsIdempotent ChangesOnlyDeclared Externs Route routeOf isProvisional memberStr settled
  AppliedWhenSettled NoLawNoGrade ProvisionalIsAssumed IdentityCarriesHash Crossing mapList lengthOf
  CallbackGivesTheFunction CallsAreCounted RecordCrossesByField Host Observed Held held printDescription
  readFileDescription HostAgreesPrint HostAgreesReadFile HostObserveChangesNothing HostChangesOnlyDeclared
import "world_model.lut" State console theWorld lookupFile host

states : List Concrete := [State]
blank : State := { stdout := "", files := nil }
printed : State := { stdout := "one\n", files := nil }
withFiles : State := { stdout := "", files := [("input.txt", "first\nsecond\n"), ("empty.txt", "")] }
worlds : List State := [blank, printed, withFiles]
lines : List String := ["", "hello, world", "two\nlines"]
places : List String := ["stdout", "input.txt", "empty.txt", "other.txt"]

-- print forgets the newline: the line is appended without its end
noNewline : Console State := { world := theWorld,
  printLine := fn s st { ({ stdout := appendStr st.stdout s, files := st.files }, unit) },
  readFile := console.readFile, stdout := console.stdout }
-- print clears the files as it writes the standard output
dropsFiles : Console State := { world := theWorld,
  printLine := fn s st { ({ stdout := appendStr st.stdout (lineOf s), files := nil }, unit) },
  readFile := console.readFile, stdout := console.stdout }
-- readFile always answers that there is no file
readsNothing : Console State := { world := theWorld, printLine := console.printLine,
  readFile := fn p st { (st, nothing) }, stdout := console.stdout }
-- readFile gives the right answer but empties the standard output
readClears : Console State := { world := theWorld, printLine := console.printLine,
  readFile := fn p st { ({ stdout := "", files := st.files }, lookupFile st.files p) }, stdout := console.stdout }
noNewlines : List (Console State) := [noNewline]
dropsFilesList : List (Console State) := [dropsFiles]
readsNothingList : List (Console State) := [readsNothing]
readClearsList : List (Console State) := [readClears]

bind (p g : String) : Binding := { parameter := just p, type := nothing, generator := g, coverage := Listed }
onPrint (c : String) : List Binding := [bind "S" "states", bind "c" c, bind "st" "worlds", bind "s" "lines"]
onPrintElsewhere (c : String) : List Binding := [bind "S" "states", bind "c" c, bind "st" "worlds",
  bind "s" "lines", bind "p" "places"]
onRead (c : String) : List Binding := [bind "S" "states", bind "c" c, bind "st" "worlds", bind "p" "places"]

test "PrintAppendsALine" ExhaustiveMode (seed <- 20261015) (whereBindings <- onPrint "noNewlines") (control <- true)
test "PrintChangesOnlyStdout" ExhaustiveMode (seed <- 20261015) (whereBindings <- onPrintElsewhere "dropsFilesList") (control <- true)
test "ReadGivesThePlace" ExhaustiveMode (seed <- 20261015) (whereBindings <- onRead "readsNothingList") (control <- true)
test "ReadChangesNothing" ExhaustiveMode (seed <- 20261015) (whereBindings <- onRead "readClearsList") (control <- true)

-- ---------------------------------------------------------------- the rest of world.lth
-- Added 2026-10-15 by Claude Opus 5.5, an agent of the coordinating session, on
-- record/IA/v04-2026-10-15/prompt-e.md: the controls of the lines world_laws.test.lut adds. The broken
-- models: an own action that appends to Luthier's store instead of setting it, and a `print`
-- described as writing the standard output that also writes a log file (`Described`); a validator
-- that applies every extern, one that grades an extern whose type states no law, one that
-- validates a provisional extern, and one whose identity is the route alone (`Externs`); a bridge
-- that gives the values in reverse order, one that counts one call per crossing, and one that calls
-- the first field whatever the label (the review's W5) (`Crossing`). `Host`'s laws read of the
-- host model only its console, which is the console's and never the host's (world.lth §4, the
-- review's W1), so a host broken on purpose shows only in the cases it gathers: each control lists
-- the case `agreement` gathers from such a host (a `print` that forgets the newline, a `readFile`
-- that finds nothing, an observation that empties the standard output, a `print` that also writes
-- input.txt) on the same `listedHost` as world_laws.test.lut. `ObserverIsFaithful` has no control: it
-- is an axiom and reads nothing of the model (11.R3).

-- §1, §2 descriptions
unitTypes : List U := [Unit]
worldModels : List (World State) := [theWorld]
-- the lock appended to, not set: a second write leaves two entries
appendsLock : Described State Unit theWorld := {
  describe := fn st { ({ stdout := st.stdout, files := cons ("luthier.lock", "pinned") st.files }, unit) },
  own := true, places := ["luthier.lock"] }
-- print, declared at the standard output, also writes log.txt
printLogs : Described State Unit theWorld := {
  describe := fn st { ({ stdout := appendStr st.stdout (lineOf "hello, world"), files := cons ("log.txt", "printed") st.files }, unit) },
  own := false, places := ["stdout"] }
appendsLockList : List (Described State Unit theWorld) := [appendsLock]
printLogsList : List (Described State Unit theWorld) := [printLogs]
logPlaces : List String := ["stdout", "log.txt"]
test "OwnIsIdempotent" ExhaustiveMode (seed <- 20261015) (whereBindings <- [bind "S" "states", bind "A" "unitTypes",
  bind "m" "worldModels", bind "d" "appendsLockList", bind "s" "worlds"]) (control <- true)
test "ChangesOnlyDeclared" ExhaustiveMode (seed <- 20261015) (whereBindings <- [bind "S" "states", bind "A" "unitTypes",
  bind "m" "worldModels", bind "d" "printLogsList", bind "s" "worlds", bind "p" "logPlaces"]) (control <- true)

-- §3 externs: world_laws.test.lut's validator, broken
lawful : Term := App (Var "Likelihood") (Var "3")
lawless : Term := Var "Float64"
lawsOfType (t : Term) : List String := if t == lawful then ["TangentShapes", "ScoreIsGradient"] else nil
validations : List (String * Grade) := [("sha256:h1", Sampled), ("sha256:h2", Cases), ("sha256:h3", Proved)]
lookupGrade (h : String) (vs : List (String * Grade)) : Maybe Grade :=
  match vs { nil -> nothing ; cons (k, g) rest -> if k == h then just g else lookupGrade h rest }
gradeOfRoute (r : Route) (h : String) : Maybe Grade :=
  if isProvisional r then just AssumedGrade else if lawsOfType r.declared == nil then nothing else lookupGrade h validations
-- applies every extern, validated or not
appliesEvery : Externs := { lawsOf := lawsOfType, gradeOf := gradeOfRoute, applied := fn a ns r h { true },
  identity := fn r h { r.route + " at " + h } }
-- grades by the hash whether or not the type states a law
gradesLawless (r : Route) (h : String) : Maybe Grade := if isProvisional r then just AssumedGrade else lookupGrade h validations
gradesWithoutLaws : Externs := { lawsOf := lawsOfType, gradeOf := gradesLawless,
  applied := fn a ns r h { if isProvisional r then memberStr r.name ns else settled a (gradesLawless r h) },
  identity := fn r h { r.route + " at " + h } }
-- validates a provisional extern as any other
validatesAll (r : Route) (h : String) : Maybe Grade := if lawsOfType r.declared == nil then nothing else lookupGrade h validations
validatesProvisional : Externs := { lawsOf := lawsOfType, gradeOf := validatesAll,
  applied := fn a ns r h { if isProvisional r then memberStr r.name ns else settled a (validatesAll r h) },
  identity := fn r h { r.route + " at " + h } }
-- the identity of what an extern produces is its route, whatever was read
identityByRoute : Externs := { lawsOf := lawsOfType, gradeOf := gradeOfRoute,
  applied := fn a ns r h { if isProvisional r then memberStr r.name ns else settled a (gradeOfRoute r h) },
  identity := fn r h { r.route } }
-- [2026-10-16, D-2026-10-16-c, L9.14] a blanket acceptance of assumed evidence applies a provisional
-- extern the demand did not name, the danger he named (a provisional forgotten deep in the code)
blanketAssumed : Externs := { lawsOf := lawsOfType, gradeOf := gradeOfRoute,
  applied := fn a ns r h { if isProvisional r then memberStr r.name ns or settled a (just AssumedGrade)
                           else settled a (gradeOfRoute r h) },
  identity := fn r h { r.route + " at " + h } }
blanketAssumedList : List Externs := [blanketAssumed]
appliesEveryList : List Externs := [appliesEvery]
gradesWithoutLawsList : List Externs := [gradesWithoutLaws]
validatesProvisionalList : List Externs := [validatesProvisional]
identityByRouteList : List Externs := [identityByRoute]
cutoff : List Grade := [Sampled]
assumedCutoff : List Grade := [AssumedGrade]
noNames : List (List String) := [nil]
reasons : List String := ["exploring"]
routes : List Route := [routeOf "fit" lawful "python:m.fit" nothing, routeOf "raw" lawless "python:m.raw" nothing,
  routeOf "guess" lawful "python:m.guess" (just "exploring"), routeOf "rawGuess" lawless "python:m.rawGuess" (just "exploring")]
hashes : List String := ["sha256:h1", "sha256:h2", "sha256:h3", "sha256:h4"]
externNames : List String := ["fit"]
terms : List Term := [lawful, lawless]
routeStrings : List String := ["python:m.fit"]
onRoute (e : String) : List Binding := [bind "e" e, bind "n" "externNames", bind "t" "terms", bind "route" "routeStrings",
  bind "h" "hashes"]
test "AppliedWhenSettled" ExhaustiveMode (seed <- 20261015) (whereBindings <- [bind "e" "appliesEveryList",
  bind "accepts" "cutoff", bind "assumes" "noNames", bind "r" "routes", bind "h" "hashes"]) (control <- true)
test "AppliedWhenSettled" ExhaustiveMode (seed <- 20261015) (whereBindings <- [bind "e" "blanketAssumedList",
  bind "accepts" "assumedCutoff", bind "assumes" "noNames", bind "r" "routes", bind "h" "hashes"]) (control <- true)
test "NoLawNoGrade" ExhaustiveMode (seed <- 20261015) (whereBindings <- onRoute "gradesWithoutLawsList") (control <- true)
test "ProvisionalIsAssumed" ExhaustiveMode (seed <- 20261015) (whereBindings <- [bind "e" "validatesProvisionalList",
  bind "n" "externNames", bind "t" "terms", bind "route" "routeStrings", bind "h" "hashes", bind "why" "reasons"]) (control <- true)
test "IdentityCarriesHash" ExhaustiveMode (seed <- 20261015) (whereBindings <- [bind "e" "identityByRouteList",
  bind "r" "routes", bind "h" "hashes", bind "k" "hashes"]) (control <- true)

-- §3 the crossing, broken
fieldOf (fs : List (String * (Int -> Int))) (l : String) : Maybe (Int -> Int) :=
  match fs { nil -> nothing ; cons (k, g) rest -> if k == l then just g else fieldOf rest l }
reverseInts (xs acc : List Int) : List Int := match xs { nil -> acc ; cons x rest -> reverseInts rest (cons x acc) }
callRight (f : Int -> Int) (xs : List Int) : List Int * Nat := (mapList Int Int f xs, lengthOf Int xs)
-- the values given back in reverse order
reversesCalls : Crossing Int Int := {
  callBack := fn f xs { (reverseInts (mapList Int Int f xs) nil, lengthOf Int xs) },
  callField := fn fs l xs { match fieldOf fs l { just f -> (reverseInts (mapList Int Int f xs) nil, lengthOf Int xs) ; nothing -> (nil, 0) } },
}
-- one call counted per crossing, whatever the host asked
countsOnce : Crossing Int Int := {
  callBack := fn f xs { (mapList Int Int f xs, 1) },
  callField := fn fs l xs { match fieldOf fs l { just f -> (mapList Int Int f xs, 1) ; nothing -> (nil, 0) } },
}
-- the first field called whatever the label
firstField (fs : List (String * (Int -> Int))) : Maybe (Int -> Int) := match fs { nil -> nothing ; cons (k, g) rest -> just g }
callsFirstField : Crossing Int Int := {
  callBack := callRight,
  callField := fn fs l xs { match firstField fs { just f -> callRight f xs ; nothing -> (nil, 0) } },
}
reversesCallsList : List (Crossing Int Int) := [reversesCalls]
countsOnceList : List (Crossing Int Int) := [countsOnce]
callsFirstFieldList : List (Crossing Int Int) := [callsFirstField]
ints : List Concrete := [Int]
double (x : Int) : Int := 2 * x
succ (x : Int) : Int := x + 1
-- `opposite` and `intFunctions` were `flip` and `functions` until the core's bite 5 (core/properties/
-- functions.lth's names; a file does not redefine a core name, 12.S22, D-2026-10-18-b)
opposite (x : Int) : Int := 0 - x
intFunctions : List (Int -> Int) := [double, succ, opposite]
arguments : List (List Int) := [nil, [1], [1, 2, 3], [0 - 4, 0, 7]]
befores : List (List (String * (Int -> Int))) := [nil, [("g", succ)], [("f", double)]]
afters : List (List (String * (Int -> Int))) := [nil, [("f", opposite)], [("h", succ)]]
labels : List String := ["f", "g"]
onCallback (b : String) : List Binding := [bind "A" "ints", bind "B" "ints", bind "b" b, bind "f" "intFunctions",
  bind "xs" "arguments"]
test "CallbackGivesTheFunction" ExhaustiveMode (seed <- 20261015) (whereBindings <- onCallback "reversesCallsList") (control <- true)
test "CallsAreCounted" ExhaustiveMode (seed <- 20261015) (whereBindings <- onCallback "countsOnceList") (control <- true)
test "RecordCrossesByField" ExhaustiveMode (seed <- 20261015) (whereBindings <- [bind "A" "ints", bind "B" "ints",
  bind "b" "callsFirstFieldList", bind "before" "befores", bind "after" "afters", bind "l" "labels",
  bind "f" "intFunctions", bind "xs" "arguments"]) (control <- true)

-- §5 the cases broken hosts gather
listedHost : Host State := { console := console, observe := host.observe, print := host.print, readFile := host.readFile }
hosts : List (Host State) := [listedHost]
maybeTypes : List U := [Maybe String]
case (S A : U) (b : S) (x : A) (a : S) : Observed S A := { before := b, result := x, after := a }
after (st : State) (out : String) : State := { stdout := out, files := st.files }
hello : List String := ["hello, world"]
-- print forgets the newline
noNewlineCases : List (Observed State Unit) := [case State Unit blank unit (after blank "hello, world")]
input : List String := ["input.txt"]
-- readFile finds nothing where the file is
readsNothingCases : List (Observed State (Maybe String)) := [case State (Maybe String) withFiles nothing withFiles]
observed : List (List String) := [["stdout", "input.txt"]]
-- the observation empties the standard output
clearsCases : List (Observed State State) := [case State State printed printed blank]
-- print also writes input.txt
clobbered : State := { stdout := "hello, world\n", files := [("input.txt", "overwritten"), ("empty.txt", "")] }
clobbersCases : List (Observed State Unit) := [case State Unit withFiles unit clobbered]
helloHeld : List (Held State Unit theWorld) := [held State Unit theWorld (fn w { listedHost.print w "hello, world" })
  (printDescription State console "hello, world")]
extras : List (List String) := [["stdout", "input.txt", "other.txt"]]
test "HostAgreesPrint" ExhaustiveMode (seed <- 20261015) (whereBindings <- [bind "S" "states", bind "o" "hosts",
  bind "s" "hello", bind "c" "noNewlineCases"]) (control <- true)
test "HostAgreesReadFile" ExhaustiveMode (seed <- 20261015) (whereBindings <- [bind "S" "states", bind "o" "hosts",
  bind "p" "input", bind "c" "readsNothingCases"]) (control <- true)
test "HostObserveChangesNothing" ExhaustiveMode (seed <- 20261015) (whereBindings <- [bind "S" "states", bind "o" "hosts",
  bind "ps" "observed", bind "c" "clearsCases"]) (control <- true)
test "HostChangesOnlyDeclared" ExhaustiveMode (seed <- 20261015) (whereBindings <- [bind "S" "states", bind "o" "hosts",
  bind "A" "unitTypes", bind "h" "helloHeld", bind "extra" "extras", bind "c" "clobbersCases"]) (control <- true)
