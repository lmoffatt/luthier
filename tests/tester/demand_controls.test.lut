-- tests/tester/demand_controls.test.lut: the controls of the laws of demand.lth that tests/tester/
-- demand_laws.test.lut certifies. Each line is the law's line written `(control <- true)` (test.lth's
-- `control`), with the model replaced by one broken on purpose, and is expected to be refuted (7.S19
-- as D-2026-10-15-a generalized it to every law; L9.14). Written 2026-10-15 by Claude Opus 5.5, an
-- agent of the coordinating session, on record/IA/v04-2026-10-15/prompt-e.md. The broken models: a
-- store that kept a second run of one identity with another result (B2 of summary-BCD.md: two runs
-- that differ only in what the record does not carry, a seed); a `certifying` whose `serves`
-- ignores the cutoff; one whose `serves` takes only an entry graded exactly at the cutoff. The
-- demands and entries are demand_laws.test.lut's.

import "test.lth" test ExhaustiveMode Grade Proved Cases Sampled AssumedGrade defaultBudgets
import "generators.lth" Binding
import "laws.lth" Listed Cited
import "certification.lth" Certifying Entry Hash Outcome Passed Failed
import "certification_model.lut" certifying
import "demand.lth" Demand LawDemand RunRecord Stored RunStore recorded OneIdentityOneResult NoPriceRefusesAssumed LoweringLosesNothing
  Ran RanIsASpecimenOfTheAsked RecordKeepsThePolicies Strategy ForwardOnDemand CallByNeed
import "demand_model.lut" theDemand

eqRecord (a b : RunRecord) : Bool := a == b
keyTypes : List U := [RunRecord]
keyEqs : List (RunRecord -> RunRecord -> Bool) := [eqRecord]
first : RunRecord := recorded (theDemand (entry <- "main")) "sha256:aaaa"
other : RunRecord := recorded (theDemand (entry <- "other")) "sha256:bbbb"
run (k : RunRecord) (r : String) : Stored RunRecord := { key := k, result := r }
-- one identity, two results
twoResults : RunStore RunRecord eqRecord := { runs := [run first "1", run other "3", run first "2"] }
brokenStores : List (RunStore RunRecord eqRecord) := [twoResults]

sampledDemand : Demand := theDemand (entry <- "main")
assumedDemand : Demand := theDemand (entry <- "main") (accepts <- AssumedGrade)
casesDemand : Demand := theDemand (entry <- "main") (accepts <- Cases)
demands : List Demand := [sampledDemand, assumedDemand, casesDemand]
laws : List String := ["L"]
cones : List Hash := ["sha256:cccc"]
entry (l : String) (h : String) (g : Maybe Grade) (o : Outcome) : Entry :=
  { law := l, cone := h, binding := nil, seed := 20261015, cases := 1, conjunct := nothing, conjuncts := nil, budgets := defaultBudgets, reach := nil,
    evidence := Cited "listed", grade := g, outcome := o, date := "2026-10-15", interpreter := "listed", hosts := nil }
assumedPass : Entry := entry "L" "sha256:cccc" (just AssumedGrade) Passed
sampledPass : Entry := entry "L" "sha256:cccc" (just Sampled) Passed
provedPass : Entry := entry "L" "sha256:cccc" (just Proved) Passed
failed : Entry := entry "L" "sha256:cccc" nothing (Failed "x = 1")
assumedElsewhere : Entry := entry "M" "sha256:cccc" (just AssumedGrade) Passed
entriesOfEveryKind : List Entry := [assumedPass, sampledPass, provedPass, failed, assumedElsewhere]
entriesFor : List Entry := [assumedPass, sampledPass, provedPass, failed]

-- serves any pass of the law at its hash, whatever its grade
servesAPass (d : LawDemand) (e : Entry) : Bool := e.law == d.law and e.cone == d.cone and e.outcome == Passed
servesAnyPass : Certifying := { identity := certifying.identity, stale := certifying.stale, grade := certifying.grade,
  contains := certifying.contains, serves := servesAPass, refuse := certifying.refuse, transport := certifying.transport }
-- serves a pass only at the grade the demand accepts, not above it
exactly (d : LawDemand) (e : Entry) : Bool := servesAPass d e and e.grade == just d.accepts
servesAtExactly : Certifying := { identity := certifying.identity, stale := certifying.stale, grade := certifying.grade,
  contains := certifying.contains, serves := exactly, refuse := certifying.refuse, transport := certifying.transport }
servesAPassModels : List Certifying := [servesAnyPass]
exactlyModels : List Certifying := [servesAtExactly]

bind (p g : String) : Binding := { parameter := just p, type := nothing, generator := g, coverage := Listed }

test "OneIdentityOneResult" ExhaustiveMode (seed <- 20261015) (whereBindings <- [bind "K" "keyTypes", bind "eq" "keyEqs",
  bind "st" "brokenStores"]) (control <- true)
test "NoPriceRefusesAssumed" ExhaustiveMode (seed <- 20261015) (whereBindings <- [bind "k" "servesAPassModels",
  bind "d" "demands", bind "law" "laws", bind "cone" "cones", bind "e" "entriesOfEveryKind"]) (control <- true)
test "LoweringLosesNothing" ExhaustiveMode (seed <- 20261015) (whereBindings <- [bind "k" "exactlyModels",
  bind "d" "demands", bind "law" "laws", bind "cone" "cones", bind "e" "entriesFor"]) (control <- true)

-- §6 the strategy that ran, broken (2026-10-16, by Claude Opus 5.5, on record/IA/
-- code-follows-2026-10-16/prompt-modes.md): call by need asked, forward on demand ran, which
-- nothing holds to the order of first demand
swappedRun : Ran := { asked := CallByNeed, ran := ForwardOnDemand }
swappedRuns : List Ran := [swappedRun]
test "RanIsASpecimenOfTheAsked" ExhaustiveMode (seed <- 20261015) (whereBindings <- [bind "r" "swappedRuns"]) (control <- true)

-- §3 a record that drops a policy (2026-10-23, audit II.2): the record `recorded` makes, with the
-- grade accepted for axioms put back at the default, so a demand that set it says nothing of it;
-- likewise for the roots and for the way grades combine
dropAxioms (d : Demand) (h : Hash) : RunRecord := { entry := (recorded d h).entry, cone := h, parameters := (recorded d h).parameters,
  accept := (recorded d h).accept, assumes := (recorded d h).assumes, delta := (recorded d h).delta, fuel := (recorded d h).fuel,
  timeLimit := (recorded d h).timeLimit, checked := (recorded d h).checked, lock := (recorded d h).lock,
  decoration := (recorded d h).decoration, strategy := (recorded d h).strategy, fresh := (recorded d h).fresh,
  axioms := AssumedGrade, roots := (recorded d h).roots, combine := (recorded d h).combine }
dropRoots (d : Demand) (h : Hash) : RunRecord := { entry := (recorded d h).entry, cone := h, parameters := (recorded d h).parameters,
  accept := (recorded d h).accept, assumes := (recorded d h).assumes, delta := (recorded d h).delta, fuel := (recorded d h).fuel,
  timeLimit := (recorded d h).timeLimit, checked := (recorded d h).checked, lock := (recorded d h).lock,
  decoration := (recorded d h).decoration, strategy := (recorded d h).strategy, fresh := (recorded d h).fresh,
  axioms := (recorded d h).axioms, roots := nil, combine := (recorded d h).combine }
dropCombine (d : Demand) (h : Hash) : RunRecord := { entry := (recorded d h).entry, cone := h, parameters := (recorded d h).parameters,
  accept := (recorded d h).accept, assumes := (recorded d h).assumes, delta := (recorded d h).delta, fuel := (recorded d h).fuel,
  timeLimit := (recorded d h).timeLimit, checked := (recorded d h).checked, lock := (recorded d h).lock,
  decoration := (recorded d h).decoration, strategy := (recorded d h).strategy, fresh := (recorded d h).fresh,
  axioms := (recorded d h).axioms, roots := (recorded d h).roots, combine := "weakest" }
policyDemands : List Demand := [theDemand (entry <- "main") (axioms <- Cases), theDemand (entry <- "main") (roots <- ["Other"]),
  theDemand (entry <- "main") (combine <- "strongest")]
droppers : List (Demand -> Hash -> RunRecord) := [dropAxioms, dropRoots, dropCombine]
hashes : List Hash := ["sha256:aaaa"]
test "RecordKeepsThePolicies" ExhaustiveMode (seed <- 20261015) (whereBindings <- [bind "record" "droppers",
  bind "d" "policyDemands", bind "h" "hashes"]) (control <- true)
