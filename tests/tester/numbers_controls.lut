-- tests/tester/numbers_controls.lut: the controls of numbers.lth's laws. Each line is the law's
-- line of numbers_laws.lut written `(control <- true)` (test.lth's `control`), with the model of
-- its type in the profile replaced by one broken on purpose, and is expected to be refuted: it
-- shows that a law can fail on a wrong model, so that its passing on the real one is not vacuous
-- (7.S19 as D-2026-10-15-a generalized it to every law; L9.14). The tester records its outcome as
-- a control's entry, never the law's failure, and `luthier certify numbers_laws.lut
-- numbers_controls.lut` reports the law controlled. Written 2026-10-15 by Claude Sonnet, an agent
-- of the coordinating session, on record/IA/controls-2026-10-15/prompt-mutants.md. The lines at a
-- size of a million repeat a law already controlled and have no control of their own.

import "test.lth" test ExhaustiveMode SampledMode
import "generators_model.lut" linear
import "generators.lth" Binding
import "laws.lth" Listed
import "numbers_model.lut" doubles integerDivision conversion elementary
import "numbers.lth" Tolerance Doubles IntegerDivision Conversion Elementary PlusCommutes TimesCommutes PlusZero TimesOne DivideOne TimesZero MinusSelf DivideSelf
  MinusIsPlusNegated NegateTwice LeqReflexive LeqTotal LeqAntisymmetric LeqTransitive LessIsStrict
  GreaterIsLessReversed GeqIsLeqReversed UnequalIsNotEqual PlusMonotone TimesMonotone EpsilonIsTheUlpOfOne
  DivisionAlgorithm RemainderOfTheDivisorsSign QuotientOfProduct
  ConvertZeroAndOne ConvertAddsExactly ConvertSucceeds ConvertKeepsOrder
  SqrtOfSquares ExpOfZero LogOfOne ErfOfZero SqrtMonotone SqrtOfSquare ExpPositive ErfOdd ErfBounded
  SqrtSquares ExpOfLog LogOfExp ExpAdds LogMultiplies

tolerance : Tolerance := 1.0e-12

-- the models of the real values, one per type, and the profile of each control: the same list with
-- the broken value bound to its type
swapped : Doubles := { plus := fn a b { a - b },
  minus := doubles.minus,
  times := doubles.times,
  divide := doubles.divide,
  less := doubles.less,
  leq := doubles.leq,
  greater := doubles.greater,
  geq := doubles.geq,
  unequal := doubles.unequal,
  epsilon := doubles.epsilon }
swappedProfile : List Binding := [
  { parameter := nothing, type := just "Doubles", generator := "swapped", coverage := Listed },
  { parameter := nothing, type := just "IntegerDivision", generator := "integerDivision", coverage := Listed },
  { parameter := nothing, type := just "Conversion", generator := "conversion", coverage := Listed },
  { parameter := nothing, type := just "Elementary", generator := "elementary", coverage := Listed },
  { parameter := just "tol", type := nothing, generator := "tolerance", coverage := Listed } ]
timesSkewed : Doubles := { plus := doubles.plus,
  minus := doubles.minus,
  times := fn a b { a * b + a - b },
  divide := doubles.divide,
  less := doubles.less,
  leq := doubles.leq,
  greater := doubles.greater,
  geq := doubles.geq,
  unequal := doubles.unequal,
  epsilon := doubles.epsilon }
timesSkewedProfile : List Binding := [
