-- tests/tester/session_a.lut: session A's graph and the fit's objects on it, as values a test can
-- bind as listed cases (7.R4), on the brief record/IA/evidence-2026-10-14/prompt.md. A census is
-- a value of the program, and `readGraph` (distance_graph.lut) is an action, which a census cannot
-- run: the two tables are therefore written here as text, verbatim from
-- examples/sonolocalizacion/A/graph/nodes.csv (git blob 4dbd6f0fb231239c89ee7ed954d31756c7495391)
-- and measurements.csv (blob 7eebe310a21f1809c6fdb13a6c8434d986ee2d27), and parsed by the codec
-- `readGraph` uses (tables_model.lut), so that from the text on the path is the fit's:
-- `toMapInput`, `positionsModel`, the profile likelihood (`likelihoodOf`, eliminated sigma)
-- and the prior of experiment_zero.lut, and the settings of the run recorded in
-- record/runs/sonolocalizacion-2026-10-14/README.md (lmTol 1e-12, lmMaxIter 500, lmFloor 30 eps).

import "tables.lth" Table
import "../../examples/sonolocalizacion/distance_graph.lut" DistanceGraph ValidDistanceGraph MapInput parseTable graphOf toMapInput designOf
import "../../examples/sonolocalizacion/positions_model.lut" positionsModel
import "probability.lth" MeanModel Likelihood
import "belief.lth" Settings GaussianBelief Posterior laplacePosterior
import "optimization.lth" Damping
import "../../examples/sonolocalizacion/experiment_zero.lut" priorBelief likelihoodOf SigmaTreatment eliminated

nodesTextA : String := "name:str,x:float,y:float,z:float,sx:float,sy:float,sz:float\nmic1,0.0,0.0,1.69,0.001,0.001,0.01\nmic2,-3.5,4.286263797015736e-16,0.73,0.2,0.2,0.01\nmic3,2.143131898507868e-16,3.5,0.71,0.2,0.2,0.01\nmic5,-6.429395695523604e-16,-3.5,0.7,0.2,0.2,0.01\nmic4,3.5,0.0,0.71,0.2,0.001,0.01\nparlante_A1,1.1666666666666665,-1.1666666666666667,0.988,3.0,3.0,0.01\nparlante_A2,-1.1666666666666667,1.1666666666666667,0.988,3.0,3.0,0.01\nparlante_A3,-1.1666666666666667,1.1666666666666667,0.73,3.0,3.0,0.01\nparlante_A4,-1.1666666666666667,1.1666666666666667,1.86,3.0,3.0,0.01\nparlante_A5,-1.4802973661668753e-16,-1.1666666666666665,1.31,3.0,3.0,0.01\n"
measurementsTextA : String := "i:int,j:int,d:float\n1,2,5.38\n1,3,4.76\n2,4,4.51\n4,3,5.13\n4,1,7.0\n3,2,7.0\n1,2,5.41\n5,0,1.81\n5,3,2.84\n5,4,2.4\n6,2,1.13\n6,1,3.35\n6,0,2.02\n7,2,5.23\n8,2,5.23\n7,1,7.62\n8,1,7.62\n7,0,8.05\n8,0,8.05\n9,3,14.97\n9,1,16.38\n9,4,19.98\n"
the (g : Maybe DistanceGraph) : DistanceGraph := match g { just x -> x }
graphA : DistanceGraph := the (graphOf (parseTable (just nodesTextA)) (parseTable (just measurementsTextA)))
mapA : MapInput := toMapInput graphA
dimA : Int := 3 * mapA.x0.n
modelA : MeanModel dimA := positionsModel (designOf mapA)
likelihoodA : Likelihood dimA := likelihoodOf mapA (eliminated unit)
priorA : GaussianBelief dimA := priorBelief mapA
posteriorA : Posterior dimA := laplacePosterior dimA likelihoodA priorA mapA.d
settingsA : Settings := { tol := 1.0e-12, maxIter := 500, floor := 6.661338147750939e-15 }
-- v0.1's schedule, lm.py's DAMPING (src/luthier/lm.py:36)
dampingA : Damping := { init := 0.001, factor := 3.0, least := 1.0e-15, most := 1.0e15 }
