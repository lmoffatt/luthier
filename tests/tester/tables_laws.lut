-- tests/tester/tables_laws.lut: the laws of `Codec` (on `csv`, tables_model.lut) and of `Table`
-- (tables.lth §2, §4) as listed cases, on the brief record/IA/evidence-2026-10-14/prompt-tables.md.
-- `Table`, `Perturbed` and `BrokenText` have no generator (7.R4), so each census is a list: tables
-- built in Luthier (an empty one, one row, three rows with int, real and text columns, a cell
-- that is nothing) and parsed from listed CSV texts (session A's nodes.csv and measurements.csv,
-- as tests/tester/session_a.lut holds them); `Perturbed` pairs a table with a text that has the
-- same content written differently (spaces, no final newline, extra digits, trailing
-- zeros); `BrokenText` is one defect per value, the readings of
-- record/IA/sonolocalizacion-inventory-2026-10-13/answers-2026-10-14.md item 2 (an unknown type,
-- a repeated column, a wrong cell count, an unparsable number, a non-finite float). Seed 20261014
-- (the censuses are listed; the seed only names the run).

import "test.lth" test ExhaustiveMode
import "generators.lth" Binding
import "laws.lth" Listed
import "tables.lth" Table Codec Perturbed BrokenText Cell int real text RoundTrip Canonical Tolerant Rejects
  SchemaWellFormed KindsKnown CellsOfTheirKind NoCellsOffSchema
import "tables_model.lut" csv
import "session_a.lut" nodesTextA measurementsTextA

codecs : List Codec := [csv]

parsed (s : String) : Table := match csv.parse s { just t -> t }

-- tables built in Luthier: the empty table (no rows, one column), one row, three rows of an int, a
-- real and a text column
emptyT : Table := { nRows := 0, names := ["k"], kinds := ["int"], cell := fn c r { nothing } }
-- kept in the census though `RoundTrip` is stated over tables with a column (tables.lth, 12.S23
-- [proposed]): it shows the law's domain, which holds vacuously here
noColumns : Table := { nRows := 0, names := [], kinds := [], cell := fn c r { nothing } }
oneRow : Table := { nRows := 1, names := ["n"], kinds := ["int"],
  cell := fn c r { if c == "n" then just (int 7) else nothing } }
threeRows : Table := { nRows := 3, names := ["k", "x", "label"], kinds := ["int", "float", "str"],
  cell := fn c r {
    if c == "k" then just (int (r - 1))
    else if c == "x" then just (real (if r == 0 then 0.1 else if r == 1 then 1.0e-300 else 0.0 - 2.5))
    else if c == "label" then just (text (if r == 0 then "a,b" else if r == 1 then "say \"hi\"" else ""))
    else nothing } }
-- parsed from listed texts: session A's two tables, a small one, one with quoted newlines. No CRLF
-- case: a Luthier string has no escape for \r and the file is read with universal newlines, so
-- Tolerant's CRLF reading is not reachable from a listed text (a finding for the tester).
smallText : String := "a:int,b:float\n1,2.5\n-3,4.0\n"
quotedText : String := "s:str\n\"line1\nline2\"\n\"x\"\"y\"\n"
tables : List Table := [ emptyT, noColumns, oneRow, threeRows,
  parsed nodesTextA, parsed measurementsTextA, parsed smallText, parsed quotedText ]

-- same content written differently
perturbed : List Perturbed := [
  { table := parsed smallText, text := "a:int,b:float\n1,2.5\n-3,4.0\n" },
  { table := parsed "a:int,b:float\n1,2.5\n-3,4.0\n", text := " a : int , b : float \n 1 , 2.5 \n -3 , 4.0" },
  { table := parsed "a:int,b:float\n1,2.5\n-3,4.0\n", text := "a:int,b:float\n1,2.50\n-3,4.0000\n\n" },
  { table := parsed "x:float\n0.1\n", text := "x:float\n0.10000000000000000555\n" },
  { table := parsed "x:float\n1e-05\n", text := "x:float\n0.00001\n" },
  { table := threeRows, text := "k:int,x:float,label:str\n-1,0.1,\"a,b\"\n0,1e-300,\"say \"\"hi\"\"\"\n1,-2.5,\n" },
  { table := parsed nodesTextA, text := nodesTextA },
  { table := parsed measurementsTextA, text := " i : int , j : int , d : float \n 1 , 2 , 5.38\n1,3,4.76\n2,4,4.51\n4,3,5.13\n4,1,7.0\n3,2,7.0\n1,2,5.41\n5,0,1.81\n5,3,2.84\n5,4,2.4\n6,2,1.13\n6,1,3.35\n6,0,2.02\n7,2,5.23\n8,2,5.23\n7,1,7.62\n8,1,7.62\n7,0,8.05\n8,0,8.05\n9,3,14.97\n9,1,16.38\n9,4,19.98" },
  { table := parsed "s:str\n", text := "s:str" } ]

-- a text with one defect each
broken : List BrokenText := [
  { s := "k:int,x:real\n1,2\n" },
  { s := "k:real\n1\n" },
  { s := "k:int,k:float\n1,2.0\n" },
  { s := "a:int,b:float\n1\n" },
  { s := "a:int,b:float\n1,2.0,3\n" },
  { s := "a:int,b:float\n1,abc\n" },
  { s := "a:int\n1.5\n" },
  { s := "a:float\nnan\n" },
  { s := "a:float\ninf\n" },
  { s := "a:float\n-inf\n" },
  { s := "a:float\n1e999\n" },
  { s := "a:int\n1_000\n" },
  { s := "a\n1\n" },
  { s := ":int\n1\n" },
  { s := "" } ]

onCodec : List Binding := [ { parameter := just "c", type := nothing, generator := "codecs", coverage := Listed } ]
onTables : List Binding := [
  { parameter := just "c", type := nothing, generator := "codecs", coverage := Listed },
  { parameter := just "t", type := nothing, generator := "tables", coverage := Listed } ]
onPerturbed : List Binding := [
  { parameter := just "c", type := nothing, generator := "codecs", coverage := Listed },
  { parameter := just "p", type := nothing, generator := "perturbed", coverage := Listed } ]
onBroken : List Binding := [
  { parameter := just "c", type := nothing, generator := "codecs", coverage := Listed },
  { parameter := just "b", type := nothing, generator := "broken", coverage := Listed } ]
withRows : List Table := [ oneRow, threeRows, parsed smallText, parsed nodesTextA ]
names : List String := ["n", "k", "a", "name", "nope", ""]
rows : List Int := [0]
offSchema : List Binding := [
  { parameter := just "t", type := nothing, generator := "withRows", coverage := Listed },
  { parameter := just "c", type := nothing, generator := "names", coverage := Listed },
  { parameter := just "r", type := nothing, generator := "rows", coverage := Listed } ]
tablesOnly : List Binding := [ { parameter := just "t", type := nothing, generator := "tables", coverage := Listed } ]

test "RoundTrip" ExhaustiveMode (seed <- 20261014) (whereBindings <- onTables)
test "Canonical" ExhaustiveMode (seed <- 20261014) (whereBindings <- onPerturbed)
test "Tolerant" ExhaustiveMode (seed <- 20261014) (whereBindings <- onPerturbed)
test "Rejects" ExhaustiveMode (seed <- 20261014) (whereBindings <- onBroken)
test "SchemaWellFormed" ExhaustiveMode (seed <- 20261014) (whereBindings <- tablesOnly)
test "KindsKnown" ExhaustiveMode (seed <- 20261014) (whereBindings <- tablesOnly)
test "CellsOfTheirKind" ExhaustiveMode (seed <- 20261014) (whereBindings <- tablesOnly)
test "NoCellsOffSchema" ExhaustiveMode (seed <- 20261014) (whereBindings <- offSchema)
-- the line expected to be refuted (CellsOfTheirKind on a table with a nothing cell) is a control, in
-- tables_controls.lut
