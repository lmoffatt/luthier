-- tests/tester/arrays_laws.test.lut: the laws of `Arrays` (arrays.lth §4) run through `luthier test` on
-- numpy's model (arrays_model.lut), on the brief record/IA/evidence-2026-10-14/prompt.md. Each
-- cutoff is a census of one, the demand's (D-2026-10-14-c): the tolerance 1e-12 [proposed, as
-- numbers_laws.test.lut], the rank floor 30 eps = 6.661338147750939e-15, session A's `lmFloor`
-- (experiment_zero.lut:39). Seed 20261014. Sampled where the tester draws the parameters
-- (`Dim`, `VecOf n`, `MatOf r c`, `Fin n`, `Positive`, `ClearDiagonal`); a symmetric or an
-- orthogonal matrix has no generator (a filter over a random matrix accepts only the 0 x 0 and
-- 1 x 1 ones), so those laws run sampled, to show it, and again on the listed matrices below.
-- Since 2026-10-15 (record/IA/tester-2026-10-14/prompt-3.md) a binding can name a generator
-- (7.R1): each listed line has a sampled twin whose matrix is drawn by a family of
-- generators_model.lut (symmetric, positive semidefinite, orthogonal with a symmetric of its
-- size, a diagonal with an atom at 0); the listed lines are kept.

import "test.lth" test ExhaustiveMode SampledMode
import "generators_model.lut" linear symmetric symmetricOf gram orthogonal clearDiagonal
import "generators.lth" Binding byParameter
import "laws.lth" Listed
import "numbers.lth" Tolerance Doubles
import "numbers_model.lut" doubles : Doubles
import "arrays.lth" Arrays Vec Mat RankFloor mat vec identity zeroMat AddPointwise SubPointwise ScalePointwise
  TransposePointwise MaddPointwise MsubPointwise MscalePointwise DotCommutative DotOnBasis DotAgrees NormOfBasis
  NormOfDot NormScales MatVecOnBasis MatVecAgrees MatMulNeutral MatMulByIdentity MatMulTransposes MatMulAgrees RankOfDiagonal
  RankOfZeroAndIdentity RankBounded RankScales RankUnderRotation TraceOfIdentity TraceAdditive TraceCyclic
  TraceAgrees PinvOfDiagonal PinvOfZero PinvOfIdentity PinvProjects PinvSymmetric PinvRestricts PinvTraceIsRank
  PinvScales VecIsIndexed VecIsAnObject VecIsAFunctor VecIsFoldable VecIsTabulated MatIsIndexed MatIsAnObject
  MatIsAFunctor SymmetricIsAnEqualizer vecIndexed vecObject vecMap vecFold matIndexed matObject matMap MatShaped
  SymmetricMatrix
import "arrays_model.lut" numpy

tolerance : Tolerance := 1.0e-12
floor : RankFloor := 6.661338147750939e-15
models : List Binding := [
  { parameter := just "m", type := nothing, generator := "numpy", coverage := Listed },
  { parameter := just "tol", type := nothing, generator := "tolerance", coverage := Listed },
  { parameter := just "fl", type := nothing, generator := "floor", coverage := Listed },
  { parameter := just "fp", type := nothing, generator := "doubles", coverage := Listed } ]

-- listed symmetric matrices of three rows: rank one, indefinite, zero, the identity, an eigenvalue
-- above the floor and one below it
diag3 (a b c : Float64) : Mat Float64 := mat Float64 3 3 (fn i j { if i == j then (if i == 0 then a else if i == 1 then b else c) else 0.0 })
symmetric3 : List (Mat Float64) := [
  mat Float64 3 3 (fn i j { toFloat64 ((i + 1) * (j + 1)) }),
  mat Float64 3 3 (fn i j { if i == j then toFloat64 (2 * i - 1) else 0.5 }),
  zeroMat 3 3,
  identity 3,
  diag3 1.0 1.0e-13 2.0,
  diag3 1.0 1.0e-16 2.0 ]
-- and of other sizes: Hilbert's of five (eigenvalues down to 3e-6), one negative entry
symmetricMore : List (Mat Float64) := [
  mat Float64 3 3 (fn i j { toFloat64 ((i + 1) * (j + 1)) }),
  mat Float64 3 3 (fn i j { if i == j then toFloat64 (2 * i - 1) else 0.5 }),
  zeroMat 3 3,
  diag3 1.0 1.0e-13 2.0,
  diag3 1.0 1.0e-16 2.0,
  mat Float64 5 5 (fn i j { 1.0 / toFloat64 (i + j + 1) }),
  mat Float64 1 1 (fn i j { 0.0 - 2.0 }) ]
-- the positive semidefinite ones among them, where PinvRestricts is stated (PsdAt, 11.S18): rank
-- one, the zero matrix, one eigenvalue above the floor and one below it, Hilbert's of five; the
-- indefinite ones (the second, the one negative entry) are left out, the law does not claim them
symmetricPsd : List (Mat Float64) := [
  mat Float64 3 3 (fn i j { toFloat64 ((i + 1) * (j + 1)) }),
  zeroMat 3 3,
  identity 3,
  diag3 1.0 1.0e-13 2.0,
  diag3 1.0 1.0e-16 2.0,
  mat Float64 5 5 (fn i j { 1.0 / toFloat64 (i + j + 1) }) ]
-- listed orthogonal matrices of three rows: a permutation, a reflection, a rotation by the 3-4-5
-- triangle (orthogonal within rounding)
orthogonal3 : List (Mat Float64) := [
  mat Float64 3 3 (fn i j { if j == (i + 1) mod 3 then 1.0 else 0.0 }),
  diag3 1.0 (0.0 - 1.0) 1.0,
  mat Float64 3 3 (fn i j { if i == 2 or j == 2 then (if i == j then 1.0 else 0.0)
                            else if i == j then 0.6 else if i == 0 then 0.0 - 0.8 else 0.8 }) ]
three : List Int := [3]
listedS : List Binding := [ { parameter := just "s", type := nothing, generator := "symmetricMore", coverage := Listed } ]
listedPsd : List Binding := [ { parameter := just "s", type := nothing, generator := "symmetricPsd", coverage := Listed } ]
listedRotation : List Binding := [
  { parameter := just "k", type := nothing, generator := "three", coverage := Listed },
  { parameter := just "q", type := nothing, generator := "orthogonal3", coverage := Listed },
  { parameter := just "s", type := nothing, generator := "symmetric3", coverage := Listed } ]
-- the generators the sampled twins bind (generators_model.lut); `byParameter`'s coverage is a draw
drawnS : List Binding := [byParameter "s" "symmetric"]
drawnPsd : List Binding := [byParameter "s" "gram"]
drawnRotation : List Binding := [byParameter "q" "orthogonal", byParameter "s" "symmetricOf"]
drawnD : List Binding := [byParameter "d" "clearDiagonal"]

-- entrywise, exact
test "AddPointwise" (SampledMode linear) (seed <- 20261014) (profile <- models)
test "SubPointwise" (SampledMode linear) (seed <- 20261014) (profile <- models)
test "ScalePointwise" (SampledMode linear) (seed <- 20261014) (profile <- models)
test "TransposePointwise" (SampledMode linear) (seed <- 20261014) (profile <- models)
test "MaddPointwise" (SampledMode linear) (seed <- 20261014) (profile <- models)
test "MsubPointwise" (SampledMode linear) (seed <- 20261014) (profile <- models)
test "MscalePointwise" (SampledMode linear) (seed <- 20261014) (profile <- models)
-- the inner product and the norm
test "DotCommutative" (SampledMode linear) (seed <- 20261014) (profile <- models)
test "DotOnBasis" (SampledMode linear) (seed <- 20261014) (profile <- models)
test "DotAgrees" (SampledMode linear) (seed <- 20261014) (profile <- models)
test "NormOfBasis" (SampledMode linear) (seed <- 20261014) (profile <- models)
test "NormOfDot" (SampledMode linear) (seed <- 20261014) (profile <- models)
test "NormScales" (SampledMode linear) (seed <- 20261014) (profile <- models)
-- products
test "MatVecOnBasis" (SampledMode linear) (seed <- 20261014) (profile <- models)
test "MatVecAgrees" (SampledMode linear) (seed <- 20261014) (profile <- models)
test "MatMulNeutral" (SampledMode linear) (seed <- 20261014) (profile <- models)
test "MatMulByIdentity" (SampledMode linear) (seed <- 20261014) (profile <- models)
test "MatMulTransposes" (SampledMode linear) (seed <- 20261014) (profile <- models)
test "MatMulAgrees" (SampledMode linear) (seed <- 20261014) (profile <- models)
-- the rank at the floor
test "RankOfDiagonal" (SampledMode linear) (seed <- 20261014) (profile <- models)
test "RankOfZeroAndIdentity" (SampledMode linear) (seed <- 20261014) (profile <- models)
test "RankBounded" (SampledMode linear) (seed <- 20261014) (profile <- models)
test "RankScales" (SampledMode linear) (seed <- 20261014) (profile <- models)
test "RankUnderRotation" (SampledMode linear) (seed <- 20261014) (profile <- models)
test "RankBounded" ExhaustiveMode (whereBindings <- listedS) (profile <- models)
test "RankScales" (SampledMode linear) (seed <- 20261014) (whereBindings <- listedS) (profile <- models)
test "RankUnderRotation" ExhaustiveMode (whereBindings <- listedRotation) (profile <- models)
test "RankOfDiagonal" (SampledMode linear) (seed <- 20261014) (whereBindings <- drawnD) (profile <- models)
test "RankBounded" (SampledMode linear) (seed <- 20261014) (whereBindings <- drawnS) (profile <- models)
test "RankScales" (SampledMode linear) (seed <- 20261014) (whereBindings <- drawnS) (profile <- models)
test "RankUnderRotation" (SampledMode linear) (seed <- 20261014) (whereBindings <- drawnRotation) (profile <- models)
-- the trace
test "TraceOfIdentity" (SampledMode linear) (seed <- 20261014) (profile <- models)
test "TraceAdditive" (SampledMode linear) (seed <- 20261014) (profile <- models)
test "TraceCyclic" (SampledMode linear) (seed <- 20261014) (profile <- models)
test "TraceAgrees" (SampledMode linear) (seed <- 20261014) (profile <- models)
-- the pseudo-inverse at the floor
test "PinvOfDiagonal" (SampledMode linear) (seed <- 20261014) (profile <- models)
test "PinvOfZero" (SampledMode linear) (seed <- 20261014) (profile <- models)
test "PinvOfIdentity" (SampledMode linear) (seed <- 20261014) (profile <- models)
test "PinvProjects" (SampledMode linear) (seed <- 20261014) (profile <- models)
test "PinvSymmetric" (SampledMode linear) (seed <- 20261014) (profile <- models)
-- PinvRestricts sampled over PsdAt is not run: the drawing evaluates the filter on non-square candidates and the leaf fails on them (only the listed matrices below)
test "PinvTraceIsRank" (SampledMode linear) (seed <- 20261014) (profile <- models)
test "PinvScales" (SampledMode linear) (seed <- 20261014) (profile <- models)
test "PinvProjects" ExhaustiveMode (whereBindings <- listedS) (profile <- models)
test "PinvSymmetric" ExhaustiveMode (whereBindings <- listedS) (profile <- models)
test "PinvRestricts" ExhaustiveMode (whereBindings <- listedPsd) (profile <- models)
test "PinvTraceIsRank" ExhaustiveMode (whereBindings <- listedS) (profile <- models)
test "PinvScales" (SampledMode linear) (seed <- 20261014) (whereBindings <- listedS) (profile <- models)
test "PinvOfDiagonal" (SampledMode linear) (seed <- 20261014) (whereBindings <- drawnD) (profile <- models)
test "PinvProjects" (SampledMode linear) (seed <- 20261014) (whereBindings <- drawnS) (profile <- models)
test "PinvSymmetric" (SampledMode linear) (seed <- 20261014) (whereBindings <- drawnS) (profile <- models)
test "PinvRestricts" (SampledMode linear) (seed <- 20261014) (whereBindings <- drawnPsd) (profile <- models)
test "PinvTraceIsRank" (SampledMode linear) (seed <- 20261014) (whereBindings <- drawnS) (profile <- models)
test "PinvScales" (SampledMode linear) (seed <- 20261014) (whereBindings <- drawnS) (profile <- models)

-- [core bite 11, 2026-10-21] The container claims of arrays.lth §1 (core/structures/
-- containers.lth), on listed vectors and matrices of Int (`Float64 : Real` is no value of
-- `Concrete` a binding can give), ExhaustiveMode, seed 20261021:
-- finite evidence at one carrier, not a proof over U. The summing laws above take the bounds of
-- arrays.lth §3 from `doubles` (`fp`), no tolerance.
entryType : Concrete := Int
intEquality : Object Int := structural Int
vecEquality : Object (Vec Int) := vecObject Int
matEquality : Object (Mat Int) := matObject Int
vecIndex : Indexed (Vec Int) Int := vecIndexed Int
goodVecFunctor : Functor Vec := { map := vecMap }
goodVecFold : Foldable Vec := { fold := vecFold }
goodVecTabulation : Tabulated (Vec Int) Int := { build := vec Int }
goodMatFunctor : Functor Mat := { map := matMap }
twoRows : Nat := 2
threeColumns : Nat := 3
goodMatIndex : Indexed (MatShaped Int 2 3) Int := matIndexed Int
twiceInt : Int -> Int := fn x { 2 * x }
negated : Int -> Int := fn x { 0 - x }
differenceInt : Int -> Int -> Int := fn x y { x - y }
foldUnit : Int := 9
oddAt : Nat -> Int := fn k { 2 * k + 1 }
lengths : List Nat := [0, 1, 3]
vectors : List (Vec Int) := [
  vec Int 0 (fn k { 0 }), vec Int 1 (fn k { 1 }), vec Int 2 (fn k { k }),
  vec Int 2 (fn k { 1 - k }), vec Int 3 (fn k { 5 }), vec Int 3 (fn k { 0 - k }) ]
vectorPairs : List (Related (Vec Int) (vecObject Int).eq) := [
  { x := vec Int 2 (fn k { k }), y := vec Int 2 (fn k { k }) },
  { x := vec Int 0 (fn k { 0 }), y := vec Int 0 (fn k { 1 }) } ]
vectorChains : List (Chain (Vec Int) (vecObject Int).eq) := [
  { x := vec Int 1 (fn k { 1 }), y := vec Int 1 (fn k { 1 }), z := vec Int 1 (fn k { 1 }) } ]
-- matrices: two of one shape that differ, the 3 x 2 and the 1 x 6 with the same six entries in
-- row-major order as the first, and the empty ones of two shapes
matrices : List (Mat Int) := [
  mat Int 2 3 (fn i j { (3 * i + j) }), mat Int 2 3 (fn i j { (i - j) }),
  mat Int 3 2 (fn i j { (2 * i + j) }), mat Int 1 6 (fn i j { j }),
  mat Int 0 2 (fn i j { 0 }), mat Int 0 3 (fn i j { 0 }) ]
shaped : List (MatShaped Int 2 3) := [
  mat Int 2 3 (fn i j { (3 * i + j) }), mat Int 2 3 (fn i j { (i - j) }),
  mat Int 2 3 (fn i j { (3 * i + j) }) ]
matrixPairs : List (Related (Mat Int) (matObject Int).eq) := [
  { x := mat Int 2 3 (fn i j { (i - j) }), y := mat Int 2 3 (fn i j { (i - j) }) } ]
matrixChains : List (Chain (Mat Int) (matObject Int).eq) := [
  { x := mat Int 1 1 (fn i j { 1 }), y := mat Int 1 1 (fn i j { 1 }), z := mat Int 1 1 (fn i j { 1 }) } ]
symmetricMatrices : List SymmetricMatrix := [ identity 3, zeroMat 0 0, mat Float64 3 3 (fn i j { toFloat64 ((i + 1) * (j + 1)) }) ]

onVecIsIndexed : List Binding := [
  { parameter := just "A", type := nothing, generator := "entryType", coverage := Listed },
  { parameter := just "model", type := nothing, generator := "vecIndex", coverage := Listed },
  { parameter := just "o", type := nothing, generator := "vecEquality", coverage := Listed },
  { parameter := just "a", type := nothing, generator := "intEquality", coverage := Listed },
  { parameter := just "c", type := nothing, generator := "vectors", coverage := Listed },
  { parameter := just "d", type := nothing, generator := "vectors", coverage := Listed } ]
test "VecIsIndexed" ExhaustiveMode (seed <- 20261021) (profile <- onVecIsIndexed)
onVecIsAnObject : List Binding := [
  { parameter := just "A", type := nothing, generator := "entryType", coverage := Listed },
  { parameter := just "model", type := nothing, generator := "vecEquality", coverage := Listed },
  { parameter := just "x", type := nothing, generator := "vectors", coverage := Listed },
  { parameter := just "p", type := nothing, generator := "vectorPairs", coverage := Listed },
  { parameter := just "c", type := nothing, generator := "vectorChains", coverage := Listed } ]
test "VecIsAnObject" ExhaustiveMode (seed <- 20261021) (profile <- onVecIsAnObject)
onVecIsAFunctor : List Binding := [
  { parameter := just "A", type := nothing, generator := "entryType", coverage := Listed },
  { parameter := just "B", type := nothing, generator := "entryType", coverage := Listed },
  { parameter := just "C", type := nothing, generator := "entryType", coverage := Listed },
  { parameter := just "model", type := nothing, generator := "goodVecFunctor", coverage := Listed },
  { parameter := just "o", type := nothing, generator := "vecEquality", coverage := Listed },
  { parameter := just "g", type := nothing, generator := "twiceInt", coverage := Listed },
  { parameter := just "h", type := nothing, generator := "negated", coverage := Listed },
  { parameter := just "xs", type := nothing, generator := "vectors", coverage := Listed } ]
test "VecIsAFunctor" ExhaustiveMode (seed <- 20261021) (profile <- onVecIsAFunctor)
onVecIsFoldable : List Binding := [
  { parameter := just "A", type := nothing, generator := "entryType", coverage := Listed },
  { parameter := just "M", type := nothing, generator := "entryType", coverage := Listed },
  { parameter := just "model", type := nothing, generator := "goodVecFold", coverage := Listed },
  { parameter := just "i", type := nothing, generator := "vecIndex", coverage := Listed },
  { parameter := just "o", type := nothing, generator := "intEquality", coverage := Listed },
  { parameter := just "op", type := nothing, generator := "differenceInt", coverage := Listed },
  { parameter := just "e", type := nothing, generator := "foldUnit", coverage := Listed },
  { parameter := just "g", type := nothing, generator := "twiceInt", coverage := Listed },
  { parameter := just "xs", type := nothing, generator := "vectors", coverage := Listed } ]
test "VecIsFoldable" ExhaustiveMode (seed <- 20261021) (profile <- onVecIsFoldable)
onVecIsTabulated : List Binding := [
  { parameter := just "A", type := nothing, generator := "entryType", coverage := Listed },
  { parameter := just "model", type := nothing, generator := "goodVecTabulation", coverage := Listed },
  { parameter := just "n", type := nothing, generator := "lengths", coverage := Listed },
  { parameter := just "f", type := nothing, generator := "oddAt", coverage := Listed },
  { parameter := just "o", type := nothing, generator := "intEquality", coverage := Listed } ]
test "VecIsTabulated" ExhaustiveMode (seed <- 20261021) (profile <- onVecIsTabulated)
onMatIsIndexed : List Binding := [
  { parameter := just "A", type := nothing, generator := "entryType", coverage := Listed },
  { parameter := just "r", type := nothing, generator := "twoRows", coverage := Listed },
  { parameter := just "c", type := nothing, generator := "threeColumns", coverage := Listed },
  { parameter := just "model", type := nothing, generator := "goodMatIndex", coverage := Listed },
  { parameter := just "o", type := nothing, generator := "matEquality", coverage := Listed },
  { parameter := just "a", type := nothing, generator := "intEquality", coverage := Listed },
  { parameter := nothing, type := just "MatShaped", generator := "shaped", coverage := Listed } ]
test "MatIsIndexed" ExhaustiveMode (seed <- 20261021) (profile <- onMatIsIndexed)
onMatIsAnObject : List Binding := [
  { parameter := just "A", type := nothing, generator := "entryType", coverage := Listed },
  { parameter := just "model", type := nothing, generator := "matEquality", coverage := Listed },
  { parameter := just "x", type := nothing, generator := "matrices", coverage := Listed },
  { parameter := just "p", type := nothing, generator := "matrixPairs", coverage := Listed },
  { parameter := just "c", type := nothing, generator := "matrixChains", coverage := Listed } ]
test "MatIsAnObject" ExhaustiveMode (seed <- 20261021) (profile <- onMatIsAnObject)
onMatIsAFunctor : List Binding := [
  { parameter := just "A", type := nothing, generator := "entryType", coverage := Listed },
  { parameter := just "B", type := nothing, generator := "entryType", coverage := Listed },
  { parameter := just "C", type := nothing, generator := "entryType", coverage := Listed },
  { parameter := just "model", type := nothing, generator := "goodMatFunctor", coverage := Listed },
  { parameter := just "o", type := nothing, generator := "matEquality", coverage := Listed },
  { parameter := just "g", type := nothing, generator := "twiceInt", coverage := Listed },
  { parameter := just "h", type := nothing, generator := "negated", coverage := Listed },
  { parameter := just "xs", type := nothing, generator := "matrices", coverage := Listed } ]
test "MatIsAFunctor" ExhaustiveMode (seed <- 20261021) (profile <- onMatIsAFunctor)
onSymmetricIsAnEqualizer : List Binding := [
  { parameter := just "x", type := nothing, generator := "symmetricMatrices", coverage := Listed } ]
test "SymmetricIsAnEqualizer" ExhaustiveMode (seed <- 20261021) (profile <- onSymmetricIsAnEqualizer)
