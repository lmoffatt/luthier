-- Bite 6 revision, Codex, 2026-10-21, prompt-bite-6.md at 2859815.
-- Kernel property instances now live in core.lut and write core/core.cert.json.
-- The following historical bite 2 description records the original organization.
-- tests/tester/core_laws.test.lut: each property of core/properties/ confirmed at a listed instance
-- (bite 2 of record/plan/core-2026-10-17/execution.md): `Int` with `+`, `*`, `<=`, `<`, `==`
-- and its functions, `Bool` with `and`, `or`, `not`, `String` with `<>`, `Float64` with `+` and
-- `*` within their bounds. The laws are core_instances.lut's wrappers, the instance a parameter
-- bound by the profile of each line; the real instances are defined there too, since the
-- controls (core_controls.test.lut) need the unbroken ones beside the one they break. The
-- entries land in tests/tester/core_instances.cert.json, beside this program and untracked
-- (D-2026-10-16-h); bite 3 moves the claims into core.lut, where they get their tracked store.
-- Written 2026-10-17 by Claude Fable 5.1, an agent of the coordinating session, on
-- record/plan/core-2026-10-17/prompt-bite-2.md.
--
-- A profile binds the instance's parameters by name (`r`, `op`, `e`, `z`, `inv`, `f`, `g`, `s`,
-- `to`, `from`, the bounds by arity) and is named after the instance; a law over `Bool` runs
-- exhaustively, the rest sampled at the default size and cases.

import "core_instances.lut" boolEq
import "test.lth" test ExhaustiveMode SampledMode
import "generators_model.lut" linear
import "generators.lth" Binding
import "laws.lth" Listed
import "core_instances.lut" leq less equal parity plus minus times smallerInt largerInt firstInt second zero intOne
  identityInt negate succ pred double squareInt clamp timesZero remainder2 nonNegative
  succThenPred zeroConst flippedMinus reversedMinus
  boolAnd boolOr boolNot top bottom joinStrings empty
  fplus ftimes fzero fnegate fclamp tenth byTen sumBound productBound scaleBound noBound1 noBound2 noBound3
-- ---------------------------------------------------------------- the profiles

onLeq : List Binding := [ { parameter := just "r", type := nothing, generator := "leq", coverage := Listed } ]
onLess : List Binding := [ { parameter := just "r", type := nothing, generator := "less", coverage := Listed } ]
onEqual : List Binding := [ { parameter := just "r", type := nothing, generator := "equal", coverage := Listed } ]
-- the equivalence whose chains are drawn in few tries: a chain of `equal` is one value three
-- times, found rarely at size 10 (7.S6)
onParity : List Binding := [ { parameter := just "r", type := nothing, generator := "parity", coverage := Listed } ]

onPlus : List Binding := [
  { parameter := just "op", type := nothing, generator := "plus", coverage := Listed },
  { parameter := just "e", type := nothing, generator := "zero", coverage := Listed },
  { parameter := just "inv", type := nothing, generator := "negate", coverage := Listed } ]
onTimes : List Binding := [
  { parameter := just "op", type := nothing, generator := "times", coverage := Listed },
  { parameter := just "e", type := nothing, generator := "intOne", coverage := Listed },
  { parameter := just "z", type := nothing, generator := "zero", coverage := Listed } ]
onSmaller : List Binding := [ { parameter := just "op", type := nothing, generator := "smallerInt", coverage := Listed } ]
onSecond : List Binding := [
  { parameter := just "op", type := nothing, generator := "second", coverage := Listed },
  { parameter := just "e", type := nothing, generator := "intOne", coverage := Listed } ]
onFirst : List Binding := [
  { parameter := just "op", type := nothing, generator := "firstInt", coverage := Listed },
  { parameter := just "e", type := nothing, generator := "intOne", coverage := Listed } ]
onTimesOverPlus : List Binding := [
  { parameter := just "product", type := nothing, generator := "times", coverage := Listed },
  { parameter := just "sum", type := nothing, generator := "plus", coverage := Listed } ]
onMinMax : List Binding := [
  { parameter := just "meet", type := nothing, generator := "smallerInt", coverage := Listed },
  { parameter := just "join", type := nothing, generator := "largerInt", coverage := Listed } ]
zeroAndOne : List Binding := [
  { parameter := just "a", type := nothing, generator := "zero", coverage := Listed },
  { parameter := just "b", type := nothing, generator := "intOne", coverage := Listed } ]

onAnd : List Binding := [
  { parameter := just "op", type := nothing, generator := "boolAnd", coverage := Listed },
  { parameter := just "e", type := nothing, generator := "top", coverage := Listed },
  { parameter := just "z", type := nothing, generator := "bottom", coverage := Listed },
  { parameter := just "complement", type := nothing, generator := "boolNot", coverage := Listed } ]
onOr : List Binding := [
  { parameter := just "op", type := nothing, generator := "boolOr", coverage := Listed },
  { parameter := just "e", type := nothing, generator := "bottom", coverage := Listed },
  { parameter := just "z", type := nothing, generator := "top", coverage := Listed },
  { parameter := just "complement", type := nothing, generator := "boolNot", coverage := Listed } ]
onAndOverOr : List Binding := [
  { parameter := just "product", type := nothing, generator := "boolAnd", coverage := Listed },
  { parameter := just "sum", type := nothing, generator := "boolOr", coverage := Listed },
  { parameter := just "meet", type := nothing, generator := "boolAnd", coverage := Listed },
  { parameter := just "join", type := nothing, generator := "boolOr", coverage := Listed } ]
onOrOverAnd : List Binding := [
  { parameter := just "product", type := nothing, generator := "boolOr", coverage := Listed },
  { parameter := just "sum", type := nothing, generator := "boolAnd", coverage := Listed } ]
onNot : List Binding := [ { parameter := just "f", type := nothing, generator := "boolNot", coverage := Listed } ]

onAppend : List Binding := [
  { parameter := just "op", type := nothing, generator := "joinStrings", coverage := Listed },
  { parameter := just "e", type := nothing, generator := "empty", coverage := Listed } ]

onFloatPlus : List Binding := [
  { parameter := just "op", type := nothing, generator := "fplus", coverage := Listed },
  { parameter := just "e", type := nothing, generator := "fzero", coverage := Listed },
  { parameter := just "inv", type := nothing, generator := "fnegate", coverage := Listed },
  { parameter := just "bound3", type := nothing, generator := "sumBound", coverage := Listed },
  { parameter := just "bound2", type := nothing, generator := "noBound2", coverage := Listed },
  { parameter := just "bound1", type := nothing, generator := "noBound1", coverage := Listed } ]
onFloatTimesOverPlus : List Binding := [
  { parameter := just "product", type := nothing, generator := "ftimes", coverage := Listed },
  { parameter := just "sum", type := nothing, generator := "fplus", coverage := Listed },
  { parameter := just "bound3", type := nothing, generator := "productBound", coverage := Listed } ]

-- functions: `succ` with its inverse `pred`
onSucc : List Binding := [
  { parameter := just "f", type := nothing, generator := "succ", coverage := Listed },
  { parameter := just "g", type := nothing, generator := "pred", coverage := Listed },
  { parameter := just "s", type := nothing, generator := "pred", coverage := Listed },
  { parameter := just "to", type := nothing, generator := "succ", coverage := Listed },
  { parameter := just "from", type := nothing, generator := "pred", coverage := Listed } ]
onNegate : List Binding := [ { parameter := just "f", type := nothing, generator := "negate", coverage := Listed } ]
onClamp : List Binding := [ { parameter := just "f", type := nothing, generator := "clamp", coverage := Listed } ]
onTimesZero : List Binding := [ { parameter := just "f", type := nothing, generator := "timesZero", coverage := Listed } ]
composedAgainstIdentity : List Binding := [
  { parameter := just "f", type := nothing, generator := "succThenPred", coverage := Listed },
  { parameter := just "g", type := nothing, generator := "identityInt", coverage := Listed } ]
constantAgainstTimesZero : List Binding := [
  { parameter := just "f", type := nothing, generator := "zeroConst", coverage := Listed },
  { parameter := just "g", type := nothing, generator := "timesZero", coverage := Listed } ]
flippedAgainstReversed : List Binding := [
  { parameter := just "f", type := nothing, generator := "flippedMinus", coverage := Listed },
  { parameter := just "g", type := nothing, generator := "reversedMinus", coverage := Listed } ]
succOverLeq : List Binding := [
  { parameter := just "r", type := nothing, generator := "leq", coverage := Listed },
  { parameter := just "t", type := nothing, generator := "leq", coverage := Listed },
  { parameter := just "f", type := nothing, generator := "succ", coverage := Listed } ]
doubleOverLeq : List Binding := [
  { parameter := just "r", type := nothing, generator := "leq", coverage := Listed },
  { parameter := just "t", type := nothing, generator := "leq", coverage := Listed },
  { parameter := just "f", type := nothing, generator := "double", coverage := Listed } ]
doubleOverPlus : List Binding := [
  { parameter := just "opA", type := nothing, generator := "plus", coverage := Listed },
  { parameter := just "opB", type := nothing, generator := "plus", coverage := Listed },
  { parameter := just "f", type := nothing, generator := "double", coverage := Listed } ]
remainderOverParity : List Binding := [
  { parameter := just "rA", type := nothing, generator := "parity", coverage := Listed },
  { parameter := just "f", type := nothing, generator := "remainder2", coverage := Listed } ]
squareInNonNegative : List Binding := [
  { parameter := just "f", type := nothing, generator := "squareInt", coverage := Listed },
  { parameter := just "inside", type := nothing, generator := "nonNegative", coverage := Listed } ]
onFloatClamp : List Binding := [
  { parameter := just "f", type := nothing, generator := "fclamp", coverage := Listed },
  { parameter := just "bound1", type := nothing, generator := "noBound1", coverage := Listed } ]
onFloatNegate : List Binding := [
  { parameter := just "f", type := nothing, generator := "fnegate", coverage := Listed },
  { parameter := just "bound1", type := nothing, generator := "noBound1", coverage := Listed } ]
tenthAgainstByTen : List Binding := [
  { parameter := just "f", type := nothing, generator := "tenth", coverage := Listed },
  { parameter := just "g", type := nothing, generator := "byTen", coverage := Listed },
  { parameter := just "bound1", type := nothing, generator := "scaleBound", coverage := Listed } ]

