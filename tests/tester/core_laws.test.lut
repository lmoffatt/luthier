coreTwo : { n : Int | 0 < n } := 2
coreFinPredicate : Fin 1 -> Bool := fn k { k == 0 }
coreFinRelation : Fin 1 -> Fin 1 -> Bool := fn i j { i == j }
coreModuloPredicate (k : Int) : Bool := k mod 2 == 0
coreModuloRespect (p : Related Int (fn x y { x mod 2 == y mod 2 })) : { u : Unit | (structural Bool).eq (coreModuloPredicate p.x) (coreModuloPredicate p.y) } := unit
