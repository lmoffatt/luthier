-- tests/tester/certification_fold.test.lut: the laws of `Folding` (certification.lth §7) on
-- certification_model.lut's `folding`, the five operations a demand's evidence is read with (`allOf`,
-- `alternative`, `restrict`, `projectGrade`, `admit`) and their empty cases. Written 2026-10-23 by
-- Claude Opus 5.5 on record/plan/audit-algebras-2026-10-22/prompt-wave-a.md (bite A4), after the
-- audit of 2026-10-22, 1.3. Over listed cases: every constructor of `Held`, each grade, two names of
-- an obligation, and three counts of a region's cases. Seed 20261023. Its controls are in
-- certification_fold_controls.test.lut.

import "test.lth" test ExhaustiveMode Grade Proved ExhaustiveGrade Cases Sampled AssumedGrade
import "generators.lth" Binding
import "laws.lth" Listed
import "certification.lth" Held EmptyFold NoEntry FailedObligation HeldAt Folding EmptyFoldIsTheUnit AMissingObligationLeavesNoGrade
  AFailureAbsorbs AnAlternativeIsTheStronger FoldsAreAssociative AllOfIsNoMoreThanAnAlternative RestrictNeverRaises
  OutsideTheReachHoldsNothing AnEmptyRegionIsAtMostSampled AdmitIsTheCutoff
import "certification_model.lut" folding

onGenerator (p g : String) : Binding := { parameter := just p, type := nothing, generator := g, coverage := Listed }
foldings : List Folding := [folding]
helds : List Held := [EmptyFold, NoEntry "a", NoEntry "b", FailedObligation "a", FailedObligation "b", HeldAt Proved,
  HeldAt ExhaustiveGrade, HeldAt Cases, HeldAt Sampled, HeldAt AssumedGrade]
names : List String := ["a", "b"]
regionCases : List Nat := [0, 1, 7]
test "EmptyFoldIsTheUnit" ExhaustiveMode (seed <- 20261023) (whereBindings <- [onGenerator "f" "foldings", onGenerator "j" "helds"])
test "AMissingObligationLeavesNoGrade" ExhaustiveMode (seed <- 20261023) (whereBindings <- [onGenerator "f" "foldings", onGenerator "o" "names", onGenerator "j" "helds"])
test "AFailureAbsorbs" ExhaustiveMode (seed <- 20261023) (whereBindings <- [onGenerator "f" "foldings", onGenerator "o" "names", onGenerator "j" "helds"])
test "AnAlternativeIsTheStronger" ExhaustiveMode (seed <- 20261023) (whereBindings <- [onGenerator "f" "foldings", onGenerator "o" "names"])
test "FoldsAreAssociative" ExhaustiveMode (seed <- 20261023) (whereBindings <- [onGenerator "f" "foldings", onGenerator "j" "helds", onGenerator "k" "helds", onGenerator "l" "helds"])
test "AllOfIsNoMoreThanAnAlternative" ExhaustiveMode (seed <- 20261023) (whereBindings <- [onGenerator "f" "foldings", onGenerator "j" "helds", onGenerator "k" "helds"])
test "RestrictNeverRaises" ExhaustiveMode (seed <- 20261023) (whereBindings <- [onGenerator "f" "foldings", onGenerator "n" "regionCases", onGenerator "j" "helds"])
test "OutsideTheReachHoldsNothing" ExhaustiveMode (seed <- 20261023) (whereBindings <- [onGenerator "f" "foldings", onGenerator "n" "regionCases"])
test "AnEmptyRegionIsAtMostSampled" ExhaustiveMode (seed <- 20261023) (whereBindings <- [onGenerator "f" "foldings", onGenerator "j" "helds"])
test "AdmitIsTheCutoff" ExhaustiveMode (seed <- 20261023) (whereBindings <- [onGenerator "f" "foldings", onGenerator "j" "helds"])
