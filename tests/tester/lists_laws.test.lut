testedType : Concrete := Int
intEquality : Object Int := structural Int
listEquality : Object (List Int) := structural (List Int)
indexModel : Indexed (List Int) Int := listIndexed Int
foldModel : Foldable List := { fold := foldList }
functorModel : Functor List := { map := mapKernelList }
tabulationModel : Tabulated (List Int) Int := { build := buildList Int }
monoidModel : Monoid (List Int) (structural (List Int)) := listMonoid Int
orderModel : Order Int (structural Int) := { leq := fn x y { x <= y } }
ordered : Int -> Int -> Bool := fn x y { x <= y }
plusOne : Int -> Int := fn x { x + 1 }
minusOne : Int -> Int := fn x { x - 1 }
subtract : Int -> Int -> Int := fn x y { x - y }
foldNeutral : Int := 9
sizes : List Nat := [0, 1, 2, 3]
values : List (List Int) := [[], [0], [1], [1, 2], [2, 1], [1, 1], [3, 1, 2, 1]]
predicate : Int -> Bool := fn x { 1 <= x }
keep : List Int -> List Int := filter List Int foldModel predicate
reverseModel : List Int -> List Int := reverse Int
sortModel : List Int -> List Int := sortBy Int ordered
joiningModel : List Int -> List Int -> List Int := combineList Int
hammingSize : HammingLength := 2
hammingModel : Metric (BoolListOf 2) (structural (BoolListOf 2)) := { d := hammingList 2 }
boolVectors : List (BoolListOf 2) := [[false, false], [false, true], [true, false], [true, true]]
equalVectors : List (EqualPair (BoolListOf 2) (structural (BoolListOf 2))) := [
  { x := [false, false], y := [false, false] }, { x := [false, true], y := [false, true] },
  { x := [true, false], y := [true, false] }, { x := [true, true], y := [true, true] }]

-- Left fold and early-stop searches (lists.lut, the list searches brief): a step that does not commute,
-- and lists with a failing element in first, middle and last place.
searchValues : List (List Int) := [[], [0], [1], [1, 2], [1, 0], [0, 1], [1, 0, 1], [2, 1, 0, 3]]
horner : Int -> Int -> Int := fn acc x { 2 * acc + x }
leftFoldModel : (Int -> Int -> Int) -> Int -> List Int -> Int := foldLeft Int Int
takingModel : List Int -> List Int := takeWhile Int predicate
droppingModel : List Int -> List Int := dropWhile Int predicate
findModel : List Int -> Maybe Int := find Int predicate

