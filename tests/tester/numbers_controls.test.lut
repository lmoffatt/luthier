convertOff : Conversion := { convert := fn i { toFloat64 i + 1.0 } }
convertOffProfile : List Binding := [
  { parameter := nothing, type := just "Doubles", generator := "doubles", coverage := Listed },
  { parameter := nothing, type := just "IntegerDivision", generator := "integerDivision", coverage := Listed },
  { parameter := nothing, type := just "Conversion", generator := "convertOff", coverage := Listed },
  { parameter := nothing, type := just "Elementary", generator := "elementary", coverage := Listed },
  { parameter := just "tol", type := nothing, generator := "tolerance", coverage := Listed } ]
convertDoubled : Conversion := { convert := fn i { toFloat64 i * 2.0 } }
convertDoubledProfile : List Binding := [
  { parameter := nothing, type := just "Doubles", generator := "doubles", coverage := Listed },
  { parameter := nothing, type := just "IntegerDivision", generator := "integerDivision", coverage := Listed },
  { parameter := nothing, type := just "Conversion", generator := "convertDoubled", coverage := Listed },
  { parameter := nothing, type := just "Elementary", generator := "elementary", coverage := Listed },
  { parameter := just "tol", type := nothing, generator := "tolerance", coverage := Listed } ]
convertNegated : Conversion := { convert := fn i { 0.0 - toFloat64 i } }
convertNegatedProfile : List Binding := [
  { parameter := nothing, type := just "Doubles", generator := "doubles", coverage := Listed },
  { parameter := nothing, type := just "IntegerDivision", generator := "integerDivision", coverage := Listed },
  { parameter := nothing, type := just "Conversion", generator := "convertNegated", coverage := Listed },
  { parameter := nothing, type := just "Elementary", generator := "elementary", coverage := Listed },
  { parameter := just "tol", type := nothing, generator := "tolerance", coverage := Listed } ]
sqrtHalf : Elementary := { sqrt := fn x { x / 2.0 }, exp := elementary.exp, log := elementary.log, erf := elementary.erf }
sqrtHalfProfile : List Binding := [
  { parameter := nothing, type := just "Doubles", generator := "doubles", coverage := Listed },
  { parameter := nothing, type := just "IntegerDivision", generator := "integerDivision", coverage := Listed },
  { parameter := nothing, type := just "Conversion", generator := "conversion", coverage := Listed },
  { parameter := nothing, type := just "Elementary", generator := "sqrtHalf", coverage := Listed },
  { parameter := just "tol", type := nothing, generator := "tolerance", coverage := Listed } ]
sqrtNegated : Elementary := { sqrt := fn x { 0.0 - x }, exp := elementary.exp, log := elementary.log, erf := elementary.erf }
sqrtNegatedProfile : List Binding := [
  { parameter := nothing, type := just "Doubles", generator := "doubles", coverage := Listed },
  { parameter := nothing, type := just "IntegerDivision", generator := "integerDivision", coverage := Listed },
  { parameter := nothing, type := just "Conversion", generator := "conversion", coverage := Listed },
  { parameter := nothing, type := just "Elementary", generator := "sqrtNegated", coverage := Listed },
  { parameter := just "tol", type := nothing, generator := "tolerance", coverage := Listed } ]
expScaled : Elementary := { sqrt := elementary.sqrt, exp := fn x { 1.0001 * elementary.exp x }, log := elementary.log, erf := elementary.erf }
expScaledProfile : List Binding := [
  { parameter := nothing, type := just "Doubles", generator := "doubles", coverage := Listed },
  { parameter := nothing, type := just "IntegerDivision", generator := "integerDivision", coverage := Listed },
  { parameter := nothing, type := just "Conversion", generator := "conversion", coverage := Listed },
  { parameter := nothing, type := just "Elementary", generator := "expScaled", coverage := Listed },
  { parameter := just "tol", type := nothing, generator := "tolerance", coverage := Listed } ]
expNegated : Elementary := { sqrt := elementary.sqrt, exp := fn x { 0.0 - elementary.exp x }, log := elementary.log, erf := elementary.erf }
expNegatedProfile : List Binding := [
  { parameter := nothing, type := just "Doubles", generator := "doubles", coverage := Listed },
  { parameter := nothing, type := just "IntegerDivision", generator := "integerDivision", coverage := Listed },
  { parameter := nothing, type := just "Conversion", generator := "conversion", coverage := Listed },
  { parameter := nothing, type := just "Elementary", generator := "expNegated", coverage := Listed },
  { parameter := just "tol", type := nothing, generator := "tolerance", coverage := Listed } ]
logShifted : Elementary := { sqrt := elementary.sqrt, exp := elementary.exp, log := fn x { elementary.log x + 1.0e-4 }, erf := elementary.erf }
logShiftedProfile : List Binding := [
  { parameter := nothing, type := just "Doubles", generator := "doubles", coverage := Listed },
  { parameter := nothing, type := just "IntegerDivision", generator := "integerDivision", coverage := Listed },
  { parameter := nothing, type := just "Conversion", generator := "conversion", coverage := Listed },
  { parameter := nothing, type := just "Elementary", generator := "logShifted", coverage := Listed },
  { parameter := just "tol", type := nothing, generator := "tolerance", coverage := Listed } ]
erfShifted : Elementary := { sqrt := elementary.sqrt, exp := elementary.exp, log := elementary.log, erf := fn x { elementary.erf x + 1.0e-4 } }
erfShiftedProfile : List Binding := [
  { parameter := nothing, type := just "Doubles", generator := "doubles", coverage := Listed },
  { parameter := nothing, type := just "IntegerDivision", generator := "integerDivision", coverage := Listed },
  { parameter := nothing, type := just "Conversion", generator := "conversion", coverage := Listed },
  { parameter := nothing, type := just "Elementary", generator := "erfShifted", coverage := Listed },
  { parameter := just "tol", type := nothing, generator := "tolerance", coverage := Listed } ]
erfDoubled : Elementary := { sqrt := elementary.sqrt, exp := elementary.exp, log := elementary.log, erf := fn x { 2.0 * elementary.erf x } }
erfDoubledProfile : List Binding := [
  { parameter := nothing, type := just "Doubles", generator := "doubles", coverage := Listed },
  { parameter := nothing, type := just "IntegerDivision", generator := "integerDivision", coverage := Listed },
  { parameter := nothing, type := just "Conversion", generator := "conversion", coverage := Listed },
  { parameter := nothing, type := just "Elementary", generator := "erfDoubled", coverage := Listed },
  { parameter := just "tol", type := nothing, generator := "tolerance", coverage := Listed } ]

-- §2 the doubles. `Doubles`, the claim: each broken model refutes a different conjunct, the
-- conjuncts running in order until one is refuted (7.S22)
-- [bite A3b] `y` equal to `x` in a quarter of the draws (generators_model.lut's `sameOrFloat`), so that
-- the conjunct Antisymmetric sees its premise; the other conjuncts with a `y` draw it so too
sameY : List Binding := [byParameter "y" "sameOrFloat"]
-- plus is a - b, which is not commutative
test "Doubles" (SampledMode linear) (seed <- 20261015) (whereBindings <- sameY) (profile <- swappedProfile) (control <- true)
-- times adds a - b to the product, which is not symmetric
test "Doubles" (SampledMode linear) (seed <- 20261015) (whereBindings <- sameY) (profile <- timesSkewedProfile) (control <- true)
-- plus adds one to the sum, so x + 0 is x + 1
test "Doubles" (SampledMode linear) (seed <- 20261015) (whereBindings <- sameY) (profile <- plusOffProfile) (control <- true)
-- times adds one to the product, so x * 0 is 1
test "Doubles" (SampledMode linear) (seed <- 20261015) (whereBindings <- sameY) (profile <- timesOffProfile) (control <- true)
-- times scales by 1.5, so x * 1 is 1.5 x
test "Doubles" (SampledMode linear) (seed <- 20261021) (whereBindings <- sameY) (profile <- timesScaledProfile) (control <- true)
-- minus takes twice b, so negating twice multiplies by four
test "Doubles" (SampledMode linear) (seed <- 20261015) (whereBindings <- sameY) (profile <- minusDoubledProfile) (control <- true)
-- leq is the strict order, which fails on x and x
test "Doubles" (SampledMode linear) (seed <- 20261015) (whereBindings <- sameY) (profile <- leqStrictProfile) (control <- true)
-- leq is equality, so two distinct doubles are not comparable
test "Doubles" (SampledMode linear) (seed <- 20261015) (whereBindings <- sameY) (profile <- leqIsEqualProfile) (control <- true)
-- leq is always true, so two distinct doubles are each at most the other
test "Doubles" (SampledMode linear) (seed <- 20261015) (whereBindings <- sameY) (profile <- leqAlwaysProfile) (control <- true)
-- leq allows a slack of one, which does not compose along the listed chain
test "Doubles" ExhaustiveMode (whereBindings <- slackChainBinding) (profile <- leqSlackProfile) (control <- true)

-- the laws of §2, each on its own line
-- divide adds one to the quotient, so x / 1 is x + 1
test "DivideOne" (SampledMode linear) (seed <- 20261015) (profile <- divideOffProfile) (control <- true)
-- minus adds one to the difference, so x - x is 1
test "MinusSelf" (SampledMode linear) (seed <- 20261015) (profile <- minusOffProfile) (control <- true)
-- divide divides by b + 1, so x / x is not one
test "DivideSelf" (SampledMode linear) (seed <- 20261015) (profile <- divideShiftedProfile) (control <- true)
-- minus is b - a: x - y is y - x, while x + (0 - y) is x + y
test "MinusIsPlusNegated" (SampledMode linear) (seed <- 20261015) (profile <- minusFlippedProfile) (control <- true)
-- less is a <= b, wrong only at a tie, which the law draws with probability one half (report-weak-laws.md)
test "LessIsStrict" (SampledMode linear) (seed <- 20261015) (profile <- lessLooseProfile) (control <- true)
-- greater is a < b, the wrong direction
test "GreaterIsLessReversed" (SampledMode linear) (seed <- 20261015) (profile <- greaterWrongProfile) (control <- true)
-- geq is a <= b, the wrong direction
test "GeqIsLeqReversed" (SampledMode linear) (seed <- 20261015) (profile <- geqWrongProfile) (control <- true)
-- unequal is a < b, false when a > b
test "UnequalIsNotEqual" (SampledMode linear) (seed <- 20261015) (profile <- unequalWrongProfile) (control <- true)
-- plus is b - a, which reverses the order of the first term
test "PlusMonotone" (SampledMode linear) (seed <- 20261015) (profile <- plusFlippedProfile) (control <- true)
-- times is the negated product, which reverses the order
test "TimesMonotone" (SampledMode linear) (seed <- 20261015) (profile <- timesNegatedProfile) (control <- true)
-- epsilon is 1e-16, below half the ulp of one, so one plus it is one
test "EpsilonIsTheUlpOfOne" ExhaustiveMode (seed <- 20261015) (profile <- epsilonSmallProfile) (control <- true)

-- the within-bound laws, two controls each: an operation rounded to the coarse grid, and a bound
-- too small on the real doubles (D-2026-10-17-f's gamma2, or u / 2 for the reciprocal)
test "PlusAssociativeWithin" (SampledMode linear) (seed <- 20261021) (profile <- plusCoarseProfile) (control <- true)
test "PlusAssociativeWithin" ExhaustiveMode (whereBindings <- plusWitness) (profile <- epsilonThirdProfile) (control <- true)
test "TimesAssociativeWithin" (SampledMode linear) (seed <- 20261021) (profile <- timesCoarseProfile) (control <- true)
test "TimesAssociativeWithin" ExhaustiveMode (whereBindings <- timesWitness) (profile <- epsilonThirdProfile) (control <- true)
test "TimesDistributiveWithin" (SampledMode linear) (seed <- 20261021) (profile <- timesCoarseProfile) (control <- true)
test "TimesDistributiveWithin" ExhaustiveMode (whereBindings <- distributiveWitness) (profile <- epsilonThirdProfile) (control <- true)
test "DivideInvertibleWithin" (SampledMode linear) (seed <- 20261021) (profile <- divideCoarseProfile) (control <- true)
test "DivideInvertibleWithin" ExhaustiveMode (whereBindings <- reciprocalWitness) (profile <- epsilonQuarterProfile) (control <- true)
-- the computed distance: its distances rounded to the coarse grid; a bound of zero
test "AbsDistanceIsAMetricWithin" (SampledMode linear) (seed <- 20261021) (profile <- onDistanceCoarse) (control <- true)
test "AbsDistanceIsAMetricWithin" ExhaustiveMode (profile <- onDistanceUnbounded) (control <- true)

-- §3 integer division
-- the quotient is one too large, so q * b + r is a + b
test "DivisionAlgorithm" (SampledMode linear) (seed <- 20261015) (profile <- quotientOffProfile) (control <- true)
-- the remainder is shifted by the divisor, out of its range
test "RemainderOfTheDivisorsSign" (SampledMode linear) (seed <- 20261015) (profile <- remainderShiftedProfile) (control <- true)
-- the quotient is one too large, so (a * b) / b is a + 1
test "QuotientOfProduct" (SampledMode linear) (seed <- 20261015) (profile <- quotientOffProfile) (control <- true)

-- §4 the conversion
-- convert doubles, so one converts to two
test "ConvertZeroAndOne" ExhaustiveMode (seed <- 20261015) (profile <- convertDoubledProfile) (control <- true)
-- convert adds one, so the image of a sum is one short of the sum of the images
test "ConvertAddsExactly" (SampledMode linear) (seed <- 20261015) (profile <- convertOffProfile) (control <- true)
-- convert doubles, so the image of i + 1 is two more than the image of i
test "ConvertSucceeds" (SampledMode linear) (seed <- 20261015) (profile <- convertDoubledProfile) (control <- true)
-- convert negates, which reverses the order
test "ConvertKeepsOrder" (SampledMode linear) (seed <- 20261015) (profile <- convertNegatedProfile) (control <- true)

-- §5 the elementary functions
-- sqrt halves, so the square root of 0.25 is not 0.5
test "SqrtOfSquares" ExhaustiveMode (seed <- 20261015) (profile <- sqrtHalfProfile) (control <- true)
-- exp is scaled by 1.0001, so exp 0 is not one
test "ExpOfZero" ExhaustiveMode (seed <- 20261015) (profile <- expScaledProfile) (control <- true)
-- log adds 1e-4, so log 1 is not zero
test "LogOfOne" ExhaustiveMode (seed <- 20261015) (profile <- logShiftedProfile) (control <- true)
-- erf adds 1e-4, so erf 0 is not zero
test "ErfOfZero" ExhaustiveMode (seed <- 20261015) (profile <- erfShiftedProfile) (control <- true)
-- sqrt is the negation, which reverses the order
test "SqrtMonotone" (SampledMode linear) (seed <- 20261015) (profile <- sqrtNegatedProfile) (control <- true)
-- sqrt halves, so the root of x * x is x * x / 2
test "SqrtOfSquare" (SampledMode linear) (seed <- 20261015) (profile <- sqrtHalfProfile) (control <- true)
-- exp is the negated exponential, negative everywhere
test "ExpPositive" (SampledMode linear) (seed <- 20261015) (profile <- expNegatedProfile) (control <- true)
-- erf adds 1e-4, which an odd function cannot do
test "ErfOdd" (SampledMode linear) (seed <- 20261015) (profile <- erfShiftedProfile) (control <- true)
-- erf is doubled, so it leaves [-1, 1]
test "ErfBounded" (SampledMode linear) (seed <- 20261015) (profile <- erfDoubledProfile) (control <- true)
-- sqrt halves, so its square is a quarter of x
test "SqrtSquares" (SampledMode linear) (seed <- 20261015) (profile <- sqrtHalfProfile) (control <- true)
-- exp is scaled by 1.0001, so exp (log x) is 1.0001 x
test "ExpOfLog" (SampledMode linear) (seed <- 20261015) (profile <- expScaledProfile) (control <- true)
-- exp is scaled by 1.0001, so log (exp x) is x + 1e-4
test "LogOfExp" (SampledMode linear) (seed <- 20261015) (profile <- expScaledProfile) (control <- true)
-- exp is scaled by 1.0001, so exp (x + y) and exp x * exp y differ by 1e-4 relative
test "ExpAdds" (SampledMode linear) (seed <- 20261015) (profile <- expScaledProfile) (control <- true)
-- log adds 1e-4, so log (x * y) has one shift and log x + log y two
test "LogMultiplies" (SampledMode linear) (seed <- 20261015) (profile <- logShiftedProfile) (control <- true)
