-- Bite 8, 2026-10-21 (prompt-bite-8.md): the broken models of the within-bound laws. `coarse`
-- rounds a double to 26 significant bits, Veltkamp's splitting with the constant 2^27 + 1 (Dekker,
-- A floating-point technique for extending the available precision, 1971): an operation rounded
-- to that grid errs by about 2^-27 of its result, far above the laws' bounds near 2^-52
coarse (v : Float64) : Float64 :=
  { t := 134217729.0 * v
    t - (t - v) }
plusCoarse : Doubles Float64 := { plus := fn a b { coarse (a + b) }, minus := doubles.minus, times := doubles.times,
  divide := doubles.divide, less := doubles.less, leq := doubles.leq, greater := doubles.greater, geq := doubles.geq,
  unequal := doubles.unequal, epsilon := doubles.epsilon }
plusCoarseProfile : List Binding := [ { parameter := nothing, type := just "Doubles", generator := "plusCoarse", coverage := Listed } ]
timesCoarse : Doubles Float64 := { plus := doubles.plus, minus := doubles.minus, times := fn a b { coarse (a * b) },
  divide := doubles.divide, less := doubles.less, leq := doubles.leq, greater := doubles.greater, geq := doubles.geq,
  unequal := doubles.unequal, epsilon := doubles.epsilon }
timesCoarseProfile : List Binding := [ { parameter := nothing, type := just "Doubles", generator := "timesCoarse", coverage := Listed } ]
divideCoarse : Doubles Float64 := { plus := doubles.plus, minus := doubles.minus, times := doubles.times,
  divide := fn a b { coarse (a / b) }, less := doubles.less, leq := doubles.leq, greater := doubles.greater, geq := doubles.geq,
  unequal := doubles.unequal, epsilon := doubles.epsilon }
divideCoarseProfile : List Binding := [ { parameter := nothing, type := just "Doubles", generator := "divideCoarse", coverage := Listed } ]
-- the real operations with a third of the real epsilon: each bound `3 gamma2` becomes `3 gamma2 (epsilon / 3)`,
-- just below `gamma2`, the bound D-2026-10-17-f first wrote; refuted at a listed case, found by a
-- search of uniform draws in [-10, 10] (seed 20261021) and checked in Python with the law's own
-- order of operations; at a quarter, the reciprocal's bound `2u` becomes `u / 2`
