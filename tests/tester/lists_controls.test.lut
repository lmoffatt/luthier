-- kept as a recursion (bite 13b): a broken control that ignores the list; 4.R3 asks its match to touch nil and cons
emptyPredicate : List Int -> Bool := fn xs { match xs { nil -> true ; cons x rest -> true } }
-- kept as a recursion (bite 13b): a broken control that ignores the list; 4.R3 asks its match to touch nil and cons
distinctPredicate : List Int -> Bool := fn xs { match xs { nil -> true ; cons x rest -> true } }

