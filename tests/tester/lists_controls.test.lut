-- Codex, bite 7, 2026-10-21; prompt-bite-7.md, input 1429de8.
-- Finite listed evidence, seed 20261021; no claim over every type in U.
import "test.lth" test ExhaustiveMode
import "generators.lth" Binding
import "laws.lth" Listed

testedType : Concrete := Int
intEquality : Object Int := structural Int
listEquality : Object (List Int) := structural (List Int)
indexModel : Indexed (List Int) Int := listIndexed Int
foldModel : Foldable List := { fold := foldList }
functorModel : Functor List := { map := mapKernelList }
tabulationModel : Tabulated (List Int) Int := { build := buildList Int }
monoidModel : Monoid (List Int) (structural (List Int)) := listMonoid Int
orderModel : Order Int (structural Int) := { leq := fn x y { x <= y } }
ordered : Int -> Int -> Bool := fn x y { x <= y }
plusOne : Int -> Int := fn x { x + 1 }
minusOne : Int -> Int := fn x { x - 1 }
subtract : Int -> Int -> Int := fn x y { x - y }
foldNeutral : Int := 9
sizes : List Nat := [0, 1, 2, 3]
values : List (List Int) := [[], [0], [1], [1, 2], [2, 1], [1, 1], [3, 1, 2, 1]]
predicate : Int -> Bool := fn x { 1 <= x }
keep : List Int -> List Int := filter List Int foldModel predicate
reverseModel : List Int -> List Int := reverse Int
sortModel : List Int -> List Int := sortBy Int ordered
joiningModel : List Int -> List Int -> List Int := combineList Int
hammingSize : HammingLength := 2
hammingModel : Metric (BoolListOf 2) (structural (BoolListOf 2)) := { d := hammingList 2 }
boolVectors : List (BoolListOf 2) := [[false, false], [false, true], [true, false], [true, true]]
equalVectors : List (EqualPair (BoolListOf 2) (structural (BoolListOf 2))) := [
  { x := [false, false], y := [false, false] }, { x := [false, true], y := [false, true] },
  { x := [true, false], y := [true, false] }, { x := [true, true], y := [true, true] }]

-- The four controls named by §3.7, plus independent controls for the other claims.
badFunctor : Functor List := { map := fn (A B : U) f xs { take B (if lengthList A xs == 0 then 0 else lengthList A xs - 1) (mapKernelList A B f xs) } }
badFold : Foldable List := { fold := fn (A M : U) op e f xs { e } }
badTabulation : Tabulated (List Int) Int := { build := fn n f { nil } }
-- Same lengths, wrong order: Monoid's associativity/neutral laws must see this.
badAppend (xs ys : List Int) : List Int := combineList Int xs (reverse Int ys)
badMonoid : Monoid (List Int) (structural (List Int)) := { neutral := nil, combine := badAppend }
shortAppend : List Int -> List Int -> List Int := fn xs ys { xs }
shortReverse : List Int -> List Int := fn xs { drop Int 1 xs }
-- Fixing the head still gives an involution; it refutes ReversesEntries instead.
fixedHead (xs : List Int) : List Int := take Int 1 xs <> reverse Int (drop Int 1 xs)
noFilter : List Int -> List Int := id (List Int)
noSort : List Int -> List Int := id (List Int)
uniqueSort (xs : List Int) : List Int := sortBy Int ordered (foldList Int (List Int) (fn front tail { if member List Int (atList Int front 0) tail then tail else combineList Int front tail }) nil (singleton Int) xs)
badHamming : Metric (BoolListOf 2) (structural (BoolListOf 2)) := { d := fn xs ys { 0.0 } }

onListIsAFunctor : List Binding := [
  { parameter := just "A", type := nothing, generator := "testedType", coverage := Listed },
  { parameter := just "B", type := nothing, generator := "testedType", coverage := Listed },
  { parameter := just "C", type := nothing, generator := "testedType", coverage := Listed },
  { parameter := just "model", type := nothing, generator := "badFunctor", coverage := Listed },
  { parameter := just "o", type := nothing, generator := "listEquality", coverage := Listed },
  { parameter := just "g", type := nothing, generator := "plusOne", coverage := Listed },
  { parameter := just "h", type := nothing, generator := "minusOne", coverage := Listed },
  { parameter := just "xs", type := nothing, generator := "values", coverage := Listed } ]
test "ListIsAFunctor" ExhaustiveMode (seed <- 20261021) (profile <- onListIsAFunctor) (control <- true)

