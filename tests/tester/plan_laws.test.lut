-- tests/tester/plan_laws.test.lut: the laws of plan.lth on plan_model.lut: `Dataflow` (§1) on its
-- `example` and two dataflows written here, `Confluent` (§2) on listed schedules, `Planning` (§5)
-- on `planning`, and the law of the key (§4), as listed cases. Written 2026-10-15
-- by Claude Opus 5.5, an agent of the coordinating session, on record/IA/v04-2026-10-15/prompt-e.md
-- (criterion e of v0.4, L9.14). There is no generator of dataflows (record/IA/demand-2026-10-15/
-- report.md), so the dataflows are a census: plan_model.lut's `example` (five names, the entry `d`
-- reaches four); `uneven`, where the order of first demand from `d` is not by levels (`c` reads
-- nothing and is demanded after `b`); and `leafy`, whose `p` reads a name no node defines (a leaf
-- that keeps `init`, plan.lth §1). `Keying` (§4) has lines since 2026-10-23 (audit 3.4,
-- A7), on plan_model.lut's `keying`, a model over the host's digest of flattened values. Seed 20261015 (the censuses are listed; the seed only names the
-- run).

import "test.lth" test ExhaustiveMode
import "generators.lth" Binding
import "laws.lth" Listed
import "certification.lth" Value Number Printed
import "demand.lth" Demand RunRecord recorded
import "demand_model.lut" theDemand
import "plan.lth" Planning Dataflow Schedule reaches NamesAreUnique Acyclic StepIsLocal Confluent PlanIsTheLiveCone
  PlanLinearizes StrategiesAgree TheDefaultsAgree ForwardIsByLevels ByNeedIsFirstDemand PlanIsConfluent
  KeyReadsOnlyTheCone PureConeIsDeterminate MemoKey DemandKey Plan Keying DigestSeparatesTheDemand DigestSeparatesTheCone
  DigestSeparatesTheMode DigestSeparatesTheSeed DigestSeparatesThePlan DigestSeparatesTheCertificates
  PlanDigestSeparatesTheSchedule LookupComparesTheFullKey ActionConeIsNeverServed KeyIsOfTheRecord Strategy ForwardOnDemand CallByNeed
import "generators.lth" Seed
import "certification.lth" Hash
import "plan_model.lut" planning keying example eqNat

types : List U := [Nat]
eqs : List (Nat -> Nat -> Bool) := [eqNat]
planners : List (Planning Nat eqNat) := [planning]

-- a = 2, b = a * 3, c = 5, d = b + c: by first demand from d the order is a, b, c, d, where c (level
-- 0) follows b (level 1)
uneven : Dataflow Nat eqNat := {
  nodes := [{ name := "a", reads := nil }, { name := "b", reads := ["a"] }, { name := "c", reads := nil },
            { name := "d", reads := ["b", "c"] }],
  init := 0,
  step := fn n env { if n == "a" then 2 else if n == "b" then env "a" * 3 else if n == "c" then 5
                     else if n == "d" then env "b" + env "c" else 0 },
}
-- p reads q, which no node defines: q keeps init, p = q + 1
leafy : Dataflow Nat eqNat := {
  nodes := [{ name := "p", reads := ["q"] }, { name := "r", reads := ["p"] }],
  init := 0,
  step := fn n env { if n == "p" then env "q" + 1 else if n == "r" then env "p" * 10 else 0 },
}
dataflows : List (Dataflow Nat eqNat) := [example, uneven, leafy]
entries : List String := ["d", "e", "a", "r"]
nodeNames : List String := ["a", "b", "c", "d", "e", "p", "q", "x"]
-- environments: every name 7; a 3 and every other 10; each name its length plus one
everySeven (m : String) : Nat := 7
aThree (m : String) : Nat := if m == "a" then 3 else 10
byName (m : String) : Nat := if m == "b" then 4 else if m == "c" then 9 else if m == "q" then 6 else 1
envs : List (String -> Nat) := [everySeven, aThree, byName]
envLists : List (List (String -> Nat)) := [envs]
-- the live set of `d` in example and uneven, and four orders of its names, three of them
-- linearizations of one or both
lives : List (List String) := [["a", "b", "c", "d"]]
schedules : List Schedule := [["a", "b", "c", "d"], ["a", "c", "b", "d"], ["c", "a", "b", "d"], ["d", "b", "c", "a"]]
-- choices for a linearization built from draws (plan.lth's `linearization`)
choices : List (List Nat) := [nil, [1], [1, 1], [0, 1, 0], [2, 1, 1], [5]]
-- demands: the default's entry set to d, without and with values set
plain : Demand := theDemand (entry <- "d")
withSets : Demand := theDemand (entry <- "d") (sets <- [("a", Number 1.0), ("z", Printed "x")])
demands : List Demand := [plain, withSets]
holes : List String := ["a", "e", "z"]
values : List Value := [Number 2.0, Printed "y"]

bind (p g : String) : Binding := { parameter := just p, type := nothing, generator := g, coverage := Listed }
onDataflow : List Binding := [bind "A" "types", bind "eq" "eqs", bind "d" "dataflows"]
onStep : List Binding := [bind "A" "types", bind "eq" "eqs", bind "d" "dataflows", bind "n" "nodeNames", bind "env" "envs"]
onSchedules : List Binding := [bind "A" "types", bind "eq" "eqs", bind "d" "dataflows", bind "live" "lives",
  bind "s1" "schedules", bind "s2" "schedules"]
onPlan : List Binding := [bind "A" "types", bind "eq" "eqs", bind "p" "planners", bind "d" "dataflows", bind "e" "entries"]
onConfluentPlan : List Binding := [bind "A" "types", bind "eq" "eqs", bind "p" "planners", bind "d" "dataflows",
  bind "e" "entries", bind "cs" "choices"]
onKey : List Binding := [bind "A" "types", bind "eq" "eqs", bind "p" "planners", bind "d" "dataflows",
  bind "dm" "demands", bind "n" "holes", bind "v" "values"]

-- §1 the dataflow
test "NamesAreUnique" ExhaustiveMode (seed <- 20261015) (whereBindings <- onDataflow)
test "Acyclic" ExhaustiveMode (seed <- 20261015) (whereBindings <- onDataflow)
test "StepIsLocal" ExhaustiveMode (seed <- 20261015) (whereBindings <- onStep)
-- §2 any two linearizations agree
test "Confluent" ExhaustiveMode (seed <- 20261015) (whereBindings <- onSchedules)
-- §5 the planner; the strategies are every value of `Strategy`
test "PlanIsTheLiveCone" ExhaustiveMode (seed <- 20261015) (whereBindings <- onPlan)
test "PlanLinearizes" ExhaustiveMode (seed <- 20261015) (whereBindings <- onPlan)
test "StrategiesAgree" ExhaustiveMode (seed <- 20261015) (whereBindings <- onPlan)
test "TheDefaultsAgree" ExhaustiveMode (seed <- 20261015) (whereBindings <- onPlan)
test "ForwardIsByLevels" ExhaustiveMode (seed <- 20261015) (whereBindings <- onPlan)
test "ByNeedIsFirstDemand" ExhaustiveMode (seed <- 20261015) (whereBindings <- onPlan)
test "PlanIsConfluent" ExhaustiveMode (seed <- 20261015) (whereBindings <- onConfluentPlan)
-- §4 the demand's key: a hole the entry does not reach leaves it as it was (restated 2026-10-17 so
-- that the planner enters it; `KeyReadsTheType` removed, plan.lth §4 says why)
test "KeyReadsOnlyTheCone" ExhaustiveMode (seed <- 20261015) (whereBindings <- onKey)

-- §4 the key and its digest (2026-10-23, Claude Sonnet 5.5, audit 3.4, A7): keys, and for each
-- input of a key another value of it, listed. The record is demand.lth's `recorded` on demands that
-- set two holes, one of them off the plan's live names.
key1 : MemoKey := { demand := { decoration := nothing, values := nil }, cone := "sha256:c1", mode := "plain", seed := 1,
  plan := "sha256:p1", certificates := ["sha256:e1"] }
key2 : MemoKey := { demand := { decoration := nothing, values := [("a", Number 1.0)] }, cone := "sha256:c2", mode := "checked", seed := 2,
  plan := "sha256:p2", certificates := nil }
keys : List MemoKey := [key1, key2]
demandKeys : List DemandKey := [{ decoration := nothing, values := nil }, { decoration := nothing, values := [("a", Number 1.0)] },
  { decoration := nothing, values := [("a", Number 2.0)] }]
cones : List Hash := ["sha256:c1", "sha256:c2"]
modes : List String := ["plain", "checked"]
seeds : List Seed := [1, 2, 3]
planHashes : List Hash := ["sha256:p1", "sha256:p2"]
certLists : List (List Hash) := [nil, ["sha256:e1"], ["sha256:e1", "sha256:e2"]]
somePlans : List (Plan Nat) := [{ strategy := ForwardOnDemand, entry := "d", live := ["a", "b", "c", "d"], schedule := ["a", "b", "c", "d"] },
  { strategy := CallByNeed, entry := "d", live := ["a", "b", "c", "d"], schedule := ["a", "b", "c", "d"] }]
orders : List Schedule := [nil, ["a", "b", "c", "d"], ["a", "c", "b", "d"]]
records : List RunRecord := [recorded (theDemand (entry <- "d") (sets <- [("a", Number 1.0), ("z", Printed "x")])) "sha256:c1",
  recorded (theDemand (entry <- "d") (checked <- true)) "sha256:c2"]
pures : List Bool := [true, false]
keyings : List (Keying Nat) := [keying]
strategies : List Strategy := [ForwardOnDemand, CallByNeed]
test "DigestSeparatesTheDemand" ExhaustiveMode (seed <- 20261015) (whereBindings <- [bind "A" "types", bind "h" "keyings", bind "k" "keys", bind "dk" "demandKeys"])
test "DigestSeparatesTheCone" ExhaustiveMode (seed <- 20261015) (whereBindings <- [bind "A" "types", bind "h" "keyings", bind "k" "keys", bind "c" "cones"])
test "DigestSeparatesTheMode" ExhaustiveMode (seed <- 20261015) (whereBindings <- [bind "A" "types", bind "h" "keyings", bind "k" "keys", bind "m" "modes"])
test "DigestSeparatesTheSeed" ExhaustiveMode (seed <- 20261015) (whereBindings <- [bind "A" "types", bind "h" "keyings", bind "k" "keys", bind "s" "seeds"])
test "DigestSeparatesThePlan" ExhaustiveMode (seed <- 20261015) (whereBindings <- [bind "A" "types", bind "h" "keyings", bind "k" "keys", bind "p" "planHashes"])
test "DigestSeparatesTheCertificates" ExhaustiveMode (seed <- 20261015) (whereBindings <- [bind "A" "types", bind "h" "keyings", bind "k" "keys", bind "hs" "certLists"])
test "PlanDigestSeparatesTheSchedule" ExhaustiveMode (seed <- 20261015) (whereBindings <- [bind "A" "types", bind "h" "keyings", bind "p" "somePlans", bind "s" "orders"])
test "LookupComparesTheFullKey" ExhaustiveMode (seed <- 20261015) (whereBindings <- [bind "A" "types", bind "h" "keyings", bind "stored" "keys", bind "asked" "keys"])
test "ActionConeIsNeverServed" ExhaustiveMode (seed <- 20261015) (whereBindings <- [bind "A" "types", bind "h" "keyings", bind "stored" "keys", bind "asked" "keys"])
test "KeyIsOfTheRecord" ExhaustiveMode (seed <- 20261015) (whereBindings <- [bind "A" "types", bind "h" "keyings", bind "r" "records", bind "s" "seeds", bind "p" "somePlans", bind "cs" "certLists"])
-- §5 determinacy of a pure cone under any two strategies, on the dataflows above and the environments listed
test "PureConeIsDeterminate" ExhaustiveMode (seed <- 20261015) (whereBindings <- [bind "A" "types", bind "eq" "eqs", bind "p" "planners",
  bind "d" "dataflows", bind "e" "entries", bind "envs" "envLists", bind "s1" "strategies", bind "s2" "strategies"])
