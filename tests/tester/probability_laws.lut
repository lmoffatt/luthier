-- tests/tester/probability_laws.lut: the laws of probability.lth run through `luthier test`, on
-- the brief record/IA/evidence-2026-10-14/prompt.md. `Kolmogorov` on numpy's sort
-- (probability_model.lut); the mean models, scaled models and likelihoods, records of functions
-- with no generator (7.R4), on listed cases from the fit: session A's (tests/tester/session_a.lut:
-- `modelA`, the profile likelihood `likelihoodA`, 30 coordinates, 22 measurements) and the seven
-- nodes of distances.lut (`posModel`, `fullModel`, `nativeFull`, `nativeProfile`). Each cutoff a
-- census of one, the demand's (D-2026-10-14-c): the tolerance 1e-12 [proposed], the resolution
-- distances.lut's `pitResolution` (step eps^(1/3), tol 1e-6), the level alpha 0.01 on 200 values
-- [proposed]. Seed 20261014. The parameters and data (`VecOf n`) are drawn; a unit list of
-- vectors has no generator (a filter over random lists accepts only empty vectors), so its laws
-- run sampled, to show it, and on the listed lists below.

import "test.lth" test ExhaustiveMode SampledMode
import "generators_model.lut" linear
import "generators.lth" Binding Level
import "laws.lth" Listed
import "numbers.lth" Tolerance
import "arrays.lth" Vec vec
import "probability.lth" Resolution KolmogorovOfNothing KolmogorovOfOne KolmogorovOfMultiset KolmogorovBounded
  KolmogorovAgrees UniformAtLevel MeanShape JacShape JacIsJacobian ScaledShapes DLogSigmaIsGradient TangentShapes
  ScoreIsGradient InfoSymmetric InfoNonNegative GaussianPeaksAtMean ProfiledIsGaussianAtItsSigma
import "probability_model.lut" numpySort
import "../../examples/sonolocalizacion/distances.lut" posModel fullModel nativeFull nativeProfile pitResolution freeDim
import "session_a.lut" dimA modelA likelihoodA

tolerance : Tolerance := 1.0e-12
level : Level := { alpha := 0.01, n := 200 }
kolmogorov : List Binding := [
  { parameter := just "d", type := nothing, generator := "numpySort", coverage := Listed },
  { parameter := just "l", type := nothing, generator := "level", coverage := Listed } ]

-- listed unit lists: empty, one empty vector, the multiples of 37 mod 101 over 101 (a permutation
-- of the 101 points k/101, near uniform), split in vectors of several lengths, and a lump at 0.9
spread (n start : Int) : Vec Float64 := vec Float64 n (fn k { toFloat64 (((start + k) * 37) mod 101) / 101.0 })
unitLists : List (List (Vec Float64)) := [
  nil,
  [vec Float64 0 (fn k { 0.0 })],
  [spread 101 0],
  [spread 30 0, spread 50 30, spread 21 80],
  [spread 1 0, spread 1 1, spread 1 2],
  [vec Float64 20 (fn k { 0.9 }), spread 10 0] ]
listedVs : List Binding := [ { parameter := just "vs", type := nothing, generator := "unitLists", coverage := Listed } ]
-- the calibrated ones only, for the statistical law (the lump at 0.9 is not a sample of the uniform)
uniformLists : List (List (Vec Float64)) := [
  [spread 101 0],
  [spread 30 0, spread 50 30, spread 21 80],
  [spread 1 0, spread 1 1, spread 1 2] ]
listedUniform : List Binding := [ { parameter := just "vs", type := nothing, generator := "uniformLists", coverage := Listed } ]

-- the models as censuses of one, with their dimension and the cutoffs
dimPos : List Int := [freeDim]
dimFull : List Int := [freeDim + 1]
dimSessionA : List Int := [dimA]
cutoffs : List Binding := [
  { parameter := just "tol", type := nothing, generator := "tolerance", coverage := Listed },
  { parameter := just "r", type := nothing, generator := "pitResolution", coverage := Listed } ]
onModelA : List Binding := [
  { parameter := just "n", type := nothing, generator := "dimSessionA", coverage := Listed },
  { parameter := just "m", type := nothing, generator := "modelA", coverage := Listed },
  { parameter := just "l", type := nothing, generator := "likelihoodA", coverage := Listed } ]
onPosModel : List Binding := [
  { parameter := just "n", type := nothing, generator := "dimPos", coverage := Listed },
  { parameter := just "m", type := nothing, generator := "posModel", coverage := Listed },
  { parameter := just "l", type := nothing, generator := "nativeProfile", coverage := Listed } ]
onFullModel : List Binding := [
  { parameter := just "n", type := nothing, generator := "dimFull", coverage := Listed },
  { parameter := just "m", type := nothing, generator := "fullModel", coverage := Listed },
  { parameter := just "l", type := nothing, generator := "nativeFull", coverage := Listed } ]

-- §5 Kolmogorov's distance on numpy's sort
test "KolmogorovOfNothing" ExhaustiveMode (profile <- kolmogorov)
test "KolmogorovOfOne" (SampledMode linear) (seed <- 20261014) (profile <- kolmogorov)
test "KolmogorovOfMultiset" (SampledMode linear) (seed <- 20261014) (profile <- kolmogorov)
test "KolmogorovBounded" (SampledMode linear) (seed <- 20261014) (profile <- kolmogorov)
test "KolmogorovAgrees" (SampledMode linear) (seed <- 20261014) (profile <- kolmogorov)
test "KolmogorovOfMultiset" ExhaustiveMode (whereBindings <- listedVs) (profile <- kolmogorov)
test "KolmogorovBounded" ExhaustiveMode (whereBindings <- listedVs) (profile <- kolmogorov)
test "KolmogorovAgrees" ExhaustiveMode (whereBindings <- listedVs) (profile <- kolmogorov)
test "UniformAtLevel" ExhaustiveMode (whereBindings <- listedUniform) (profile <- kolmogorov)

-- §2 the mean models: session A's, distances.lut's
test "MeanShape" (SampledMode linear) (cases <- 20) (seed <- 20261014) (whereBindings <- onModelA) (profile <- cutoffs)
test "JacShape" (SampledMode linear) (cases <- 20) (seed <- 20261014) (whereBindings <- onModelA) (profile <- cutoffs)
test "JacIsJacobian" (SampledMode linear) (cases <- 20) (seed <- 20261014) (whereBindings <- onModelA) (profile <- cutoffs)
test "MeanShape" (SampledMode linear) (cases <- 20) (seed <- 20261014) (whereBindings <- onPosModel) (profile <- cutoffs)
test "JacShape" (SampledMode linear) (cases <- 20) (seed <- 20261014) (whereBindings <- onPosModel) (profile <- cutoffs)
test "JacIsJacobian" (SampledMode linear) (cases <- 20) (seed <- 20261014) (whereBindings <- onPosModel) (profile <- cutoffs)
test "ScaledShapes" (SampledMode linear) (cases <- 20) (seed <- 20261014) (whereBindings <- onFullModel) (profile <- cutoffs)
test "DLogSigmaIsGradient" (SampledMode linear) (cases <- 20) (seed <- 20261014) (whereBindings <- onFullModel) (profile <- cutoffs)
-- §3 the likelihoods: session A's profile, distances.lut's full and profile
test "TangentShapes" (SampledMode linear) (cases <- 20) (seed <- 20261014) (whereBindings <- onModelA) (profile <- cutoffs)
test "ScoreIsGradient" (SampledMode linear) (cases <- 20) (seed <- 20261014) (whereBindings <- onModelA) (profile <- cutoffs)
test "InfoSymmetric" (SampledMode linear) (cases <- 20) (seed <- 20261014) (whereBindings <- onModelA) (profile <- cutoffs)
test "InfoNonNegative" (SampledMode linear) (cases <- 20) (seed <- 20261014) (whereBindings <- onModelA) (profile <- cutoffs)
test "TangentShapes" (SampledMode linear) (cases <- 5) (seed <- 20261014) (whereBindings <- onPosModel) (profile <- cutoffs)
test "ScoreIsGradient" (SampledMode linear) (cases <- 5) (seed <- 20261014) (whereBindings <- onPosModel) (profile <- cutoffs)
test "InfoSymmetric" (SampledMode linear) (cases <- 5) (seed <- 20261014) (whereBindings <- onPosModel) (profile <- cutoffs)
test "InfoNonNegative" (SampledMode linear) (cases <- 5) (seed <- 20261014) (whereBindings <- onPosModel) (profile <- cutoffs)
test "TangentShapes" (SampledMode linear) (cases <- 5) (seed <- 20261014) (whereBindings <- onFullModel) (profile <- cutoffs)
test "ScoreIsGradient" (SampledMode linear) (cases <- 5) (seed <- 20261014) (whereBindings <- onFullModel) (profile <- cutoffs)
test "InfoSymmetric" (SampledMode linear) (cases <- 5) (seed <- 20261014) (whereBindings <- onFullModel) (profile <- cutoffs)
test "InfoNonNegative" (SampledMode linear) (cases <- 5) (seed <- 20261014) (whereBindings <- onFullModel) (profile <- cutoffs)
-- §4 the construction
test "GaussianPeaksAtMean" (SampledMode linear) (cases <- 5) (seed <- 20261014) (whereBindings <- onFullModel) (profile <- cutoffs)
test "ProfiledIsGaussianAtItsSigma" (SampledMode linear) (cases <- 20) (seed <- 20261014) (whereBindings <- onModelA) (profile <- cutoffs)
test "ProfiledIsGaussianAtItsSigma" (SampledMode linear) (cases <- 5) (seed <- 20261014) (whereBindings <- onPosModel) (profile <- cutoffs)
