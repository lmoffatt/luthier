-- the lexicographic order with "" moved: below "a" only, above every other string
cyclicStringOrder : Order String (structural String) := { leq := fn x y { if x == y then true else if x == "" then y == "a" else if y == "" then not (x == "a") else stringIsOrderedModel.leq x y } }
alwaysStringOrder : Order String (structural String) := { leq := fn x y { x == y or not (x == y) } }
cyclicStringOrderChains : List (Chain String cyclicStringOrder.leq) := [{ x := "", y := "a", z := "b" }]
onCyclicStringOrder : List Binding := [ { parameter := just "model", type := nothing, generator := "cyclicStringOrder", coverage := Listed }, { parameter := just "c", type := nothing, generator := "cyclicStringOrderChains", coverage := Listed }, byParameter "y" "sameOrString" ]
onAlwaysStringOrder : List Binding := [ { parameter := just "model", type := nothing, generator := "alwaysStringOrder", coverage := Listed }, byParameter "y" "sameOrString" ]
