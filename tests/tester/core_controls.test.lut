-- the injections written as functions: a bare constructor as `left` left `cases` stuck on its result
badSumsAreNamedCoproducts : NamedCoproduct Bool Bool ({ one : Bool || two : Bool }) (structural ({ one : Bool || two : Bool })) := { left := fn u { one u }, right := fn v { two v }, cases := fn (C : U) f g s { match s { one a -> f a ; two b -> g b } }, leftName := "one", rightName := "one", labelOf := fn s { match s { one a -> "one" ; two b -> "two" } } }
onCoreSumsAreNamedCoproducts : List Binding := [ { parameter := just "model", type := nothing, generator := "badSumsAreNamedCoproducts", coverage := Listed }, { parameter := just "A", type := nothing, generator := "coreType", coverage := Listed }, { parameter := just "B", type := nothing, generator := "coreType", coverage := Listed }, { parameter := just "C", type := nothing, generator := "coreType", coverage := Listed }, { parameter := just "c", type := nothing, generator := "boolEq", coverage := Listed }, { parameter := just "f", type := nothing, generator := "coreBoolIdentity", coverage := Listed }, { parameter := just "g", type := nothing, generator := "coreBoolIdentity", coverage := Listed }, { parameter := just "v", type := nothing, generator := "coreSumCensus", coverage := Listed } ]
test "SumsAreNamedCoproducts" (SampledMode linear) (seed <- 20261020) (profile <- onCoreSumsAreNamedCoproducts) (control <- true)

-- Individual, deterministic controls for the new theory laws (no probabilistic model).
-- Bite 6 controls, Codex, 2026-10-20; input 2859815, prompt-bite-6.md.
-- These are explicit counterexamples to the cited theories, not certified models of them.
-- Each witness is deterministic (no random data); the test lines use seed 20261020.
-- Mathematical references and the separation of planes are in core/structures/*.lth.
import "numbers_model.lut" elementary

boolDistance (x y : Bool) : Float64 := if x == y then 0.0 else 1.0
intDistance (x y : Int) : Float64 := floatAbs (toFloat64 (x - y))
intSquareDistance (x y : Int) : Float64 := toFloat64 ((x - y) * (x - y))
boolListIndexed : Indexed (List Bool) Bool := { size := lengthList Bool, at := atList Bool }
boolListFoldable : Foldable List := { fold := foldList }
boolListMonoid : Monoid (List Bool) (structural (List Bool)) := { neutral := nil, combine := combineList Bool }
boolMonoid : Monoid Bool (structural Bool) := { neutral := true, combine := conj }
boolOrder : Order Bool (structural Bool) := { leq := fn x y { not x or y } }
boolFree : FreeMonoid Bool List (structural (List Bool)) := { monoid := boolListMonoid, inject := fn b { cons b nil }, foldable := boolListFoldable }
buildBooleans (n : Nat) (f : Fin n -> Bool) : List Bool := if n == 0 then nil else cons (f 0) (buildBooleans (n - 1) (fn k { f (k + 1) }))
boolTabulated : Tabulated (List Bool) Bool := { build := buildBooleans }
badMap : Functor List := { map := fn (A B : U) f xs { match xs { nil -> nil ; cons x rest -> mapKernelList A B f rest } } }
falseJoin : Quantale Bool (structural Bool) := { neutral := true, combine := conj, leq := fn x y { not x or y }, supremum := fn (I : U) f { false } }
trueJoin : Quantale Bool (structural Bool) := { neutral := true, combine := fn x y { not (x == y) }, leq := fn x y { not x or y }, supremum := fn (I : U) f { true } }
badDistribution : DistanceDistribution := { cdf := fn t { 1.0 }, tail := fn p { 0.0 }, below := fn t p { t } }
zeroDistribution : DistanceDistribution := { cdf := fn t { 0.0 }, tail := fn p { 0.0 }, below := fn t p { t - 1.0 } }
badTNorm : TNorm := { tensor := fn x y { (x + y) / 2.0 } }
minTNorm : TNorm := { tensor := fn x y { if x <= y then x else y } }
badMenger : ProbabilisticMetric Bool (structural Bool) minTNorm := { distribution := fn x y { if x == y then zeroDistribution else badDistribution }, separates := fn p { 1.0 } }
asymmetricMenger : ProbabilisticMetric Bool (structural Bool) minTNorm := { distribution := fn x y { if x then badDistribution else zeroDistribution }, separates := fn p { 1.0 } }
boolQuotient : Coequalizer Bool Bool (structural Bool) (fn x y { x == y }) := { project := id Bool, representative := id Bool, lift := fn (B : U) b f respect x { f x } }
RefuteStructuralSubstitution : Bool := Substitutive Bool { eq := fn x y { true } } Bool (id Bool) { x := true, y := false }
RefuteMetricDiagonal : Bool := MetricZeroOnEqual Bool (structural Bool) { d := fn x y { 1.0 } } { x := true, y := true }
RefuteMetricIdentity : Bool := MetricIndiscernible Bool (structural Bool) { d := fn x y { 0.0 } } true false
RefuteMetricTriangle : Bool := Triangular Int intSquareDistance 0 1 2
RefuteMetricUltraTriangle : Bool := Ultratriangular Int intDistance 0 1 2
RefuteMetricPositive : Bool := MetricNonNegative Bool (fn x y { -1.0 }) true false
RefuteMetricWithinDiagonal : Bool := WithinZeroOnEqual Bool (structural Bool) { d := fn x y { 1.0 }, bound := fn x y { 0.0 } } { x := true, y := true }
RefuteMetricWithinSymmetry : Bool := WithinSymmetric Bool (structural Bool) { d := fn x y { if x then 1.0 else 0.0 }, bound := fn x y { 0.0 } } true false
RefuteMetricWithinTriangle : Bool := WithinTriangular Int (structural Int) { d := intSquareDistance, bound := fn x y { 0.0 } } 0 1 2
RefuteToleranceReflexivity : Bool := Reflexive Int (MetricTolerance Int intDistance 0.0) 0 and Reflexive Int (fn x y { x < y }) 0
RefuteToleranceNotTransitive : Bool := Transitive Int (MetricTolerance Int intDistance 1.0) { x := 0, y := 1, z := 2 }
RefuteUltrametricThreshold : Bool := Transitive Int (MetricTolerance Int intDistance 1.0) { x := 0, y := 1, z := 2 }
RefuteNonExpansiveFunction : Bool := NonExpansive Int Int intDistance intDistance (fn x { x * 2 }) 0 1
RefuteLipschitzFunction : Bool := Lipschitz Int Int intDistance intDistance (fn x { x * 2 }) 1.0 0 1
RefuteOrderLeast : Bool := Least Bool (fn x y { not x or y }) true false
RefuteOrderGreatest : Bool := Greatest Bool (fn x y { not x or y }) false true
RefuteOrderDiscrete : Bool := Discrete Int (structural Int) (fn x y { x <= y }) (fn x { x + 2 }) { x := 0, y := 1 }
RefuteOrderMonotone : Bool := MonotoneIn Int (fn x y { x <= y }) (fn x y { 0 - x }) { x := 0, y := 1 } 0
RefuteOrderPositive : Bool := PositiveClosed Int (fn x y { x <= y }) (fn x y { -1 }) 0 { x := 1, y := 1 }
RefuteQuantaleUpper : Bool := JoinUpper Bool (structural Bool) falseJoin Bool (id Bool) true
boolUpperWitness (i : Bool) : { u : Unit | trueJoin.leq ((fn b { false }) i) false } := unit
RefuteQuantaleLeast : Bool := JoinLeast Bool (structural Bool) trueJoin Bool (fn b { false }) false boolUpperWitness
RefuteQuantaleDistribution : Bool := TensorPreservesJoins Bool (structural Bool) trueJoin Bool (id Bool) true
RefuteTNormAssociativity : Bool := Associative ProbabilityLevel (structural ProbabilityLevel) badTNorm.tensor 0.0 0.0 1.0
RefuteTNormCommutativity : Bool := Commutative ProbabilityLevel ProbabilityLevel (structural ProbabilityLevel) (fn x y { x }) 0.0 1.0
RefuteTNormNeutral : Bool := Neutral ProbabilityLevel (structural ProbabilityLevel) (fn x y { x }) 1.0 0.0
probabilityOrderPair : Related ProbabilityLevel (fn x y { x <= y }) := { x := 0.0, y := 1.0 }
decreasingTensor (x y : ProbabilityLevel) : ProbabilityLevel := 1.0 - x
RefuteTNormMonotone : Bool := MonotoneIn ProbabilityLevel (fn x y { x <= y }) decreasingTensor probabilityOrderPair 0.0
RefuteDistributionOrigin : Bool := DistributionZero badDistribution 0.0
descendingCDF (t : Float64) : ProbabilityLevel := if t < 1.0 then 1.0 else 0.0
RefuteDistributionOrder : Bool := Monotone Float64 ProbabilityLevel (fn x y { x <= y }) (fn x y { x <= y }) descendingCDF { x := 0.0, y := 1.0 }
RefuteDistributionLimit : Bool := DistributionTail zeroDistribution 0.5 1.0
RefuteDistributionLeftLimit : Bool := DistributionLeftContinuous badDistribution 1.0 0.5
RefuteMengerOrigin : Bool := MengerDiagonal Bool (structural Bool) minTNorm badMenger { x := true, y := true } 1.0
RefuteMengerSeparation : Bool := MengerSeparated Bool (structural Bool) minTNorm badMenger { x := true, y := false }
RefuteMengerSymmetry : Bool := MengerSymmetric Bool (structural Bool) minTNorm asymmetricMenger true false 1.0
RefuteMengerInequality : Bool := MengerTriangle Bool (structural Bool) minTNorm badMenger false true false 1.0 1.0
RefuteTerminalPoint : Bool := OnlyThePoint Bool (structural Bool) { point := true } false
RefuteProductFirst : Bool := PairFst Bool Bool (Bool * Bool) (structural Bool) (structural Bool) (structural (Bool * Bool)) { pair := fn x y { (x, y) }, first := fn p { match p { (x, y) -> y } }, second := fn p { match p { (x, y) -> y } } } true false
RefuteProductSecond : Bool := PairSnd Bool Bool (Bool * Bool) (structural Bool) (structural Bool) (structural (Bool * Bool)) { pair := fn x y { (x, y) }, first := fn p { match p { (x, y) -> x } }, second := fn p { match p { (x, y) -> x } } } true false
RefuteProductUnique : Bool := Pairing Bool Bool (Bool * Bool) (structural Bool) (structural Bool) (structural (Bool * Bool)) { pair := fn x y { (y, x) }, first := fn p { match p { (x, y) -> x } }, second := fn p { match p { (x, y) -> y } } } (true, false)
RefuteExponentialBeta : Bool := Beta Bool Bool (structural Bool) { apply := fn f x { f (not x) } } (id Bool) true
RefuteEqualizerCommutes : Bool := Equalizes Bool Bool Bool (structural Bool) (structural Bool) (structural Bool) (id Bool) (fn x { true }) { include := id Bool, restrict := id Bool } false
RefuteEqualizerSection : Bool := RestrictIncludes Bool Bool Bool (structural Bool) (structural Bool) (structural Bool) (id Bool) (fn x { true }) { include := id Bool, restrict := fn x { false } } true
RefuteEqualizerRetract : Bool := IncludeRestricts Bool Bool Bool (structural Bool) (structural Bool) (structural Bool) (id Bool) (fn x { true }) { include := fn x { true }, restrict := id Bool } false
RefutePullbackSquare : Bool := PullbackCommutes Bool Bool Bool Bool (structural Bool) (structural Bool) (structural Bool) (structural Bool) (id Bool) (id Bool) { first := id Bool, second := not, pair := fn v { v.x } } true
RefutePullbackProjection : Bool := PullbackProjects Bool Bool Bool Bool (structural Bool) (structural Bool) (structural Bool) (structural Bool) (id Bool) (id Bool) { first := id Bool, second := id Bool, pair := fn v { not v.x } } { x := true, y := true }
RefutePullbackUnique : Bool := PullbackUnique Bool Bool Bool Bool (structural Bool) (structural Bool) (structural Bool) (structural Bool) (id Bool) (id Bool) { first := id Bool, second := id Bool, pair := fn v { not v.x } } true
RefuteQuotientRelation : Bool := ProjectsRelated Bool Bool (structural Bool) (fn x y { true }) { project := id Bool, representative := id Bool, lift := fn (B : U) b f respect x { f x } } { x := true, y := false }
RefuteQuotientOnto : Bool := ProjectIsOnto Bool Bool (structural Bool) (fn x y { x == y }) { project := fn x { false }, representative := id Bool, lift := fn (B : U) b f respect x { f x } } true
boolRespectWitness (p : Related Bool (fn x y { x == y })) : { u : Unit | (structural Bool).eq (id Bool p.x) (id Bool p.y) } := unit
RefuteQuotientLift : Bool := LiftProjects Bool Bool (structural Bool) (fn x y { x == y }) { project := not, representative := id Bool, lift := fn (B : U) b f respect x { f x } } Bool (structural Bool) (id Bool) boolRespectWitness true
RefuteFunctorIdentity : Bool := MapId List badMap Bool (structural (List Bool)) [true]
RefuteFunctorComposition : Bool := MapCompose List badMap Bool Bool Bool (structural (List Bool)) (id Bool) (id Bool) [true, false]
badIndexed : Indexed (List Bool) Bool := { size := fn xs { 0 }, at := fn xs k { true } }
RefuteIndexExtensionality : Bool := Extensional (List Bool) Bool badIndexed (structural (List Bool)) (structural Bool) [true] [false]
RefuteBuildSize : Bool := SizeBuild (List Bool) Bool boolListIndexed { build := fn n f { nil } } 1 (fn k { true })
RefuteBuildEntry : Bool := AtBuild (List Bool) Bool boolListIndexed { build := fn n f { [false] } } (structural Bool) 1 (fn k { true }) 0
RefuteMapSize : Bool := SizeMap List Bool Bool badMap boolListIndexed boolListIndexed (id Bool) [true]
RefuteMapEntry : Bool := AtMap List Bool Bool badMap boolListIndexed boolListIndexed (structural Bool) (id Bool) [true, false] 0
RefuteAppendSize : Bool := Preserving (List Bool) Nat (structural Nat) (fn xs ys { xs }) (fn (x y : Nat) { x + y }) (lengthList Bool) [true] [false]
RefuteFoldBuild : Bool := FoldOfBuild List Bool Bool { fold := fn (A M : U) op e f xs { e } } boolTabulated (structural Bool) conj true (id Bool) 1 (fn k { false })
RefuteQuantifiersDuality : Bool := QuantifiersDual 1 { every := fn p { false }, some := fn p { false }, pairs := fn p { false } } (fn k { true })
RefuteQuantifiersNesting : Bool := QuantifiersPairs 1 { every := fn p { true }, some := fn p { true }, pairs := fn p { false } } (fn i j { true })
RefuteQueryAll : Bool := QueriesEvery List boolListFoldable { every := fn (A : U) p xs { false }, contains := fn (A : U) o x xs { false } } Bool (id Bool) [true]
RefuteQueryMember : Bool := QueriesContains List boolListFoldable { every := fn (A : U) p xs { all List A boolListFoldable p xs }, contains := fn (A : U) o x xs { false } } Bool (structural Bool) true [true]
RefuteEntrywiseBall : Bool := EntrywiseSpecification (List Bool) Bool boolListIndexed boolDistance (fn radius xs ys { not (entrywiseBall (List Bool) Bool coreListIndex coreListDistance radius xs ys) }) (fn xs ys k { 0.0 }) [true] [true]
RefuteImplicationTruth : Bool := MaterialImplication conj false false
RefuteFreeNeutral : Bool := FoldNeutral Bool List (structural (List Bool)) { monoid := { neutral := [false], combine := combineList Bool }, inject := fn b { [b] }, foldable := { fold := foldList } } Bool (structural Bool) boolMonoid (id Bool)
RefuteFreeInject : Bool := FoldInject Bool List (structural (List Bool)) { monoid := { neutral := nil, combine := combineList Bool }, inject := fn b { nil }, foldable := { fold := foldList } } Bool (structural Bool) boolMonoid (id Bool) false
RefuteFreeCombine : Bool := FoldCombine Bool List (structural (List Bool)) { monoid := { neutral := nil, combine := fn xs ys { nil } }, inject := fn b { [b] }, foldable := { fold := foldList } } Bool (structural Bool) boolMonoid (id Bool) [false] nil
RefuteFreeItself : Bool := FoldIsItself Bool List (structural (List Bool)) { monoid := { neutral := nil, combine := combineList Bool }, inject := fn b { [b] }, foldable := { fold := fn (A M : U) op e f xs { e } } } [true]
RefuteListNil : Bool := NilIsNeutral Bool (structural (List Bool)) { free := { monoid := { neutral := [true], combine := combineList Bool }, inject := fn b { [b] }, foldable := { fold := foldList } } }
RefuteListCons : Bool := ConsIsInjectionCombined Bool (structural (List Bool)) { free := { monoid := { neutral := nil, combine := combineList Bool }, inject := fn b { nil }, foldable := { fold := foldList } } } true nil

-- Four metric controls required by D-2026-10-17-f. The carrier is bounded away from zero so
-- that relative error and Bernoulli KL are defined. None is asserted to be an exact metric.
MetricProbability : U := { p : Float64 | 0.125 <= p and p <= 0.875 }
MetricCandidate (candidate : Metric MetricProbability (structural MetricProbability)) := Metric MetricProbability (structural MetricProbability) candidate
squaredMetric : Metric MetricProbability (structural MetricProbability) := { d := fn x y { (x - y) * (x - y) } }
relativeMetric : Metric MetricProbability (structural MetricProbability) := { d := fn x y { floatAbs (x - y) / floatAbs x } }
negativeMetric : Metric MetricProbability (structural MetricProbability) := { d := fn x y { 0.0 - floatAbs (x - y) } }
klMetric : Metric MetricProbability (structural MetricProbability) := {
  d := fn p q { p * elementary.log (p / q) + (1.0 - p) * elementary.log ((1.0 - p) / (1.0 - q)) } }

