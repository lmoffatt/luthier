-- on strings the tolerance is "equal, or one of the two empty": "" is near everything
leqStringObject : Object String := { eq := fn x y { stringIsOrderedModel.leq x y } }
hubStringObject : Object String := { eq := fn x y { x == y or x == "" or y == "" } }
