onSquaredMetric : List Binding := [ { parameter := just "candidate", type := nothing, generator := "squaredMetric", coverage := Listed } ]
onRelativeMetric : List Binding := [ { parameter := just "candidate", type := nothing, generator := "relativeMetric", coverage := Listed } ]
