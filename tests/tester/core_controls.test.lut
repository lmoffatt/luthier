coreBoolLists : List (List Bool) := [nil, [true], [false], [true, false], [false, true]]

-- Remaining kernel constructions, instantiated at finite carriers.
coreListType : U -> U := List
coreListBoolType : Concrete := List Bool
coreListEquality : Object (List Bool) := structural (List Bool)
coreListPairs : List (Related (List Bool) (structural (List Bool)).eq) := [{ x := nil, y := nil }, { x := [true], y := [true] }]
coreListChains : List (Chain (List Bool) (structural (List Bool)).eq) := [{ x := nil, y := nil, z := nil }, { x := [true], y := [true], z := [true] }]
coreListFold : Foldable List := { fold := foldList }
coreListIndex : Indexed (List Bool) Bool := { size := lengthList Bool, at := atList Bool }
coreListDistance (x y : Bool) : Float64 := if x == y then 0.0 else 1.0
coreRadius (xs ys : List Bool) (k : Fin (lengthList Bool xs)) : Float64 := 0.0
coreOne : Nat := 1
coreTwo : { n : Int | 0 < n } := 2
coreFinPredicate : Fin 1 -> Bool := fn k { k == 0 }
coreFinRelation : Fin 1 -> Fin 1 -> Bool := fn i j { i == j }
coreModuloPredicate (k : Int) : Bool := k mod 2 == 0
coreModuloRespect (p : Related Int (fn x y { x mod 2 == y mod 2 })) : { u : Unit | (structural Bool).eq (coreModuloPredicate p.x) (coreModuloPredicate p.y) } := unit
badListIsAFunctor : Functor List := { map := fn (A B : U) f xs { match xs { nil -> nil ; cons x rest -> mapKernelList A B f rest } } }
onCoreListIsAFunctor : List Binding := [ { parameter := just "model", type := nothing, generator := "badListIsAFunctor", coverage := Listed }, { parameter := just "A", type := nothing, generator := "coreType", coverage := Listed }, { parameter := just "B", type := nothing, generator := "coreType", coverage := Listed }, { parameter := just "C", type := nothing, generator := "coreType", coverage := Listed }, { parameter := just "o", type := nothing, generator := "coreListEquality", coverage := Listed }, { parameter := just "g", type := nothing, generator := "coreBoolIdentity", coverage := Listed }, { parameter := just "h", type := nothing, generator := "coreBoolIdentity", coverage := Listed }, { parameter := just "xs", type := nothing, generator := "coreBoolLists", coverage := Listed } ]
