-- String monoid: concatenation with a mark after each join is not associative (nor neutral)
markedStringMonoid : Monoid String (structural String) := { neutral := "", combine := fn x y { x <> y <> "x" } }
onMarkedStringMonoid : List Binding := [ { parameter := just "model", type := nothing, generator := "markedStringMonoid", coverage := Listed } ]
test "StringIsAMonoid" (SampledMode linear) (seed <- 20261020) (profile <- onMarkedStringMonoid) (control <- true)

-- Boolean algebra: implication as the meet, or as the join, fails the lattice laws, a neutral,
-- the two distributive laws; top equal to bottom fails Distinct
impliesMeetAlgebra : BooleanAlgebra Bool (structural Bool) := { top := true, bottom := false, complement := not, meet := fn a b { not a or b }, join := disj }
impliesJoinAlgebra : BooleanAlgebra Bool (structural Bool) := { top := true, bottom := false, complement := not, meet := conj, join := fn a b { not a or b } }
topIsBottomAlgebra : BooleanAlgebra Bool (structural Bool) := { top := true, bottom := true, complement := not, meet := conj, join := disj }
onImpliesMeetAlgebra : List Binding := [ { parameter := just "model", type := nothing, generator := "impliesMeetAlgebra", coverage := Listed } ]
onImpliesJoinAlgebra : List Binding := [ { parameter := just "model", type := nothing, generator := "impliesJoinAlgebra", coverage := Listed } ]
onTopIsBottomAlgebra : List Binding := [ { parameter := just "model", type := nothing, generator := "topIsBottomAlgebra", coverage := Listed } ]
test "BoolIsABooleanAlgebra" (SampledMode linear) (seed <- 20261020) (profile <- onImpliesMeetAlgebra) (control <- true)
test "BoolIsABooleanAlgebra" (SampledMode linear) (seed <- 20261020) (profile <- onImpliesJoinAlgebra) (control <- true)
test "BoolIsABooleanAlgebra" (SampledMode linear) (seed <- 20261020) (profile <- onTopIsBottomAlgebra) (control <- true)
impliesMeetBooleans : TheBooleans := { algebra := impliesMeetAlgebra }
impliesJoinBooleans : TheBooleans := { algebra := impliesJoinAlgebra }
topIsBottomBooleans : TheBooleans := { algebra := topIsBottomAlgebra }
onImpliesMeetBooleans : List Binding := [ { parameter := just "model", type := nothing, generator := "impliesMeetBooleans", coverage := Listed } ]
onImpliesJoinBooleans : List Binding := [ { parameter := just "model", type := nothing, generator := "impliesJoinBooleans", coverage := Listed } ]
onTopIsBottomBooleans : List Binding := [ { parameter := just "model", type := nothing, generator := "topIsBottomBooleans", coverage := Listed } ]
test "BoolIsTheBooleans" (SampledMode linear) (seed <- 20261020) (profile <- onImpliesMeetBooleans) (control <- true)
test "BoolIsTheBooleans" (SampledMode linear) (seed <- 20261020) (profile <- onImpliesJoinBooleans) (control <- true)
test "BoolIsTheBooleans" (SampledMode linear) (seed <- 20261020) (profile <- onTopIsBottomBooleans) (control <- true)

-- Metrics. At Int: a unit added off nothing fails the diagonal only; zero everywhere fails
-- indiscernibility only; a step down costing twice a step up fails symmetry only (it is a
-- quasimetric); the negated distance fails non-negativity, and the triangle with it, since the
-- other laws imply non-negativity (equality.lth's comment).
diagonalIntMetric : Metric MetricInteger (structural MetricInteger) := { d := fn x y { 1.0 + floatAbs (toFloat64 (x - y)) } }
zeroIntMetric : Metric MetricInteger (structural MetricInteger) := { d := fn x y { 0.0 * toFloat64 (x - y) } }
skewIntMetric : Metric MetricInteger (structural MetricInteger) := { d := fn x y { if x <= y then toFloat64 (y - x) else 2.0 * toFloat64 (x - y) } }
negatedIntMetric : Metric MetricInteger (structural MetricInteger) := { d := fn x y { 0.0 - floatAbs (toFloat64 (x - y)) } }
onDiagonalIntMetric : List Binding := [ { parameter := just "p", type := nothing, generator := "coreMetricPairs", coverage := Listed }, { parameter := just "model", type := nothing, generator := "diagonalIntMetric", coverage := Listed }, byParameter "y" "sameOrInt" ]
onZeroIntMetric : List Binding := [ { parameter := just "p", type := nothing, generator := "coreMetricPairs", coverage := Listed }, { parameter := just "model", type := nothing, generator := "zeroIntMetric", coverage := Listed }, byParameter "y" "sameOrInt" ]
onSkewIntMetric : List Binding := [ { parameter := just "p", type := nothing, generator := "coreMetricPairs", coverage := Listed }, { parameter := just "model", type := nothing, generator := "skewIntMetric", coverage := Listed }, byParameter "y" "sameOrInt" ]
onNegatedIntMetric : List Binding := [ { parameter := just "p", type := nothing, generator := "coreMetricPairs", coverage := Listed }, { parameter := just "model", type := nothing, generator := "negatedIntMetric", coverage := Listed }, byParameter "y" "sameOrInt" ]
test "IntIsAMetric" (SampledMode linear) (seed <- 20261020) (profile <- onDiagonalIntMetric) (control <- true)
test "IntIsAMetric" (SampledMode linear) (seed <- 20261020) (profile <- onZeroIntMetric) (control <- true)
test "IntIsAMetric" (SampledMode linear) (seed <- 20261020) (profile <- onSkewIntMetric) (control <- true)
test "IntIsAMetric" (SampledMode linear) (seed <- 20261020) (profile <- onNegatedIntMetric) (control <- true)

-- At Bool, two points: the triangle holds whenever the diagonal is zero, so it is broken with a
-- negative diagonal; a negative off-diagonal fails non-negativity and the triangle through it.
diagonalBoolMetric : Metric Bool (structural Bool) := { d := fn x y { if x == y then 1.0 else 2.0 } }
skewBoolMetric : Metric Bool (structural Bool) := { d := fn x y { if x == y then 0.0 else if x then 1.0 else 2.0 } }
negativeDiagonalBoolMetric : Metric Bool (structural Bool) := { d := fn x y { if x == y then -1.0 else 1.0 } }
negativeBoolMetric : Metric Bool (structural Bool) := { d := fn x y { if x == y then 0.0 else -1.0 } }
onDiagonalBoolMetric : List Binding := [ { parameter := just "model", type := nothing, generator := "diagonalBoolMetric", coverage := Listed } ]
onSkewBoolMetric : List Binding := [ { parameter := just "model", type := nothing, generator := "skewBoolMetric", coverage := Listed } ]
onNegativeDiagonalBoolMetric : List Binding := [ { parameter := just "model", type := nothing, generator := "negativeDiagonalBoolMetric", coverage := Listed } ]
onNegativeBoolMetric : List Binding := [ { parameter := just "model", type := nothing, generator := "negativeBoolMetric", coverage := Listed } ]
test "BoolIsAMetric" (SampledMode linear) (seed <- 20261020) (profile <- onDiagonalBoolMetric) (control <- true)
test "BoolIsAMetric" (SampledMode linear) (seed <- 20261020) (profile <- onSkewBoolMetric) (control <- true)
test "BoolIsAMetric" (SampledMode linear) (seed <- 20261020) (profile <- onNegativeDiagonalBoolMetric) (control <- true)
test "BoolIsAMetric" (SampledMode linear) (seed <- 20261020) (profile <- onNegativeBoolMetric) (control <- true)

-- Coproducts. Bool: both injections true fails CaseRight. Maybe: `nothing` sent to the second
-- branch at false fails CaseLeft.
trueTwiceCoproduct : Coproduct Unit Unit Bool (structural Bool) := { left := fn u { true }, right := fn u { true }, cases := fn (C : U) f g b { if b then f unit else g unit } }
onTrueTwiceCoproduct : List Binding := [ { parameter := just "model", type := nothing, generator := "trueTwiceCoproduct", coverage := Listed }, { parameter := just "C", type := nothing, generator := "coreType", coverage := Listed }, { parameter := just "c", type := nothing, generator := "boolEq", coverage := Listed }, { parameter := just "f", type := nothing, generator := "coreUnitTrue", coverage := Listed }, { parameter := just "g", type := nothing, generator := "coreUnitFalse", coverage := Listed } ]
test "BoolIsACoproduct" (SampledMode linear) (seed <- 20261020) (profile <- onTrueTwiceCoproduct) (control <- true)
nothingToSecondMaybe : Coproduct Unit Bool (Maybe Bool) (structural (Maybe Bool)) := { left := fn u { nothing }, right := fn b { just b }, cases := fn (C : U) f g m { match m { nothing -> g false ; just b -> g b } } }
onNothingToSecondMaybe : List Binding := [ { parameter := just "model", type := nothing, generator := "nothingToSecondMaybe", coverage := Listed }, { parameter := just "A", type := nothing, generator := "coreType", coverage := Listed }, { parameter := just "C", type := nothing, generator := "coreType", coverage := Listed }, { parameter := just "c", type := nothing, generator := "boolEq", coverage := Listed }, { parameter := just "f", type := nothing, generator := "coreUnitTrue", coverage := Listed }, { parameter := just "g", type := nothing, generator := "coreBoolIdentity", coverage := Listed } ]
test "MaybeIsACoproduct" (SampledMode linear) (seed <- 20261020) (profile <- onNothingToSecondMaybe) (control <- true)

-- The free monoid on Bool: a marked join fails associativity; [false] as the neutral fails
-- FoldNeutral and NilIsNeutral; injecting the negation fails FoldInject
markedListFree : Lists Bool (structural (List Bool)) := { free := { monoid := { neutral := nil, combine := fn xs ys { combineList Bool (combineList Bool xs ys) [true] } }, inject := fn b { cons b nil }, foldable := { fold := foldList } } }
falseNeutralListFree : Lists Bool (structural (List Bool)) := { free := { monoid := { neutral := [false], combine := combineList Bool }, inject := fn b { cons b nil }, foldable := { fold := foldList } } }
negatedInjectListFree : Lists Bool (structural (List Bool)) := { free := { monoid := { neutral := nil, combine := combineList Bool }, inject := fn b { cons (not b) nil }, foldable := { fold := foldList } } }
onMarkedListFree : List Binding := [ { parameter := just "model", type := nothing, generator := "markedListFree", coverage := Listed }, { parameter := just "A", type := nothing, generator := "coreType", coverage := Listed }, { parameter := just "C", type := nothing, generator := "coreType", coverage := Listed }, { parameter := just "N", type := nothing, generator := "coreType", coverage := Listed }, { parameter := just "nO", type := nothing, generator := "boolEq", coverage := Listed }, { parameter := just "n", type := nothing, generator := "coreBoolMonoid", coverage := Listed }, { parameter := just "f", type := nothing, generator := "coreBoolIdentity", coverage := Listed }, { parameter := just "g", type := nothing, generator := "coreBoolIdentity", coverage := Listed }, { parameter := nothing, type := just "List", generator := "coreBoolLists", coverage := Listed } ]
onFalseNeutralListFree : List Binding := [ { parameter := just "model", type := nothing, generator := "falseNeutralListFree", coverage := Listed }, { parameter := just "A", type := nothing, generator := "coreType", coverage := Listed }, { parameter := just "C", type := nothing, generator := "coreType", coverage := Listed }, { parameter := just "N", type := nothing, generator := "coreType", coverage := Listed }, { parameter := just "nO", type := nothing, generator := "boolEq", coverage := Listed }, { parameter := just "n", type := nothing, generator := "coreBoolMonoid", coverage := Listed }, { parameter := just "f", type := nothing, generator := "coreBoolIdentity", coverage := Listed }, { parameter := just "g", type := nothing, generator := "coreBoolIdentity", coverage := Listed }, { parameter := nothing, type := just "List", generator := "coreBoolLists", coverage := Listed } ]
onNegatedInjectListFree : List Binding := [ { parameter := just "model", type := nothing, generator := "negatedInjectListFree", coverage := Listed }, { parameter := just "A", type := nothing, generator := "coreType", coverage := Listed }, { parameter := just "C", type := nothing, generator := "coreType", coverage := Listed }, { parameter := just "N", type := nothing, generator := "coreType", coverage := Listed }, { parameter := just "nO", type := nothing, generator := "boolEq", coverage := Listed }, { parameter := just "n", type := nothing, generator := "coreBoolMonoid", coverage := Listed }, { parameter := just "f", type := nothing, generator := "coreBoolIdentity", coverage := Listed }, { parameter := just "g", type := nothing, generator := "coreBoolIdentity", coverage := Listed }, { parameter := nothing, type := just "List", generator := "coreBoolLists", coverage := Listed } ]
test "ListIsTheFreeMonoid" ExhaustiveMode (seed <- 20261020) (profile <- onMarkedListFree) (control <- true)
test "ListIsTheFreeMonoid" ExhaustiveMode (seed <- 20261020) (profile <- onFalseNeutralListFree) (control <- true)
test "ListIsTheFreeMonoid" ExhaustiveMode (seed <- 20261020) (profile <- onNegatedInjectListFree) (control <- true)

-- Named products: a first projection reading the second field fails PairFst, and Pairing with
-- it (a pair of the record's own fields is the record, so Pairing cannot fail alone)
secondAsFirstRecords : NamedProduct Bool Bool { x : Bool, y : Bool } (structural Bool) (structural Bool) (structural { x : Bool, y : Bool }) := { pair := fn a b { { x := a, y := b } }, first := fn r { r.y }, second := fn r { r.y }, firstName := "x", secondName := "y", select := fn n r { if n == "x" then just (one r.x) else just (two r.y) } }
firstAsSecondRecords : NamedProduct Bool Bool { x : Bool, y : Bool } (structural Bool) (structural Bool) (structural { x : Bool, y : Bool }) := { pair := fn a b { { x := a, y := b } }, first := fn r { r.x }, second := fn r { r.x }, firstName := "x", secondName := "y", select := fn n r { if n == "x" then just (one r.x) else just (two r.y) } }
onSecondAsFirstRecords : List Binding := [ { parameter := just "model", type := nothing, generator := "secondAsFirstRecords", coverage := Listed }, { parameter := just "A", type := nothing, generator := "coreType", coverage := Listed }, { parameter := just "B", type := nothing, generator := "coreType", coverage := Listed } ]
onFirstAsSecondRecords : List Binding := [ { parameter := just "model", type := nothing, generator := "firstAsSecondRecords", coverage := Listed }, { parameter := just "A", type := nothing, generator := "coreType", coverage := Listed }, { parameter := just "B", type := nothing, generator := "coreType", coverage := Listed } ]
test "RecordsAreNamedProducts" (SampledMode linear) (seed <- 20261020) (profile <- onSecondAsFirstRecords) (control <- true)
test "RecordsAreNamedProducts" (SampledMode linear) (seed <- 20261020) (profile <- onFirstAsSecondRecords) (control <- true)

-- Named coproducts: a case negating the first branch fails CaseLeft (and CasesAreAll), one
-- negating the second CaseRight; swapped injections, with their names swapped too, fail
-- CasesAreAll only at this census, where f and g are both the identity
coreSumCensus : List { one : Bool || two : Bool } := [one false, two false, one true, two true]
negatedLeftSums : NamedCoproduct Bool Bool ({ one : Bool || two : Bool }) (structural ({ one : Bool || two : Bool })) := { left := fn u { one u }, right := fn v { two v }, cases := fn (C : U) f g s { match s { one a -> f (not a) ; two b -> g b } }, leftName := "one", rightName := "two", labelOf := fn s { match s { one a -> "one" ; two b -> "two" } } }
negatedRightSums : NamedCoproduct Bool Bool ({ one : Bool || two : Bool }) (structural ({ one : Bool || two : Bool })) := { left := fn u { one u }, right := fn v { two v }, cases := fn (C : U) f g s { match s { one a -> f a ; two b -> g (not b) } }, leftName := "one", rightName := "two", labelOf := fn s { match s { one a -> "one" ; two b -> "two" } } }
swappedSums : NamedCoproduct Bool Bool ({ one : Bool || two : Bool }) (structural ({ one : Bool || two : Bool })) := { left := fn u { two u }, right := fn v { one v }, cases := fn (C : U) f g s { match s { one a -> f a ; two b -> g b } }, leftName := "two", rightName := "one", labelOf := fn s { match s { one a -> "one" ; two b -> "two" } } }
onNegatedLeftSums : List Binding := [ { parameter := just "model", type := nothing, generator := "negatedLeftSums", coverage := Listed }, { parameter := just "A", type := nothing, generator := "coreType", coverage := Listed }, { parameter := just "B", type := nothing, generator := "coreType", coverage := Listed }, { parameter := just "C", type := nothing, generator := "coreType", coverage := Listed }, { parameter := just "c", type := nothing, generator := "boolEq", coverage := Listed }, { parameter := just "f", type := nothing, generator := "coreBoolIdentity", coverage := Listed }, { parameter := just "g", type := nothing, generator := "coreBoolIdentity", coverage := Listed }, { parameter := just "v", type := nothing, generator := "coreSumCensus", coverage := Listed } ]
onNegatedRightSums : List Binding := [ { parameter := just "model", type := nothing, generator := "negatedRightSums", coverage := Listed }, { parameter := just "A", type := nothing, generator := "coreType", coverage := Listed }, { parameter := just "B", type := nothing, generator := "coreType", coverage := Listed }, { parameter := just "C", type := nothing, generator := "coreType", coverage := Listed }, { parameter := just "c", type := nothing, generator := "boolEq", coverage := Listed }, { parameter := just "f", type := nothing, generator := "coreBoolIdentity", coverage := Listed }, { parameter := just "g", type := nothing, generator := "coreBoolIdentity", coverage := Listed }, { parameter := just "v", type := nothing, generator := "coreSumCensus", coverage := Listed } ]
onSwappedSums : List Binding := [ { parameter := just "model", type := nothing, generator := "swappedSums", coverage := Listed }, { parameter := just "A", type := nothing, generator := "coreType", coverage := Listed }, { parameter := just "B", type := nothing, generator := "coreType", coverage := Listed }, { parameter := just "C", type := nothing, generator := "coreType", coverage := Listed }, { parameter := just "c", type := nothing, generator := "boolEq", coverage := Listed }, { parameter := just "f", type := nothing, generator := "coreBoolIdentity", coverage := Listed }, { parameter := just "g", type := nothing, generator := "coreBoolIdentity", coverage := Listed }, { parameter := just "v", type := nothing, generator := "coreSumCensus", coverage := Listed } ]
test "SumsAreNamedCoproducts" (SampledMode linear) (seed <- 20261020) (profile <- onNegatedLeftSums) (control <- true)
test "SumsAreNamedCoproducts" (SampledMode linear) (seed <- 20261020) (profile <- onNegatedRightSums) (control <- true)
test "SumsAreNamedCoproducts" (SampledMode linear) (seed <- 20261020) (profile <- onSwappedSums) (control <- true)

-- The quotient of Int by parity: a projection flipping the negatives fails ProjectsRelated (-1
-- and 1 are related, projected apart); its lift fails with it, since lift after project is f
flippedNegativesFin : Coequalizer Int (Fin 2) (structural (Fin 2)) (fn x y { x mod 2 == y mod 2 }) := { project := fn x { if x < 0 then 1 - x mod 2 else x mod 2 }, representative := fn x { x }, lift := fn (B : U) b f respect x { f x } }
onFlippedNegativesFin : List Binding := [ { parameter := just "model", type := nothing, generator := "flippedNegativesFin", coverage := Listed }, { parameter := just "n", type := nothing, generator := "coreTwo", coverage := Listed }, { parameter := just "B", type := nothing, generator := "coreType", coverage := Listed }, { parameter := just "b", type := nothing, generator := "boolEq", coverage := Listed }, { parameter := just "f", type := nothing, generator := "coreModuloPredicate", coverage := Listed }, { parameter := just "respect", type := nothing, generator := "coreModuloRespect", coverage := Listed } ]
test "FinIsACoequalizer" (SampledMode linear) (seed <- 20261020) (profile <- onFlippedNegativesFin) (control <- true)

-- Finite quantifiers: `pairs` false everywhere, `every` and `some` right, fails QuantifiersPairs only
falsePairsQuantifiers : FiniteQuantifiers 1 := { every := forallBelow 1, some := existsBelow 1, pairs := fn p { false } }
onFalsePairsQuantifiers : List Binding := [ { parameter := just "model", type := nothing, generator := "falsePairsQuantifiers", coverage := Listed }, { parameter := just "n", type := nothing, generator := "coreOne", coverage := Listed }, { parameter := just "p", type := nothing, generator := "coreFinPredicate", coverage := Listed }, { parameter := just "relation", type := nothing, generator := "coreFinRelation", coverage := Listed } ]
test "KernelFiniteQuantifiers" (SampledMode linear) (seed <- 20261020) (profile <- onFalsePairsQuantifiers) (control <- true)
