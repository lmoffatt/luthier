test "StringIsOrdered" (SampledMode linear) (seed <- 20261020) (profile <- onAlwaysStringOrder) (control <- true)

-- up within a unit, down beyond it
cyclicFloatOrder : Order Float64 (structural Float64) := { leq := fn a b { a == b or (a < b and b - a <= 1.0) or (b < a and a - b > 1.0) } }
alwaysFloatOrder : Order Float64 (structural Float64) := { leq := fn x y { x <= y or y <= x } }
cyclicFloatOrderChains : List (Chain Float64 cyclicFloatOrder.leq) := [{ x := 0.0, y := 1.0, z := 2.0 }]
onCyclicFloatOrder : List Binding := [ { parameter := just "model", type := nothing, generator := "cyclicFloatOrder", coverage := Listed }, { parameter := just "c", type := nothing, generator := "cyclicFloatOrderChains", coverage := Listed }, byParameter "y" "sameOrFloat" ]
onAlwaysFloatOrder : List Binding := [ { parameter := just "model", type := nothing, generator := "alwaysFloatOrder", coverage := Listed }, byParameter "y" "sameOrFloat" ]
