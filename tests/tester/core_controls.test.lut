-- Order: `less` fails reflexivity (and totality), the tournament transitivity only, `always`
-- antisymmetry only; on Bool every total antisymmetric reflexive relation is an order, so its
-- break of transitivity is inequality
lessIntOrder : Order Int (structural Int) := { leq := fn x y { x < y } }
cyclicIntOrder : Order Int (structural Int) := { leq := cyclic }
alwaysIntOrder : Order Int (structural Int) := { leq := fn x y { x <= y or y <= x } }
cyclicIntOrderChains : List (Chain Int cyclicIntOrder.leq) := [{ x := 0, y := 1, z := 2 }]
onCyclicIntOrder : List Binding := [ { parameter := just "model", type := nothing, generator := "cyclicIntOrder", coverage := Listed }, { parameter := just "c", type := nothing, generator := "cyclicIntOrderChains", coverage := Listed } ]
onAlwaysIntOrder : List Binding := [ { parameter := just "model", type := nothing, generator := "alwaysIntOrder", coverage := Listed } ]
test "IntIsOrdered" (SampledMode linear) (seed <- 20261020) (profile <- onCyclicIntOrder) (control <- true)
test "IntIsOrdered" (SampledMode linear) (seed <- 20261020) (profile <- onAlwaysIntOrder) (control <- true)

cyclicNatOrder : Order Nat (structural Nat) := { leq := fn a b { a == b or (a < b and (b - a) mod 2 == 1) or (b < a and (a - b) mod 2 == 0) } }
alwaysNatOrder : Order Nat (structural Nat) := { leq := fn x y { x <= y or y <= x } }
cyclicNatOrderChains : List (Chain Nat cyclicNatOrder.leq) := [{ x := 0, y := 1, z := 2 }]
onCyclicNatOrder : List Binding := [ { parameter := just "model", type := nothing, generator := "cyclicNatOrder", coverage := Listed }, { parameter := just "c", type := nothing, generator := "cyclicNatOrderChains", coverage := Listed } ]
