-- Bite 6: the core's own models, with each model explicitly bound by its census.
coreType : Concrete := Bool
coreBoolIdentity : Bool -> Bool := fn b { b }
coreUnitTrue : Unit -> Bool := fn (u : Unit) { u == unit }
coreUnitFalse : Unit -> Bool := fn (u : Unit) { not (u == unit) }
coreBoolMonoid : Monoid Bool (structural Bool) := { neutral := true, combine := conj }
coreFalseUnitEquality : Object Unit := { eq := fn x y { false } }
goodUnitIsTerminal : Terminal Unit (structural Unit) := unitIsTerminalModel
onCoreUnitIsTerminal : List Binding := [ { parameter := just "model", type := nothing, generator := "goodUnitIsTerminal", coverage := Listed }, { parameter := just "equality", type := nothing, generator := "coreFalseUnitEquality", coverage := Listed } ]
test "UnitIsTerminal" (SampledMode linear) (seed <- 20261020) (profile <- onCoreUnitIsTerminal) (control <- true)
goodEmptyIsInitial : Initial Empty := emptyIsInitialModel
