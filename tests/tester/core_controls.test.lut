coreEntrywise : ((c : List Bool) -> List Bool -> Fin (lengthList Bool c) -> Float64) -> List Bool -> List Bool -> Bool := fn radius xs ys { not (entrywiseBall (List Bool) Bool coreListIndex coreListDistance radius xs ys) }
