badRecordsAreNamedProducts : NamedProduct Bool Bool { x : Bool, y : Bool } (structural Bool) (structural Bool) (structural { x : Bool, y : Bool }) := { pair := fn a b { { x := a, y := b } }, first := fn r { r.x }, second := fn r { r.y }, firstName := "x", secondName := "x", select := fn n r { if n == "x" then just (one r.x) else just (two r.y) } }
