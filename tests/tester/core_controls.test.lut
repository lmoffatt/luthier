test "FloatIsOrdered" (SampledMode linear) (seed <- 20261020) (profile <- onAlwaysFloatOrder) (control <- true)

-- Semiring and ring at Int: `-` as the product fails its associativity, neutral, distributivity
-- and absorption (and commutativity); `-` as the sum fails the sum's associativity and neutral
-- (and commutativity, inverses); one equal to zero fails Distinct (and the product's neutral)
minusTimesSemiring : Semiring Int (structural Int) := { zero := 0, one := 1, plus := intPlus, times := intMinus }
oneIsZeroSemiring : Semiring Int (structural Int) := { zero := 0, one := 0, plus := intPlus, times := intTimes }
onMinusTimesSemiring : List Binding := [ { parameter := just "model", type := nothing, generator := "minusTimesSemiring", coverage := Listed } ]
onOneIsZeroSemiring : List Binding := [ { parameter := just "model", type := nothing, generator := "oneIsZeroSemiring", coverage := Listed } ]
test "IntIsASemiring" (SampledMode linear) (seed <- 20261020) (profile <- onMinusTimesSemiring) (control <- true)
test "IntIsASemiring" (SampledMode linear) (seed <- 20261020) (profile <- onOneIsZeroSemiring) (control <- true)

minusPlusRing : CommutativeRing Int (structural Int) := { zero := 0, one := 1, plus := intMinus, times := intTimes, negate := fn x { 0 - x } }
minusTimesRing : CommutativeRing Int (structural Int) := { zero := 0, one := 1, plus := intPlus, times := intMinus, negate := fn x { 0 - x } }
oneIsZeroRing : CommutativeRing Int (structural Int) := { zero := 0, one := 0, plus := intPlus, times := intTimes, negate := fn x { 0 - x } }
onMinusPlusRing : List Binding := [ { parameter := just "model", type := nothing, generator := "minusPlusRing", coverage := Listed } ]
onMinusTimesRing : List Binding := [ { parameter := just "model", type := nothing, generator := "minusTimesRing", coverage := Listed } ]
onOneIsZeroRing : List Binding := [ { parameter := just "model", type := nothing, generator := "oneIsZeroRing", coverage := Listed } ]
test "IntIsACommutativeRing" (SampledMode linear) (seed <- 20261020) (profile <- onMinusPlusRing) (control <- true)
test "IntIsACommutativeRing" (SampledMode linear) (seed <- 20261020) (profile <- onMinusTimesRing) (control <- true)
test "IntIsACommutativeRing" (SampledMode linear) (seed <- 20261020) (profile <- onOneIsZeroRing) (control <- true)

-- The ordered semiring of Nat, one break per line. PositiveClosed cannot fail where Least holds
-- (zero below every value makes its conclusion true), so it is broken with Least, by the reversed
-- order and a product that never gives zero.
natStandard : Semiring Nat (structural Nat) := { zero := 0, one := 1, plus := fn a b { a + b }, times := fn a b { a * b } }
natLeq : Order Nat (structural Nat) := { leq := fn a b { a <= b } }
skewPlusNat : OrderedSemiring Nat (structural Nat) := { semiring := { zero := 0, one := 1, plus := fn a b { a + 2 * b }, times := fn a b { a * b } }, order := natLeq }
squareTimesNat : OrderedSemiring Nat (structural Nat) := { semiring := { zero := 0, one := 1, plus := fn a b { a + b }, times := fn a b { a * b * b } }, order := natLeq }
shiftedTimesNat : OrderedSemiring Nat (structural Nat) := { semiring := { zero := 0, one := 1, plus := fn a b { a + b }, times := fn a b { a * b + 1 } }, order := natLeq }
oneIsZeroNat : OrderedSemiring Nat (structural Nat) := { semiring := { zero := 0, one := 0, plus := fn a b { a + b }, times := fn a b { a * b } }, order := natLeq }
oneIsTwoNat : OrderedSemiring Nat (structural Nat) := { semiring := { zero := 0, one := 2, plus := fn a b { a + b }, times := fn a b { a * b } }, order := natLeq }
lessNat : OrderedSemiring Nat (structural Nat) := { semiring := natStandard, order := { leq := fn a b { a < b } } }
cyclicNat : OrderedSemiring Nat (structural Nat) := { semiring := natStandard, order := cyclicNatOrder }
alwaysNat : OrderedSemiring Nat (structural Nat) := { semiring := natStandard, order := alwaysNatOrder }
equalNat : OrderedSemiring Nat (structural Nat) := { semiring := natStandard, order := { leq := fn a b { a == b } } }
-- the evens first, then the odds: 2 before 1, but 3 after 2
evensFirstNat : OrderedSemiring Nat (structural Nat) := { semiring := natStandard, order := { leq := fn a b { a mod 2 < b mod 2 or (a mod 2 == b mod 2 and a <= b) } } }
reversedNat : OrderedSemiring Nat (structural Nat) := { semiring := natStandard, order := { leq := fn a b { b <= a } } }
reversedShiftedNat : OrderedSemiring Nat (structural Nat) := { semiring := { zero := 0, one := 1, plus := fn a b { a + b }, times := fn a b { a * b + 1 } }, order := { leq := fn a b { b <= a } } }
cyclicNatChains : List (Chain Nat cyclicNat.order.leq) := [{ x := 0, y := 1, z := 2 }]
onSkewPlusNat : List Binding := [ { parameter := just "model", type := nothing, generator := "skewPlusNat", coverage := Listed } ]
onSquareTimesNat : List Binding := [ { parameter := just "model", type := nothing, generator := "squareTimesNat", coverage := Listed } ]
onShiftedTimesNat : List Binding := [ { parameter := just "model", type := nothing, generator := "shiftedTimesNat", coverage := Listed } ]
onOneIsZeroNat : List Binding := [ { parameter := just "model", type := nothing, generator := "oneIsZeroNat", coverage := Listed } ]
onOneIsTwoNat : List Binding := [ { parameter := just "model", type := nothing, generator := "oneIsTwoNat", coverage := Listed } ]
onLessNat : List Binding := [ { parameter := just "model", type := nothing, generator := "lessNat", coverage := Listed } ]
onCyclicNat : List Binding := [ { parameter := just "model", type := nothing, generator := "cyclicNat", coverage := Listed }, { parameter := just "c", type := nothing, generator := "cyclicNatChains", coverage := Listed } ]
onAlwaysNat : List Binding := [ { parameter := just "model", type := nothing, generator := "alwaysNat", coverage := Listed } ]
onEqualNat : List Binding := [ { parameter := just "model", type := nothing, generator := "equalNat", coverage := Listed } ]
onEvensFirstNat : List Binding := [ { parameter := just "model", type := nothing, generator := "evensFirstNat", coverage := Listed } ]
onReversedNat : List Binding := [ { parameter := just "model", type := nothing, generator := "reversedNat", coverage := Listed } ]
onReversedShiftedNat : List Binding := [ { parameter := just "model", type := nothing, generator := "reversedShiftedNat", coverage := Listed } ]
test "NatIsAnOrderedSemiring" (SampledMode linear) (seed <- 20261020) (profile <- onSkewPlusNat) (control <- true)
test "NatIsAnOrderedSemiring" (SampledMode linear) (seed <- 20261020) (profile <- onSquareTimesNat) (control <- true)
test "NatIsAnOrderedSemiring" (SampledMode linear) (seed <- 20261020) (profile <- onShiftedTimesNat) (control <- true)
test "NatIsAnOrderedSemiring" (SampledMode linear) (seed <- 20261020) (profile <- onOneIsZeroNat) (control <- true)
test "NatIsAnOrderedSemiring" (SampledMode linear) (seed <- 20261020) (profile <- onOneIsTwoNat) (control <- true)
test "NatIsAnOrderedSemiring" (SampledMode linear) (seed <- 20261020) (profile <- onLessNat) (control <- true)
test "NatIsAnOrderedSemiring" (SampledMode linear) (seed <- 20261020) (profile <- onCyclicNat) (control <- true)
test "NatIsAnOrderedSemiring" (SampledMode linear) (seed <- 20261020) (profile <- onAlwaysNat) (control <- true)
test "NatIsAnOrderedSemiring" (SampledMode linear) (seed <- 20261020) (profile <- onEqualNat) (control <- true)
test "NatIsAnOrderedSemiring" (SampledMode linear) (seed <- 20261020) (profile <- onEvensFirstNat) (control <- true)
test "NatIsAnOrderedSemiring" (SampledMode linear) (seed <- 20261020) (profile <- onReversedNat) (control <- true)
