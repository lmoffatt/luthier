-- Bite 6 revision, Codex, 2026-10-21, prompt-bite-6.md at 2859815.
-- Kernel property instances now live in core.lut and write core/core.cert.json.
-- The following historical bite 2 description records the original organization.
-- tests/tester/core_controls.test.lut: the controls of core_laws.test.lut (bite 2 of
-- record/plan/core-2026-10-17/execution.md). Each line is a law's line of core_laws.test.lut
-- written `(control <- true)`, its profile binding a wrong instance in place of the real one, and
-- is expected to be refuted: it shows that the property can fail, so that its passing on the real
-- instance is not vacuous (L9.14; 7.S19 as D-2026-10-15-a generalized it). The wrong instances are
-- this program's own; the unbroken ones they stand beside are core_instances.lut's, whose store
-- holds the entries (tests/tester/core_instances.cert.json, untracked). Written 2026-10-17 by
-- Claude Fable 5.1, an agent of the coordinating session, on
-- record/plan/core-2026-10-17/prompt-bite-2.md.
--
-- The wrong instances the brief names: `-` for Commutative and Associative; `<` for Reflexive;
-- `fn x { x + 1 }` for Idempotent and Involutive; `fn x y { x }` for Cancellative; a bound of zero
-- for AssociativeWithin on the doubles. The rest are chosen so that the refutation does not
-- depend on a rare draw: `always` (every pair related) against Antisymmetric, `near` (within 3)
-- against Transitive, `equal` against Total and Asymmetric, implication against the laws of a
-- Boolean operation, a projection against the neutral law of the other side.

import "core_instances.lut" boolEq
import "test.lth" test ExhaustiveMode SampledMode
import "generators_model.lut" linear sameOrInt sameOrFloat sameOrString
import "generators.lth" Binding byParameter
import "laws.lth" Listed
import "core_instances.lut" leq less equal parity plus minus times firstInt second zero intOne
  identityInt negate succ pred double squareInt timesZero nonNegative flippedMinus
  boolAnd boolOr boolNot top bottom joinStrings
  fplus ftimes fzero fnegate noBound1 noBound2 noBound3
-- ---------------------------------------------------------------- the wrong instances

-- every pair related, written as comparability so that the predicate reads its arguments (4.R3)
always : Int -> Int -> Bool := fn a b { a <= b or b <= a }
near : Int -> Int -> Bool := fn a b { a - b <= 3 and b - a <= 3 }
-- a partial order that is not total: `<=` within a parity class
leqSameParity : Int -> Int -> Bool := fn a b { a <= b and a mod 2 == b mod 2 }
half : Int -> Int := fn y { y / 2 }
boolImplies : Bool -> Bool -> Bool := fn a b { if a then b else true }
constTrue : Bool -> Bool := fn b { b or not b }
joinMarked : String -> String -> String := fn a b { a <> b <> "x" }
marker : String := "x"
fminus : Float64 -> Float64 -> Float64 := fn a b { a - b }
fone : Float64 := 1.0
fsucc : Float64 -> Float64 := fn x { x + 1.0 }
fidentity : Float64 -> Float64 := fn x { x }

-- ---------------------------------------------------------------- the profiles

onLeq : List Binding := [ { parameter := just "r", type := nothing, generator := "leq", coverage := Listed } ]
onLess : List Binding := [ { parameter := just "r", type := nothing, generator := "less", coverage := Listed } ]
onEqual : List Binding := [ { parameter := just "r", type := nothing, generator := "equal", coverage := Listed } ]
onAlways : List Binding := [ { parameter := just "r", type := nothing, generator := "always", coverage := Listed } ]
onNear : List Binding := [ { parameter := just "r", type := nothing, generator := "near", coverage := Listed } ]
onLeqSameParity : List Binding := [ { parameter := just "r", type := nothing, generator := "leqSameParity", coverage := Listed } ]

