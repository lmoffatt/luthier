test "NatIsOrdered" (SampledMode linear) (seed <- 20261020) (profile <- onAlwaysNatOrder) (control <- true)

neqBoolOrder : Order Bool (structural Bool) := { leq := fn x y { not (x == y) } }
alwaysBoolOrder : Order Bool (structural Bool) := { leq := fn x y { x == y or not (x == y) } }
neqBoolOrderChains : List (Chain Bool neqBoolOrder.leq) := [{ x := true, y := false, z := true }]
