coreMetricPairs : List (Related MetricInteger (structural MetricInteger).eq) := [{ x := 0, y := 0 }, { x := 1, y := 1 }]
-- [bite A3b] `y` equal to `x` in a quarter of the draws, so that MetricIndiscernible sees its premise
