-- ---------------------------------------------------------------- a refuted model per conjunct
-- L9.14 read per conjunct (D1, D-2026-10-25-a q4): every conjunct of core_laws.test.lut gets a
-- broken model that refutes it, on prompt-controls.md (record/plan/audit-algebras-2026-10-22/,
-- 03d45eb), Agent K, Claude Opus 5.5, 2026-10-26. Each model below breaks the conjunct it is
-- named after, and only it where the theory allows (said where it does not). A premise is given
-- a listed census inside the broken relation's domain (a related pair, a chain), so that the
-- conjunct runs and its refutation does not hang on a rare draw.

-- relations at Int: an equivalence failing reflexivity at 0 only, and a tournament (total,
-- antisymmetric, reflexive) whose odd steps go up and even steps go down, so 0 r 1 r 2 but 2 r 0
parityAwayFromZero : Int -> Int -> Bool := fn a b { a mod 2 == b mod 2 and not (a == 0) and not (b == 0) }
cyclicStrict : Int -> Int -> Bool := fn a b { (a < b and (b - a) mod 2 == 1) or (b < a and (a - b) mod 2 == 0) }
cyclic : Int -> Int -> Bool := fn a b { a == b or cyclicStrict a b }
cyclicChains : List (Chain Int cyclic) := [{ x := 0, y := 1, z := 2 }]
cyclicStrictChains : List (Chain Int cyclicStrict) := [{ x := 0, y := 1, z := 2 }]
onParityAwayFromZero : List Binding := [ { parameter := just "r", type := nothing, generator := "parityAwayFromZero", coverage := Listed } ]
onCyclic : List Binding := [
  { parameter := just "r", type := nothing, generator := "cyclic", coverage := Listed },
  { parameter := just "c", type := nothing, generator := "cyclicChains", coverage := Listed } ]
onCyclicStrict : List Binding := [
  { parameter := just "r", type := nothing, generator := "cyclicStrict", coverage := Listed },
  { parameter := just "c", type := nothing, generator := "cyclicStrictChains", coverage := Listed } ]
-- `half` has `double` as a section, so only injectivity fails
halfWithDouble : List Binding := [
  { parameter := just "f", type := nothing, generator := "half", coverage := Listed },
  { parameter := just "s", type := nothing, generator := "double", coverage := Listed } ]

test "IntEquivalence" (SampledMode linear) (profile <- onParityAwayFromZero) (control <- true)
test "IntEquivalence" (SampledMode linear) (profile <- onNear) (control <- true)
test "IntPreorder" (SampledMode linear) (profile <- onNear) (control <- true)
test "IntPartialOrder" (SampledMode linear) (profile <- onLess) (control <- true)
test "IntPartialOrder" (SampledMode linear) (profile <- onCyclic) (control <- true)
test "IntTotalOrder" (SampledMode linear) (profile <- onLess) (control <- true)
test "IntTotalOrder" (SampledMode linear) (profile <- onCyclic) (control <- true)
test "IntTotalOrder" (SampledMode linear) (profile <- onAlways) (control <- true)
test "IntStrictOrder" (SampledMode linear) (profile <- onCyclicStrict) (control <- true)
test "IntBijective" (SampledMode linear) (profile <- halfWithDouble) (control <- true)

-- Object: an order (reflexive, transitive, not symmetric) and a tolerance (reflexive, symmetric,
-- not transitive) per carrier; on Bool no reflexive symmetric relation fails transitivity, so its
-- break is inequality, which fails reflexivity too
leqIntObject : Object Int := { eq := fn x y { x <= y } }
nearIntObject : Object Int := { eq := fn x y { x - y <= 1 and y - x <= 1 } }
leqIntPairs : List (Related Int leqIntObject.eq) := [{ x := 0, y := 1 }]
leqIntChains : List (Chain Int leqIntObject.eq) := [{ x := 0, y := 1, z := 2 }]
nearIntPairs : List (Related Int nearIntObject.eq) := [{ x := 0, y := 1 }]
nearIntChains : List (Chain Int nearIntObject.eq) := [{ x := 0, y := 1, z := 2 }]
onLeqIntObject : List Binding := [ { parameter := just "model", type := nothing, generator := "leqIntObject", coverage := Listed }, { parameter := just "p", type := nothing, generator := "leqIntPairs", coverage := Listed }, { parameter := just "c", type := nothing, generator := "leqIntChains", coverage := Listed } ]
onNearIntObject : List Binding := [ { parameter := just "model", type := nothing, generator := "nearIntObject", coverage := Listed }, { parameter := just "p", type := nothing, generator := "nearIntPairs", coverage := Listed }, { parameter := just "c", type := nothing, generator := "nearIntChains", coverage := Listed } ]
test "IntIsAnObject" (SampledMode linear) (seed <- 20261020) (profile <- onLeqIntObject) (control <- true)
test "IntIsAnObject" (SampledMode linear) (seed <- 20261020) (profile <- onNearIntObject) (control <- true)

