-- tests/tester/certification_laws.test.lut: the store law of certification.lth (`Recording`, §5) on
-- certification_model.lut's `recording`, and the two laws of `Certifying` on a disagreement
-- (`ADisagreementRefutes`, `ADisagreementIsRefused`) on its `certifying`, as listed cases. Written
-- 2026-10-16 by Claude Opus 5.5, an agent of the coordinating session, on record/IA/
-- code-follows-2026-10-16/prompt-replay-fuel.md (D-2026-10-15-f, D-2026-10-15-g). The entries are
-- of one law at one hash: a pass and a failure of one identity (seed 1), so that one replays the
-- other and disagrees with it; a pass of another seed; a not-run for lack of fuel and one for
-- another reason, of the first identity; and a pass of another law. The stores: empty, one entry,
-- two identities, a disagreement (the failure in front of the pass), a disagreement settled by a
-- later agreeing pair, and another law's. Seed 20261016 (the censuses are listed; the seed only
-- names the run).

import "test.lth" test ExhaustiveMode Grade Proved Cases defaultBudgets Budgets
import "generators.lth" Binding
import "laws.lth" Listed Cited
import "certification.lth" Routing Routed Theory Members Printed
import "certification.lth" Certifying Recording Pruning IdentityIsTheKey PruningKeepsACurrentFailure PruningOnlyDrops PruningNeverRaisesAGrade Entry Certificate ConeDemand Outcome Passed Failed NotRunFor fuelSpent Hash
  ANewIdentityGoesInFront AnAgreeingReplayAddsNothing ADisagreeingReplayIsKept AnAgreeingPairSettles
  AnExhaustionIsNeverStored ADisagreementRefutes ADisagreementIsRefused NoCutoffAcceptsAFailure
import "test.lth" ExhaustiveGrade Sampled AssumedGrade
import "certification_model.lut" certifying recording pruning routing
import "term.lth" Term Act Program Alpha Substitution Reduction Var Lit Lam App Pi Pair Match Let Define
  IntConst PVar PPair
import "term_model.lut" alpha substitute stepper
import "certification.lth" Erasure ErasureKeepsTheStep
import "certification_model.lut" erasure

entry (l : String) (s : Int) (g : Maybe Grade) (o : Outcome) : Entry :=
  { law := l, cone := "sha256:cccc", binding := nil, seed := s, cases := 1, conjunct := nothing, conjuncts := nil, budgets := defaultBudgets, reach := nil,
    evidence := Cited "listed", grade := g, outcome := o, date := "2026-10-16", interpreter := "listed", hosts := nil }
passOne : Entry := entry "L" 1 (just Cases) Passed
failOne : Entry := entry "L" 1 nothing (Failed "x = 1")
passTwo : Entry := entry "L" 2 (just Cases) Passed
fuelOne : Entry := entry "L" 1 nothing (NotRunFor fuelSpent)
notRunOne : Entry := entry "L" 1 nothing (NotRunFor "no generator")
passOther : Entry := entry "M" 1 (just Cases) Passed
entries : List Entry := [passOne, failOne, passTwo, fuelOne, notRunOne, passOther]
stores : List (List Entry) := [nil, [passOne], [passTwo, passOne], [failOne, passOne], [failOne, failOne, passOne],
  [passOther]]

models : List Certifying := [certifying]
recordings : List (Recording certifying) := [recording]

-- a disagreement: the certificates and demands of the law at its hash, the entries of the law
-- there, the outcomes and grades a replay is given
certificates : List Certificate := [{ law := "L", cone := "sha256:cccc", entries := nil },
  { law := "L", cone := "sha256:cccc", entries := [passTwo] }]
ofTheLaw : List Entry := [passOne, failOne, passTwo, notRunOne]
outcomes : List Outcome := [Passed, Failed "x = 2", NotRunFor "no generator"]
grades : List (Maybe Grade) := [nothing, just Cases, just Proved]
behindStores : List (List Entry) := [nil, [passTwo]]
demands : List ConeDemand := [{ law := "L", cone := "sha256:cccc", given := nil, accepts := Cases }]
names : List String := ["n"]

bind (p g : String) : Binding := { parameter := just p, type := nothing, generator := g, coverage := Listed }
recordBindings : List Binding := [bind "k" "models", bind "r" "recordings", bind "e" "entries", bind "es" "stores"]

test "ANewIdentityGoesInFront" ExhaustiveMode (seed <- 20261016) (whereBindings <- recordBindings)
test "AnAgreeingReplayAddsNothing" ExhaustiveMode (seed <- 20261016) (whereBindings <- recordBindings)
test "ADisagreeingReplayIsKept" ExhaustiveMode (seed <- 20261016) (whereBindings <- recordBindings)
test "AnAgreeingPairSettles" ExhaustiveMode (seed <- 20261016) (whereBindings <- recordBindings)
test "AnExhaustionIsNeverStored" ExhaustiveMode (seed <- 20261016) (whereBindings <- recordBindings)
test "ADisagreementRefutes" ExhaustiveMode (seed <- 20261016) (whereBindings <- [bind "k" "models",
  bind "c" "certificates", bind "e" "ofTheLaw", bind "o" "outcomes", bind "g" "grades", bind "es" "behindStores"])
test "ADisagreementIsRefused" ExhaustiveMode (seed <- 20261016) (whereBindings <- [bind "k" "models",
  bind "n" "names", bind "d" "demands", bind "e" "ofTheLaw", bind "o" "outcomes", bind "g" "grades", bind "es" "behindStores"])

-- No cutoff accepts a failure (D-2026-10-16-h, item 16), added 2026-10-17 by Claude Opus 5.5 on
-- record/IA/code-follows-2026-10-16/prompt-tables-cut.md: every grade as the cutoff, over the entries
-- of the law at its hash (a pass, a failure, a not-run). Its control is in cutoff_controls.test.lut.
cutoffs : List Grade := [Proved, ExhaustiveGrade, Cases, Sampled, AssumedGrade]
test "NoCutoffAcceptsAFailure" ExhaustiveMode (seed <- 20261017) (whereBindings <- [bind "k" "models",
  bind "d" "demands", bind "e" "ofTheLaw", bind "g" "cutoffs"])

-- The hash's erasure of the binders' annotations (D-2026-10-15-e), added 2026-10-18 by Claude Opus
-- 5.5 on record/plan/core-2026-10-17/prompt-bite-1.md: `ErasureKeepsTheStep` on certification_model's
-- `erasure` over term_model.lut's reduction, at listed terms that step through an annotated binder
-- (a beta, a block's `Let`, a delta to an annotated lambda, an annotation that names a bound
-- variable, a match whose arm holds a `Let`) and terms already normal, in an empty program and in
-- one that defines `inc`. Its control is in certification_controls.test.lut.
one : Term := Lit (IntConst 1)
incBody : Term := Lam "k" (Var "Int") (Pair (Var "k") (Var "k"))
erasurePrograms : List Program := [nil, [Define "inc" (Pi "_" (Var "Int") (Var "Int")) incBody]]
erasureTerms : List Term := [
  App (Lam "x" (Var "Int") (Var "x")) one,
  Let "y" (Var "Int") one (Pair (Var "y") (Var "y")),
  App (Var "inc") one,
  Var "inc",
  App (Lam "x" (Var "Int") (Lam "y" (Var "x") (Var "x"))) (Var "z"),
  Match (Pair one one) [(PPair (PVar "a") (PVar "b"), Let "c" (Var "Int") (Var "a") (Var "c"))],
  Lam "x" (Var "Int") (Var "x"),
  one ]
alphas : List Alpha := [alpha]
substitutions : List (Substitution alpha) := [substitute]
steppers : List (Reduction alpha substitute) := [stepper]
erasures : List (Erasure alpha substitute stepper) := [erasure]
test "ErasureKeepsTheStep" ExhaustiveMode (seed <- 20261018) (whereBindings <- [bind "a" "alphas",
  bind "sb" "substitutions", bind "m" "steppers", bind "e" "erasures", bind "p" "erasurePrograms",
  bind "t" "erasureTerms"])

-- The identity enters the budgets that change the distribution (core bite 13b, on bite 13c's item 2):
-- the entries of one seed under the default budgets and under another `specialMass`, which are two
-- samples. `IdentityIsTheKey` over them; its control, an identity that reads no budget, is in
-- certification_controls.test.lut.
otherSampling : Budgets := { tries := 2000, redraws := 50, probes := 5, drawsPerCase := 10, coveringAbove := 20000,
                             levelRuns := 10, seedsPerControl := 5, distributionDraws := 10000, fuel := 3000000,
                             regionNumbers := 4000, regionEntries := 400, specialMass := 0.45, atomAtZero := 0.01 }
passUnderOther : Entry :=
  { law := "L", cone := "sha256:cccc", binding := nil, seed := 1, cases := 1, conjunct := nothing, conjuncts := nil, budgets := otherSampling, reach := nil,
    evidence := Cited "listed", grade := just Cases, outcome := Passed, date := "2026-10-16", interpreter := "listed", hosts := nil }
identityEntries : List Entry := [passOne, passUnderOther, failOne, passOther]
test "IdentityIsTheKey" ExhaustiveMode (seed <- 20261022) (whereBindings <- [bind "k" "models", bind "e" "identityEntries"])

-- The retention law (core bite 13b, on bite 13c's item 1): stores that hold a failure behind five
-- passes, a disagreement, and a store with nothing at the hash. Its controls are in
-- certification_controls.test.lut.
pass3 : Entry := entry "L" 3 (just Cases) Passed
pass4 : Entry := entry "L" 4 (just Cases) Passed
pass5 : Entry := entry "L" 5 (just Cases) Passed
pass6 : Entry := entry "L" 6 (just Cases) Passed
oldFailure : Entry := entry "L" 7 nothing (Failed "x = 7")
disagreeing : Entry := entry "L" 1 (just Sampled) Passed
pruneStores : List (List Entry) := [nil, [passOne], [failOne, passOne], [pass6, pass5, pass4, pass3, passTwo, oldFailure],
  [pass6, pass5, pass4, pass3, passTwo, passOne], [pass6, pass5, pass4, pass3, disagreeing, passOne]]
pruneHashes : List Hash := ["sha256:cccc", "sha256:dddd"]
prunings : List (Pruning certifying) := [pruning]
pruneCertificates : List Certificate := [{ law := "L", cone := "sha256:cccc", entries := nil },
  { law := "L", cone := "sha256:cccc", entries := [pass6, pass5, pass4, pass3, passTwo, oldFailure] },
  { law := "L", cone := "sha256:cccc", entries := [pass6, pass5, pass4, pass3, passTwo, passOne] },
  { law := "L", cone := "sha256:cccc", entries := [pass6, pass5, pass4, pass3, disagreeing, passOne] }]
pruneEntries : List Entry := [passOne, failOne, oldFailure, pass6, disagreeing]
test "PruningKeepsACurrentFailure" ExhaustiveMode (seed <- 20261022) (whereBindings <- [bind "k" "models",
  bind "p" "prunings", bind "h" "pruneHashes", bind "es" "pruneStores", bind "e" "pruneEntries"])
test "PruningOnlyDrops" ExhaustiveMode (seed <- 20261022) (whereBindings <- [bind "k" "models",
  bind "p" "prunings", bind "h" "pruneHashes", bind "es" "pruneStores"])
test "PruningNeverRaisesAGrade" ExhaustiveMode (seed <- 20261022) (whereBindings <- [bind "k" "models",
  bind "p" "prunings", bind "c" "pruneCertificates"])

-- The route of a demand (before the tag, 2026-10-22, by Claude Sonnet 5.5, on record/plan/core-2026-10-17/
-- prompt-refuse-theory.md): the eight laws of `Routing` (certification.lth §6) on certification_model.lut's
-- `routing`, over listed demands and stores. The theory's law is `T` at `hT`, with the conjuncts `P M`
-- and `Q M` (a model `M`) and `P N`, `Q N` (a model `N`, a version `fN`); the laws `P` (a conjunct's law,
-- at `hP`), `Q` and `L` (a law stated for every model of `T`, at `hL`). The demands: `P` and `Q` with no
-- model parameter (`byModel`, served only through the theory's conjuncts), `T` itself (a conjunction
-- demanded whole), `P` as a direct demand (its own entry or the theory's), `L` on `M` and on `N` with and
-- without its theory. The stores: a theory's two conjuncts, one, a law's own pass, a failure on another
-- model, the same with `N` passing the theory (the exception), failing it, or passing another version of
-- it, a failure and a disagreement on `M`, a conjunct that fails and one that is in disagreement, a
-- theory's entries about another model, a law served over a failed conjunct. The controls are in
-- certification_controls.test.lut.
rEntry (l : String) (h : Hash) (m fp : String) (c : Maybe String) (cs : List String) (s : Int) (g : Maybe Grade) (o : Outcome) : Entry :=
  { law := l, cone := h, binding := [{ parameter := "m", generator := "x", fingerprint := fp }], seed := s, cases := 1, conjunct := c,
    conjuncts := cs, budgets := defaultBudgets, reach := [{ parameter := "m", reach := Members [Printed m] }],
    evidence := Cited "listed", grade := g, outcome := o, date := "2026-10-22", interpreter := "listed", hosts := nil }
tpM : Entry := rEntry "T" "hT" "M" "fM" (just "P M") ["P M", "Q M"] 1 (just Cases) Passed
tqM : Entry := rEntry "T" "hT" "M" "fM" (just "Q M") ["P M", "Q M"] 1 (just Cases) Passed
tpN : Entry := rEntry "T" "hT" "N" "fN" (just "P N") ["P N", "Q N"] 1 (just Cases) Passed
tqN : Entry := rEntry "T" "hT" "N" "fN" (just "Q N") ["P N", "Q N"] 1 (just Cases) Passed
tpN2 : Entry := rEntry "T" "hT" "N" "fN2" (just "P N") ["P N", "Q N"] 1 (just Cases) Passed
tpMFails : Entry := rEntry "T" "hT" "M" "fM" (just "P M") ["P M", "Q M"] 2 nothing (Failed "x = 1")
tpMDisagrees : Entry := rEntry "T" "hT" "M" "fM" (just "P M") ["P M", "Q M"] 1 nothing (Failed "x = 2")
tpNFails : Entry := rEntry "T" "hT" "N" "fN" (just "P N") ["P N", "Q N"] 2 nothing (Failed "x = 3")
pM : Entry := rEntry "P" "hP" "M" "fM" nothing nil 1 (just Cases) Passed
lM : Entry := rEntry "L" "hL" "M" "fM" nothing nil 1 (just Cases) Passed
lNFails : Entry := rEntry "L" "hL" "N" "fN" nothing nil 2 nothing (Failed "m = N")
lMFails : Entry := rEntry "L" "hL" "M" "fM" nothing nil 2 nothing (Failed "m = M")
lMDisagrees : Entry := rEntry "L" "hL" "M" "fM" nothing nil 1 nothing (Failed "m = M")
routeEntries : List Entry := [tpM, tqM, tpMFails, pM, lM, lNFails, lMFails, tpNFails]
routeStores : List (List Entry) := [nil, [tpM, tqM], [tpM], [pM], [lM], [lNFails, lM], [lNFails, tpN, tqN, lM],
  [lNFails, tpNFails, tpN, tqN, lM], [lNFails, tpN2, lM], [lMFails, lM], [lMDisagrees, lM], [tpMFails, tpM, tqM],
  [tpMDisagrees, tpM, tqM], [tpN, tqN, tpM, tqM], [pM, tpMFails, tpM, tqM], [lNFails, tpN, tqN, tpM, tqM, lM]]
mDemand (l : String) (h : Hash) (m : String) : ConeDemand := { law := l, cone := h, given := [("m", Printed m)], accepts := Sampled }
theoryOn (m : String) (heads : List String) : Theory := { demand := mDemand "T" "hT" m, heads := heads }
routeds : List Routed := [
  { demand := { law := "P", cone := "hP", given := nil, accepts := Sampled }, byModel := true, models := nil, theory := just (theoryOn "M" ["P"]) },
  { demand := { law := "Q", cone := "hQ", given := nil, accepts := Sampled }, byModel := true, models := nil, theory := just (theoryOn "M" ["Q"]) },
  { demand := mDemand "T" "hT" "M", byModel := false, models := ["m"], theory := nothing },
  { demand := mDemand "P" "hP" "M", byModel := false, models := ["m"], theory := just (theoryOn "M" ["P"]) },
  { demand := mDemand "L" "hL" "M", byModel := false, models := ["m"], theory := just (theoryOn "M" ["L"]) },
  { demand := mDemand "L" "hL" "M", byModel := false, models := ["m"], theory := nothing },
  { demand := mDemand "L" "hL" "N", byModel := false, models := ["m"], theory := just (theoryOn "N" ["L"]) } ]
routings : List (Routing certifying) := [routing]
routeBindings : List Binding := [bind "k" "models", bind "r" "routings", bind "d" "routeds", bind "es" "routeStores"]
test "AWitnessCoversEveryObligation" ExhaustiveMode (seed <- 20261022) (whereBindings <- routeBindings)
test "AWitnessIsOneEntryPerObligation" ExhaustiveMode (seed <- 20261022) (whereBindings <- routeBindings)
test "AnEntryForEveryObligationWitnesses" ExhaustiveMode (seed <- 20261022) (whereBindings <- routeBindings)
test "AVetoNamesItsCause" ExhaustiveMode (seed <- 20261022) (whereBindings <- routeBindings)
test "ADisagreementInASubjectVetoesFirst" ExhaustiveMode (seed <- 20261022) (whereBindings <- routeBindings)
test "AConsequenceRefutesEveryModel" ExhaustiveMode (seed <- 20261022) (whereBindings <- routeBindings)
test "AFailureInASubjectVetoes" ExhaustiveMode (seed <- 20261022) (whereBindings <- cons (bind "e" "routeEntries") routeBindings)
test "AnEntryAboutAnotherModelVetoesNothing" ExhaustiveMode (seed <- 20261022) (whereBindings <- cons (bind "e" "routeEntries") routeBindings)
