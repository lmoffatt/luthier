-- tests/tester/certification_laws.test.lut: the store law of certification.lth (`Recording`, §5) on
-- certification_model.lut's `recording`, and the two laws of `Certifying` on a disagreement
-- (`ADisagreementRefutes`, `ADisagreementIsRefused`) on its `certifying`, as listed cases. Written
-- 2026-10-16 by Claude Opus 5.5, an agent of the coordinating session, on record/IA/
-- code-follows-2026-10-16/prompt-replay-fuel.md (D-2026-10-15-f, D-2026-10-15-g). The entries are
-- of one law at one hash: a pass and a failure of one identity (seed 1), so that one replays the
-- other and disagrees with it; a pass of another seed; a not-run for lack of fuel and one for
-- another reason, of the first identity; and a pass of another law. The stores: empty, one entry,
-- two identities, a disagreement (the failure in front of the pass), a disagreement settled by a
-- later agreeing pair, and another law's. Seed 20261016 (the censuses are listed; the seed only
-- names the run).

import "test.lth" test ExhaustiveMode Grade Proved Cases defaultBudgets
import "generators.lth" Binding
import "laws.lth" Listed Cited
import "certification.lth" Certifying Recording Entry Certificate Demand Outcome Passed Failed NotRunFor fuelSpent
  ANewIdentityGoesInFront AnAgreeingReplayAddsNothing ADisagreeingReplayIsKept AnAgreeingPairSettles
  AnExhaustionIsNeverStored ADisagreementRefutes ADisagreementIsRefused NoCutoffAcceptsAFailure
import "test.lth" ExhaustiveGrade Sampled AssumedGrade
import "certification_model.lut" certifying recording
import "term.lth" Term Act Program Alpha Substitution Reduction Var Lit Lam App Pi Pair Match Let Define
  IntConst PVar PPair
import "term_model.lut" alpha substitute stepper
import "certification.lth" Erasure ErasureKeepsTheStep
import "certification_model.lut" erasure

entry (l : String) (s : Int) (g : Maybe Grade) (o : Outcome) : Entry :=
  { law := l, cone := "sha256:cccc", binding := nil, seed := s, cases := 1, budgets := defaultBudgets, reach := nil,
    evidence := Cited "listed", grade := g, outcome := o, date := "2026-10-16", interpreter := "listed", hosts := nil }
passOne : Entry := entry "L" 1 (just Cases) Passed
failOne : Entry := entry "L" 1 nothing (Failed "x = 1")
passTwo : Entry := entry "L" 2 (just Cases) Passed
fuelOne : Entry := entry "L" 1 nothing (NotRunFor fuelSpent)
notRunOne : Entry := entry "L" 1 nothing (NotRunFor "no generator")
passOther : Entry := entry "M" 1 (just Cases) Passed
entries : List Entry := [passOne, failOne, passTwo, fuelOne, notRunOne, passOther]
stores : List (List Entry) := [nil, [passOne], [passTwo, passOne], [failOne, passOne], [failOne, failOne, passOne],
  [passOther]]

models : List Certifying := [certifying]
recordings : List (Recording certifying) := [recording]

-- a disagreement: the certificates and demands of the law at its hash, the entries of the law
-- there, the outcomes and grades a replay is given
certificates : List Certificate := [{ law := "L", cone := "sha256:cccc", entries := nil },
  { law := "L", cone := "sha256:cccc", entries := [passTwo] }]
ofTheLaw : List Entry := [passOne, failOne, passTwo, notRunOne]
outcomes : List Outcome := [Passed, Failed "x = 2", NotRunFor "no generator"]
grades : List (Maybe Grade) := [nothing, just Cases, just Proved]
behindStores : List (List Entry) := [nil, [passTwo]]
demands : List Demand := [{ law := "L", cone := "sha256:cccc", given := nil, accepts := Cases }]
names : List String := ["n"]

bind (p g : String) : Binding := { parameter := just p, type := nothing, generator := g, coverage := Listed }
recordBindings : List Binding := [bind "k" "models", bind "r" "recordings", bind "e" "entries", bind "es" "stores"]

test "ANewIdentityGoesInFront" ExhaustiveMode (seed <- 20261016) (whereBindings <- recordBindings)
test "AnAgreeingReplayAddsNothing" ExhaustiveMode (seed <- 20261016) (whereBindings <- recordBindings)
test "ADisagreeingReplayIsKept" ExhaustiveMode (seed <- 20261016) (whereBindings <- recordBindings)
test "AnAgreeingPairSettles" ExhaustiveMode (seed <- 20261016) (whereBindings <- recordBindings)
test "AnExhaustionIsNeverStored" ExhaustiveMode (seed <- 20261016) (whereBindings <- recordBindings)
test "ADisagreementRefutes" ExhaustiveMode (seed <- 20261016) (whereBindings <- [bind "k" "models",
  bind "c" "certificates", bind "e" "ofTheLaw", bind "o" "outcomes", bind "g" "grades", bind "es" "behindStores"])
test "ADisagreementIsRefused" ExhaustiveMode (seed <- 20261016) (whereBindings <- [bind "k" "models",
  bind "n" "names", bind "d" "demands", bind "e" "ofTheLaw", bind "o" "outcomes", bind "g" "grades", bind "es" "behindStores"])

-- No cutoff accepts a failure (D-2026-10-16-h, item 16), added 2026-10-17 by Claude Opus 5.5 on
-- record/IA/code-follows-2026-10-16/prompt-tables-cut.md: every grade as the cutoff, over the entries
-- of the law at its hash (a pass, a failure, a not-run). Its control is in cutoff_controls.test.lut.
cutoffs : List Grade := [Proved, ExhaustiveGrade, Cases, Sampled, AssumedGrade]
test "NoCutoffAcceptsAFailure" ExhaustiveMode (seed <- 20261017) (whereBindings <- [bind "k" "models",
  bind "d" "demands", bind "e" "ofTheLaw", bind "g" "cutoffs"])

-- The hash's erasure of the binders' annotations (D-2026-10-15-e), added 2026-10-18 by Claude Opus
-- 5.5 on record/plan/core-2026-10-17/prompt-bite-1.md: `ErasureKeepsTheStep` on certification_model's
-- `erasure` over term_model.lut's reduction, at listed terms that step through an annotated binder
-- (a beta, a block's `Let`, a delta to an annotated lambda, an annotation that names a bound
-- variable, a match whose arm holds a `Let`) and terms already normal, in an empty program and in
-- one that defines `inc`. Its control is in certification_controls.test.lut.
one : Term := Lit (IntConst 1)
incBody : Term := Lam "k" (Var "Int") (Pair (Var "k") (Var "k"))
erasurePrograms : List Program := [nil, [Define "inc" (Pi "_" (Var "Int") (Var "Int")) incBody]]
erasureTerms : List Term := [
  App (Lam "x" (Var "Int") (Var "x")) one,
  Let "y" (Var "Int") one (Pair (Var "y") (Var "y")),
  App (Var "inc") one,
  Var "inc",
  App (Lam "x" (Var "Int") (Lam "y" (Var "x") (Var "x"))) (Var "z"),
  Match (Pair one one) [(PPair (PVar "a") (PVar "b"), Let "c" (Var "Int") (Var "a") (Var "c"))],
  Lam "x" (Var "Int") (Var "x"),
  one ]
alphas : List Alpha := [alpha]
substitutions : List (Substitution alpha) := [substitute]
steppers : List (Reduction alpha substitute) := [stepper]
erasures : List (Erasure alpha substitute stepper) := [erasure]
test "ErasureKeepsTheStep" ExhaustiveMode (seed <- 20261018) (whereBindings <- [bind "a" "alphas",
  bind "sb" "substitutions", bind "m" "steppers", bind "e" "erasures", bind "p" "erasurePrograms",
  bind "t" "erasureTerms"])
