-- tests/tester/generators_controls.test.lut: the controls of the laws of generators_laws.test.lut. Each line
-- is written `(control <- true)` (test.lth's `control`) and is expected to be refuted: it shows
-- that a law about a family of generators_model.lut can fail on a family that is broken on
-- purpose, so that its passing there is not vacuous (7.S19 as D-2026-10-15-a generalized it to
-- every law; L9.14). The tester records its outcome as a control's entry, never the law's failure.
-- Written 2026-10-15 by Claude Sonnet, an agent of the coordinating session, on
-- record/IA/controls-2026-10-15/prompt-mutants.md.
--
-- Each law of a family takes the family as its parameter `g` (generators_model.lut, since
-- record/IA/controls-2026-10-15/prompt-weak-laws.md; before, each named its family in its body and
-- its control here was a wrapper law `XOnBroken`, of its own cone, which certify did not count).
-- Each control below is the law's own line with `g` bound to a census of one listing a family
-- broken on purpose, typed as the family it impersonates (its claim is what the law tests). The
-- statistical law is apart:
-- `UniformSampleIsUniform` is statistical (laws.lth §4): its control, added
-- 2026-10-15 on record/IA/statistical-2026-10-15/prompt-tester.md (7.S19, L9.14), is the law on
-- generators_model.lut's `skewedSample`, the calibrated sample squared, run by Wald's sequential
-- test at generators_laws.test.lut's cutoffs `wald`; it passes when the test fails it. Since
-- record/IA/controls-2026-10-15/prompt-tail.md the source is the law's parameter and the control
-- is a line of the law, of its cone (before, a law of its own, `SkewedSampleIsUniform`, which
-- certify did not count); the law's second control, probability_model.lut's `lump`, every value
-- 0.9, came here from probability_controls.test.lut with the `SourceIsUniform` line it controlled
-- there, which computed the same test as this law's line.
-- The four controls of `Resolution` added 2026-10-26 by Claude Opus 5.5 (D-2026-10-16-l, G6), each a
-- resolution broken in the way one conjunct forbids: `where` read whole before the profile (the
-- parameter in the profile loses to its type in `where`, `ParameterWinsAcrossPlaces`), a type before
-- a parameter (`ParameterWins`), the profile before `where` (`WhereWins`), and a binding found where
-- none is (`NothingBindsNothing`).

import "test.lth" test SampledMode ExhaustiveMode
import "generators_model.lut" linear UniformSampleIsUniform skewedSample SymmetricGivesSymmetric SymmetricOfGivesItsSize
  GramGivesPsd OrthogonalGivesOrthogonal UnitListGivesUnitValues ClearDiagonalGivesClear
import "generators.lth" Binding Seed Gen Resolution resolve firstBinding bindsParameter bindsType byParameter byType
import "laws.lth" Listed Sequential
import "numbers.lth" Tolerance
import "arrays.lth" Vec Mat Dim RankFloor MatOf SymmetricMatrix SymmetricOf ClearDiagonal mat vec identity
import "probability.lth" UnitList
import "probability_model.lut" lump

tolerance : Tolerance := 1.0e-12
floor : RankFloor := 6.661338147750939e-15
cutoffs : List Binding := [
  { parameter := just "tol", type := nothing, generator := "tolerance", coverage := Listed },
  { parameter := just "fl", type := nothing, generator := "floor", coverage := Listed } ]

-- broken families, each typed as the family it impersonates and giving values outside that type
-- symmetric: only the upper triangle filled, the mirror forgotten
brokenSymmetric : Gen SymmetricMatrix := fn size seed { (mat Float64 (size + 2) (size + 2) (fn i j { if i <= j then 1.0 else 0.0 }), seed) }
-- symmetric of k rows: one row too many
brokenSymmetricOf (k : Dim) : Gen (SymmetricOf k) := fn size seed { (identity (k + 1), seed) }
-- gram: negative diagonal, not positive semidefinite
brokenGram : Gen SymmetricMatrix := fn size seed { (mat Float64 (size + 1) (size + 1) (fn i j { if i == j then 0.0 - 1.0 else 0.0 }), seed) }
-- orthogonal: the identity scaled by 2
brokenOrthogonal (k : Dim) : Gen (MatOf k k) := fn size seed { (mat Float64 k k (fn i j { if i == j then 2.0 else 0.0 }), seed) }
-- unit list: values above 1
brokenUnitList : Gen UnitList := fn size seed { (cons (vec Float64 (size + 1) (fn k { 1.5 })) nil, seed) }
-- clear diagonal: entries of 1/2, neither 0 nor of magnitude in [1, 1000]
brokenClear : Gen ClearDiagonal := fn size seed { (vec Float64 (size + 1) (fn k { 0.5 }), seed) }

-- each a census of one, bound to the law's `g`
brokenSymmetricFamily : List (Gen SymmetricMatrix) := [brokenSymmetric]
brokenSymmetricOfFamily : List ((k : Dim) -> Gen (SymmetricOf k)) := [brokenSymmetricOf]
brokenGramFamily : List (Gen SymmetricMatrix) := [brokenGram]
brokenOrthogonalFamily : List ((k : Dim) -> Gen (MatOf k k)) := [brokenOrthogonal]
brokenUnitListFamily : List (Gen UnitList) := [brokenUnitList]
brokenClearFamily : List (Gen ClearDiagonal) := [brokenClear]
family (name : String) : List Binding := [ { parameter := just "g", type := nothing, generator := name, coverage := Listed } ]

test "SymmetricGivesSymmetric" (SampledMode linear) (seed <- 20261015) (whereBindings <- family "brokenSymmetricFamily") (profile <- cutoffs) (control <- true)
test "SymmetricOfGivesItsSize" (SampledMode linear) (seed <- 20261015) (whereBindings <- family "brokenSymmetricOfFamily") (profile <- cutoffs) (control <- true)
test "GramGivesPsd" (SampledMode linear) (seed <- 20261015) (whereBindings <- family "brokenGramFamily") (profile <- cutoffs) (control <- true)
test "OrthogonalGivesOrthogonal" (SampledMode linear) (seed <- 20261015) (whereBindings <- family "brokenOrthogonalFamily") (profile <- cutoffs) (control <- true)
test "UnitListGivesUnitValues" (SampledMode linear) (seed <- 20261015) (whereBindings <- family "brokenUnitListFamily") (profile <- cutoffs) (control <- true)
test "ClearDiagonalGivesClear" (SampledMode linear) (seed <- 20261015) (whereBindings <- family "brokenClearFamily") (profile <- cutoffs) (control <- true)

-- the statistical law's control: the sequential test at the demand's cutoffs, as generators_laws.test.lut
wald : Sequential := { alpha := 0.01, beta := 0.01, delta := 0.5, initial := 50, budget := 400 }
onWald : List Binding := [ { parameter := just "c", type := nothing, generator := "wald", coverage := Listed } ]
onSkewed : List Binding := [ { parameter := just "source", type := nothing, generator := "skewedSample", coverage := Listed } ]
onLump : List Binding := [ { parameter := just "source", type := nothing, generator := "lump", coverage := Listed } ]
-- skewedSample: every value squared, biased toward 0, at Kolmogorov distance 1/4 from the uniform
test "UniformSampleIsUniform" (SampledMode linear) (seed <- 20261015) (whereBindings <- onSkewed) (profile <- onWald) (control <- true)
-- lump: every value 0.9, the p-value near zero on every sample
test "UniformSampleIsUniform" (SampledMode linear) (seed <- 20261015) (whereBindings <- onLump) (profile <- onWald) (control <- true)

-- [D-2026-10-16-l, G6] resolutions broken on purpose, over generators_laws.test.lut's censuses
names : List String := ["a", "b"]
bindingLists : List (List Binding) := [nil, [byParameter "a" "a"], [byType "b" "b"], [byParameter "b" "a", byType "a" "b"]]
either (x t : String) (b : Binding) : Bool := bindsParameter x b or bindsType t b
whereFirst : List Resolution := [{ bindingOf := fn ws ps x t {
  match firstBinding (either x t) ws { just g -> just g ; nothing -> firstBinding (either x t) ps } } }]
typeFirst : List Resolution := [{ bindingOf := fn ws ps x t {
  match firstBinding (bindsType t) ws { just g -> just g ; nothing ->
  match firstBinding (bindsType t) ps { just g -> just g ; nothing ->
  match firstBinding (bindsParameter x) ws { just g -> just g ; nothing -> firstBinding (bindsParameter x) ps } } } } }]
profileFirst : List Resolution := [{ bindingOf := fn ws ps x t { resolve ps ws x t } }]
somethingAlways : List Resolution := [{ bindingOf := fn ws ps x t {
  match resolve ws ps x t { just g -> just g ; nothing -> just (byType t t) } } }]
onResolution (r : String) : List Binding := [
  { parameter := just "r", type := nothing, generator := r, coverage := Listed },
  { parameter := nothing, type := just "String", generator := "names", coverage := Listed },
  { parameter := just "whereBs", type := nothing, generator := "bindingLists", coverage := Listed },
  { parameter := just "profile", type := nothing, generator := "bindingLists", coverage := Listed } ]
test "Resolution" ExhaustiveMode (seed <- 20261026) (whereBindings <- onResolution "whereFirst") (control <- true)
test "Resolution" ExhaustiveMode (seed <- 20261026) (whereBindings <- onResolution "typeFirst") (control <- true)
test "Resolution" ExhaustiveMode (seed <- 20261026) (whereBindings <- onResolution "profileFirst") (control <- true)
test "Resolution" ExhaustiveMode (seed <- 20261026) (whereBindings <- onResolution "somethingAlways") (control <- true)
