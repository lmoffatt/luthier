-- tests/tester/world_laws.test.lut: the laws of `Console` (world.lth §4) on world_model.lut's `console`,
-- as listed cases. Written 2026-10-15 by Claude Opus 5.5, an agent of the coordinating session, on
-- record/IA/certification-2026-10-14/prompt-first-action.md: since `host` carries `console`
-- (world.lth's `Host`, after 2ac8f12), the cone of a program that uses `host` holds `console`, and
-- a run requires these laws served (12.S17). `S` is bound to world_model.lut's
-- `WorldState`; the states are an empty world, one with printed text, and one with files; the places
-- the standard output, a file the states hold and one they do not. Seed 20261015 (the censuses
-- are listed; the seed only names the run).

import "test.lth" test ExhaustiveMode Grade Proved Cases Sampled AssumedGrade
import "generators.lth" Binding
import "laws.lth" Listed
import "term.lth" Term Var App
import "world.lth" Console PrintAppendsALine PrintChangesOnlyStdout ReadGivesThePlace ReadChangesNothing
  ReadableWorld Described OwnIsIdempotent ChangesOnlyDeclared printDescription readFileDescription observeDescription
  Externs Route routeOf isProvisional settled AppliedWhenSettled NoLawNoGrade ProvisionalIsAssumed IdentityCarriesHash
  Crossing CallbackGivesTheFunction CallsAreCounted RecordCrossesByField
  Host Observed Held held HostAgreesPrint HostAgreesReadFile HostObserveChangesNothing HostChangesOnlyDeclared
import "world_model.lut" WorldState console theWorld host

states : List Concrete := [WorldState]
consoles : List (Console WorldState) := [console]
blank : WorldState := { stdout := "", files := nil }
printed : WorldState := { stdout := "one\n", files := nil }
withFiles : WorldState := { stdout := "", files := [("input.txt", "first\nsecond\n"), ("empty.txt", "")] }
worlds : List WorldState := [blank, printed, withFiles]
lines : List String := ["", "hello, world", "two\nlines"]
places : List String := ["stdout", "input.txt", "empty.txt", "other.txt"]

bind (p g : String) : Binding := { parameter := just p, type := nothing, generator := g, coverage := Listed }
onPrint : List Binding := [bind "S" "states", bind "c" "consoles", bind "st" "worlds", bind "s" "lines"]
onPrintElsewhere : List Binding := [bind "S" "states", bind "c" "consoles", bind "st" "worlds", bind "s" "lines",
  bind "p" "places"]
onRead : List Binding := [bind "S" "states", bind "c" "consoles", bind "st" "worlds", bind "p" "places"]

test "PrintAppendsALine" ExhaustiveMode (seed <- 20261015) (whereBindings <- onPrint)
test "PrintChangesOnlyStdout" ExhaustiveMode (seed <- 20261015) (whereBindings <- onPrintElsewhere)
test "ReadGivesThePlace" ExhaustiveMode (seed <- 20261015) (whereBindings <- onRead)
test "ReadChangesNothing" ExhaustiveMode (seed <- 20261015) (whereBindings <- onRead)

-- ---------------------------------------------------------------- the rest of world.lth
-- Added 2026-10-15 by Claude Opus 5.5, an agent of the coordinating session, on
-- record/IA/v04-2026-10-15/prompt-e.md (criterion e of v0.4, L9.14): a line for every other law
-- of world.lth but the roots of trust `FileSystemKeeps` and `SystemDelivers` (axioms, 11.R3, which
-- replaced `ObserverIsFaithful` on 2026-10-26, D-2026-10-16-n: their evidence is a citation or an
-- assumption, never a case) and `Persistence`'s two (tests/tester/plot_laws.test.lut certifies them on
-- plot_model.lut's `files`). The models: `Described` on world.lth's descriptions of the console's
-- actions (§4) and on `lockWrite`, an own action written here (no own action has a model yet);
-- `Externs` on `validator` and `Crossing` on `bridge`, both written here as run.py reads them
-- (the validator of a run and the bridge are run.py's Python, no Luthier value); `Host` over
-- listed `Observed` cases, those a faithful host gathers by `agreement`, on `listedHost`:
-- world_model.lut's `host` under another name, so that an entry of a listed case never serves a
-- run's validation at its first action, which must gather its own case (10.S10; run.py serves a
-- Host law from any entry of the model's store whose reach covers the run's arguments, and the
-- case is no argument). The cutoff of `AppliedWhenSettled` is a census of one, the demand's
-- (D-2026-10-14-c): `Sampled`, demand_model.lut's default [proposed].
-- 2026-10-16, by Claude Opus 5.5, on record/IA/code-follows-2026-10-16/prompt-modes.md
-- (D-2026-10-16-c): the validator applies a provisional extern only when the demand names it; the
-- cutoffs are `Sampled` and `AssumedGrade`, so that a blanket acceptance of assumed evidence is seen
-- not to apply one, and the names the demand runs as assumed are none, or the provisional `guess`.

-- §1, §2 descriptions
unitTypes : List U := [Unit]
maybeTypes : List U := [Maybe String]
stateTypes : List U := [WorldState]
worldModels : List (ReadableWorld WorldState) := [theWorld]
-- an own action: Luthier's lock written with the revision pinned, the same whatever was there
lockWrite : Described WorldState Unit theWorld := {
  describe := fn st { ({ stdout := st.stdout, files := cons ("luthier.lock", "pinned") (dropFile "luthier.lock" st.files) }, unit) },
  own := true, places := ["luthier.lock"] }
dropFile (p : String) (fs : List (String * String)) : List (String * String) :=
  filter List (String * String) (fn (qc : String * String) { match qc { (q, c) -> not (p == q) } }) fs
unitDescriptions : List (Described WorldState Unit theWorld) := [printDescription WorldState console "",
  printDescription WorldState console "hello, world", lockWrite]
-- [bite A3b] the reads and observations own nothing, so `OwnIsIdempotent` (`not d.own or ...`) held
-- on them with no case of its premise (D-2026-10-16-m): each census also lists an own action of its
-- result type, the lock written as above and the content or the state after given back
lockWritten (st : WorldState) : WorldState := { stdout := st.stdout, files := cons ("luthier.lock", "pinned") (dropFile "luthier.lock" st.files) }
lockGiven : Described WorldState (Maybe String) theWorld := {
  describe := fn st { (lockWritten st, just "pinned") }, own := true, places := ["luthier.lock"] }
lockObserved : Described WorldState WorldState theWorld := {
  describe := fn st { (lockWritten st, lockWritten st) }, own := true, places := ["luthier.lock"] }
readDescriptions : List (Described WorldState (Maybe String) theWorld) := [readFileDescription WorldState console "input.txt",
  readFileDescription WorldState console "other.txt", readFileDescription WorldState console "stdout", lockGiven]
observeDescriptions : List (Described WorldState WorldState theWorld) := [observeDescription WorldState console ["stdout", "input.txt"],
  observeDescription WorldState console nil, lockObserved]
locked : WorldState := { stdout := "", files := [("luthier.lock", "old"), ("input.txt", "first\n")] }
moreWorlds : List WorldState := [blank, printed, withFiles, locked]
morePlaces : List String := ["stdout", "input.txt", "empty.txt", "other.txt", "luthier.lock"]
onDescribed (a d : String) : List Binding := [bind "S" "states", bind "A" a, bind "m" "worldModels", bind "d" d,
  bind "s" "moreWorlds"]
onDeclared (a d : String) : List Binding := [bind "S" "states", bind "A" a, bind "m" "worldModels", bind "d" d,
  bind "s" "moreWorlds", bind "p" "morePlaces"]
test "OwnIsIdempotent" ExhaustiveMode (seed <- 20261015) (whereBindings <- onDescribed "unitTypes" "unitDescriptions")
test "OwnIsIdempotent" ExhaustiveMode (seed <- 20261015) (whereBindings <- onDescribed "maybeTypes" "readDescriptions")
test "OwnIsIdempotent" ExhaustiveMode (seed <- 20261015) (whereBindings <- onDescribed "stateTypes" "observeDescriptions")
test "ChangesOnlyDeclared" ExhaustiveMode (seed <- 20261015) (whereBindings <- onDeclared "unitTypes" "unitDescriptions")
test "ChangesOnlyDeclared" ExhaustiveMode (seed <- 20261015) (whereBindings <- onDeclared "maybeTypes" "readDescriptions")
test "ChangesOnlyDeclared" ExhaustiveMode (seed <- 20261015) (whereBindings <- onDeclared "stateTypes" "observeDescriptions")

-- §3 externs: a validator over a type that states laws (a likelihood) and one that states none
lawful : Term := App (Var "Likelihood") (Var "3")
lawless : Term := Var "Float64"
lawsOfType (t : Term) : List String := if t == lawful then ["TangentShapes", "ScoreIsGradient"] else nil
-- the grade of the validation of the bytes at each hash; a hash not listed was refuted or not run
validations : List (String * Grade) := [("sha256:h1", Sampled), ("sha256:h2", Cases), ("sha256:h3", Proved)]
gradeOfRoute (r : Route) (h : String) : Maybe Grade :=
  if isProvisional r then just AssumedGrade else if lawsOfType r.declared == nil then nothing else lookup List String Grade h validations
validator : Externs := {
  lawsOf := lawsOfType,
  gradeOf := gradeOfRoute,
  applied := fn a ns r h { if isProvisional r then member List String r.name ns else settled a (gradeOfRoute r h) },
  identity := fn r h { r.route <> " at " <> h },
}
validators : List Externs := [validator]
-- the cutoff and the state type under names of this file: a census member defined in another file
-- makes that file a home of the line's entries (tester.py's `model_homes`), and neither `Sampled`
-- (a constructor of test.lth) nor `WorldState` (an alias, which `_is_type` does not see as a type) is
-- a model; the Host lines' entries would otherwise land in world_model.cert.json
sampledCutoff : Grade := Sampled
assumedCutoff : Grade := AssumedGrade
cutoff : List Grade := [sampledCutoff, assumedCutoff]
assumedNames : List (List String) := [nil, ["guess"]]
reasons : List String := ["", "a fit to try before its laws are written"]
routes : List Route := [routeOf "fit" lawful "python:m.fit" nothing, routeOf "raw" lawless "python:m.raw" nothing,
  routeOf "guess" lawful "python:m.guess" (just "exploring"), routeOf "rawGuess" lawless "python:m.rawGuess" (just "exploring")]
hashes : List String := ["sha256:h1", "sha256:h2", "sha256:h3", "sha256:h4"]
externNames : List String := ["fit"]
terms : List Term := [lawful, lawless]
routeStrings : List String := ["python:m.fit"]
onRoute : List Binding := [bind "e" "validators", bind "n" "externNames", bind "t" "terms", bind "route" "routeStrings",
  bind "h" "hashes"]
test "AppliedWhenSettled" ExhaustiveMode (seed <- 20261015) (whereBindings <- [bind "e" "validators",
  bind "accepts" "cutoff", bind "assumes" "assumedNames", bind "r" "routes", bind "h" "hashes"])
test "NoLawNoGrade" ExhaustiveMode (seed <- 20261015) (whereBindings <- onRoute)
test "ProvisionalIsAssumed" ExhaustiveMode (seed <- 20261015) (whereBindings <- [bind "e" "validators",
  bind "n" "externNames", bind "t" "terms", bind "route" "routeStrings", bind "h" "hashes", bind "why" "reasons"])
test "IdentityCarriesHash" ExhaustiveMode (seed <- 20261015) (whereBindings <- [bind "e" "validators", bind "r" "routes",
  bind "h" "hashes", bind "k" "hashes"])

-- §3 the crossing of a callback and of a record of functions
bridge : Crossing Int Int := {
  callBack := fn f xs { (map Int Int f xs, size xs) },
  callField := fn fs l xs { match lookup List String (Int -> Int) l fs { just f -> (map Int Int f xs, size xs) ; nothing -> (nil, 0) } },
}
bridges : List (Crossing Int Int) := [bridge]
ints : List Concrete := [Int]
double (x : Int) : Int := 2 * x
succ (x : Int) : Int := x + 1
-- `opposite` and `intFunctions` were `flip` and `functions` until the core's bite 5 (core/properties/
-- functions.lth's names; a file does not redefine a core name, 12.S22, D-2026-10-18-b)
opposite (x : Int) : Int := 0 - x
intFunctions : List (Int -> Int) := [double, succ, opposite]
arguments : List (List Int) := [nil, [1], [1, 2, 3], [0 - 4, 0, 7]]
befores : List (List (String * (Int -> Int))) := [nil, [("g", succ)], [("f", double)]]
afters : List (List (String * (Int -> Int))) := [nil, [("f", opposite)], [("h", succ)]]
labels : List String := ["f", "g"]
onCallback : List Binding := [bind "A" "ints", bind "B" "ints", bind "b" "bridges", bind "f" "intFunctions", bind "xs" "arguments"]
test "CallbackGivesTheFunction" ExhaustiveMode (seed <- 20261015) (whereBindings <- onCallback)
test "CallsAreCounted" ExhaustiveMode (seed <- 20261015) (whereBindings <- onCallback)
test "RecordCrossesByField" ExhaustiveMode (seed <- 20261015) (whereBindings <- [bind "A" "ints", bind "B" "ints",
  bind "b" "bridges", bind "before" "befores", bind "after" "afters", bind "l" "labels", bind "f" "intFunctions",
  bind "xs" "arguments"])

-- §5 the host, over the cases a faithful host gathers along one chain of tokens
listedHost : Host WorldState := { console := console, observe := host.observe, print := host.print, readFile := host.readFile }
hosts : List (Host WorldState) := [listedHost]
HostState = WorldState
hostStates : List Concrete := [HostState]
case (S A : U) (b : S) (x : A) (a : S) : Observed S A := { before := b, result := x, after := a }
after (st : WorldState) (out : String) : WorldState := { stdout := out, files := st.files }
hello : List String := ["hello, world"]
helloCases : List (Observed WorldState Unit) := [case WorldState Unit blank unit (after blank "hello, world\n"),
  case WorldState Unit printed unit (after printed "one\nhello, world\n"), case WorldState Unit withFiles unit (after withFiles "hello, world\n")]
empty : List String := [""]
emptyCases : List (Observed WorldState Unit) := [case WorldState Unit blank unit (after blank "\n"),
  case WorldState Unit printed unit (after printed "one\n\n")]
input : List String := ["input.txt"]
inputCases : List (Observed WorldState (Maybe String)) := [case WorldState (Maybe String) withFiles (just "first\nsecond\n") withFiles,
  case WorldState (Maybe String) blank nothing blank]
otherFile : List String := ["other.txt"]
otherCases : List (Observed WorldState (Maybe String)) := [case WorldState (Maybe String) withFiles nothing withFiles,
  case WorldState (Maybe String) printed nothing printed]
observed : List (List String) := [["stdout", "input.txt"]]
observeCases : List (Observed WorldState WorldState) := [case WorldState WorldState withFiles withFiles withFiles,
  case WorldState WorldState printed printed printed, case WorldState WorldState blank blank blank]
helloHeld : List (Held WorldState Unit theWorld) := [held WorldState Unit theWorld (fn w { listedHost.print w "hello, world" })
  (printDescription WorldState console "hello, world")]
inputHeld : List (Held WorldState (Maybe String) theWorld) := [held WorldState (Maybe String) theWorld
  (fn w { listedHost.readFile w "input.txt" }) (readFileDescription WorldState console "input.txt")]
extras : List (List String) := [["stdout"], ["stdout", "input.txt", "other.txt"]]
test "HostAgreesPrint" ExhaustiveMode (seed <- 20261015) (whereBindings <- [bind "S" "hostStates", bind "o" "hosts",
  bind "s" "hello", bind "c" "helloCases"])
test "HostAgreesPrint" ExhaustiveMode (seed <- 20261015) (whereBindings <- [bind "S" "hostStates", bind "o" "hosts",
  bind "s" "empty", bind "c" "emptyCases"])
test "HostAgreesReadFile" ExhaustiveMode (seed <- 20261015) (whereBindings <- [bind "S" "hostStates", bind "o" "hosts",
  bind "p" "input", bind "c" "inputCases"])
test "HostAgreesReadFile" ExhaustiveMode (seed <- 20261015) (whereBindings <- [bind "S" "hostStates", bind "o" "hosts",
  bind "p" "otherFile", bind "c" "otherCases"])
test "HostObserveChangesNothing" ExhaustiveMode (seed <- 20261015) (whereBindings <- [bind "S" "hostStates", bind "o" "hosts",
  bind "ps" "observed", bind "c" "observeCases"])
test "HostChangesOnlyDeclared" ExhaustiveMode (seed <- 20261015) (whereBindings <- [bind "S" "hostStates", bind "o" "hosts",
  bind "A" "unitTypes", bind "h" "helloHeld", bind "extra" "extras", bind "c" "helloCases"])
test "HostChangesOnlyDeclared" ExhaustiveMode (seed <- 20261015) (whereBindings <- [bind "S" "hostStates", bind "o" "hosts",
  bind "A" "maybeTypes", bind "h" "inputHeld", bind "extra" "extras", bind "c" "inputCases"])
