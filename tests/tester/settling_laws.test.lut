-- tests/tester/settling_laws.test.lut: laws.lth's `Settling` on laws_model.lut's `settling` (core bite 13b).
-- The sixteen laws, among them the two of the combination (`Commutative` and `Associative` at
-- `Verdict`), run on listed censuses: laws of each form, evidence of each shape, and the verdicts.
-- Written 2026-10-22 by Claude Sonnet 5.5 on record/plan/core-2026-10-17/prompt-bite-13b.md.
-- `VacuousIsUnsettled` and `Vacuous 3` among the evidences added 2026-10-23 by Claude Opus 5.5, wave A
-- bite A3 (record/plan/audit-algebras-2026-10-22/prompt-wave-a.md).
-- `WithinIsMeasured` with its metric, distances and bounds added 2026-10-25 by Claude Opus 5.5, wave C
-- bite C1 (record/plan/audit-algebras-2026-10-22/prompt-wave-bc.md).

import "test.lth" test ExhaustiveMode
import "generators.lth" Binding
import "laws.lth" Listed Settling Law Evidence Verdict Case Forall Exists Conjunction Either Not Then Statistical Evaluated At Points
  EvidencePair Side Cited Assumed NotRun Tested Vacuous Coverage Exhaustive Bounded Drawn Confirmed Refuted Supported Unsettled Cites
  Assumes StatisticalVerdict Rates Holds Fails Unresolved byPValue StatisticalLaw Sequential Within Measured
import "laws_model.lut" settling
import "laws.lth" Measuring measuring ratioOf worseRatio

settlings : List Settling := [settling]
bools : List Bool := [true, false]
strings : List String := ["a", "b"]
ints : List Int := [0, 1]
types : List U := [Int]
laws : List Law := [Case true, Case false, Not (Case true), Conjunction (Case true) (Case false), Either (Case false) (Case true)]
quantified : List (Int -> Law) := [fn n { Case (n == 0) }, fn n { Case true }, fn n { Not (Case (n == 0)) }]
points : List (List (Int * Evidence)) := [nil, [(0, Evaluated true)], [(0, Evaluated true), (1, Evaluated true)],
  [(0, Evaluated true), (1, Evaluated false)], [(1, Evaluated false), (0, Cited "c")]]
coverages : List Coverage := [Exhaustive, Listed, Drawn 3, Bounded 2]
evidences : List Evidence := [Evaluated true, Evaluated false, At Int 0 (Evaluated true), At Int 1 (Evaluated false),
  Points Int [(0, Evaluated true), (1, Evaluated true)] Exhaustive, Points Int [(0, Evaluated true), (1, Evaluated true)] (Drawn 3),
  Points Int [(0, Evaluated true), (1, Evaluated false)] Exhaustive, EvidencePair (Evaluated true) (Evaluated false),
  EvidencePair (Evaluated false) (Evaluated false), Side true (Evaluated true), Side false (Evaluated false),
  Cited "c", Assumed, NotRun "r", Vacuous 3]
verdicts : List Verdict := [Confirmed, Refuted, Supported, Unsettled, Cites "c", Assumes]
cutoffs : List Sequential := [{ alpha := 0.05, beta := 0.05, delta := 0.5, initial := 1, budget := 10 }]
pvalueLaws : List (StatisticalLaw Int) := [byPValue Int (fn n { 0.5 })]
draws : List (Nat -> Nat -> Int * Nat) := [fn n t { (0, t + 1) }]
scalarTypes : List U := [Int]
nats : List U := [Nat]
aRate : Rates := { alpha := 0.05, beta := 0.05, delta := 0.5, spent := 1 }
treated : List StatisticalVerdict := [Holds aRate, Fails aRate, Unresolved aRate]
counts : List Nat := [0, 3]
-- [bite C1] a metric and the distances and bounds `WithinIsMeasured` reads
metrics : List (Int -> Int -> Float64) := [fn x y { if x == y then 0.0 else 1.0 }]
floats : List Float64 := [0.0, 1.0, 2.0]

bind (p g : String) : Binding := { parameter := just p, type := nothing, generator := g, coverage := Listed }
ofType (t g : String) : Binding := { parameter := nothing, type := just t, generator := g, coverage := Listed }

test "Settling" ExhaustiveMode (seed <- 20261022) (whereBindings <- [bind "m" "settlings", ofType "Bool" "bools",
  bind "r" "strings", bind "A" "types", bind "a" "ints", ofType "Law" "laws", bind "body" "quantified",
  ofType "Evidence" "evidences", bind "pts" "points", ofType "Coverage" "coverages", ofType "Verdict" "verdicts",
  bind "S" "scalarTypes", bind "T" "nats", bind "l" "pvalueLaws", bind "draw" "draws",
  ofType "Sequential" "cutoffs", ofType "StatisticalVerdict" "treated", bind "n" "counts",
  bind "d" "metrics", bind "bound" "floats", bind "x" "ints", bind "y" "ints", bind "dist" "floats", bind "w" "floats"])

-- [bite C1] what the certifier computes of a numerical law's evidence (laws.lth §5): the ratio of a
-- distance to its bound and the worse of two, on listed distances, bounds (a negative one among them)
-- and ratios (an unbounded one among them); and its controls, a ratio with no guard at a bound of zero
-- or below, and a worse ratio that reads an unbounded one as zero
measurings : List Measuring := [measuring]
signedFloats : List Float64 := [0.0, 1.0, 2.0, -1.0]
ratios : List (Maybe Float64) := [nothing, just 0.0, just 0.5, just 2.0]
test "Measuring" ExhaustiveMode (seed <- 20261025) (whereBindings <- [bind "m" "measurings", bind "bound" "signedFloats",
  bind "dist" "signedFloats", bind "r" "ratios", bind "s" "ratios", bind "q" "ratios"])
unguarded : List Measuring := [{ ratioOf := fn d b { just (if b == 0.0 then 0.0 else d / b) }, worseRatio := worseRatio }]
unboundedAsZero : List Measuring := [{ ratioOf := ratioOf, worseRatio := fn r s {
  { a := (match r { nothing -> 0.0 ; just x -> x })
    b := (match s { nothing -> 0.0 ; just x -> x })
    just (if a < b then b else a) } } }]
test "Measuring" ExhaustiveMode (seed <- 20261025) (whereBindings <- [bind "m" "unguarded", bind "bound" "signedFloats",
  bind "dist" "signedFloats", bind "r" "ratios", bind "s" "ratios", bind "q" "ratios"]) (control <- true)
test "Measuring" ExhaustiveMode (seed <- 20261025) (whereBindings <- [bind "m" "unboundedAsZero", bind "bound" "signedFloats",
  bind "dist" "signedFloats", bind "r" "ratios", bind "s" "ratios", bind "q" "ratios"]) (control <- true)
