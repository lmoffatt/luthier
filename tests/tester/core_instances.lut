-- Bite 6 revision, Codex, 2026-10-21, prompt-bite-6.md at 2859815.
-- Kernel property instances now live in core.lut and write core/core.cert.json.
-- The following historical bite 2 description records the original organization.
-- tests/tester/core_instances.lut: the properties of core/properties/ applied at listed instances,
-- as laws over the instance, so that core_laws.test.lut confirms each on a real instance and
-- core_controls.test.lut refutes it on a wrong one (L9.14: a law without a refuted model is
-- evidence of nothing). Written 2026-10-17 by Claude Fable 5.1, an agent of the coordinating
-- session, on record/plan/core-2026-10-17/prompt-bite-2.md (bite 2 of execution.md).
--
-- Why a file beside the two test programs. A control is matched to its law by the hash of the
-- law's cone (certify.py `control_status`), so the law the controls file names must be the very
-- definition the laws file names, with the instance a parameter bound by each program's census;
-- and a test program is never imported (D-2026-10-16-e). So the wrappers live here, as
-- fit_cutoffs.lut and plot_cases.lut do for their test programs, and the entries of every line
-- land in this file's store, tests/tester/core_instances.cert.json, untracked under tests/
-- (D-2026-10-16-h); bite 3 moves the claims into core.lut, where they get their tracked store.
-- The real instances are defined here too, since the controls need the unbroken ones beside
-- the one they break; the broken instances are core_controls.test.lut's own.
--
-- Each wrapper is named by the type and the property (`IntReflexive`, `BoolCommutative`); its
-- first parameters are the instance (`r` a relation, `op` an operation, `f` a function, `e` a
-- neutral element, `z` an absorbing one, `inv` an inverse, `bound1`..`bound3` a bound by its
-- arity), bound by name from a profile, and the rest are the quantified variables the tester
-- draws. The equalities are the structural `==` of each concrete type, as a value of `Object`
-- (kernel_laws.lth; `structural A` in bite 3).

-- The core is seen without an import (12.S22, the core's bite 5); the names imported here are the
-- ones two core files define until bite 6 (run.py's CORE_COLLISIONS), so the import says which.

-- ---------------------------------------------------------------- the equalities

intEq : Object Int := { eq := fn x y { x == y } }
boolEq : Object Bool := { eq := fn x y { x == y } }
stringEq : Object String := { eq := fn x y { x == y } }

-- ---------------------------------------------------------------- the instances

-- relations on Int
leq : Int -> Int -> Bool := fn a b { a <= b }
less : Int -> Int -> Bool := fn a b { a < b }
equal : Int -> Int -> Bool := fn a b { a == b }
-- the same remainder modulo 2 (the host's floor remainder, so -3 mod 2 is 1)
parity : Int -> Int -> Bool := fn a b { a mod 2 == b mod 2 }

-- operations and elements of Int
plus : Int -> Int -> Int := fn a b { a + b }
minus : Int -> Int -> Int := fn a b { a - b }
times : Int -> Int -> Int := fn a b { a * b }
smaller : Int -> Int -> Int := fn a b { if a <= b then a else b }
larger : Int -> Int -> Int := fn a b { if a <= b then b else a }
-- the projections: `second` is left-neutral for every element and `first` right-neutral
first : Int -> Int -> Int := fn a b { a }
second : Int -> Int -> Int := fn a b { b }
zero : Int := 0
intOne : Int := 1

-- functions on Int
identity : Int -> Int := id Int
negate : Int -> Int := fn x { 0 - x }
succ : Int -> Int := fn x { x + 1 }
pred : Int -> Int := fn x { x - 1 }
double : Int -> Int := fn x { x * 2 }
square : Int -> Int := fn x { x * x }
clamp : Int -> Int := fn x { if x < 0 then 0 else x }
timesZero : Int -> Int := fn x { x * 0 }
remainder2 : Int -> Int := fn x { x mod 2 }
nonNegative : Int -> Bool := fn y { 0 <= y }
-- built with the combinators, each equal pointwise to a function written by hand
succThenPred : Int -> Int := compose Int Int Int pred succ
zeroConst : Int -> Int := const Int Int 0
flippedMinus : Int -> Int -> Int := flip Int Int Int minus
reversedMinus : Int -> Int -> Int := fn a b { b - a }

-- Bool
boolAnd : Bool -> Bool -> Bool := fn a b { a and b }
boolOr : Bool -> Bool -> Bool := fn a b { a or b }
boolNot : Bool -> Bool := fn b { not b }
top : Bool := true
bottom : Bool := false

-- String
append : String -> String -> String := fn a b { a <> b }
empty : String := ""

-- Float64, with the distance and the bounds of the within-bound laws. `unitRoundoff` is
-- 2^-53, the unit roundoff of the doubles; `gamma2 = 2u / (1 - 2u)` (Higham 2002, section 2.2);
-- `sumBound` is the bound of D-2026-10-17-f as dc781f2 corrects it, `3 gamma2 (|x| + |y| + |z|)`,
-- and `productBound` the same derivation for `x (y + z)` against `x y + x z`: each side carries
-- two roundings, so the two differ by at most `(2 gamma2 + gamma2^2) |x| (|y| + |z|)`, below
-- `3 gamma2 |x| (|y| + |z|)`. `scaleBound` bounds `x * 0.1` against `x / 10`: the first carries
-- the rounding of 0.1 and of the product, the second one rounding, three in all, below
-- `gamma2 |x|` by a factor near two. A bound of zero is the exact property, the control's.
fplus : Float64 -> Float64 -> Float64 := fn a b { a + b }
ftimes : Float64 -> Float64 -> Float64 := fn a b { a * b }
fzero : Float64 := 0.0
fnegate : Float64 -> Float64 := fn x { 0.0 - x }
fclamp : Float64 -> Float64 := fn x { if x < 0.0 then 0.0 else x }
tenth : Float64 -> Float64 := fn x { x * 0.1 }
byTen : Float64 -> Float64 := fn x { x / 10.0 }
absolute : Float64 -> Float64 := fn x { if x < 0.0 then 0.0 - x else x }
absDistance : Float64 -> Float64 -> Float64 := fn a b { absolute (a - b) }
unitRoundoff : Float64 := 1.0 / 9007199254740992.0
gamma2 : Float64 := 2.0 * unitRoundoff / (1.0 - 2.0 * unitRoundoff)
sumBound : Float64 -> Float64 -> Float64 -> Float64 := fn x y z { 3.0 * gamma2 * (absolute x + absolute y + absolute z) }
productBound : Float64 -> Float64 -> Float64 -> Float64 := fn x y z { 3.0 * gamma2 * absolute x * (absolute y + absolute z) }
scaleBound : Float64 -> Float64 := fn x { gamma2 * absolute x }
noBound1 : Float64 -> Float64 := fn x { 0.0 }
noBound2 : Float64 -> Float64 -> Float64 := fn x y { 0.0 }
noBound3 : Float64 -> Float64 -> Float64 -> Float64 := fn x y z { 0.0 }
