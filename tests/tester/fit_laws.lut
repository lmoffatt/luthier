-- tests/tester/fit_laws.lut: the fit's laws on the quadratic family, on the brief
-- record/IA/evidence-2026-10-14/prompt.md, item 3: `QuadraticConverges` (belief.lth) on two
-- models of `Maximizer`, the host's Levenberg-Marquardt (`lm`, belief_model.lut) and the native
-- one (`lmMaximizer` with v0.1's damping, optimization_model.lut); the laws of `LMStep`
-- (optimization.lth) on its two models, the host's (`host`) and the native definitions
-- (`native`). The quadratic family is drawn: its maximum `b`, its curvature `c` and the start.
-- `DirectionDescends`, `DirectionAgrees` and `StepRule` take an objective, a record of functions
-- (7.R4); the three `...OnQuadratic` below [proposed] are each law applied to the family's
-- objective, so that the family's parameters are what the tester draws. `MaximizersAgree`
-- [proposed] states the question of item 3, that the two maximizers end at the same point and
-- say the same about convergence, within the tolerance. Each cutoff a census of one, the demand's
-- (D-2026-10-14-c): session A's settings and v0.1's damping (tests/tester/session_a.lut), the
-- tolerance 1e-12 [proposed]. Seed 20261014: every line draws the same cases, the models being
-- censuses. [2026-10-16] The three `...OnQuadratic` now live in optimization.lth, `MaximizersAgree`
-- in belief.lth and `nativeLM` in examples/sonolocalizacion/session_a.lut, so that every entry
-- has a file that claims it and this test program keeps no store (L10.12).

import "test.lth" test ExhaustiveMode SampledMode
import "generators_model.lut" linear
import "generators.lth" Binding
import "laws.lth" Listed
import "numbers.lth" Tolerance Positive
import "arrays.lth" Dim VecOf approxVec
import "belief.lth" Maximizer Settings MaxResult quadratic QuadraticConverges MaximizersAgree
import "belief_model.lut" lm
import "optimization.lth" LMStep Damping LMState quadraticObjective QuadraticStepAccepts DirectionDescends
  DirectionAgrees StepRule DirectionDescendsOnQuadratic DirectionAgreesOnQuadratic StepRuleOnQuadratic
import "optimization_model.lut" native host
import "../../examples/sonolocalizacion/session_a.lut" settingsA dampingA nativeLM

tolerance : Tolerance := 1.0e-12
-- the iterations the demand grants a maximizer on the quadratic family (QuadraticConverges's
-- `budget`), a census of one, 50, as the probe of record/IA/layer-3-review-2026-10-15/report-fix-BCD.md
-- [proposed]; settingsA's maxIter 500 is above it, so the law is asked
budget : Nat := 50

cutoffs : List Binding := [
  { parameter := just "s", type := nothing, generator := "settingsA", coverage := Listed },
  { parameter := just "d", type := nothing, generator := "dampingA", coverage := Listed },
  { parameter := just "tol", type := nothing, generator := "tolerance", coverage := Listed },
  { parameter := just "budget", type := nothing, generator := "budget", coverage := Listed } ]
onLm : List Binding := [ { parameter := just "mx", type := nothing, generator := "lm", coverage := Listed } ]
onNativeLM : List Binding := [ { parameter := just "mx", type := nothing, generator := "nativeLM", coverage := Listed } ]
onHost : List Binding := [ { parameter := just "m", type := nothing, generator := "host", coverage := Listed } ]
onNative : List Binding := [ { parameter := just "m", type := nothing, generator := "native", coverage := Listed } ]
both : List Binding := [
  { parameter := just "mx", type := nothing, generator := "lm", coverage := Listed },
  { parameter := just "my", type := nothing, generator := "nativeLM", coverage := Listed } ]

-- Maximizer: the host's, the native one, and whether they agree
test "QuadraticConverges" (SampledMode linear) (seed <- 20261014) (whereBindings <- onLm) (profile <- cutoffs)
test "QuadraticConverges" (SampledMode linear) (seed <- 20261014) (whereBindings <- onNativeLM) (profile <- cutoffs)
test "MaximizersAgree" (SampledMode linear) (seed <- 20261014) (whereBindings <- both) (profile <- cutoffs)
-- LMStep: the host's, then the native definitions
test "QuadraticStepAccepts" (SampledMode linear) (seed <- 20261014) (whereBindings <- onHost) (profile <- cutoffs)
test "DirectionDescendsOnQuadratic" (SampledMode linear) (seed <- 20261014) (whereBindings <- onHost) (profile <- cutoffs)
test "DirectionAgreesOnQuadratic" (SampledMode linear) (seed <- 20261014) (whereBindings <- onHost) (profile <- cutoffs)
test "StepRuleOnQuadratic" (SampledMode linear) (seed <- 20261014) (whereBindings <- onHost) (profile <- cutoffs)
test "QuadraticStepAccepts" (SampledMode linear) (seed <- 20261014) (whereBindings <- onNative) (profile <- cutoffs)
test "DirectionDescendsOnQuadratic" (SampledMode linear) (seed <- 20261014) (whereBindings <- onNative) (profile <- cutoffs)
test "DirectionAgreesOnQuadratic" (SampledMode linear) (seed <- 20261014) (whereBindings <- onNative) (profile <- cutoffs)
test "StepRuleOnQuadratic" (SampledMode linear) (seed <- 20261014) (whereBindings <- onNative) (profile <- cutoffs)
