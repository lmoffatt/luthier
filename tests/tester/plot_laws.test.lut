-- tests/tester/plot_laws.test.lut: the laws of `Drawing` (plot.lth §5) on matplotlib's drawing
-- (plot_model.lut, src/luthier/plots.py) and of `Persistence` (world.lth §2) on its store
-- `files`, as listed cases, on the brief record/IA/plots-2026-10-15/prompt-host.md (item 2: the
-- run of tests/run/plot_two_tables.run.lut is refused while these laws have no entry). Written
-- 2026-10-15 by Claude Opus 5.5, an agent of the coordinating session. `Plot` and the
-- permutations of rows have no generator, so each census is a list: plots built here from tables
-- parsed by `csv` (points and a line; points coloured by a palette, a text from a second table
-- and a line y = x; the same plots built a second time, for `ImageOfTheValue`), the three-row
-- table of the first under every permutation of its rows, two layers apart for the swap.
-- `S` is bound to world_model.lut's `State`, the representation `files` is a store of. The
-- margin of `LayerOrderInvariant` is a census of one, the demand's (D-2026-10-14-c):
-- 0.05 [proposed], a twentieth of the span of the two layers together. Seed 20261015 (the
-- censuses are listed; the seed only names the run). [2026-10-16] The plots and the censuses but
-- those of models live in plot_cases.lut, which the controls import too: a test program is never
-- imported (D-2026-10-16-e).

import "test.lth" test ExhaustiveMode
import "generators.lth" Binding
import "laws.lth" Listed
import "tables.lth" Table
import "tables_model.lut" csv
import "plot.lth" Plot Canvas Mapping Drawing Margin plot table point line addLayer texts abline scale labels linear
  auto palette FileExistsAfter FormatByExtension ImageOfTheValue RowOrderInvariant LayerOrderInvariant
  ImageSeesTheTitle
import "world.lth" Persistence WriteThenRead WriteChangesOnlyItsPlace
import "world_model.lut" WorldState
import "plot_model.lut" matplotlibDrawing files
import "plot_cases.lut" states plots again exts stems worlds tableNames obsTables perms margins positions titles paths
  contents bindTo

drawings : List (Drawing WorldState) := [matplotlibDrawing]
stores : List (Persistence WorldState) := [files]

onExists : List Binding := [bindTo "S" "states", bindTo "d" "drawings", bindTo "p" "plots", bindTo "stem" "stems",
  bindTo "ext" "exts", bindTo "st" "worlds"]
onFormat : List Binding := [bindTo "S" "states", bindTo "d" "drawings", bindTo "p" "plots", bindTo "ext" "exts"]
onValue : List Binding := [bindTo "S" "states", bindTo "d" "drawings", bindTo "p" "plots", bindTo "q" "again", bindTo "ext" "exts"]
onRows : List Binding := [bindTo "S" "states", bindTo "d" "drawings", bindTo "p" "plots", bindTo "name" "tableNames",
  bindTo "t" "obsTables", bindTo "f" "perms", bindTo "ext" "exts"]
onLayers : List Binding := [bindTo "S" "states", bindTo "d" "drawings", bindTo "margin" "margins", bindTo "p" "plots",
  bindTo "i" "positions", bindTo "ext" "exts"]
onTitle : List Binding := [bindTo "S" "states", bindTo "d" "drawings", bindTo "p" "plots", bindTo "s" "titles", bindTo "ext" "exts"]
onWrite : List Binding := [bindTo "S" "states", bindTo "s" "stores", bindTo "st" "worlds", bindTo "p" "paths", bindTo "c" "contents"]
onOthers : List Binding := [bindTo "S" "states", bindTo "s" "stores", bindTo "st" "worlds", bindTo "p" "paths", bindTo "c" "contents",
  bindTo "q" "paths"]

test "FileExistsAfter" ExhaustiveMode (seed <- 20261015) (whereBindings <- onExists)
test "FormatByExtension" ExhaustiveMode (seed <- 20261015) (whereBindings <- onFormat)
test "ImageOfTheValue" ExhaustiveMode (seed <- 20261015) (whereBindings <- onValue)
test "RowOrderInvariant" ExhaustiveMode (seed <- 20261015) (whereBindings <- onRows)
test "LayerOrderInvariant" ExhaustiveMode (seed <- 20261015) (whereBindings <- onLayers)
test "ImageSeesTheTitle" ExhaustiveMode (seed <- 20261015) (whereBindings <- onTitle)
test "WriteThenRead" ExhaustiveMode (seed <- 20261015) (whereBindings <- onWrite)
test "WriteChangesOnlyItsPlace" ExhaustiveMode (seed <- 20261015) (whereBindings <- onOthers)
