-- tests/tester/sonolocalizacion_controls.test.lut: the controls of the laws tests/tester/
-- sonolocalizacion_laws.test.lut certifies on the port (examples/sonolocalizacion). Each line is the
-- law's line written `(control <- true)` (test.lth's `control`), with the model replaced by one
-- broken on purpose, and is expected to be refuted (7.S19 as D-2026-10-15-a generalized it to every
-- law; L9.14). Written 2026-10-15 by Claude Opus 5.5, an agent of the coordinating session, on
-- record/IA/v04-2026-10-15/prompt-e.md. The broken models: a layout whose `from` reads the vector
-- row by row (the table transposed: the same as `layout` at one node, wrong from two); the native
-- likelihoods with the constant K/2 log(2 pi) dropped from the log-likelihood (K the number of
-- pairs), the score and information kept; a check of the graph that sees the schema and no row.
-- Every cutoff, seed, size and count is the law line's.

import "test.lth" test ExhaustiveMode SampledMode
import "generators_model.lut" linear
import "generators.lth" Binding
import "laws.lth" Listed
import "numbers.lth" Tolerance
import "arrays.lth" Dim MatOf VecOf mat
import "algebra.lth" Iso FromUndoesTo ToUndoesFrom
import "probability.lth" Likelihood log2pi
import "../../examples/sonolocalizacion/positions.lut" layout LayoutFromUndoesTo LayoutToUndoesFrom
import "../../examples/sonolocalizacion/distances.lut" FullAgrees ProfileAgrees ProfileIsFullAtItsSigma nativeFull nativeProfile
  freeDim nPairs
import "../../examples/sonolocalizacion/distance_graph.lut" DistanceGraph Violation ReportsValidity graphOf parseTable
  HasNodeColumns HasMeasurementColumns schema
import "../../examples/sonolocalizacion/session_a.lut" nodesTextA measurementsTextA the graphA

tolerance : Tolerance := 1.0e-12
cutoffs : List Binding := [ { parameter := just "tol", type := nothing, generator := "tolerance", coverage := Listed } ]

-- positions.lut: the vector read row by row
rowMajor (n : Dim) : Iso (MatOf 3 n) (VecOf (3 * n)) :=
  { eqA := (layout n).eqA, eqB := (layout n).eqB, to := (layout n).to,
    from := fn p { mat Float64 3 (p.n / 3) (fn a k { p.f (a * (p.n / 3) + k) }) } }
rowMajors : List ((n : Dim) -> Iso (MatOf 3 n) (VecOf (3 * n))) := [rowMajor]
onRowMajor : List Binding := [ { parameter := just "lay", type := nothing, generator := "rowMajors", coverage := Listed } ]
test "LayoutFromUndoesTo" (SampledMode linear) (seed <- 20261014) (whereBindings <- onRowMajor) (control <- true)
test "LayoutToUndoesFrom" (SampledMode linear) (seed <- 20261014) (whereBindings <- onRowMajor) (control <- true)

-- distances.lut: the log-likelihoods without their constant
dropped : Float64 := 0.5 * toFloat64 nPairs * log2pi
noConstantFull : Likelihood (freeDim + 1) := { k := nativeFull.k, loglik := fn y t { nativeFull.loglik y t + dropped },
  score := nativeFull.score, info := nativeFull.info }
noConstantProfile : Likelihood freeDim := { k := nativeProfile.k, loglik := fn y t { nativeProfile.loglik y t + dropped },
  score := nativeProfile.score, info := nativeProfile.info }
onFull : List Binding := [ { parameter := just "l", type := nothing, generator := "noConstantFulls", coverage := Listed } ]
onProfile : List Binding := [ { parameter := just "l", type := nothing, generator := "noConstantProfiles", coverage := Listed } ]
noConstantFulls : List (Likelihood (freeDim + 1)) := [noConstantFull]
noConstantProfiles : List (Likelihood freeDim) := [noConstantProfile]
test "FullAgrees" (SampledMode linear) (cases <- 5) (size <- 5) (seed <- 20261014) (whereBindings <- onFull) (profile <- cutoffs) (control <- true)
test "ProfileAgrees" (SampledMode linear) (cases <- 5) (size <- 5) (seed <- 20261014) (whereBindings <- onProfile) (profile <- cutoffs) (control <- true)
test "ProfileIsFullAtItsSigma" (SampledMode linear) (cases <- 5) (size <- 5) (seed <- 20261014) (whereBindings <- onProfile) (profile <- cutoffs) (control <- true)

-- distance_graph.lut: a check that sees the schema and no row, on sonolocalizacion_laws.test.lut's graphs
schemaOnly (g : DistanceGraph) : Maybe Violation :=
  if not (HasNodeColumns g) then just (schema "HasNodeColumns")
  else if not (HasMeasurementColumns g) then just (schema "HasMeasurementColumns") else nothing
graphFrom (nodes measurements : String) : DistanceGraph := the (graphOf (parseTable (just nodes)) (parseTable (just measurements)))
graphs : List DistanceGraph := [
  graphA,
  graphFrom "name:str,x:float,y:float,z:float\nmic1,0.0,0.0,1.69\n" measurementsTextA,
  graphFrom nodesTextA "i:int,j:int\n1,2\n",
  graphFrom nodesTextA (measurementsTextA + "1,99,2.0\n"),
  graphFrom nodesTextA (measurementsTextA + "3,3,1.0\n"),
  graphFrom nodesTextA (measurementsTextA + "1,2,0.0\n"),
  graphFrom (nodesTextA + "extra,9.0,9.0,1.0,0.0,1.0,0.01\n") measurementsTextA,
  graphFrom (nodesTextA + "mic1,9.0,9.0,1.0,1.0,1.0,0.01\n") measurementsTextA,
  graphFrom nodesTextA (measurementsTextA + "6,7,1.0\n") ]
checks : List (DistanceGraph -> Maybe Violation) := [schemaOnly]
listedGraphs : List Binding := [
  { parameter := just "f", type := nothing, generator := "checks", coverage := Listed },
  { parameter := just "g", type := nothing, generator := "graphs", coverage := Listed } ]
test "ReportsValidity" ExhaustiveMode (whereBindings <- listedGraphs) (control <- true)
