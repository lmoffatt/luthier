-- tests/tester/tables_controls.lut: the controls of tables.lth's laws. Each line is written
-- `(control <- true)` (test.lth's `control`) and is expected to be refuted: it shows that a law of
-- tables_laws.lut can fail on a case that breaks it, so that its passing there is not vacuous
-- (7.S19 as D-2026-10-15-a generalized it to every law; L9.14). The tester records its outcome as a
-- control's entry, never the law's failure, and `luthier certify tables_laws.lut
-- tables_controls.lut` reports the law controlled. Kept apart from tables_laws.lut, which it was
-- before the control had its own kind of entry.

import "test.lth" test ExhaustiveMode
import "generators.lth" Binding
import "laws.lth" Listed
import "tables.lth" Table Cell int CellsOfTheirKind

-- a table with a cell that is nothing where its column says int: not a table of the theory
-- (CellsOfTheirKind)
holeT : Table := { nRows := 2, names := ["k"], kinds := ["int"],
  cell := fn c r { if c == "k" then (if r == 0 then just (int 1) else nothing) else nothing } }

holes : List Table := [ holeT ]
holeOnly : List Binding := [ { parameter := just "t", type := nothing, generator := "holes", coverage := Listed } ]

-- expected to be refuted: the table with a nothing cell breaks the law
test "CellsOfTheirKind" ExhaustiveMode (seed <- 20261014) (whereBindings <- holeOnly) (control <- true)
