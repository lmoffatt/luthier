-- tests/tester/certification_controls.test.lut: the controls of the laws tests/tester/
-- certification_laws.test.lut certifies (7.S19 as D-2026-10-15-a generalized it, L9.14). Each line is
-- the law's line written `(control <- true)`, with the model replaced by one broken on purpose, and
-- is expected to be refuted. Written 2026-10-16 by Claude Opus 5.5, an agent of the coordinating
-- session, on record/IA/code-follows-2026-10-16/prompt-replay-fuel.md. The broken models: a store
-- that absorbs every replay of a known identity, a disagreeing one too (certification.lth's
-- `record` before D-2026-10-15-f); one that writes a not-run for lack of fuel (before
-- D-2026-10-15-g); and a `certifying` whose grade and refusal do not see a disagreement. The
-- entries, stores and censuses are certification_laws.test.lut's.

import "test.lth" test ExhaustiveMode Grade Proved Cases Sampled defaultBudgets Budgets
import "generators.lth" Binding
import "laws.lth" Listed Cited
import "certification.lth" Certifying Recording Entry Certificate ConeDemand ConeName Refusal Outcome Passed Failed NotRunFor
  fuelSpent outOfFuel known recordEntry failureAt Current agree disputedAt
  ANewIdentityGoesInFront AnAgreeingReplayAddsNothing AnAgreeingPairSettles ADisagreeingReplayIsKept AnExhaustionIsNeverStored ADisagreementRefutes ADisagreementIsRefused
import "certification.lth" Routing Routed Theory Veto Members Printed Disagrees
import "certification_model.lut" routing witness veto firstDispute firstFailure routesOf entryIdentity
import "certification_model.lut" certifying hasFailure passes weakestOfBests serves stateOf entryFailed
import "term.lth" Term Act Program Alpha Substitution Reduction Var Lit Lam App Pi Pair Match Let Define
  IntConst PVar PPair
import "term_model.lut" alpha substitute stepper
import "certification.lth" Erasure ErasureKeepsTheStep eraseBinders erased samplingOf Identity Pruning Hash

entry (l : String) (s : Int) (g : Maybe Grade) (o : Outcome) : Entry :=
  { law := l, cone := "sha256:cccc", binding := nil, seed := s, cases := 1, conjunct := nothing, conjuncts := nil, budgets := defaultBudgets, reach := nil,
    evidence := Cited "listed", grade := g, outcome := o, date := "2026-10-16", interpreter := "listed", hosts := nil }
passOne : Entry := entry "L" 1 (just Cases) Passed
failOne : Entry := entry "L" 1 nothing (Failed "x = 1")
passTwo : Entry := entry "L" 2 (just Cases) Passed
fuelOne : Entry := entry "L" 1 nothing (NotRunFor fuelSpent)
notRunOne : Entry := entry "L" 1 nothing (NotRunFor "no generator")
passOther : Entry := entry "M" 1 (just Cases) Passed
entries : List Entry := [passOne, failOne, passTwo, fuelOne, notRunOne, passOther]
stores : List (List Entry) := [nil, [passOne], [passTwo, passOne], [failOne, passOne], [failOne, failOne, passOne],
  [passOther]]
models : List Certifying := [certifying]

-- a store that absorbs a disagreeing replay: a known identity leaves it as it is, whatever the
-- replay gave
absorb (e : Entry) (es : List Entry) : List Entry :=
  match known certifying (certifying.identity e) es { just f -> es ; nothing -> cons e es }
absorbing : Recording certifying := { record := absorb }
-- a store that writes a not-run for lack of fuel
keepFuel (e : Entry) (es : List Entry) : List Entry := if outOfFuel e.outcome then cons e es else recordEntry certifying e es
keepingFuel : Recording certifying := { record := keepFuel }
-- a store that drops an identity it has not seen
dropNew (e : Entry) (es : List Entry) : List Entry :=
  match known certifying (certifying.identity e) es { just f -> recordEntry certifying e es ; nothing -> es }
droppingNew : Recording certifying := { record := dropNew }
-- a store that writes an exact replay that agrees, where no disagreement stands
writeAgreeing (e : Entry) (es : List Entry) : List Entry :=
  match known certifying (certifying.identity e) es {
    just f -> if agree e f and not (disputedAt certifying.identity (certifying.identity e) es) then cons e es
              else recordEntry certifying e es ;
    nothing -> cons e es }
writingAgreeing : Recording certifying := { record := writeAgreeing }
-- a store that leaves a disagreement standing when an agreeing replay comes
keepDispute (e : Entry) (es : List Entry) : List Entry :=
  match known certifying (certifying.identity e) es {
    just f -> if agree e f and disputedAt certifying.identity (certifying.identity e) es then es
              else recordEntry certifying e es ;
    nothing -> cons e es }
keepingDispute : Recording certifying := { record := keepDispute }
droppingModels : List (Recording certifying) := [droppingNew]
agreeingModels : List (Recording certifying) := [writingAgreeing]
disputeModels : List (Recording certifying) := [keepingDispute]
absorbingModels : List (Recording certifying) := [absorbing]
fuelModels : List (Recording certifying) := [keepingFuel]

-- a `certifying` blind to a disagreement: the grade and the refusal of certification_model.lut's
-- draft 1
blindGrade (c : Certificate) : Maybe Grade :=
  if hasFailure c c.entries then nothing else weakestOfBests (passes c c.entries) (passes c c.entries) nothing
blindLaw (es : List Entry) (n : String) (d : ConeDemand) : List Refusal :=
  match failureAt d.law d.cone es {
    just f -> [{ name := n, law := just d.law, state := Current f.outcome }] ;
    nothing -> if any List Entry (fn (e : Entry) { serves d e }) es then nil
               else [{ name := n, law := just d.law, state := stateOf d es }] }
blindLaws (es : List Entry) (n : String) (ds : List ConeDemand) : List Refusal :=
  concat Refusal (map ConeDemand (List Refusal) (blindLaw es n) ds)
blindName (es : List Entry) (c : ConeName) : List Refusal := blindLaws es c.name c.laws
blindRefuse (es : List Entry) (cs : List ConeName) : List Refusal :=
  concat Refusal (map ConeName (List Refusal) (blindName es) cs)
blind : Certifying := { identity := certifying.identity, stale := certifying.stale, grade := blindGrade,
  contains := certifying.contains, serves := certifying.serves, refuse := blindRefuse, transport := certifying.transport }
blindModels : List Certifying := [blind]

certificates : List Certificate := [{ law := "L", cone := "sha256:cccc", entries := nil },
  { law := "L", cone := "sha256:cccc", entries := [passTwo] }]
ofTheLaw : List Entry := [passOne, failOne, passTwo, notRunOne]
outcomes : List Outcome := [Passed, Failed "x = 2", NotRunFor "no generator"]
grades : List (Maybe Grade) := [nothing, just Cases, just Proved]
behindStores : List (List Entry) := [nil, [passTwo]]
demands : List ConeDemand := [{ law := "L", cone := "sha256:cccc", given := nil, accepts := Cases }]
names : List String := ["n"]

bind (p g : String) : Binding := { parameter := just p, type := nothing, generator := g, coverage := Listed }

test "ADisagreeingReplayIsKept" ExhaustiveMode (seed <- 20261016) (whereBindings <- [bind "k" "models",
  bind "r" "absorbingModels", bind "e" "entries", bind "es" "stores"]) (control <- true)
test "AnExhaustionIsNeverStored" ExhaustiveMode (seed <- 20261016) (whereBindings <- [bind "k" "models",
  bind "r" "fuelModels", bind "e" "entries", bind "es" "stores"]) (control <- true)
test "ADisagreementRefutes" ExhaustiveMode (seed <- 20261016) (whereBindings <- [bind "k" "blindModels",
  bind "c" "certificates", bind "e" "ofTheLaw", bind "o" "outcomes", bind "g" "grades", bind "es" "behindStores"])
  (control <- true)
test "ADisagreementIsRefused" ExhaustiveMode (seed <- 20261016) (whereBindings <- [bind "k" "blindModels",
  bind "n" "names", bind "d" "demands", bind "e" "ofTheLaw", bind "o" "outcomes", bind "g" "grades",
  bind "es" "behindStores"]) (control <- true)
test "ANewIdentityGoesInFront" ExhaustiveMode (seed <- 20261016) (whereBindings <- [bind "k" "models",
  bind "r" "droppingModels", bind "e" "entries", bind "es" "stores"]) (control <- true)
test "AnAgreeingReplayAddsNothing" ExhaustiveMode (seed <- 20261016) (whereBindings <- [bind "k" "models",
  bind "r" "agreeingModels", bind "e" "entries", bind "es" "stores"]) (control <- true)
test "AnAgreeingPairSettles" ExhaustiveMode (seed <- 20261016) (whereBindings <- [bind "k" "models",
  bind "r" "disputeModels", bind "e" "entries", bind "es" "stores"]) (control <- true)

-- The controls of `IdentityIsTheKey` and of the retention law (core bite 13b, on bite 13c's items 1
-- and 2). An identity that reads no budget; a pruning that keeps the four latest entries and
-- forgets a failure behind them (what certify.py did before bite 13c); one that also drops the two
-- entries of a disagreement; one that keeps what was never in the store. The entries and stores
-- are certification_laws.test.lut's.
otherSampling : Budgets := { tries := 2000, redraws := 50, probes := 5, drawsPerCase := 10, coveringAbove := 20000,
                             levelRuns := 10, seedsPerControl := 5, distributionDraws := 10000, fuel := 3000000,
                             regionNumbers := 4000, regionEntries := 400, specialMass := 0.45, atomAtZero := 0.01 }
passUnderOther : Entry :=
  { law := "L", cone := "sha256:cccc", binding := nil, seed := 1, cases := 1, conjunct := nothing, conjuncts := nil, budgets := otherSampling, reach := nil,
    evidence := Cited "listed", grade := just Cases, outcome := Passed, date := "2026-10-16", interpreter := "listed", hosts := nil }
identityEntries : List Entry := [passOne, passUnderOther, failOne, passOther]
noBudgetIdentity (e : Entry) : Identity :=
  { law := e.law, cone := e.cone, binding := e.binding, seed := e.seed, cases := e.cases, conjunct := e.conjunct,
    sampling := samplingOf defaultBudgets }
ignoresSampling : Certifying := { identity := noBudgetIdentity, stale := certifying.stale, grade := certifying.grade,
  contains := certifying.contains, serves := certifying.serves, refuse := certifying.refuse, transport := certifying.transport }
ignoringModels : List Certifying := [ignoresSampling]
test "IdentityIsTheKey" ExhaustiveMode (seed <- 20261022) (whereBindings <- [bind "k" "ignoringModels", bind "e" "identityEntries"])
  (control <- true)

pass3 : Entry := entry "L" 3 (just Cases) Passed
pass4 : Entry := entry "L" 4 (just Cases) Passed
pass5 : Entry := entry "L" 5 (just Cases) Passed
pass6 : Entry := entry "L" 6 (just Cases) Passed
oldFailure : Entry := entry "L" 7 nothing (Failed "x = 7")
disagreeing : Entry := entry "L" 1 (just Sampled) Passed
pruneStores : List (List Entry) := [nil, [passOne], [failOne, passOne], [pass6, pass5, pass4, pass3, passTwo, oldFailure],
  [pass6, pass5, pass4, pass3, passTwo, passOne], [pass6, pass5, pass4, pass3, disagreeing, passOne]]
pruneHashes : List Hash := ["sha256:cccc", "sha256:dddd"]
pruneCertificates : List Certificate := [{ law := "L", cone := "sha256:cccc", entries := nil },
  { law := "L", cone := "sha256:cccc", entries := [pass6, pass5, pass4, pass3, passTwo, oldFailure] },
  { law := "L", cone := "sha256:cccc", entries := [pass6, pass5, pass4, pass3, passTwo, passOne] },
  { law := "L", cone := "sha256:cccc", entries := [pass6, pass5, pass4, pass3, disagreeing, passOne] }]
pruneEntries : List Entry := [passOne, failOne, oldFailure, pass6, disagreeing]
forgetsFailures (h : Hash) (es : List Entry) : List Entry :=
  filter List Entry (fn (e : Entry) { e.cone == h }) (take Entry 4 es)
forgetsDisagreements (h : Hash) (es : List Entry) : List Entry :=
  filter List Entry (fn (e : Entry) { e.cone == h and (entryFailed e
    or any List Entry (fn (f : Entry) { f == e }) (take Entry 4 (filter List Entry (fn (x : Entry) { x.cone == h and not (entryFailed x) }) es))) }) es
inventsEntries (h : Hash) (es : List Entry) : List Entry := cons passOther es
forgettingPrunings : List (Pruning certifying) := [{ prune := forgetsFailures }]
undisputingPrunings : List (Pruning certifying) := [{ prune := forgetsDisagreements }]
inventingPrunings : List (Pruning certifying) := [{ prune := inventsEntries }]
test "PruningKeepsACurrentFailure" ExhaustiveMode (seed <- 20261022) (whereBindings <- [bind "k" "models",
  bind "p" "forgettingPrunings", bind "h" "pruneHashes", bind "es" "pruneStores", bind "e" "pruneEntries"]) (control <- true)
test "PruningNeverRaisesAGrade" ExhaustiveMode (seed <- 20261022) (whereBindings <- [bind "k" "models",
  bind "p" "undisputingPrunings", bind "c" "pruneCertificates"]) (control <- true)
test "PruningOnlyDrops" ExhaustiveMode (seed <- 20261022) (whereBindings <- [bind "k" "models",
  bind "p" "inventingPrunings", bind "h" "pruneHashes", bind "es" "pruneStores"]) (control <- true)

-- The control of `ErasureKeepsTheStep` (D-2026-10-15-e), added 2026-10-18 by Claude Opus 5.5 on
-- record/plan/core-2026-10-17/prompt-bite-1.md: an erasure that also erases the binder of a lambda
-- at the head of a term or of its function, leaving its occurrences free. It goes past the
-- annotation into what the term does, and the beta of the first term shows it.
one : Term := Lit (IntConst 1)
incBody : Term := Lam "k" (Var "Int") (Pair (Var "k") (Var "k"))
erasurePrograms : List Program := [nil, [Define "inc" (Pi "_" (Var "Int") (Var "Int")) incBody]]
erasureTerms : List Term := [
  App (Lam "x" (Var "Int") (Var "x")) one,
  Let "y" (Var "Int") one (Pair (Var "y") (Var "y")),
  App (Var "inc") one ]
eraseBinderNames (t : Term) : Term := match t {
  Lam x a b -> Lam "erased" erased (eraseBinders b) ;
  App f a -> App (eraseBinderNames f) (eraseBinders a) ;
  _ -> eraseBinders t }
alphas : List Alpha := [alpha]
substitutions : List (Substitution alpha) := [substitute]
steppers : List (Reduction alpha substitute) := [stepper]
greedyErasures : List (Erasure alpha substitute stepper) := [{ erase := eraseBinderNames }]
test "ErasureKeepsTheStep" ExhaustiveMode (seed <- 20261018) (whereBindings <- [bind "a" "alphas",
  bind "sb" "substitutions", bind "m" "steppers", bind "e" "greedyErasures", bind "p" "erasurePrograms",
  bind "t" "erasureTerms"]) (control <- true)

rEntry (l : String) (h : Hash) (m fp : String) (c : Maybe String) (cs : List String) (s : Int) (g : Maybe Grade) (o : Outcome) : Entry :=
  { law := l, cone := h, binding := [{ parameter := "m", generator := "x", fingerprint := fp }], seed := s, cases := 1, conjunct := c,
    conjuncts := cs, budgets := defaultBudgets, reach := [{ parameter := "m", reach := Members [Printed m] }],
    evidence := Cited "listed", grade := g, outcome := o, date := "2026-10-22", interpreter := "listed", hosts := nil }
tpM : Entry := rEntry "T" "hT" "M" "fM" (just "P M") ["P M", "Q M"] 1 (just Cases) Passed
tqM : Entry := rEntry "T" "hT" "M" "fM" (just "Q M") ["P M", "Q M"] 1 (just Cases) Passed
tpN : Entry := rEntry "T" "hT" "N" "fN" (just "P N") ["P N", "Q N"] 1 (just Cases) Passed
tqN : Entry := rEntry "T" "hT" "N" "fN" (just "Q N") ["P N", "Q N"] 1 (just Cases) Passed
tpN2 : Entry := rEntry "T" "hT" "N" "fN2" (just "P N") ["P N", "Q N"] 1 (just Cases) Passed
tpMFails : Entry := rEntry "T" "hT" "M" "fM" (just "P M") ["P M", "Q M"] 2 nothing (Failed "x = 1")
tpMDisagrees : Entry := rEntry "T" "hT" "M" "fM" (just "P M") ["P M", "Q M"] 1 nothing (Failed "x = 2")
tpNFails : Entry := rEntry "T" "hT" "N" "fN" (just "P N") ["P N", "Q N"] 2 nothing (Failed "x = 3")
pM : Entry := rEntry "P" "hP" "M" "fM" nothing nil 1 (just Cases) Passed
lM : Entry := rEntry "L" "hL" "M" "fM" nothing nil 1 (just Cases) Passed
lNFails : Entry := rEntry "L" "hL" "N" "fN" nothing nil 2 nothing (Failed "m = N")
lMFails : Entry := rEntry "L" "hL" "M" "fM" nothing nil 2 nothing (Failed "m = M")
lMDisagrees : Entry := rEntry "L" "hL" "M" "fM" nothing nil 1 nothing (Failed "m = M")
routeEntries : List Entry := [tpM, tqM, tpMFails, pM, lM, lNFails, lMFails, tpNFails]
routeStores : List (List Entry) := [nil, [tpM, tqM], [tpM], [pM], [lM], [lNFails, lM], [lNFails, tpN, tqN, lM],
  [lNFails, tpNFails, tpN, tqN, lM], [lNFails, tpN2, lM], [lMFails, lM], [lMDisagrees, lM], [tpMFails, tpM, tqM],
  [tpMDisagrees, tpM, tqM], [tpN, tqN, tpM, tqM], [pM, tpMFails, tpM, tqM], [lNFails, tpN, tqN, tpM, tqM, lM]]
mDemand (l : String) (h : Hash) (m : String) : ConeDemand := { law := l, cone := h, given := [("m", Printed m)], accepts := Sampled }
theoryOn (m : String) (heads : List String) : Theory := { demand := mDemand "T" "hT" m, heads := heads }
routeds : List Routed := [
  { demand := { law := "P", cone := "hP", given := nil, accepts := Sampled }, byModel := true, models := nil, theory := just (theoryOn "M" ["P"]) },
  { demand := { law := "Q", cone := "hQ", given := nil, accepts := Sampled }, byModel := true, models := nil, theory := just (theoryOn "M" ["Q"]) },
  { demand := mDemand "T" "hT" "M", byModel := false, models := ["m"], theory := nothing },
  { demand := mDemand "P" "hP" "M", byModel := false, models := ["m"], theory := just (theoryOn "M" ["P"]) },
  { demand := mDemand "L" "hL" "M", byModel := false, models := ["m"], theory := just (theoryOn "M" ["L"]) },
  { demand := mDemand "L" "hL" "M", byModel := false, models := ["m"], theory := nothing },
  { demand := mDemand "L" "hL" "N", byModel := false, models := ["m"], theory := just (theoryOn "N" ["L"]) } ]

-- The controls of the route's laws (before the tag, 2026-10-22). A witness that keeps the first entry
-- of the real one only (it drops an obligation) and one that adds an entry the demand does not need;
-- a witness that never serves; a byModel demand served by the law's own entries; a veto that invents a
-- failure; one that reads only the law's own entries (skips the theory's subject); one that reads
-- failures before disagreements; one not scoped by reach (it reads the law's entries of every model);
-- and one scoped by reach that never treats a consequence as refuting all (it passes the defining
-- laws of N and still refutes only N's runs). The demands, entries and stores are the laws' file's.
firstOnly (d : Routed) (es : List Entry) : Maybe (List Entry) :=
  match witness d es { nothing -> nothing ; just w -> just (take Entry 1 w) }
padded (d : Routed) (es : List Entry) : Maybe (List Entry) :=
  match witness d es { nothing -> nothing ; just w -> just (w <> take Entry 1 es) }
never (d : Routed) (es : List Entry) : Maybe (List Entry) := nothing
ownForByModel (d : Routed) (es : List Entry) : Maybe (List Entry) :=
  witness { demand := d.demand, byModel := false, models := d.models, theory := d.theory } es
invents (d : Routed) (es : List Entry) : Maybe Veto := just { state := Current (Failed "invented"), exception := false }
ownOnly (d : Routed) (es : List Entry) : Maybe Veto :=
  veto { demand := d.demand, byModel := d.byModel, models := d.models, theory := nothing } es
failureFirst (d : Routed) (es : List Entry) : Maybe Veto :=
  match firstFailure (routesOf d es) es { just f -> just { state := Current f.outcome, exception := false } ; nothing -> veto d es }
unscoped (d : Routed) (es : List Entry) : Maybe Veto :=
  veto { demand := d.demand, byModel := d.byModel, models := nil, theory := d.theory } es
noException (d : Routed) (es : List Entry) : Maybe Veto :=
  match firstDispute (routesOf d es) es { just p -> (match p { (a, b) -> just { state := Disagrees a b, exception := false } }) ; nothing ->
    (match firstFailure (routesOf d es) es { just f -> just { state := Current f.outcome, exception := false } ; nothing -> nothing }) }
droppingRoutings : List (Routing certifying) := [{ headOf := routing.headOf, witness := firstOnly, veto := veto }]
paddingRoutings : List (Routing certifying) := [{ headOf := routing.headOf, witness := padded, veto := veto }]
neverRoutings : List (Routing certifying) := [{ headOf := routing.headOf, witness := never, veto := veto }]
ownRoutings : List (Routing certifying) := [{ headOf := routing.headOf, witness := ownForByModel, veto := veto }]
inventingRoutings : List (Routing certifying) := [{ headOf := routing.headOf, witness := witness, veto := invents }]
ownOnlyRoutings : List (Routing certifying) := [{ headOf := routing.headOf, witness := witness, veto := ownOnly }]
failureFirstRoutings : List (Routing certifying) := [{ headOf := routing.headOf, witness := witness, veto := failureFirst }]
unscopedRoutings : List (Routing certifying) := [{ headOf := routing.headOf, witness := witness, veto := unscoped }]
noExceptionRoutings : List (Routing certifying) := [{ headOf := routing.headOf, witness := witness, veto := noException }]
test "AWitnessCoversEveryObligation" ExhaustiveMode (seed <- 20261022) (whereBindings <- [bind "k" "models", bind "r" "droppingRoutings", bind "d" "routeds", bind "es" "routeStores"]) (control <- true)
test "AWitnessIsOneEntryPerObligation" ExhaustiveMode (seed <- 20261022) (whereBindings <- [bind "k" "models", bind "r" "paddingRoutings", bind "d" "routeds", bind "es" "routeStores"]) (control <- true)
test "AnEntryForEveryObligationWitnesses" ExhaustiveMode (seed <- 20261022) (whereBindings <- [bind "k" "models", bind "r" "neverRoutings", bind "d" "routeds", bind "es" "routeStores"]) (control <- true)
test "AWitnessCoversEveryObligation" ExhaustiveMode (seed <- 20261022) (whereBindings <- [bind "k" "models", bind "r" "ownRoutings", bind "d" "routeds", bind "es" "routeStores"]) (control <- true)
test "AVetoNamesItsCause" ExhaustiveMode (seed <- 20261022) (whereBindings <- [bind "k" "models", bind "r" "inventingRoutings", bind "d" "routeds", bind "es" "routeStores"]) (control <- true)
test "AFailureInASubjectVetoes" ExhaustiveMode (seed <- 20261022) (whereBindings <- [bind "k" "models", bind "r" "ownOnlyRoutings", bind "d" "routeds", bind "es" "routeStores", bind "e" "routeEntries"]) (control <- true)
test "ADisagreementInASubjectVetoesFirst" ExhaustiveMode (seed <- 20261022) (whereBindings <- [bind "k" "models", bind "r" "failureFirstRoutings", bind "d" "routeds", bind "es" "routeStores"]) (control <- true)
test "AnEntryAboutAnotherModelVetoesNothing" ExhaustiveMode (seed <- 20261022) (whereBindings <- [bind "k" "models", bind "r" "unscopedRoutings", bind "d" "routeds", bind "es" "routeStores", bind "e" "routeEntries"]) (control <- true)
test "AConsequenceRefutesEveryModel" ExhaustiveMode (seed <- 20261022) (whereBindings <- [bind "k" "models", bind "r" "noExceptionRoutings", bind "d" "routeds", bind "es" "routeStores"]) (control <- true)
