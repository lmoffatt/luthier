-- tests/tester/certification_controls.test.lut: the controls of the laws tests/tester/
-- certification_laws.test.lut certifies (7.S19 as D-2026-10-15-a generalized it, L9.14). Each line is
-- the law's line written `(control <- true)`, with the model replaced by one broken on purpose, and
-- is expected to be refuted. Written 2026-10-16 by Claude Opus 5.5, an agent of the coordinating
-- session, on record/IA/code-follows-2026-10-16/prompt-replay-fuel.md. The broken models: a store
-- that absorbs every replay of a known identity, a disagreeing one too (certification.lth's
-- `record` before D-2026-10-15-f); one that writes a not-run for lack of fuel (before
-- D-2026-10-15-g); and a `certifying` whose grade and refusal do not see a disagreement. The
-- entries, stores and censuses are certification_laws.test.lut's.

import "test.lth" test ExhaustiveMode Grade Proved Cases defaultBudgets
import "generators.lth" Binding
import "laws.lth" Listed Cited
import "certification.lth" Certifying Recording Entry Certificate Demand ConeName Refusal Outcome Passed Failed NotRunFor
  fuelSpent outOfFuel known recordEntry anyServes appendRefusals failureAt Current agree disputedAt
  ANewIdentityGoesInFront AnAgreeingReplayAddsNothing AnAgreeingPairSettles ADisagreeingReplayIsKept AnExhaustionIsNeverStored ADisagreementRefutes ADisagreementIsRefused
import "certification_model.lut" certifying anyFailure passes weakestOfBests serves stateOf
import "term.lth" Term Act Program Alpha Substitution Reduction Var Lit Lam App Pi Pair Match Let Define
  IntConst PVar PPair
import "term_model.lut" alpha substitute stepper
import "certification.lth" Erasure ErasureKeepsTheStep eraseBinders erased

entry (l : String) (s : Int) (g : Maybe Grade) (o : Outcome) : Entry :=
  { law := l, cone := "sha256:cccc", binding := nil, seed := s, cases := 1, conjunct := nothing, conjuncts := nil, budgets := defaultBudgets, reach := nil,
    evidence := Cited "listed", grade := g, outcome := o, date := "2026-10-16", interpreter := "listed", hosts := nil }
passOne : Entry := entry "L" 1 (just Cases) Passed
failOne : Entry := entry "L" 1 nothing (Failed "x = 1")
passTwo : Entry := entry "L" 2 (just Cases) Passed
fuelOne : Entry := entry "L" 1 nothing (NotRunFor fuelSpent)
notRunOne : Entry := entry "L" 1 nothing (NotRunFor "no generator")
passOther : Entry := entry "M" 1 (just Cases) Passed
entries : List Entry := [passOne, failOne, passTwo, fuelOne, notRunOne, passOther]
stores : List (List Entry) := [nil, [passOne], [passTwo, passOne], [failOne, passOne], [failOne, failOne, passOne],
  [passOther]]
models : List Certifying := [certifying]

-- a store that absorbs a disagreeing replay: a known identity leaves it as it is, whatever the
-- replay gave
absorb (e : Entry) (es : List Entry) : List Entry :=
  match known certifying (certifying.identity e) es { just f -> es ; nothing -> cons e es }
absorbing : Recording certifying := { record := absorb }
-- a store that writes a not-run for lack of fuel
keepFuel (e : Entry) (es : List Entry) : List Entry := if outOfFuel e.outcome then cons e es else recordEntry certifying e es
keepingFuel : Recording certifying := { record := keepFuel }
-- a store that drops an identity it has not seen
dropNew (e : Entry) (es : List Entry) : List Entry :=
  match known certifying (certifying.identity e) es { just f -> recordEntry certifying e es ; nothing -> es }
droppingNew : Recording certifying := { record := dropNew }
-- a store that writes an exact replay that agrees, where no disagreement stands
writeAgreeing (e : Entry) (es : List Entry) : List Entry :=
  match known certifying (certifying.identity e) es {
    just f -> if agree e f and not (disputedAt certifying.identity (certifying.identity e) es) then cons e es
              else recordEntry certifying e es ;
    nothing -> cons e es }
writingAgreeing : Recording certifying := { record := writeAgreeing }
-- a store that leaves a disagreement standing when an agreeing replay comes
keepDispute (e : Entry) (es : List Entry) : List Entry :=
  match known certifying (certifying.identity e) es {
    just f -> if agree e f and disputedAt certifying.identity (certifying.identity e) es then es
              else recordEntry certifying e es ;
    nothing -> cons e es }
keepingDispute : Recording certifying := { record := keepDispute }
droppingModels : List (Recording certifying) := [droppingNew]
agreeingModels : List (Recording certifying) := [writingAgreeing]
disputeModels : List (Recording certifying) := [keepingDispute]
absorbingModels : List (Recording certifying) := [absorbing]
fuelModels : List (Recording certifying) := [keepingFuel]

-- a `certifying` blind to a disagreement: the grade and the refusal of certification_model.lut's
-- draft 1
blindGrade (c : Certificate) : Maybe Grade :=
  if anyFailure c c.entries then nothing else weakestOfBests (passes c c.entries) (passes c c.entries) nothing
blindLaws (es : List Entry) (n : String) (ds : List Demand) : List Refusal :=
  match ds { nil -> nil ; cons d rest ->
    match failureAt d.law d.cone es {
      just f -> cons { name := n, law := just d.law, state := Current f.outcome } (blindLaws es n rest) ;
      nothing -> if anyServes serves d es then blindLaws es n rest
                 else cons { name := n, law := just d.law, state := stateOf d es } (blindLaws es n rest) } }
blindName (es : List Entry) (c : ConeName) : List Refusal := blindLaws es c.name c.laws
blindRefuse (es : List Entry) (cs : List ConeName) : List Refusal :=
  match cs { nil -> nil ; cons c rest -> appendRefusals (blindName es c) (blindRefuse es rest) }
blind : Certifying := { identity := certifying.identity, stale := certifying.stale, grade := blindGrade,
  contains := certifying.contains, serves := certifying.serves, refuse := blindRefuse, transport := certifying.transport }
blindModels : List Certifying := [blind]

certificates : List Certificate := [{ law := "L", cone := "sha256:cccc", entries := nil },
  { law := "L", cone := "sha256:cccc", entries := [passTwo] }]
ofTheLaw : List Entry := [passOne, failOne, passTwo, notRunOne]
outcomes : List Outcome := [Passed, Failed "x = 2", NotRunFor "no generator"]
grades : List (Maybe Grade) := [nothing, just Cases, just Proved]
behindStores : List (List Entry) := [nil, [passTwo]]
demands : List Demand := [{ law := "L", cone := "sha256:cccc", given := nil, accepts := Cases }]
names : List String := ["n"]

bind (p g : String) : Binding := { parameter := just p, type := nothing, generator := g, coverage := Listed }

test "ADisagreeingReplayIsKept" ExhaustiveMode (seed <- 20261016) (whereBindings <- [bind "k" "models",
  bind "r" "absorbingModels", bind "e" "entries", bind "es" "stores"]) (control <- true)
test "AnExhaustionIsNeverStored" ExhaustiveMode (seed <- 20261016) (whereBindings <- [bind "k" "models",
  bind "r" "fuelModels", bind "e" "entries", bind "es" "stores"]) (control <- true)
test "ADisagreementRefutes" ExhaustiveMode (seed <- 20261016) (whereBindings <- [bind "k" "blindModels",
  bind "c" "certificates", bind "e" "ofTheLaw", bind "o" "outcomes", bind "g" "grades", bind "es" "behindStores"])
  (control <- true)
test "ADisagreementIsRefused" ExhaustiveMode (seed <- 20261016) (whereBindings <- [bind "k" "blindModels",
  bind "n" "names", bind "d" "demands", bind "e" "ofTheLaw", bind "o" "outcomes", bind "g" "grades",
  bind "es" "behindStores"]) (control <- true)
test "ANewIdentityGoesInFront" ExhaustiveMode (seed <- 20261016) (whereBindings <- [bind "k" "models",
  bind "r" "droppingModels", bind "e" "entries", bind "es" "stores"]) (control <- true)
test "AnAgreeingReplayAddsNothing" ExhaustiveMode (seed <- 20261016) (whereBindings <- [bind "k" "models",
  bind "r" "agreeingModels", bind "e" "entries", bind "es" "stores"]) (control <- true)
test "AnAgreeingPairSettles" ExhaustiveMode (seed <- 20261016) (whereBindings <- [bind "k" "models",
  bind "r" "disputeModels", bind "e" "entries", bind "es" "stores"]) (control <- true)

-- The control of `ErasureKeepsTheStep` (D-2026-10-15-e), added 2026-10-18 by Claude Opus 5.5 on
-- record/plan/core-2026-10-17/prompt-bite-1.md: an erasure that also erases the binder of a lambda
-- at the head of a term or of its function, leaving its occurrences free. It goes past the
-- annotation into what the term does, and the beta of the first term shows it.
one : Term := Lit (IntConst 1)
incBody : Term := Lam "k" (Var "Int") (Pair (Var "k") (Var "k"))
erasurePrograms : List Program := [nil, [Define "inc" (Pi "_" (Var "Int") (Var "Int")) incBody]]
erasureTerms : List Term := [
  App (Lam "x" (Var "Int") (Var "x")) one,
  Let "y" (Var "Int") one (Pair (Var "y") (Var "y")),
  App (Var "inc") one ]
eraseBinderNames (t : Term) : Term := match t {
  Lam x a b -> Lam "erased" erased (eraseBinders b) ;
  App f a -> App (eraseBinderNames f) (eraseBinders a) ;
  _ -> eraseBinders t }
alphas : List Alpha := [alpha]
substitutions : List (Substitution alpha) := [substitute]
steppers : List (Reduction alpha substitute) := [stepper]
greedyErasures : List (Erasure alpha substitute stepper) := [{ erase := eraseBinderNames }]
test "ErasureKeepsTheStep" ExhaustiveMode (seed <- 20261018) (whereBindings <- [bind "a" "alphas",
  bind "sb" "substitutions", bind "m" "steppers", bind "e" "greedyErasures", bind "p" "erasurePrograms",
  bind "t" "erasureTerms"]) (control <- true)
