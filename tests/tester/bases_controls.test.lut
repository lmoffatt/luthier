-- tests/tester/bases_controls.test.lut: the controls of bases_laws.test.lut (bite B2 of
-- record/plan/audit-algebras-2026-10-22/execution.md, D-2026-10-25-a). Each line runs a claim of
-- core.lut on a model broken on purpose, `(control <- true)`, and is expected to be refuted
-- (L9.14; 7.S19). The wrong models are this program's own: an equality that relates nothing; the
-- product dioid on [0, ∞] (min, ∞, ×, 1), a dioid whose unit is not the top, which refutes
-- `Integral` alone; the join taken the wrong way round (the larger distance with bottom ∞), which
-- refutes the join's neutral law; the product composition as a model of the assumption-free
-- claim, refuted at a = b = 0.1 where 0.19 is below the union bound 0.2 (the audit's 4.2); a
-- projection as a composition, refuted at the unit; and a log that falls, which turns the nats
-- conversion around. 2026-10-25, Claude Fable 5.1, on prompt-wave-bc.md.
import "test.lth" test ExhaustiveMode
import "generators.lth" Binding
import "laws.lth" Listed
import "core/structures/equality.lth" finiteDistance infiniteDistance

on (p g : String) : Binding := { parameter := just p, type := nothing, generator := g, coverage := Listed }

-- ---------------------------------------------------------------- the wrong models
errors : List Extended := [ finiteDistance 0.0, finiteDistance 0.5, finiteDistance 1.0, finiteDistance 2.0, infiniteDistance unit ]
nothingEqual : Object Extended := { eq := fn a b { false } }
-- [2026-10-27] the pairs and chains it relates: none, so `Symmetric` and `Transitive` hold on it
-- vacuously and `Reflexive` alone is refuted
nothingPairs : List (Related Extended nothingEqual.eq) := []
nothingChains : List (Chain Extended nothingEqual.eq) := []
extendedTimes (a b : Extended) : Extended :=
  match a { infiniteDistance u -> infiniteDistance unit ; finiteDistance x ->
  (match b { infiniteDistance v -> infiniteDistance unit ; finiteDistance y -> finiteDistance (x * y) }) }
extendedLarger (a b : Extended) : Extended :=
  match a { infiniteDistance u -> a ; finiteDistance x ->
  (match b { infiniteDistance v -> b ; finiteDistance y -> finiteDistance (larger x y) }) }
-- a dioid (the laws of `Dioid` hold on the listed errors) whose unit 1 is not the top 0
productDioid : Dioid Extended extendedObject :=
  { bottom := infiniteDistance unit, neutral := finiteDistance 1.0, join := extendedSmaller, combine := extendedTimes }
productBase : ErrorBase := { dioid := productDioid }
-- the join read in the numerical order, against the base's: max with ∞ as its neutral fails
largerDioid : Dioid Extended extendedObject :=
  { bottom := infiniteDistance unit, neutral := finiteDistance 0.0, join := extendedLarger, combine := extendedPlus }
largerBase : ErrorBase := { dioid := largerDioid }

tenths : List EvidenceBound := [ { failure := 0.1, risk := 0.1 } ]
dyadic : List EvidenceBound := [ { failure := 0.0, risk := 0.0 }, { failure := 0.25, risk := 0.5 }, { failure := 1.0, risk := 1.0 } ]
badProduct : EvidenceComposition := productComposition
firstComposition : EvidenceComposition := { tensor := fn x y { x } }

levelPairs : List (Related ProbabilityLevel (fn x y { x <= y })) := [ { x := 0.0, y := 0.5 } ]
fallingLog : Float64 -> Float64 := fn x { 0.0 - x }

-- [2026-10-26, prompt-controls.md, L9.14] a wrong model per uncontrolled conjunct, each breaking the
-- conjunct it names and as few others as the theory allows; the censuses are inside the conjunct's
-- domain (pairs and chains related by the wrong equality).
-- Equalities: the order read as equality (reflexive, transitive, not symmetric), and nearness within
-- a half (reflexive, symmetric, not transitive).
leqEqual : Object Extended := { eq := extendedLeq }
nearEqual : Object Extended := { eq := fn a b {
  match a { infiniteDistance u -> (match b { infiniteDistance v -> true ; finiteDistance y -> false }) ;
            finiteDistance x -> (match b { infiniteDistance v -> false ; finiteDistance y -> (x - y) <= 0.5 and (y - x) <= 0.5 }) } } }
leqPairs : List (Related Extended leqEqual.eq) := [ { x := finiteDistance 0.0, y := finiteDistance 1.0 } ]
leqChains : List (Chain Extended leqEqual.eq) := [ { x := finiteDistance 0.0, y := finiteDistance 0.5, z := finiteDistance 1.0 } ]
nearPairs : List (Related Extended nearEqual.eq) := [ { x := finiteDistance 0.0, y := finiteDistance 0.5 } ]
nearChains : List (Chain Extended nearEqual.eq) := [ { x := finiteDistance 0.0, y := finiteDistance 0.5, z := finiteDistance 1.0 } ]
-- Error bases. The join as the mean of two finite distances (∞ its neutral): commutative and
-- idempotent, not associative; Integral and the join's Pointwise2 fall with it.
extendedMean (a b : Extended) : Extended :=
  match a { infiniteDistance u -> b ; finiteDistance x ->
  (match b { infiniteDistance v -> a ; finiteDistance y -> finiteDistance ((x + y) * 0.5) }) }
meanBase : ErrorBase := { dioid := { bottom := infiniteDistance unit, neutral := finiteDistance 0.0, join := extendedMean, combine := extendedPlus } }
-- the combination a + b + ab(a + b): commutative, monotone (so it distributes over the smaller), 0
-- its unit, ∞ absorbing, never below either part; not associative (1, 1, 2 gives 54 and 100)
extendedCubic (a b : Extended) : Extended :=
  match a { infiniteDistance u -> infiniteDistance unit ; finiteDistance x ->
  (match b { infiniteDistance v -> infiniteDistance unit ; finiteDistance y -> finiteDistance (x + y + x * y * (x + y)) }) }
cubicBase : ErrorBase := { dioid := { bottom := infiniteDistance unit, neutral := finiteDistance 0.0, join := extendedSmaller, combine := extendedCubic } }
-- the unit of the combination read as 1, the rest the base's: Neutral alone
shiftedUnitBase : ErrorBase := { dioid := { bottom := infiniteDistance unit, neutral := finiteDistance 1.0, join := extendedSmaller, combine := extendedPlus } }
-- the combination as the smaller distance with ∞ its unit, so unit and bottom coincide: Absorbing
-- and Distinct (and Integral, and the combination's Pointwise2); one cannot fall without another,
-- since a unit equal to the bottom would be the top, and ∞ is no top here
minBase : ErrorBase := { dioid := { bottom := infiniteDistance unit, neutral := infiniteDistance unit, join := extendedSmaller, combine := extendedSmaller } }
-- the join as the smaller distance plus a toll of a half: associative, commutative, ∞ its neutral,
-- the sum distributes over it; not idempotent (Integral and the join's Pointwise2 fall too)
extendedTolled (a b : Extended) : Extended :=
  match a { infiniteDistance u -> b ; finiteDistance x ->
  (match b { infiniteDistance v -> a ; finiteDistance y -> finiteDistance (smaller x y + 0.5) }) }
tolledBase : ErrorBase := { dioid := { bottom := infiniteDistance unit, neutral := finiteDistance 0.0, join := extendedTolled, combine := extendedPlus } }
-- the sum wrapped modulo 3 on finite distances (∞ absorbing): an associative, commutative monoid
-- with unit 0 that is not monotone, so it does not distribute over the smaller (1 + min(1, 2) is 2,
-- min(1 + 1, 1 + 2) is 0); Integral and the combination's Pointwise2 fall with it
extendedWrapped (a b : Extended) : Extended :=
  match a { infiniteDistance u -> infiniteDistance unit ; finiteDistance x ->
  (match b { infiniteDistance v -> infiniteDistance unit ; finiteDistance y -> finiteDistance (if 3.0 <= x + y then x + y - 3.0 else x + y) }) }
wrappedBase : ErrorBase := { dioid := { bottom := infiniteDistance unit, neutral := finiteDistance 0.0, join := extendedSmaller, combine := extendedWrapped } }
-- not commutative: the join as the first finite distance (associative, idempotent, ∞ its neutral;
-- Integral and the join's Pointwise2 fall too), and the combination as the first nonzero distance
-- (associative, 0 its unit; ∞ no longer absorbs, and it distributes on the left only)
extendedFirstFinite (a b : Extended) : Extended := match a { infiniteDistance u -> b ; finiteDistance x -> a }
extendedFirstNonzero (a b : Extended) : Extended :=
  match a { infiniteDistance u -> a ; finiteDistance x -> (if x == 0.0 then b else a) }
firstFiniteBase : ErrorBase := { dioid := { bottom := infiniteDistance unit, neutral := finiteDistance 0.0, join := extendedFirstFinite, combine := extendedPlus } }
firstNonzeroBase : ErrorBase := { dioid := { bottom := infiniteDistance unit, neutral := finiteDistance 0.0, join := extendedSmaller, combine := extendedFirstNonzero } }
-- Evidence compositions; the join, its bottom (1, 1) and the neutral (0, 0) are evidenceDioid's,
-- not the model's, so only the tensor's laws can fall. Each tensor acts per part.
perPart (f : Float64 -> Float64 -> Float64) : EvidenceComposition :=
  { tensor := fn x y { { failure := f x.failure y.failure, risk := f x.risk y.risk } } }
-- min(1, a + b + ab(a + b)): above the union bound, monotone, (0, 0) its unit, (1, 1) absorbing;
-- not associative
cubicComposition : EvidenceComposition := perPart (fn a b { smaller 1.0 (a + b + a * b * (a + b)) })
-- min(1, a + b + 1/8): associative, monotone, above the union bound; (0, 0) is no unit
tolledComposition : EvidenceComposition := perPart (fn a b { smaller 1.0 (a + b + 0.125) })
-- the sum wrapped into (0, 1] (a sum above 1 loses 1; 0 only for 0 + 0): an associative,
-- commutative monoid with unit 0 that is not monotone, so it does not distribute over the smaller,
-- 1 does not absorb, and a composition can know more than a part (Integral)
wrappedComposition : EvidenceComposition := perPart (fn a b { if 1.0 < a + b then a + b - 1.0 else a + b })
eighths : List EvidenceBound := [ { failure := 0.0, risk := 0.0 }, { failure := 0.125, risk := 0.25 }, { failure := 0.25, risk := 0.125 },
  { failure := 0.75, risk := 0.5 }, { failure := 1.0, risk := 1.0 } ]

-- ---------------------------------------------------------------- the lines
test "ExtendedIsAnObject" ExhaustiveMode (seed <- 20261025)
  (profile <- [on "model" "nothingEqual", on "x" "errors", on "p" "nothingPairs", on "c" "nothingChains"]) (control <- true)
test "ErrorIsABase" ExhaustiveMode (seed <- 20261025)
  (profile <- [on "model" "productBase", on "x" "errors", on "y" "errors", on "z" "errors"]) (control <- true)
test "ErrorIsABase" ExhaustiveMode (seed <- 20261025)
  (profile <- [on "model" "largerBase", on "x" "errors", on "y" "errors", on "z" "errors"]) (control <- true)
test "CappedSumIsAssumptionFree" ExhaustiveMode (seed <- 20261025)
  (profile <- [on "model" "badProduct", on "x" "tenths", on "y" "tenths", on "z" "tenths"]) (control <- true)
test "ProductIsAComposition" ExhaustiveMode (seed <- 20261025)
  (profile <- [on "model" "firstComposition", on "x" "dyadic", on "y" "dyadic", on "z" "dyadic"]) (control <- true)
test "NatsIsAConversion" ExhaustiveMode (seed <- 20261025) (profile <- [on "log" "fallingLog", on "p" "levelPairs"]) (control <- true)

-- [2026-10-26, prompt-controls.md] one line per wrong model above
test "ExtendedIsAnObject" ExhaustiveMode (seed <- 20261026)
  (profile <- [on "model" "leqEqual", on "x" "errors", on "p" "leqPairs", on "c" "leqChains"]) (control <- true)
test "ExtendedIsAnObject" ExhaustiveMode (seed <- 20261026)
  (profile <- [on "model" "nearEqual", on "x" "errors", on "p" "nearPairs", on "c" "nearChains"]) (control <- true)
test "ErrorIsABase" ExhaustiveMode (seed <- 20261026)
  (profile <- [on "model" "meanBase", on "x" "errors", on "y" "errors", on "z" "errors"]) (control <- true)
test "ErrorIsABase" ExhaustiveMode (seed <- 20261026)
  (profile <- [on "model" "cubicBase", on "x" "errors", on "y" "errors", on "z" "errors"]) (control <- true)
test "ErrorIsABase" ExhaustiveMode (seed <- 20261026)
  (profile <- [on "model" "shiftedUnitBase", on "x" "errors", on "y" "errors", on "z" "errors"]) (control <- true)
test "ErrorIsABase" ExhaustiveMode (seed <- 20261026)
  (profile <- [on "model" "minBase", on "x" "errors", on "y" "errors", on "z" "errors"]) (control <- true)
test "ErrorIsABase" ExhaustiveMode (seed <- 20261026)
  (profile <- [on "model" "tolledBase", on "x" "errors", on "y" "errors", on "z" "errors"]) (control <- true)
test "ErrorIsABase" ExhaustiveMode (seed <- 20261026)
  (profile <- [on "model" "wrappedBase", on "x" "errors", on "y" "errors", on "z" "errors"]) (control <- true)
test "ErrorIsABase" ExhaustiveMode (seed <- 20261026)
  (profile <- [on "model" "firstFiniteBase", on "x" "errors", on "y" "errors", on "z" "errors"]) (control <- true)
test "ErrorIsABase" ExhaustiveMode (seed <- 20261026)
  (profile <- [on "model" "firstNonzeroBase", on "x" "errors", on "y" "errors", on "z" "errors"]) (control <- true)
test "CappedSumIsAssumptionFree" ExhaustiveMode (seed <- 20261026)
  (profile <- [on "model" "firstComposition", on "x" "dyadic", on "y" "dyadic", on "z" "dyadic"]) (control <- true)
test "CappedSumIsAssumptionFree" ExhaustiveMode (seed <- 20261026)
  (profile <- [on "model" "cubicComposition", on "x" "eighths", on "y" "eighths", on "z" "eighths"]) (control <- true)
test "CappedSumIsAssumptionFree" ExhaustiveMode (seed <- 20261026)
  (profile <- [on "model" "tolledComposition", on "x" "eighths", on "y" "eighths", on "z" "eighths"]) (control <- true)
test "CappedSumIsAssumptionFree" ExhaustiveMode (seed <- 20261026)
  (profile <- [on "model" "wrappedComposition", on "x" "eighths", on "y" "eighths", on "z" "eighths"]) (control <- true)
test "ProductIsAComposition" ExhaustiveMode (seed <- 20261026)
  (profile <- [on "model" "cubicComposition", on "x" "eighths", on "y" "eighths", on "z" "eighths"]) (control <- true)
test "ProductIsAComposition" ExhaustiveMode (seed <- 20261026)
  (profile <- [on "model" "tolledComposition", on "x" "eighths", on "y" "eighths", on "z" "eighths"]) (control <- true)
test "ProductIsAComposition" ExhaustiveMode (seed <- 20261026)
  (profile <- [on "model" "wrappedComposition", on "x" "eighths", on "y" "eighths", on "z" "eighths"]) (control <- true)
test "ProductIsIndependent" ExhaustiveMode (seed <- 20261026)
  (profile <- [on "model" "cubicComposition", on "x" "eighths", on "y" "eighths", on "z" "eighths"]) (control <- true)
test "ProductIsIndependent" ExhaustiveMode (seed <- 20261026)
  (profile <- [on "model" "tolledComposition", on "x" "eighths", on "y" "eighths", on "z" "eighths"]) (control <- true)
test "ProductIsIndependent" ExhaustiveMode (seed <- 20261026)
  (profile <- [on "model" "wrappedComposition", on "x" "eighths", on "y" "eighths", on "z" "eighths"]) (control <- true)
test "ProductIsIndependent" ExhaustiveMode (seed <- 20261026)
  (profile <- [on "model" "firstComposition", on "x" "dyadic", on "y" "dyadic", on "z" "dyadic"]) (control <- true)
