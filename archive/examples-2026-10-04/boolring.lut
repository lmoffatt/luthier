-- Bool with xor and and is a ring (the field with two elements).

import "algebra"

import "xor.lut"

eqB (a b : Bool) : Bool := a == b

ringBool : Ring Bool := { eq := eqB, add := xor, mul := and, zero := false, one := true, neg := same }

-- (or, and) is a semiring but not a ring: or has no inverses. The test must find it.
semiringOr : Semiring Bool := { eq := eqB, add := or, mul := and, zero := false, one := true }
badRing    : Ring Bool     := { eq := eqB, add := or, mul := and, zero := false, one := true, neg := not }

test ringBool exhaustive
test semiringOr exhaustive
test badRing exhaustive
