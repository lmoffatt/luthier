-- tape.test.lut: the demand that certifies tape.lut's claims, with a control for each: the same
-- line written `(control <- true)` with a model broken on purpose bound in place of the real one,
-- which the law must refute (L9.14). The example of docs/concepts.md, written 2026-10-21 by Claude
-- Opus 5.5. Run with `luthier certify docs/concepts/tape.test.lut`; the entries go to
-- tape.cert.json, beside tape.lut, which makes the claims (L10.12).

import "test.lth" test SampledMode
import "generators_model.lut" linear sameOrNat
import "generators.lth" Binding byParameter
import "laws.lth" Listed
import "numbers.lth" Doubles
import "numbers_model.lut" doubles
import "tape.lth" Mark Tape MetresWithin
import "tape.lut" tape markIsAMetricModel

-- the models each law runs on, a census of one bound by its type (7.R1, 7.R4)
models : List Binding := [
  { parameter := nothing, type := just "Tape", generator := "tape", coverage := Listed },
  { parameter := nothing, type := just "Doubles", generator := "doubles", coverage := Listed } ]

-- the size bounds the integers drawn, [-size, size], filtered into the marks (7.S3, 7.S6)
test "Tape" (SampledMode linear) (cases <- 200) (size <- 50000) (seed <- 20261021) (profile <- models)

-- a metric's diagonal is drawn from listed equal pairs, which a uniform draw almost never gives;
-- for the same reason `y` is drawn equal to `x` in a quarter of the cases (`sameOrNat`, bite A3b),
-- so that MetricIndiscernible, `x` equal to `y` unless their distance is not zero, sees its premise
equalMarks : List (Related Mark (structural Mark).eq) := [{ x := 0, y := 0 }, { x := 1234, y := 1234 }, { x := 50000, y := 50000 }]
onMetric : List Binding := [
  { parameter := just "model", type := nothing, generator := "markIsAMetricModel", coverage := Listed },
  { parameter := just "p", type := nothing, generator := "equalMarks", coverage := Listed }, byParameter "y" "sameOrNat" ]
test "MarkIsAMetric" (SampledMode linear) (cases <- 200) (size <- 50000) (seed <- 20261021) (profile <- onMetric)

-- ---------------------------------------------------------------- the controls

-- a tape read from the outside of its hook, one millimetre long at every reading: ReadingAdds and
-- the metric's diagonal refute it
hooked : Tape := { reading := fn a b { tape.reading a b + 1.0 } }
hookedMetric : Metric Mark (structural Mark) := { d := hooked.reading }
onHooked : List Binding := [
  { parameter := nothing, type := just "Tape", generator := "hooked", coverage := Listed },
  { parameter := nothing, type := just "Doubles", generator := "doubles", coverage := Listed } ]
test "Tape" (SampledMode linear) (cases <- 200) (size <- 50000) (seed <- 20261021) (profile <- onHooked) (control <- true)
onHookedMetric : List Binding := [
  { parameter := just "model", type := nothing, generator := "hookedMetric", coverage := Listed },
  { parameter := just "p", type := nothing, generator := "equalMarks", coverage := Listed }, byParameter "y" "sameOrNat" ]
test "MarkIsAMetric" (SampledMode linear) (cases <- 200) (size <- 50000) (seed <- 20261021) (profile <- onHookedMetric) (control <- true)

-- the doubles with no room for rounding: the bound of MetresWithin becomes zero, and the rounding
-- of the division by a thousand refutes it
noRoom : Doubles Float64 := { plus := doubles.plus, minus := doubles.minus, times := doubles.times,
  divide := doubles.divide, less := doubles.less, leq := doubles.leq, greater := doubles.greater, geq := doubles.geq,
  unequal := doubles.unequal, epsilon := 0.0 }
onNoRoom : List Binding := [
  { parameter := nothing, type := just "Tape", generator := "tape", coverage := Listed },
  { parameter := nothing, type := just "Doubles", generator := "noRoom", coverage := Listed } ]
test "MetresWithin" (SampledMode linear) (cases <- 200) (size <- 50000) (seed <- 20261021) (profile <- onNoRoom) (control <- true)

-- ---------------------------------------------------------------- controls per conjunct (L9.14)
-- 2026-10-26, Claude Sonnet 5.5, record/plan/audit-algebras-2026-10-22/prompt-controls.md: the
-- control of `hooked` is seen by three of Tape's four conjuncts and one of MarkIsAMetric's five, so
-- each of the others gets a model that breaks it. Same cases, same seed.

-- a tape that reads a longer distance one ulp too large when the first mark is the larger: the
-- readings in order (ReadingAdds, ReadingSteps) are exact, and MetresWithin's bound has room for a
-- relative error of one epsilon, so only ReadingSymmetric sees the break
ulpUp : Float64 := 1.0 + 2.0e-16
lopsided : Tape := { reading := fn a b { if a <= b then tape.reading a b else tape.reading a b * ulpUp } }
onLopsided : List Binding := [
  { parameter := nothing, type := just "Tape", generator := "lopsided", coverage := Listed },
  { parameter := nothing, type := just "Doubles", generator := "doubles", coverage := Listed } ]
test "Tape" (SampledMode linear) (cases <- 200) (size <- 50000) (seed <- 20261021) (profile <- onLopsided) (control <- true)

-- a distance that is zero between any two marks: it breaks only the indiscernibility of the
-- marks, and every pair has its premise (a zero distance)
flatMetric : Metric Mark (structural Mark) := { d := fn a b { 0.0 } }
onFlatMetric : List Binding := [
  { parameter := just "model", type := nothing, generator := "flatMetric", coverage := Listed },
  { parameter := just "p", type := nothing, generator := "equalMarks", coverage := Listed }, byParameter "y" "sameOrNat" ]
test "MarkIsAMetric" (SampledMode linear) (cases <- 200) (size <- 50000) (seed <- 20261021) (profile <- onFlatMetric) (control <- true)

-- the distance doubled when the first mark is the larger: symmetric nowhere, a quasimetric otherwise
oneWayMetric : Metric Mark (structural Mark) := { d := fn a b { toFloat64 (if a <= b then b - a else 2 * (a - b)) } }
onOneWayMetric : List Binding := [
  { parameter := just "model", type := nothing, generator := "oneWayMetric", coverage := Listed },
  { parameter := just "p", type := nothing, generator := "equalMarks", coverage := Listed }, byParameter "y" "sameOrNat" ]
test "MarkIsAMetric" (SampledMode linear) (cases <- 200) (size <- 50000) (seed <- 20261021) (profile <- onOneWayMetric) (control <- true)

-- the square of the difference: symmetric, positive, zero only on the diagonal, and the triangle
-- fails (a half-way mark gives two quarters)
squaredMetric : Metric Mark (structural Mark) := { d := fn a b { toFloat64 ((a - b) * (a - b)) } }
onSquaredMetric : List Binding := [
  { parameter := just "model", type := nothing, generator := "squaredMetric", coverage := Listed },
  { parameter := just "p", type := nothing, generator := "equalMarks", coverage := Listed }, byParameter "y" "sameOrNat" ]
test "MarkIsAMetric" (SampledMode linear) (cases <- 200) (size <- 50000) (seed <- 20261021) (profile <- onSquaredMetric) (control <- true)

-- minus the difference between distinct marks: non-negativity fails. No total model breaks it
-- alone (with the diagonal, symmetry and the triangle at x, z, x a negative distance contradicts
-- them), so this one is refuted also at the triangle
negativeMetric : Metric Mark (structural Mark) := { d := fn a b { if a == b then 0.0 else 0.0 - toFloat64 (if a <= b then b - a else a - b) } }
onNegativeMetric : List Binding := [
  { parameter := just "model", type := nothing, generator := "negativeMetric", coverage := Listed },
  { parameter := just "p", type := nothing, generator := "equalMarks", coverage := Listed }, byParameter "y" "sameOrNat" ]
test "MarkIsAMetric" (SampledMode linear) (cases <- 200) (size <- 50000) (seed <- 20261021) (profile <- onNegativeMetric) (control <- true)
